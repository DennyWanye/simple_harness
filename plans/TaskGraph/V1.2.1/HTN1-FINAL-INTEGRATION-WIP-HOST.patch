+
+function Network({ snapshot, mode, inspect, disabled }: { snapshot: GraphSnapshot; mode: "hierarchy" | "execution";
+  inspect: (node: GraphNode) => void; disabled: boolean }) {
+  const marker = useId().replace(/:/g, "");
