    model = _image_model()
    png, err = _generate_png(prompt, size, model)
    if png is None:
        return _err("image gen failed", err or "æœªçŸ¥é”™è¯¯")
    try:
        out = _save_image(png)
    except Exception as exc:  # noqa: BLE001
