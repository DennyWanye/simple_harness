+def test_the_seam_offers_no_retry_or_escalate_adapter():
+    """§57 PR-7 covers READY_TASK_PRIORITY only; RetryAction's six values are deferred.
+
+    The assertion is over the module's executable surface — its public callables —
+    not over its prose: the docstring *explains* the deferral, so a substring scan
+    would fail on the explanation instead of on an adapter.
+    """
+
+    exported = {name for name in seam.__all__}
+    assert not {name for name in exported if "retry" in name.lower()}
+    assert not {name for name in exported if "escalate" in name.lower()}
+    assert seam.READY_TASK_PRIORITY_TYPE is DecisionType.READY_TASK_PRIORITY
+    assert DecisionType.RETRY_OR_ESCALATE not in seam.__all__
+    # The seam's own request builder can only ever mint the one type.
+    request = seam.build_ready_task_priority_request(
+        three_ready(), mission_id=MISSION, decision_id="njr-plan", context={}
+    )
+    assert request.decision_type is DecisionType.READY_TASK_PRIORITY
+    signature = inspect.signature(seam.ready_task_priority_decision)
+    assert "retry" not in " ".join(signature.parameters).lower()
+    source_callables = {
+        name
+        for name, value in vars(seam).items()
+        if callable(value) and getattr(value, "__module__", "") == seam.__name__
+    }
+    assert not {name for name in source_callables if "retry" in name.lower()}
