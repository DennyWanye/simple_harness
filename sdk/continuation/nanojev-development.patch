+"""Contract tests for the NanoJev decision subsystem."""
+
+from __future__ import annotations
+
+import dataclasses
+import inspect
+import math
+
+import pytest
+
+from agent_orchestrator.decision import (
+    DecisionCandidate,
+    DecisionMode,
+    DecisionPolicy,
+    DecisionProvider,
+    DecisionRequest,
+    DecisionResult,
+    DecisionScore,
+    DecisionType,
+)
+
+
+def _candidate(cid: str) -> DecisionCandidate:
+    return DecisionCandidate(id=cid, label=cid, metadata={})
+
+
+def _request(
+    decision_id: str = "d-1",
+    decision_type: DecisionType = DecisionType.READY_TASK_PRIORITY,
+    mission_id: str = "m-1",
+    task_id: str | None = "t-1",
+    candidates: tuple[DecisionCandidate, ...] = (
+        _candidate("a"),
+        _candidate("b"),
+    ),
+    context: dict | None = None,
+) -> DecisionRequest:
+    return DecisionRequest(
+        decision_id=decision_id,
+        decision_type=decision_type,
+        mission_id=mission_id,
+        task_id=task_id,
+        candidates=candidates,
+        context={} if context is None else context,
+    )
+
+
+def _result(
+    selected: str = "a",
+    scores: tuple[DecisionScore, ...] = (
+        DecisionScore(candidate_id="a", probability=0.7),
+        DecisionScore(candidate_id="b", probability=0.3),
+    ),
+    top1_probability: float = 0.7,
+    margin: float = 0.4,
+) -> DecisionResult:
+    return DecisionResult(
+        decision_id="d-1",
+        provider="test-provider",
+        selected=selected,
+        scores=scores,
+        top1_probability=top1_probability,
+        margin=margin,
+        latency_ms=1.5,
+        model_version=None,
+    )
+
+
+class TestDecisionType:
+    def test_members(self) -> None:
+        assert list(DecisionType) == [
+            DecisionType.READY_TASK_PRIORITY,
+            DecisionType.RETRY_OR_ESCALATE,
+        ]
+
+    def test_values(self) -> None:
+        assert DecisionType.READY_TASK_PRIORITY.value == "ready_task_priority"
+        assert DecisionType.RETRY_OR_ESCALATE.value == "retry_or_escalate"
+        assert DecisionType("ready_task_priority") is DecisionType.READY_TASK_PRIORITY
+
+    def test_is_str_enum(self) -> None:
+        assert issubclass(DecisionType, str)
+
+
+class TestDecisionMode:
+    def test_members(self) -> None:
+        assert list(DecisionMode) == [
+            DecisionMode.EXISTING,
+            DecisionMode.SHADOW,
+            DecisionMode.NANOJEV,
+        ]
+
+    def test_values(self) -> None:
+        assert DecisionMode.EXISTING.value == "existing"
+        assert DecisionMode.SHADOW.value == "shadow"
+        assert DecisionMode.NANOJEV.value == "nanojev"
+
+
+class TestDecisionCandidate:
+    def test_valid_candidate_is_frozen_and_slotted(self) -> None:
+        candidate = DecisionCandidate(id="a", label="A", metadata={"k": 1})
+        assert candidate.id == "a"
+        assert candidate.label == "A"
+        assert candidate.metadata == {"k": 1}
+        with pytest.raises(dataclasses.FrozenInstanceError):
+            candidate.id = "b"  # type: ignore[misc]
+        assert not hasattr(candidate, "__dict__")
+
+    def test_rejects_empty_id(self) -> None:
+        with pytest.raises(ValueError):
+            DecisionCandidate(id="", label="A", metadata={})
+        with pytest.raises(ValueError):
+            DecisionCandidate(id="   ", label="A", metadata={})
+
+    def test_rejects_non_mapping_metadata(self) -> None:
+        with pytest.raises(TypeError):
+            DecisionCandidate(id="a", label="A", metadata=[("k", 1)])  # type: ignore[arg-type]
+
+
+class TestDecisionRequestValidation:
+    def test_accepts_valid_request(self) -> None:
+        request = _request()
+        assert request.decision_id == "d-1"
+        assert request.task_id == "t-1"
+        with pytest.raises(dataclasses.FrozenInstanceError):
+            request.mission_id = "other"  # type: ignore[misc]
+
+    def test_accepts_none_task_id(self) -> None:
+        assert _request(task_id=None).task_id is None
+
+    def test_rejects_empty_decision_id(self) -> None:
+        with pytest.raises(ValueError):
+            _request(decision_id="")
+
+    def test_rejects_empty_mission_id(self) -> None:
+        with pytest.raises(ValueError):
+            _request(mission_id="  ")
+
+    def test_rejects_duplicate_candidate_ids(self) -> None:
+        with pytest.raises(ValueError):
+            _request(candidates=(_candidate("a"), _candidate("a")))
+
+    def test_rejects_empty_candidates(self) -> None:
+        with pytest.raises(ValueError):
+            _request(candidates=())
+
+    def test_rejects_non_decision_type(self) -> None:
+        with pytest.raises(TypeError):
+            _request(decision_type="ready_task_priority")  # type: ignore[arg-type]
+
+    def test_rejects_non_mapping_context(self) -> None:
+        with pytest.raises(TypeError):
+            _request(context=["not", "a", "mapping"])  # type: ignore[arg-type]
+
+
+class TestDecisionScoreValidation:
+    def test_accepts_bounds(self) -> None:
+        assert DecisionScore(candidate_id="a", probability=0.0).probability == 0.0
+        assert DecisionScore(candidate_id="a", probability=1.0).probability == 1.0
+
+    def test_rejects_empty_candidate_id(self) -> None:
+        with pytest.raises(ValueError):
+            DecisionScore(candidate_id="", probability=0.5)
+
+    def test_rejects_out_of_range_probability(self) -> None:
+        with pytest.raises(ValueError):
+            DecisionScore(candidate_id="a", probability=-0.1)
+        with pytest.raises(ValueError):
+            DecisionScore(candidate_id="a", probability=1.1)
+
+    def test_rejects_non_finite_probability(self) -> None:
+        for value in (math.nan, math.inf, -math.inf):
+            with pytest.raises(ValueError):
+                DecisionScore(candidate_id="a", probability=value)
+
+    def test_rejects_non_float_probability(self) -> None:
+        with pytest.raises(TypeError):
+            DecisionScore(candidate_id="a", probability="0.5")  # type: ignore[arg-type]
+
+
+class TestDecisionResultValidation:
+    def test_accepts_valid_result(self) -> None:
+        result = _result()
+        assert result.selected == "a"
+        assert result.top1_probability == 0.7
+        assert result.margin == pytest.approx(0.4)
+        with pytest.raises(dataclasses.FrozenInstanceError):
+            result.selected = "b"  # type: ignore[misc]
+
+    def test_model_version_defaults_to_none(self) -> None:
+        result = DecisionResult(
+            decision_id="d-1",
+            provider="test-provider",
+            selected="a",
+            scores=(DecisionScore(candidate_id="a", probability=1.0),),
+            top1_probability=1.0,
+            margin=1.0,
+            latency_ms=0.0,
+        )
+        assert result.model_version is None
+
+    def test_rejects_empty_identifiers(self) -> None:
+        for field in ("decision_id", "provider", "selected"):
+            kwargs = {
+                "selected": "a",
+                "scores": (DecisionScore(candidate_id="a", probability=1.0),),
+                "top1_probability": 1.0,
+                "margin": 1.0,
+            }
+            base = dict(decision_id="d-1", provider="p", latency_ms=0.0, model_version=None)
+            base.update(kwargs)
+            base[field] = ""
+            with pytest.raises(ValueError):
+                DecisionResult(**base)  # type: ignore[arg-type]
+
+    def test_rejects_empty_scores(self) -> None:
+        with pytest.raises(ValueError):
+            _result(scores=(), top1_probability=1.0, margin=1.0)
+
+    def test_rejects_duplicate_score_ids(self) -> None:
+        with pytest.raises(ValueError):
+            _result(
+                scores=(
+                    DecisionScore(candidate_id="a", probability=0.6),
+                    DecisionScore(candidate_id="a", probability=0.4),
+                ),
+                top1_probability=0.6,
+                margin=0.2,
+            )
+
+    def test_rejects_selected_absent_from_scores(self) -> None:
+        with pytest.raises(ValueError):
+            _result(selected="c")
+
+    def test_rejects_top1_mismatch(self) -> None:
+        with pytest.raises(ValueError):
+            _result(top1_probability=0.4)
+
+    def test_rejects_margin_mismatch(self) -> None:
+        with pytest.raises(ValueError):
+            _result(margin=0.9)
+
+
+class TestMargin:
+    def test_margin_two_highest_gap(self) -> None:
+        result = _result(
+            scores=(
+                DecisionScore(candidate_id="a", probability=0.5),
+                DecisionScore(candidate_id="b", probability=0.3),
+                DecisionScore(candidate_id="c", probability=0.2),
+            ),
+            top1_probability=0.5,
+            margin=0.2,
+        )
+        assert result.margin == pytest.approx(0.2)
+
+    def test_single_candidate_margin_is_one(self) -> None:
+        result = _result(
+            scores=(DecisionScore(candidate_id="a", probability=0.42),),
+            top1_probability=0.42,
+            margin=1.0,
+        )
+        assert result.margin == 1.0
+
+    def test_single_candidate_margin_other_rejected(self) -> None:
+        with pytest.raises(ValueError):
+            _result(
+                scores=(DecisionScore(candidate_id="a", probability=0.42),),
+                top1_probability=0.42,
+                margin=0.0,
+            )
+
+
+class TestDecisionProvider:
+    def test_is_abstract(self) -> None:
+        assert inspect.isabstract(DecisionProvider)
+        with pytest.raises(TypeError):
+            DecisionProvider()  # type: ignore[abstract]
+
+    def test_decide_is_async_abstractmethod(self) -> None:
+        assert "decide" in DecisionProvider.__abstractmethods__
+        assert inspect.iscoroutinefunction(DecisionProvider.decide)
+
+    @pytest.mark.asyncio
+    async def test_subclass_can_implement(self) -> None:
+        class FixedProvider(DecisionProvider):
+            async def decide(self, request: DecisionRequest) -> DecisionResult:
+                return _result()
+
+        result = await FixedProvider().decide(_request())
+        assert result.decision_id == "d-1"
+        assert result.provider == "test-provider"
+
+
+class TestDecisionPolicy:
+    def test_default_mode_is_existing(self) -> None:
+        assert DecisionPolicy().mode is DecisionMode.EXISTING
+
+    def test_accepts_all_modes(self) -> None:
+        for mode in (DecisionMode.EXISTING, DecisionMode.SHADOW, DecisionMode.NANOJEV):
+            assert DecisionPolicy(mode=mode).mode is mode
+
+    def test_is_frozen(self) -> None:
+        policy = DecisionPolicy()
+        with pytest.raises(dataclasses.FrozenInstanceError):
+            policy.mode = DecisionMode.SHADOW  # type: ignore[misc]
+
+    def test_rejects_non_decision_mode(self) -> None:
+        with pytest.raises(TypeError):
+            DecisionPolicy(mode="shadow")  # type: ignore[arg-type]
