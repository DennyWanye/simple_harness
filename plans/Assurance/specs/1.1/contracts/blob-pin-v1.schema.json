{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.simpleharness.invalid/assurance/1.1/blob-pin-v1.schema.json",
  "title": "ReviewBlobPinV1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "pin_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "mission_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "review_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "object_ref": {
      "$ref": "common.schema.json#/$defs/ref"
    },
    "blob_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "state": {
      "enum": [
        "PREPARING",
        "BOUND",
        "RELEASED"
      ]
    },
    "row_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "created_at_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "released_at_ms": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "source_receipt_ref": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/ref"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "commit_receipt"
              ]
            }
          }
        }
      ]
    },
    "last_receipt_ref": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/ref"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "commit_receipt"
              ]
            }
          }
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "pin_id",
    "mission_id",
    "review_key",
    "object_ref",
    "blob_hash",
    "state",
    "row_version",
    "created_at_ms",
    "released_at_ms",
    "source_receipt_ref",
    "last_receipt_ref"
  ],
  "additionalProperties": false,
  "$defs": {
    "formula": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "criterion"
          ],
          "properties": {
            "criterion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "items": {
                "$ref": "#/$defs/formula"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "any"
          ],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "items": {
                "$ref": "#/$defs/formula"
              }
            }
          }
        }
      ]
    }
  }
}
