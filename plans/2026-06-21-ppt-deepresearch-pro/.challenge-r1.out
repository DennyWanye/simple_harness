def _run_coro_sync(coro: Any) -> Any:
    """æŠŠä¸€ä¸?coroutine åœ?sync ä¸Šä¸‹æ–‡é‡Œè·‘åˆ°åº•ï¼Œè¿”å›žå…¶ç»“æžœã€?

    è®°å¿†ç³»ç»Ÿå‡çº§ WI-M1.6ï¼š``dispatch()`` æ˜?sync çš„ï¼Œä½?file å·¥å…· handler
    æ”¹æˆäº?asyncã€‚æ—  running loopï¼ˆæµ‹è¯?/ smoke / é—ç•™ sync è°ƒç”¨ï¼‰â†’ ç›´æŽ¥
    ``asyncio.run``ï¼›ä¸‡ä¸€åœ?running loop é‡Œè¢«è°ƒåˆ°ï¼ˆä¸åº”å‘ç”?â€”â€?ç”Ÿäº§ async
    è·¯èµ° V2 ``execute_tool``ï¼‰â†’ ä¸¢è¿›ç‹¬ç«‹çº¿ç¨‹å„è‡ªèµ?loop è·‘ï¼Œé¿å…
    "loop already running"ã€?
    """
    import asyncio as _asyncio

    try:
        _asyncio.get_running_loop()
    except RuntimeError:
        return _asyncio.run(coro)
    import concurrent.futures as _cf

    with _cf.ThreadPoolExecutor(max_workers=1) as _ex:
        return _ex.submit(lambda: _asyncio.run(coro)).result()


