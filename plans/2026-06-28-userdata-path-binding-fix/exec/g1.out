 215: def user_cache_dir() -> Path:
 216:     """Cache directory (HF scratch, temp files).
 217: 
 218:     Portable: ``<install_dir>/userdata/cache``.
 219:     Classic:  ``%LocalAppData%\\deskpet\\Cache\\`` (Windows).
 220: 
 221:     Override via ``DESKPET_USER_CACHE_DIR``.
 222:     """
 223:     override = os.environ.get("DESKPET_USER_CACHE_DIR")
 224:     if override:
 225:         return Path(override)
 226:     portable = _portable_userdata_dir()
 227:     if portable is not None:
