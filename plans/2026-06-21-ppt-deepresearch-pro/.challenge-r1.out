def _save_image(png: bytes) -> Path:
    """Save PNG into workspace, return the path. Raises on IO failure."""
    ws = _workspace_dir()
    stamp = time.strftime("%Y%m%dT%H%M%S", time.gmtime())
    fname = f"genimg_{stamp}_{time.time_ns()}.png"
    out = ws / fname
    out.write_bytes(png)
    return out


