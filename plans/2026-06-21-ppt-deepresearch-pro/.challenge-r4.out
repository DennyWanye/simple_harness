/**
 * P4-S23 鈥?Multi-session zustand store.
 *
 * Single source of truth for everything Code-mode UI renders. The
 * companion-pet window AND the code-panel webview both subscribe to
 * the same store via Tauri's broadcast WS 鈥?events stamped with
 * `payload.session_id` get fanned out to the matching slice here.
 *
 * Design note: we deliberately keep this minimal. Session state lives
 * in this in-memory store + on backend's SessionDB; we don't try to
 * persist scrollback to localStorage (browser quota) 鈥?backend's
 * memory hierarchy already handles long-term retrieval.
 */
import { create } from "zustand";

export type MessageRole =
  | "user"
  | "assistant"
  | "assistant_delta"   // P4-S25 A1: streaming partial assistant content
  | "reasoning_delta"   // P4-S25 A1: streaming thinking-mode chain-of-thought
  | "tool_call"
  | "tool_result"
  | "plan"              // P4-S25 A2: plan card preceding execution
  | "skill_candidate"   // FP-5 WI-4.3c: 鎶€鑳借嚜鍒涚‘璁ゅ崱锛堝悗绔?propose 鈫?鐢ㄦ埛纭锛?
  | "slash_result"      // FEAT-A2: /slash 鍛戒护缁撴灉锛坔elp/goal/prefs/skill/error锛?
  | "error";

export interface PlanStep {
  title: string;
  detail: string;
}

export interface Message {
  id: string;
  role: MessageRole;
  text?: string;
  // Tool-call specific
  tool_name?: string;
  tool_args?: Record<string, unknown>;
  // Tool-result specific
  tool_ok?: boolean;
  tool_result?: string;
  tool_error?: string;
  // P4-S25 A2: plan-card payload
  plan_rationale?: string;
  plan_steps?: PlanStep[];
  // superpowers 鍐崇瓥2 plan-confirm 纭棬: 绛夌敤鎴风偣 [鎵ц]/[鍙栨秷]
  plan_awaiting_confirm?: boolean;
  plan_sid?: string;  // which session this plan belongs to (for plan_confirm WS)
  // FP-5 WI-4.3c: 鎶€鑳借嚜鍒涚‘璁ゅ崱 payload锛堥暅鍍?plan-card 鐨?awaiting 妯″紡锛?
  skill_candidate_id?: number;     // 鍚庣 pending_skill_candidates 琛?id锛堝洖浼?key锛?
  skill_candidate_name?: string;
  skill_candidate_description?: string;
  skill_candidate_steps?: string[];
  // 绛夌敤鎴风偣 [淇濆瓨鎶€鑳絔/[蹇界暐]锛況esolve 鍚庣疆 false 鈫?鎸夐挳娑堝け / 鏄剧ず缁撴灉
  skill_candidate_awaiting?: boolean;
  // resolve 鍚庤褰曠敤鎴锋渶缁堝喅瀹氾紙true=宸蹭繚瀛? false=宸插拷鐣ワ級锛岄┍鍔ㄧ粨鏋滄枃妗?
  skill_candidate_accepted?: boolean;
  skill_candidate_sid?: string;    // 璇ュ崱鎵€灞?session锛堝洖浼?WS 鏃朵笉闇€瑕佷絾渚夸簬瀹氫綅锛?
  // Bookkeeping
  ts: number;
}

export interface Todo {
  content: string;
  activeForm: string;
  status: "pending" | "in_progress" | "completed";
}

export type SessionStatus =
  | "idle"
  | "thinking"
  | "running"
  | "permission"
  | "error";

/** P5-S3-Inbox 鈥?single supervisor alert payload, kept in two places:
 *   鈥?`supervisor_alert` (latest, drives PetStateMachine)
 *   鈥?`supervisor_inbox`  (queue of unhandled, drives toolbar badge + MessageStreamPanel) */
export interface SupervisorAlertEntry {
  alert_id: string;
  severity: "green" | "yellow" | "red";
  action: "nudge" | "ask_user";
  diagnosis: string;
  user_message: string;
  suggested_buttons: string[];
  received_at: number;
}

