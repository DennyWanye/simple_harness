def _default_template() -> Optional[str]:
    """æ— æ˜¾å¼?template æ—¶çš„é»˜è®¤æ¨¡æ¿(å¤§ç±»åæˆ– .pptx è·¯å¾„)ï¼Œæ¥è‡ªçŽ¯å¢ƒå˜é‡?
