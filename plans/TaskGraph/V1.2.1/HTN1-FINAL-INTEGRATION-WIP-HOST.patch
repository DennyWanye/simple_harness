+          <text x="10" y="47" fill="currentColor" fontSize="11">{snapshot.view_mode === "HISTORICAL_STRUCTURE" ? "历史记录" : nodeLabel(node)}</text>
+        </g>;
+      })}
+    </svg>
+  </div>;
