                    pass
            xml_slides.remove(sldId)

        for so in slides:
            layout = _pick_template_layout(prs, so.layout)
            slide = prs.slides.add_slide(layout)

            title_ph = _template_placeholders(
                slide, PP_PLACEHOLDER.TITLE, PP_PLACEHOLDER.CENTER_TITLE,
            )
