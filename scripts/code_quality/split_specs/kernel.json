   "doc": "Starting base-agent and legacy runs and signalling base-agent input.",
   "methods": [
    "_reserve_legacy_start",
    "_reserve_base_agent_start",
    "start_base_agent_run",
    "signal_base_agent_input",
    "_require_legacy_mode"
   ]
  },
  {
   "module": "lifecycle",
   "class": "RuntimeLifecycleMixin",
   "doc": "Start, recovery, reconciliation, diagnostics and shutdown.",
   "methods": [
    "diagnostics_snapshot",
