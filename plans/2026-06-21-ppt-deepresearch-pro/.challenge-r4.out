```python
_PPT_PRO_TASKS: set[asyncio.Task] = set()   # æ¨¡å—çº§ï¼Œä¿æ´»å¼•ç”¨

async def _ppt_pro_orchestrate(*, topic, pages, depth, theme, image_mode,
                               title, author, output_path,
                               outline_propose, notifier, run_blocking, session_id):
    """ç‹¬ç«‹ taskï¼šè°ƒç ”â†’æ‹Ÿçº²â†?å¤§çº²å?ç¡®è®¤â†’æ¸²æŸ“ã€‚åœ¨ main loop ä¸Šè·‘ï¼Œä¸å?chat preempt å½±å“ã€?""
    try:
        await notifier(session_id, "ðŸ” æ­£åœ¨å›´ç»•ä¸»é¢˜åšæ·±åº¦è°ƒç ”â€?)
        report = await _research_topic_for_ppt(topic, depth=depth, timeout_s=research_to)  # WI-1ï¼ˆdeepæ¡£~5minï¼?        if cfg.pro_save_research and report: _save_and_index_research(topic, report)       # WI-1 é»˜è®¤è½ç›˜
        n_src = len(report.citations) if report else 0
        await notifier(session_id, f"ðŸ“š è°ƒç ”å®Œæˆï¼ˆ{n_src} ä¸ªæ¥æºï¼‰ï¼Œæ­£åœ¨æ‹Ÿå¤§çº²â€? if report
                       else "ðŸ“ è°ƒç ”æœªå–å¾—æ¥æºï¼ŒæŒ‰é€šç”¨çŸ¥è¯†æ‹Ÿå¤§çº²â€?)
        llm = await _resolve_default_llm_call()                                            # WI-2 é”å®š LLM æº?        slides = await _draft_outline_from_research(topic, report, pages=pages, theme=theme,
                                                    image_mode=image_mode, llm_call=llm)
        # ç¡®è®¤çŽ¯ï¼ˆFP-5 é£Žæ ¼å¤§çº²å¡ï¼Œâ‰?max_revisionsï¼Œä¼  prev_slides é˜²æ•´ç›˜é‡æ‹?â€?WI-3ï¼?        confirmed = False
        for _ in range(max_revisions + 1):
            d = await outline_propose(session_id, topic=topic, slides=slides, sources_count=n_src,
                                      outline_md=_outline_to_markdown(slides), no_research=(report is None))
            act = d.get("action")
            if act == "accept": confirmed = True; break
            if act == "reuse":            # å¤ç”¨åŽ†å²å¤§çº²
                slides = parse_outline(_outline_store.get_outline(d["reuse_id"])["slides_json"])
                confirmed = True; break
            if act == "cancel":
                await notifier(session_id, "å¥½çš„ï¼Œå·²å–æ¶ˆï¼Œæ²¡æœ‰ç”Ÿæˆ?PPTã€?); return
            # act == "modify"
            slides = await _draft_outline_from_research(topic, report, pages=pages, theme=theme,
                                                        image_mode=image_mode, llm_call=llm,
                                                        feedback=d.get("feedback",""), prev_slides=slides)
        if not confirmed:
            await notifier(session_id, "å¤§çº²æ”¹äº†å¥½å‡ è½®è¿˜æ²¡å®šï¼Œå…ˆæš‚åœå•¦ï¼Œéœ€è¦å†å«æˆ‘~"); return
        # æ¸²æŸ“ï¼ˆé˜»å¡?â†?executorï¼Œä¸å?main loopï¼›render é˜¶æ®µç‹¬ç«‹è¶…æ—¶ï¼Œç»•è¿?registry 1200s æ•…è‡ªåŒ…ï¼‰
        await notifier(session_id, "âœ?å¤§çº²å·²ç¡®è®¤ï¼Œå¼€å§‹ç”Ÿæˆâ€?)
        result = await asyncio.wait_for(
            run_blocking(lambda: _render_pro(slides, theme=theme, title=title,
                    author=author, output_path=output_path, image_mode=image_mode,
                    probe_timeout_s=probe_to, notify=_sync_notify(notifier, session_id))),
            timeout=render_to)   # _ppt_pro_cfg().render_timeout_s = max(600, pages*120)
        await _ppt_pro_report_done(result, notifier, session_id)        # WI-10 receipt/artifact + æŽ¨æˆå“?+ è‡ªåŠ¨æ‰“å¼€
    except asyncio.CancelledError:
        raise
    except Exception as e:
        log.exception("ppt_pro orchestrate failed")
        await notifier(session_id, f"ðŸ˜¿ PPT æ²¡åšæˆï¼š{e}")
```
- `run_blocking` = æ³¨å…¥çš?`lambda coro_fn: loop.run_in_executor(None, coro_fn)`ï¼ˆmain loop çš?executorï¼‰ã€?- `notifier` = æ³¨å…¥çš?main-loop æŽ¨é€ï¼ˆcontrol WS æˆ?`worker.notifier`ï¼Œç¡®è®?notifier ä¹Ÿåœ¨ main loopï¼‰ã€?- `outline_propose` = æ³¨å…¥çš?`_ppt_outline_propose`ï¼ˆWI-3ï¼ŒFP-5 é£Žæ ¼å¤§çº²å?propose+await+historyï¼‰ã€?- handlerï¼ˆWI-7ï¼‰ï¼š`t=asyncio.create_task(_ppt_pro_orchestrate(...)); _PPT_PRO_TASKS.add(t); t.add_done_callback(_PPT_PRO_TASKS.discard); return {"ok":True,"status":"researching","message":"æ­£åœ¨è°ƒç ”ä¸»é¢˜ï¼Œç¨ç­‰æˆ‘æŠŠå¤§çº²æ‹Ÿå‡ºæ¥ç»™ä½ ç¡®è®¤~"}`ã€?
