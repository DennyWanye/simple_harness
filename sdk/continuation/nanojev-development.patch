@@ -0,0 +1,171 @@
+"""The acceptance runner's fixture -> runtime-context adapter.
+
+The frozen R02 fixtures describe a *situation* (``goal_summary``/``blocking_gap``/
+``notes``, or the retry conditions).  The runtime's admission needs the model's
+two prompt segments — ``state`` and ``instructions`` — because the checkpoint was
+trained against ``State:\\n...\\nQuestion type: ...\\nQuestion:\\n...``.  Only the
+caller knows which of its own context keys play those roles, so the derivation
+lives in the runner rather than being guessed inside the runtime.
+
+These tests pin three properties of that derivation:
+
+* every frozen fact still reaches the model, with its type intact;
+* the question is chosen by decision type, never invented for an unknown one;
+* admission actually accepts the result — the adapter's whole job.
+"""
+
+from __future__ import annotations
+
+import importlib.util
+import json
+from pathlib import Path
+from typing import Any
+
+import pytest
+
+REPO_ROOT = Path(__file__).resolve().parents[3]
+
+
+def _load_runner() -> Any:
+    """Import ``scripts/nanojev_sdk_acceptance.py`` without an importable package."""
+    path = REPO_ROOT / "scripts" / "nanojev_sdk_acceptance.py"
+    spec = importlib.util.spec_from_file_location("nanojev_sdk_acceptance", path)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+runner = _load_runner()
+
+
+def _fixture(fixture_id: str) -> dict[str, Any]:
+    for item in runner.load_fixtures():
+        if item["fixture_id"] == fixture_id:
+            return item
+    raise AssertionError(f"fixture not found: {fixture_id}")
+
+
+# --------------------------------------------------------------------------
+# the frozen set still loads and every fixture is admissible
+# --------------------------------------------------------------------------
+
+
+def test_every_frozen_fixture_passes_admission() -> None:
+    """The adapter's whole purpose: no fixture is refused by the runtime boundary."""
+    from agent_orchestrator.decision import NanoJevRequest
+    from agent_orchestrator.decision.local_runtime import LocalNanoJevRuntime
+
+    runtime = LocalNanoJevRuntime("/tmp/checkpoint-not-loaded")
+    for fixture in runner.load_fixtures():
+        request = runner.build_sdk_request(fixture)
+        nano = NanoJevRequest(
+            decision_id=request.decision_id,
+            decision_type=request.decision_type,
+            candidates=tuple(
+                {"id": c.id, "label": c.label, "metadata": c.metadata}
+                for c in request.candidates
+            ),
+            context=request.context,
+        )
+        question = runtime._question_for(nano)  # noqa: SLF001 - the boundary under test
+        assert tuple(question.candidate_ids) == tuple(
+            c.id for c in request.candidates
+        )
+
+
+# --------------------------------------------------------------------------
+# state: every fact preserved, nothing invented
+# --------------------------------------------------------------------------
+
+
+def test_state_preserves_every_frozen_fact_with_its_type() -> None:
+    fixture = _fixture("r02-clear-retry-01")
+    context = runner.build_runtime_context(fixture)
+    state = context["state"]
+
+    for key, value in fixture["context"].items():
+        assert key in state, f"{key} was dropped from the state segment"
+        rendered = value if isinstance(value, str) else json.dumps(value)
+        assert f"{key}: {rendered}" in state
+
+    # Booleans and integers must keep their type rather than becoming "True"/"1"
+    # text, so the model sees the same facts the fixture froze.
+    assert "input_changed: false" in state
+    assert "attempts_so_far: 1" in state
+    assert "input_changed: False" not in state
+
+
+def test_state_renders_priority_and_retry_keys_in_their_own_order() -> None:
+    priority = runner.build_runtime_context(_fixture("r02-clear-priority-01"))
+    retry = runner.build_runtime_context(_fixture("r02-context-retry-01"))
+
+    assert list(priority["state"].splitlines()) == [
+        "goal_summary: the failing request is not reproducible yet; "
+        "find the trigger first",
+        "blocking_gap: no minimal reproduction exists",
+        "notes: cosmetic work is not on the critical path",
+    ]
+    # The retry state starts at the error and ends at the qualifying note.
+    assert retry["state"].splitlines()[0].startswith("normalized_error: ")
+    assert retry["state"].splitlines()[-1].startswith("notes: ")
+
+
+def test_state_omits_absent_keys_instead_of_inventing_them() -> None:
+    """A context missing a key must not gain a placeholder for it."""
+    state = runner.derive_state_text(
+        "ready_task_priority", {"goal_summary": "ship the fix"}
+    )
+    assert state == "goal_summary: ship the fix"
+    assert "blocking_gap" not in state
+    assert "notes" not in state
+
+
+# --------------------------------------------------------------------------
+# instructions: chosen by decision type, never guessed
+# --------------------------------------------------------------------------
+
+
+@pytest.mark.parametrize(
+    "decision_type",
+    ["ready_task_priority", "retry_or_escalate"],
+)
+def test_instructions_come_from_the_decision_type(decision_type: str) -> None:
+    fixture = _fixture("r02-clear-priority-01")
+    context = runner.build_runtime_context({**fixture, "decision_type": decision_type})
+    assert context["instructions"] == runner._INSTRUCTIONS_BY_TYPE[decision_type]
+
+
+def test_unknown_decision_type_is_refused_rather_than_given_a_question() -> None:
+    fixture = {**_fixture("r02-clear-priority-01"), "decision_type": "invent_a_new_one"}
+    with pytest.raises(runner.FixtureError, match="invent_a_new_one"):
+        runner.build_runtime_context(fixture)
+
+
+# --------------------------------------------------------------------------
+# the fixture's own semantics survive the adapter
+# --------------------------------------------------------------------------
+
+
+def test_original_fixture_context_is_kept_verbatim() -> None:
+    """The adapter adds the prompt split; it does not replace the fixture facts."""
+    fixture = _fixture("r02-context-priority-01")
+    context = runner.build_runtime_context(fixture)
+
+    for key, value in fixture["context"].items():
+        assert context[key] == value, f"{key} was rewritten by the adapter"
+    assert context["fixture_context"] == dict(fixture["context"])
+
+
+def test_reversed_candidates_keep_their_own_labels() -> None:
+    """Order sensitivity must be attributable to position, not to a label swap."""
+    fixture = _fixture("r02-clear-priority-01")
+    forward = runner.build_sdk_request(fixture)
+    reversed_request = runner.build_sdk_request(fixture, reverse=True)
+
+    assert [c.id for c in reversed_request.candidates] == list(
+        reversed([c.id for c in forward.candidates])
+    )
+    by_id = {c.id: c.label for c in forward.candidates}
+    for candidate in reversed_request.candidates:
+        assert candidate.label == by_id[candidate.id]
