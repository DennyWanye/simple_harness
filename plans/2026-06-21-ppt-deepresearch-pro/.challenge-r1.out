def _resolve_endpoint() -> tuple[str, str | None]:
    """(base_url, api_key) â€?the SAME creds the working chat path uses.

    Priority: ``<user_data>/llm_runtime.json`` (base_url + api_key the
    user actually configured for the relay) â†?config.toml ``[llm]`` +
    ``resolve_cloud_api_key()``. Lazy imports keep tool auto-discovery
    free of import-order coupling.
    """
    base_url = ""
    api_key: str | None = None
    try:
        from paths import user_data_dir  # type: ignore[import-not-found]

        rt = user_data_dir() / "llm_runtime.json"
        if rt.exists():
            data = json.loads(rt.read_text(encoding="utf-8"))
            base_url = str(data.get("base_url") or "")
            api_key = data.get("api_key") or None
    except Exception:  # noqa: BLE001 â€?fall through to config
        pass

    if not base_url:
        try:
            from config import standalone_config_section  # type: ignore[import-not-found]

            base_url = str(
                (standalone_config_section("llm") or {}).get("base_url", "")
            )
        except Exception:  # noqa: BLE001
            base_url = ""
    if not api_key:
        try:
            from config import resolve_cloud_api_key  # type: ignore

            api_key = resolve_cloud_api_key()
        except Exception:  # noqa: BLE001
            api_key = None

    return base_url.rstrip("/"), api_key


def _image_model() -> str:
    try:
        from config import standalone_config_section  # type: ignore[import-not-found]

        return str(
            (standalone_config_section("image") or {}).get("model")
            or _DEFAULT_MODEL
        )
    except Exception:  # noqa: BLE001
        return _DEFAULT_MODEL


def _trust_env_proxy() -> bool:
    """config ``[image].trust_env_proxy`` â†?httpx trust_envï¼ˆé»˜è®?Falseï¼‰ã€?
    é»˜è®¤ç»•è¿‡ç³»ç»Ÿä»£ç†ç›´è¿žä¸­è½¬ç«™ï¼šæœ¬æœºä»£ç†ï¼ˆClash ç­‰ï¼‰ä¼šæŠŠå‡ºå›¾è¿™ç§
    60~220s é›¶å­—èŠ‚æµåŠ¨çš„ã€Œç©ºé—²ã€è¿žæŽ?~60s æŽæ–­ï¼ˆè§æ¨¡å—é¡¶éƒ¨æ ¹å› æ³¨é‡Šï¼‰ã€?    è‹¥ç”¨æˆ·çš„ç½‘ç»œçŽ¯å¢ƒå¿…é¡»èµ°ä»£ç†æ‰èƒ½åˆ°è¾?endpointï¼Œå¯åœ?config è®?    ``[image] trust_env_proxy = true`` æ”¹å›žè·Ÿéš HTTP(S)_PROXY envã€?    """
    try:
        from config import standalone_config_section  # type: ignore[import-not-found]

        return bool(
            (standalone_config_section("image") or {}).get("trust_env_proxy", False)
        )
    except Exception:  # noqa: BLE001
        return False


def _image_quality() -> str:
    """config ``[image].quality`` â†?payload qualityï¼ˆé»˜è®?mediumï¼‰ã€?
    ä¸­è½¬å±‚å…¨å­—æ®µé€ä¼ ï¼ˆimages.service.ts ä»…æ›¿æ?model å­—æ®µï¼‰ï¼Œquality ç›´è¾¾
    ä¸Šæ¸¸ï¼›è®¡è´¹æŒ‰å¼ æ•°ä¸Žè´¨é‡æ— å…³ã€‚æ¡Œå® å°çª—å±•ç¤ºåœºæ™¯ç”¨ä¸åˆ° HD â€”â€?é™?quality
    èƒ½æŠŠçŽ°ç½‘ 57~221s çš„ç”Ÿæˆè€—æ—¶æ˜¾è‘—åŽ‹ä½Žï¼Œæ˜¯æœ€ä¾¿å®œçš„æé€Ÿæ‰‹æ®µã€?    """
    try:
        from config import standalone_config_section  # type: ignore[import-not-found]

        return str(
            (standalone_config_section("image") or {}).get("quality")
            or _DEFAULT_QUALITY
        )
    except Exception:  # noqa: BLE001
        return _DEFAULT_QUALITY


def _workspace_dir() -> Path:
    from paths import user_data_dir  # type: ignore[import-not-found]

    ws = user_data_dir() / "workspace"
    ws.mkdir(parents=True, exist_ok=True)
    return ws

