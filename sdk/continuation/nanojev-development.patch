+"""Caller-level guarantees for the PR-7 legacy allocation observer."""
+
+from __future__ import annotations
+
+import asyncio
+import inspect
+import time
+from types import SimpleNamespace
+
+import pytest
+
+from agent_orchestrator.orchestrator.event_handler import Orchestrator
+from agent_orchestrator.scheduling.allocator import AllocationPlanV2
+
+
+def _observer_host(observer):
+    host = object.__new__(Orchestrator)
+    host._decision_observer = observer
+    host._decision_observer_tasks = set()
+    host.notes = []
+    host._note = host.notes.append
+    return host
+
+
+@pytest.mark.asyncio
+async def test_missing_observer_is_a_noop() -> None:
+    host = _observer_host(None)
+    await host._observe_decision(SimpleNamespace(id="m"), (), (), object())
+    assert host._decision_observer_tasks == set()
+    assert host.notes == []
+
+
+@pytest.mark.asyncio
+async def test_slow_async_observer_does_not_block_dispatch_and_is_retained() -> None:
+    started = asyncio.Event()
+    release = asyncio.Event()
+
+    async def slow(*_args):
+        started.set()
+        await release.wait()
+
+    host = _observer_host(slow)
+    begin = time.monotonic()
+    await host._observe_decision(SimpleNamespace(id="m"), (), (), object())
+    elapsed = time.monotonic() - begin
+    assert elapsed < 0.05
+    await asyncio.wait_for(started.wait(), timeout=0.2)
+    assert host._decision_observer_tasks
+    release.set()
+    for _ in range(20):
+        if not host._decision_observer_tasks:
+            break
+        await asyncio.sleep(0)
+    assert host._decision_observer_tasks == set()
+    assert host.notes == []
+
+
+@pytest.mark.asyncio
+async def test_async_observer_failure_isolated_after_dispatch() -> None:
+    async def fail(*_args):
+        raise RuntimeError("shadow down")
+
+    host = _observer_host(fail)
+    await host._observe_decision(SimpleNamespace(id="m"), (), (), object())
+    for _ in range(20):
+        if host.notes:
+            break
+        await asyncio.sleep(0)
+    assert host.notes and "shadow observer failed asynchronously" in host.notes[0]
+
+
+@pytest.mark.asyncio
+async def test_v2_observer_receives_only_allocator_scored_tasks_without_mutating_plan() -> None:
+    observed = []
+
+    async def capture(mission, tasks, attempts, plan):
+        observed.append((mission, tuple(tasks), attempts, plan))
+
