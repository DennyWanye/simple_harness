@@ -0,0 +1,57 @@
+"""Small runtime boundary for NanoJev model implementations.
+
+This module contains no model-specific checkpoint code.  A concrete runtime may
+use PyTorch, MPS, CPU, or a local service while the provider contract remains
+unchanged.
+"""
+
+from __future__ import annotations
+
+from abc import ABC, abstractmethod
+from collections.abc import Mapping, Sequence
+from dataclasses import dataclass
+from typing import Any
+
+from .types import DecisionType
+
+
+@dataclass(frozen=True, slots=True)
+class NanoJevRequest:
+    decision_id: str
+    decision_type: DecisionType
+    candidates: tuple[Mapping[str, Any], ...]
+    context: Mapping[str, Any]
+
+    def __post_init__(self) -> None:
+        if not isinstance(self.decision_id, str) or not self.decision_id.strip():
+            raise ValueError("runtime request decision_id must be non-empty")
+        if not isinstance(self.decision_type, DecisionType):
+            raise TypeError("runtime request decision_type must be a DecisionType")
+        if not isinstance(self.candidates, Sequence) or not self.candidates:
+            raise ValueError("runtime request candidates must not be empty")
+        object.__setattr__(self, "candidates", tuple(self.candidates))
+        if not isinstance(self.context, Mapping):
+            raise TypeError("runtime request context must be a Mapping")
+
+
+@dataclass(frozen=True, slots=True)
+class NanoJevOutput:
+    selected: str
+    probabilities: Mapping[str, float]
+    model_version: str | None = None
+
+
+class NanoJevRuntime(ABC):
+    """Resident runtime contract; loading happens at lifecycle start."""
+
+    @abstractmethod
+    async def start(self) -> None:
+        raise NotImplementedError
+
+    @abstractmethod
+    async def evaluate(self, request: NanoJevRequest) -> NanoJevOutput:
+        raise NotImplementedError
+
+    @abstractmethod
+    async def close(self) -> None:
+        raise NotImplementedError
diff --git a/src/agent_orchestrator/decision/service.py b/src/agent_orchestrator/decision/service.py
new file mode 100644
index 0000000..98c7f15
--- /dev/null
+++ b/src/agent_orchestrator/decision/service.py
@@ -0,0 +1,464 @@
+"""Runtime boundary for existing decisions and non-blocking shadow observation.
+
+The service deliberately owns no planning or execution semantics.  It runs the
+existing provider as the production decision, and optionally observes a second
+provider without allowing that provider to delay or alter the returned result.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import copy
+import hashlib
+import json
+import math
+from collections.abc import Mapping
+from dataclasses import dataclass
+from enum import StrEnum
+from types import MappingProxyType
+from typing import Any
+
+from .events import (
+    DecisionEventJournal,
+    DecisionProduced,
+    DecisionProducer,
+    DecisionRequested,
+    DecisionStatus,
+    ShadowDecisionFailed,
+    ShadowDecisionProduced,
+)
+from .gate import FastPathGate, is_nanojev_decidable
+from .policy import DecisionMode, DecisionPolicy
+from .provider import DecisionProvider
+from .types import DecisionCandidate, DecisionRequest, DecisionResult
+
+
+class ShadowObservationStatus(StrEnum):
+    COMPLETED = "completed"
+    FAILED = "failed"
+    TIMED_OUT = "timed_out"
+
+
+@dataclass(frozen=True, slots=True)
+class DecisionObservation:
+    """A completed, attributable shadow observation."""
+
+    decision_id: str
+    request_candidate_ids: tuple[str, ...]
+    request_context: Mapping[str, Any]
+    existing_result: DecisionResult
+    shadow_result: DecisionResult | None
+    status: ShadowObservationStatus
+    error: str | None = None
+
+
+def _snapshot(value: Any) -> Any:
+    """Copy request context into a detached, test-friendly immutable shape."""
+    if isinstance(value, dict):
+        return MappingProxyType(
+            {str(key): _snapshot(item) for key, item in value.items()}
+        )
+    if isinstance(value, (list, tuple)):
+        return tuple(_snapshot(item) for item in value)
+    if isinstance(value, set):
+        return frozenset(_snapshot(item) for item in value)
+    try:
+        return copy.deepcopy(value)
+    except Exception:
+        return repr(value)
+
+
+def _snapshot_request(request: DecisionRequest) -> DecisionRequest:
+    return DecisionRequest(
+        decision_id=request.decision_id,
+        decision_type=request.decision_type,
+        mission_id=request.mission_id,
+        task_id=request.task_id,
+        candidates=tuple(
+            DecisionCandidate(
+                candidate.id,
+                candidate.label,
+                _snapshot(dict(candidate.metadata)),
+            )
+            for candidate in request.candidates
+        ),
+        context=_snapshot(dict(request.context)),
+    )
+
+
+def _context_hash(request: DecisionRequest) -> str:
+    """A stable digest of the request context — the event never carries it raw."""
+    material = json.dumps(
+        {"context": _plain(dict(request.context)), "candidates": [
+            candidate.id for candidate in request.candidates
+        ]},
+        sort_keys=True,
+        ensure_ascii=False,
+        default=repr,
+    )
+    return hashlib.sha256(material.encode("utf-8")).hexdigest()
+
+
+def _context_version(request: DecisionRequest) -> int:
+    """The context schema version a caller may pin; ``0`` when it does not."""
+    value = request.context.get("context_version", 0)
+    return value if isinstance(value, int) and not isinstance(value, bool) else 0
+
+
+def _plain(value: Any) -> Any:
+    """Reduce snapshots (mapping proxies, tuples) to a JSON-friendly shape."""
+    if isinstance(value, Mapping):
+        return {str(key): _plain(item) for key, item in value.items()}
+    if isinstance(value, (list, tuple)):
+        return [_plain(item) for item in value]
+    if isinstance(value, (set, frozenset)):
+        return sorted((_plain(item) for item in value), key=repr)
+    return value
+
+
+def _validate_result(request: DecisionRequest, result: DecisionResult) -> None:
+    if not isinstance(result, DecisionResult):
+        raise TypeError("decision provider must return a DecisionResult")
+    if result.decision_id != request.decision_id:
+        raise ValueError("decision result decision_id does not match request")
+    expected = {candidate.id for candidate in request.candidates}
+    actual = {score.candidate_id for score in result.scores}
+    if actual != expected:
+        raise ValueError("decision result scores do not match request candidates")
+    if not math.isclose(
+        sum(score.probability for score in result.scores),
+        1.0,
+        rel_tol=1e-5,
+        abs_tol=1e-5,
+    ):
+        raise ValueError("decision result probabilities must sum to 1")
+
+
+class DecisionService:
+    """Execute the existing decision and optionally observe a shadow provider."""
+
+    def __init__(
+        self,
+        existing_provider: DecisionProvider,
+        *,
+        policy: DecisionPolicy = DecisionPolicy(),
+        shadow_provider: DecisionProvider | None = None,
+        shadow_timeout_seconds: float | None = None,
+        gate: FastPathGate | None = None,
+        event_journal: DecisionEventJournal | None = None,
+    ) -> None:
+        if not isinstance(existing_provider, DecisionProvider):
+            raise TypeError("existing_provider must be a DecisionProvider")
+        if not isinstance(policy, DecisionPolicy):
+            raise TypeError("policy must be a DecisionPolicy")
+        if shadow_provider is not None and not isinstance(shadow_provider, DecisionProvider):
+            raise TypeError("shadow_provider must be a DecisionProvider")
+        if shadow_timeout_seconds is not None and shadow_timeout_seconds <= 0:
+            raise ValueError("shadow_timeout_seconds must be positive")
+        if gate is not None and not isinstance(gate, FastPathGate):
+            raise TypeError("gate must be a FastPathGate")
+        if event_journal is not None and not isinstance(event_journal, DecisionEventJournal):
+            raise TypeError("event_journal must be a DecisionEventJournal")
+        if policy.mode is DecisionMode.SHADOW and shadow_provider is None:
+            raise ValueError("shadow_provider is required in shadow mode")
+        # Plan §42/§43: NANOJEV mode means "NanoJev answers when confident, the
+        # existing path answers otherwise".  Without a provider there is nothing
+        # to answer, and quietly behaving like EXISTING would discard every
+        # NanoJev vote while the operator believes the model is live.  Fail at
+        # construction instead of never at all.
+        if policy.mode is DecisionMode.NANOJEV and shadow_provider is None:
+            raise ValueError(
+                "nanojev_provider is required in nanojev mode; without it the "
+                "mode would silently degrade to existing"
+            )
+        self._existing_provider = existing_provider
+        self._shadow_provider = shadow_provider
+        self._policy = policy
+        self._shadow_timeout_seconds = shadow_timeout_seconds
+        self._gate = FastPathGate() if gate is None else gate
+        self._event_journal = event_journal
+        self._tasks: set[asyncio.Task[None]] = set()
+        self._observations: list[DecisionObservation] = []
+
+    @property
+    def policy(self) -> DecisionPolicy:
+        """The immutable rollout policy this service was built with."""
+        return self._policy
+
+    @property
+    def gate(self) -> FastPathGate:
+        """The confidence gate applied in ``nanojev`` mode."""
+        return self._gate
+
+    @property
+    def observations(self) -> tuple[DecisionObservation, ...]:
+        return tuple(self._observations)
+
+    async def decide(self, request: DecisionRequest) -> DecisionResult:
+        if not isinstance(request, DecisionRequest):
+            raise TypeError("request must be a DecisionRequest")
+
+        request_candidate_ids = tuple(candidate.id for candidate in request.candidates)
+        request_context = _snapshot(dict(request.context))
+        shadow_request = _snapshot_request(request)
+
+        self._emit_requested(request)
+
+        if self._policy.mode is DecisionMode.NANOJEV:
+            return await self._decide_nanojev(request)
+
+        existing = await self._existing_provider.decide(request)
+        _validate_result(request, existing)
+        # A single candidate is already deterministic.  In particular, do not
+        # spend a model call merely to observe an answer that cannot differ.
+        if self._policy.mode is not DecisionMode.SHADOW or len(request.candidates) == 1:
+            self._emit_produced(request, existing)
+            return existing
+
+        assert self._shadow_provider is not None
+        task = asyncio.create_task(
+            self._observe(
+                shadow_request,
+                existing,
+                request_candidate_ids=request_candidate_ids,
+                request_context=request_context,
+            )
+        )
+        self._tasks.add(task)
+        task.add_done_callback(self._tasks.discard)
+        return existing
+
+    async def _decide_nanojev(self, request: DecisionRequest) -> DecisionResult:
+        """Plan §40/§42: NanoJev answers when confident, existing answers otherwise.
+
+        Every path that is not "a confident NanoJev result" falls back to the
+        existing provider, so the production truth stays the existing decision
+        unless the model actively wins the gate:
+
+        * a structural / non-operational decision is refused outright — the
+          request is never built and the existing provider answers;
+        * a single candidate is deterministic, so the model is not called;
+        * a provider that raises, times out, or returns an ungateable result
+          falls back;
+        * a valid but unconfident result falls back.
+        """
+        if len(request.candidates) > 1 and is_nanojev_decidable(request.decision_type):
+            try:
+                candidate = await self._call_shadow(request)
+            except Exception:  # plan §19/§43: a model problem is never a production failure
+                candidate = None
+            if candidate is not None and self._gate.accept(candidate):
+                self._emit_produced(request, candidate)
+                return candidate
+
+        existing = await self._existing_provider.decide(request)
+        _validate_result(request, existing)
+        self._emit_produced(request, existing)
+        return existing
+
+    def _emit_requested(self, request: DecisionRequest) -> None:
+        """Record the request, if a journal was injected (plan §22).
+
+        Additive: with no journal this is a no-op and no event is written.
+        """
+        journal = self._event_journal
+        if journal is None:
+            return
+        try:
+            journal.append(
+                DecisionRequested(
+                    decision_id=request.decision_id,
+                    decision_type=request.decision_type,
+                    mission_id=request.mission_id,
+                    task_id=request.task_id,
+                    candidates=tuple(candidate.id for candidate in request.candidates),
+                    context_hash=_context_hash(request),
+                    context_version=_context_version(request),
+                )
+            )
+        except Exception:
+            # Event persistence is observational; a broken sink cannot alter the
+            # existing decision or make its driver fail.
+            return
+
+    def _emit_produced(self, request: DecisionRequest, result: DecisionResult) -> None:
+        """Record the production answer, if a journal was injected (plan §23)."""
+        journal = self._event_journal
+        if journal is None:
+            return
+        try:
+            journal.append(
+                DecisionProduced(
+                    decision_id=request.decision_id,
+                    decision_type=request.decision_type,
+                    mode=str(self._policy.mode),
+                    producer=DecisionProducer.PRODUCTION,
+                    result=result,
+                )
+            )
+        except Exception:
+            return
+
+    async def _call_shadow(self, request: DecisionRequest) -> DecisionResult:
+        """Await the NanoJev provider, honouring the optional timeout."""
+        shadow = self._shadow_provider
+        assert shadow is not None
+        if self._shadow_timeout_seconds is None:
+            result = await shadow.decide(request)
+        else:
+            result = await asyncio.wait_for(
+                shadow.decide(request), timeout=self._shadow_timeout_seconds
+            )
+        _validate_result(request, result)
+        return result
+
+    async def _observe(
+        self,
+        request: DecisionRequest,
+        existing: DecisionResult,
+        *,
+        request_candidate_ids: tuple[str, ...],
+        request_context: dict[str, Any],
+        latency_ms: float = 0.0,
+    ) -> None:
+        try:
+            result = await self._call_shadow(request)
+        except TimeoutError:
+            self._append_observation(
+                request_candidate_ids,
+                request_context,
+                existing,
+                None,
+                ShadowObservationStatus.TIMED_OUT,
+                "shadow provider timed out",
+                request.decision_id,
+            )
+            self._emit_shadow_failed(
+                request, ShadowObservationStatus.TIMED_OUT, "shadow provider timed out", latency_ms
+            )
+        except Exception as exc:  # shadow failures are observations, never production failures
+            error = f"{type(exc).__name__}: {exc}"
+            self._append_observation(
+                request_candidate_ids,
+                request_context,
+                existing,
+                None,
+                ShadowObservationStatus.FAILED,
+                error,
+                request.decision_id,
+            )
+            self._emit_shadow_failed(request, ShadowObservationStatus.FAILED, error, latency_ms)
+        else:
+            self._append_observation(
+                request_candidate_ids,
+                request_context,
+                existing,
+                result,
+                ShadowObservationStatus.COMPLETED,
+                None,
+                request.decision_id,
+            )
+            try:
+                self._emit_shadow_produced(request, existing, result)
+            except Exception as exc:  # journal failure is an observation failure
+                error = f"{type(exc).__name__}: {exc}"
+                self._append_observation(
+                    request_candidate_ids,
+                    request_context,
+                    existing,
+                    result,
+                    ShadowObservationStatus.FAILED,
+                    error,
+                    request.decision_id,
+                )
+                self._emit_shadow_failed(
+                    request, ShadowObservationStatus.FAILED, error, latency_ms
+                )
+
+    def _emit_shadow_produced(
+        self,
+        request: DecisionRequest,
+        existing: DecisionResult,
+        result: DecisionResult,
+    ) -> None:
+        """Record the shadow answer and its agreement, if a journal was injected."""
+        journal = self._event_journal
+        if journal is None:
+            return
+        journal.append(
+            ShadowDecisionProduced(
+                decision_id=request.decision_id,
+                decision_type=request.decision_type,
+                mode=str(self._policy.mode),
+                result=result,
+                production_selected=existing.selected,
+                mission_id=request.mission_id,
+                task_id=request.task_id,
+            )
+        )
+
+    def _emit_shadow_failed(
+        self,
+        request: DecisionRequest,
+        status: ShadowObservationStatus,
+        error: str,
+        latency_ms: float,
+    ) -> None:
+        """Record a shadow failure, if a journal was injected (plan §19).
+
+        The failure is already caught by the caller; this only logs it.  It must
+        never raise into the production path, so a journal problem is swallowed
+        the same way a model problem is.
+        """
+        journal = self._event_journal
+        if journal is None:
+            return
+        try:
+            journal.append(
+                ShadowDecisionFailed(
+                    decision_id=request.decision_id,
+                    decision_type=request.decision_type,
+                    mode=str(self._policy.mode),
+                    error=error,
+                    status=DecisionStatus(status.value),
+                    latency_ms=latency_ms,
+                    mission_id=request.mission_id,
+                    task_id=request.task_id,
+                )
+            )
+        except Exception:
+            pass
+
+    def _append_observation(
+        self,
+        request_candidate_ids: tuple[str, ...],
+        request_context: dict[str, Any],
+        existing: DecisionResult,
+        shadow: DecisionResult | None,
+        status: ShadowObservationStatus,
+        error: str | None,
+        decision_id: str,
+    ) -> None:
+        self._observations.append(
+            DecisionObservation(
+                decision_id=decision_id,
+                request_candidate_ids=request_candidate_ids,
+                request_context=request_context,
+                existing_result=existing,
+                shadow_result=shadow,
+                status=status,
+                error=error,
+            )
+        )
+
+    async def drain(self) -> tuple[DecisionObservation, ...]:
+        """Wait for all observations started by this service and return them."""
+        if self._tasks:
+            # A provider or journal bug is an observation failure; it must not
+            # cancel or leak sibling observations when the caller drains them.
+            await asyncio.gather(*tuple(self._tasks), return_exceptions=True)
+        return self.observations
+
+    async def close(self) -> tuple[DecisionObservation, ...]:
+        """Drain outstanding observations; no provider owns a service task after this."""
+        return await self.drain()
diff --git a/src/agent_orchestrator/decision/types.py b/src/agent_orchestrator/decision/types.py
new file mode 100644
index 0000000..ca8dd4d
--- /dev/null
+++ b/src/agent_orchestrator/decision/types.py
@@ -0,0 +1,180 @@
+"""Core value types for the NanoJev decision subsystem.
+
+These types describe a provider-agnostic decision contract. A caller builds a
+``DecisionRequest`` out of the candidates it is willing to accept, a provider
+returns a ``DecisionResult`` containing calibrated scores, and the policy in
+``policy.py`` decides whether that result is actually used.
+
+The records are immutable at the dataclass level (``frozen``, ``slots``) and
+validate their own invariants at construction time. Nested mappings are kept
+as read-only-by-contract ``Mapping`` values so the decision payload stays
+small and provider-agnostic.
+"""
+
+from __future__ import annotations
+
+import math
+from collections.abc import Mapping
+from dataclasses import dataclass
+from enum import StrEnum
+from typing import Any
+
+
+class DecisionType(StrEnum):
+    """The kinds of decisions the NanoJev layer is allowed to make."""
+
+    READY_TASK_PRIORITY = "ready_task_priority"
+    RETRY_OR_ESCALATE = "retry_or_escalate"
+
+
+def _require_non_empty(value: Any, field: str) -> str:
+    if not isinstance(value, str):
+        raise TypeError(f"{field} must be a str, got {type(value).__name__}")
+    if not value.strip():
+        raise ValueError(f"{field} must be a non-empty string")
+    return value
+
+
+@dataclass(frozen=True, slots=True)
+class DecisionCandidate:
+    """A single option the decision layer may select."""
+
+    id: str
+    label: str
+    metadata: Mapping[str, Any]
+
+    def __post_init__(self) -> None:
+        _require_non_empty(self.id, "candidate.id")
+        if not isinstance(self.label, str):
+            raise TypeError("candidate.label must be a str")
+        if not isinstance(self.metadata, Mapping):
+            raise TypeError("candidate.metadata must be a Mapping")
+
+
+@dataclass(frozen=True, slots=True)
+class DecisionRequest:
+    """An immutable request handed to a ``DecisionProvider``."""
+
+    decision_id: str
+    decision_type: DecisionType
+    mission_id: str
+    task_id: str | None
+    candidates: tuple[DecisionCandidate, ...]
+    context: Mapping[str, Any]
+
+    def __post_init__(self) -> None:
+        _require_non_empty(self.decision_id, "decision_id")
+        _require_non_empty(self.mission_id, "mission_id")
+        if self.task_id is not None:
+            _require_non_empty(self.task_id, "task_id")
+        if not isinstance(self.decision_type, DecisionType):
+            raise TypeError(
+                "decision_type must be a DecisionType, got "
+                f"{type(self.decision_type).__name__}"
+            )
+        if not isinstance(self.candidates, tuple):
+            raise TypeError("candidates must be a tuple of DecisionCandidate")
+        if not self.candidates:
+            raise ValueError("candidates must not be empty")
+        seen: set[str] = set()
+        for candidate in self.candidates:
+            if not isinstance(candidate, DecisionCandidate):
+                raise TypeError("candidates must contain DecisionCandidate values")
+            if candidate.id in seen:
+                raise ValueError(f"duplicate candidate id: {candidate.id!r}")
+            seen.add(candidate.id)
+        if not isinstance(self.context, Mapping):
+            raise TypeError("context must be a Mapping")
+
+
+@dataclass(frozen=True, slots=True)
+class DecisionScore:
+    """A probability assigned to one candidate by a provider."""
+
+    candidate_id: str
+    probability: float
+
+    def __post_init__(self) -> None:
+        _require_non_empty(self.candidate_id, "score.candidate_id")
+        probability = self.probability
+        if isinstance(probability, bool) or not isinstance(probability, float):
+            raise TypeError("score.probability must be a float")
+        if not math.isfinite(probability):
+            raise ValueError("score.probability must be finite")
+        if not 0.0 <= probability <= 1.0:
+            raise ValueError(
+                f"score.probability must be within [0, 1], got {probability!r}"
+            )
+
+
+@dataclass(frozen=True, slots=True)
+class DecisionResult:
+    """The outcome of a decision, with calibrated scores and diagnostics."""
+
+    decision_id: str
+    provider: str
+    selected: str
+    scores: tuple[DecisionScore, ...]
+    top1_probability: float
+    margin: float
+    latency_ms: float
+    model_version: str | None = None
+
+    def __post_init__(self) -> None:
+        _require_non_empty(self.decision_id, "decision_id")
+        _require_non_empty(self.provider, "provider")
+        _require_non_empty(self.selected, "selected")
+        if self.model_version is not None:
+            _require_non_empty(self.model_version, "model_version")
+        if not isinstance(self.scores, tuple):
+            raise TypeError("scores must be a tuple of DecisionScore")
+        if not self.scores:
+            raise ValueError("scores must not be empty")
+
+        seen: set[str] = set()
+        for score in self.scores:
+            if not isinstance(score, DecisionScore):
+                raise TypeError("scores must contain DecisionScore values")
+            if score.candidate_id in seen:
+                raise ValueError(f"duplicate score candidate_id: {score.candidate_id!r}")
+            seen.add(score.candidate_id)
+
+        if self.selected not in seen:
+            raise ValueError("selected must reference a candidate present in scores")
+
+        for value, field in (
+            (self.top1_probability, "top1_probability"),
+            (self.margin, "margin"),
+            (self.latency_ms, "latency_ms"),
+        ):
+            if isinstance(value, bool) or not isinstance(value, float):
+                raise TypeError(f"{field} must be a float")
+            if not math.isfinite(value):
+                raise ValueError(f"{field} must be finite")
+
+        if not 0.0 <= self.top1_probability <= 1.0:
+            raise ValueError(
+                f"top1_probability must be within [0, 1], got {self.top1_probability!r}"
+            )
+
+        ordered = sorted(
+            (score.probability for score in self.scores), reverse=True
+        )
+        expected_top1 = ordered[0]
+        if not math.isclose(
+            self.top1_probability, expected_top1, rel_tol=1e-9, abs_tol=1e-9
+        ):
+            raise ValueError(
+                "top1_probability must equal the highest score "
+                f"({expected_top1!r}), got {self.top1_probability!r}"
+            )
+
+        expected_margin = 1.0 if len(ordered) == 1 else ordered[0] - ordered[1]
+        if not math.isclose(self.margin, expected_margin, rel_tol=1e-9, abs_tol=1e-9):
+            raise ValueError(
+                f"margin must equal the gap between the two highest scores "
+                f"({expected_margin!r}), got {self.margin!r}"
+            )
+
+        if self.latency_ms < 0.0:
+            raise ValueError("latency_ms must be non-negative")
