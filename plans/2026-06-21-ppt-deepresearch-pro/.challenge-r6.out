def _autofill_with_connectivity_gate(slides) -> tuple[bool, int]:
    """å…ˆç”Ÿç¬?1 å¼ å›¾ï¼›è‹¥è¿žæŽ¥ç±»å¤±è´?â†?è¿”å›ž (False, 0) è¡¨ç¤ºåˆ¤å®šä¸å¯è¾¾ä¸å†ç”Ÿå›¾ã€?    æˆåŠŸ â†?ç”Ÿå…¶ä½™å›¾ï¼Œè¿”å›?(True, n_ok)ã€‚è¿”å›?reachable æ ‡å¿— + æˆåŠŸé¡µæ•°ã€?""
    prompts = [(i, s) for i, s in enumerate(slides) if s.image_prompt]
    if not prompts: return (True, 0)
    i0, s0 = prompts[0]
    res0 = generate_images([s0.image_prompt], size=_size_for(s0))[0]
    if not res0.get("path"):
        if _should_fallback(res0):          # connectivity æˆ?model_unavailable â†?ä¸å¯è¾?            return (False, 0)
        # content/safety å¤±è´¥ï¼šå ä½é™çº§ï¼Œç»§ç»­åŽç»­ï¼ˆéžã€Œè¿žä¸ä¸Šã€ï¼‰
    else:
        slides[i0].image_path = res0["path"]
    # ç”Ÿå…¶ä½?    rest = generate_images([s.image_prompt for _, s in prompts[1:]], ...)
    n_ok = sum(1 for r in rest if r.get("path")) + (1 if slides[i0].image_path else 0)
    for (idx, s), r in zip(prompts[1:], rest):
        if r.get("path"): slides[idx].image_path = r["path"]
    if n_ok == 0:                    # v0.3 å…œåº•ï¼šå…¨å›¾å¤±è´?å«è¢«è¯¯åˆ¤ content)â†?æ•´å‰¯å›žé€€,é¿å…å…¨å ä½çƒ‚ deck
