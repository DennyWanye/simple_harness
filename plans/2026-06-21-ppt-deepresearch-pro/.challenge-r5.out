- æ–°å¢ž `async def _handle_ppt_pro(**kwargs)`ï¼?```python
_PPT_PRO_RUNNING: dict[str, asyncio.Task] = {}        # æŒ?session åŽ»é‡
_PPT_PRO_RUNNING_TOPIC: dict[str, str] = {}           # è®°å½“å‰?sid åœ¨åšçš„ä¸»é¢˜ï¼ˆåŒºåˆ† AgentLoop é‡å¤ vs ç”¨æˆ·æ¢ä¸»é¢˜ï¼‰

async def _handle_ppt_pro(**kwargs):
    sid = kwargs.get("_session_id", "default")          # registry æ³¨å…¥è¿?argsï¼ˆåŒ ppt_create @3769ï¼?    outline_propose = _PPT_PRO_CTX.get("outline_propose")  # WI-3 FP-5 é£Žæ ¼å¤§çº²å?propose
    notifier = _PPT_PRO_CTX.get("notifier")
    run_blocking = _PPT_PRO_CTX.get("run_blocking")
    if outline_propose is None or notifier is None:     # æŽ¥çº¿ç¼ºå¤± â†?ä¸é™é»˜æ­»ï¼Œæ˜Žç¡®æŠ¥é”?        return {"ok": False, "error": "ppt_pro æŽ¥çº¿ç¼ºå¤±ï¼ˆoutline_propose/notifier æœªæ³¨å…¥ï¼‰", "fallback": "è¯·ç”¨ ppt_create"}
    # â‘?å?session åŽ»é‡ / æ›¿æ¢ï¼ˆcodex R2 MAJOR + R4 MAJOR-3ï¼‰ï¼š
    cur = _PPT_PRO_RUNNING.get(sid)
    topic = (kwargs.get("topic") or "").strip()
    if cur is not None and not cur.done():
        if topic and topic == _PPT_PRO_RUNNING_TOPIC.get(sid):
            # åŒä¸»é¢˜å†è°?= AgentLoop ç§’å›žåŽé‡å¤è°ƒç”?â†?æŒ¡ä½ï¼Œä¸èµ·ç¬¬äºŒä¸ª
            return {"ok": True, "status": "already_running",
                    "message": "è¿™ä»½ PPT å·²ç»åœ¨åšå•¦ï¼ˆè°ƒç ”/ç­‰ç¡®è®?ç”Ÿæˆä¸­ï¼‰ï¼Œç­‰æˆ‘å¼„å®Œ~ï¼ˆæƒ³æ?å–æ¶ˆå¯ä»¥è¯´ã€Œåœã€ï¼‰"}
        # ä¸åŒä¸»é¢˜ = ç”¨æˆ·æ”¹ä¸»æ„é‡å?â†?å–æ¶ˆæ—§ä»»åŠ¡ï¼Œæ¢æˆæ–°çš„ï¼ˆR4 MAJOR-3ï¼šä¸èƒ½æŒ¡ 30minï¼?        _ppt_pro_cancel(sid)                       # cancel æ—?taskï¼ˆCancelledError ç©¿é€?outline awaitï¼?        await notifier(sid, "å¥½~ æ¢ä¸ªä¸»é¢˜ï¼Œæˆ‘é‡æ–°æ¥è¿‡ã€?)
    async def _runner():
        try:
            await _ppt_pro_orchestrate(        # â‘?ä¸ç”¨å•ä¸€æ€?wait_forï¼ˆè§ä¸‹ã€Œåˆ†é˜¶æ®µé™æ—¶ã€ï¼‰
                topic=kwargs["topic"], pages=kwargs.get("pages", 8),
                depth=kwargs.get("depth") or _ppt_pro_cfg().default_depth,
                theme=kwargs.get("theme", "minimal"), image_mode=kwargs.get("image_mode", True),
                title=kwargs.get("title", ""), author=kwargs.get("author", "DeskPet"),
                output_path=kwargs.get("output_path"),
                outline_propose=outline_propose, notifier=notifier, run_blocking=run_blocking, session_id=sid)
        except asyncio.CancelledError:
            await notifier(sid, "ðŸ›‘ å·²åœæ­¢å½“å‰?PPT ä»»åŠ¡ã€?); raise
        except Exception as e:
            log.exception("ppt_pro runner failed"); await notifier(sid, f"ðŸ˜¿ PPT æ²¡åšæˆï¼š{e}")
        finally:
            _PPT_PRO_RUNNING.pop(sid, None); _PPT_PRO_RUNNING_TOPIC.pop(sid, None)
    t = asyncio.create_task(_runner())
    _PPT_PRO_RUNNING[sid] = t; _PPT_PRO_RUNNING_TOPIC[sid] = topic
    _PPT_PRO_TASKS.add(t); t.add_done_callback(_PPT_PRO_TASKS.discard)
    return {"ok": True, "status": "researching",
            "message": "æ”¶åˆ°~ æˆ‘å…ˆå›´ç»•è¿™ä¸ªä¸»é¢˜åšè°ƒç ”ï¼Œæ‹Ÿå¥½å¤§çº²ä¼šå¼¹ç»™ä½ ç¡®è®¤ï¼Œç¡®è®¤åŽå¼€å§‹ç”Ÿæˆ?PPTã€?}
```
