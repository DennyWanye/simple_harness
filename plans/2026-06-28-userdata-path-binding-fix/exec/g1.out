  68:             deskpet.exe                  (Tauri main exe)
  69:             backend/
  70:                 deskpet-backend.exe      鈫?sys.executable when frozen
  71:                 _internal/
  72:             userdata/
  73:                 config.toml
  74:                 data/state.db
  75:                 models/
  76:                 logs/
  77:                 skills/
  78: 
  79:     The backend exe's ``Path.parent`` is `<install>/backend/`; that
  80:     layout binds only to `<install>/userdata/`. Standalone frozen
  81:     builds bind only to `<exe_dir>/userdata/`. Once the portable
  82:     sentinel exists, it pins the install-local directory.
  83: 
  84:     The MSI installer's component manifest does NOT list any files
  85:     under ``userdata/``, so MSI uninstall leaves the entire userdata
  86:     tree (state.db, config.toml, models/, skills/) untouched. That's
  87:     how "uninstall doesn't lose my chat history" works.
  88:     """
  89:     global _PORTABLE_CACHE
  90:     if _PORTABLE_CACHE is not _UNSET:
  91:         return _PORTABLE_CACHE if isinstance(_PORTABLE_CACHE, Path) else None
  92: 
  93:     base = _install_dir()
  94:     if base is None:
  95:         _PORTABLE_CACHE = None
  96:         return None
  97:     # Deterministic binding: backend exe -> install root, standalone exe
  98:     # -> exe dir. Never walk up to drive-root neighbor userdata folders.
  99:     root = base.parent if base.name.lower() == "backend" else base
 100:     candidate = root / "userdata"
 101:     sentinel = candidate / ".deskpet-portable"
 102:     if sentinel.exists():
 103:         _PORTABLE_CACHE = candidate
 104:         return candidate
 105: 
 106:     try:
 107:         candidate.mkdir(parents=True, exist_ok=True)
 108:         probe = candidate / ".deskpet-write-probe"
 109:         probe.write_bytes(b"")
 110:         probe.unlink()
 111:     except OSError as e:
 112:         logger.error(
 113:             "portable_userdata_unwritable dir=%s err=%s 鈥?falling back to AppData",
 114:             candidate,
 115:             e,
 116:         )
 117:         _PORTABLE_CACHE = None
 118:         return None
 119: 
 120:     try:
 121:         sentinel.touch(exist_ok=True)
 122:     except OSError:
 123:         pass
 124:     _PORTABLE_CACHE = candidate
 125:     return candidate
 126: 
 127: 
 128: def reset_path_cache() -> None:
 129:     """Tests call this to clear memoized portable resolution."""
 130:     global _PORTABLE_CACHE
 131:     _PORTABLE_CACHE = _UNSET
 132: 
