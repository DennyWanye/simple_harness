    # åŽ†å² stubs.py "register replaces on duplicate" è¡Œä¸ºçŽ°æ”¹ä¸ºï¼š
    #   - stubs.py ç”?"if not registry.has(name): register"ï¼ˆå®ˆå«æ¨¡å¼ï¼‰
    #   - çœŸå®žçŽ°æ³¨å†Œï¼ˆé»˜è®¤ replace_allowed=Falseï¼‰â†’ ä¸ä¼šè¢?stub è¦†ç›–
    #   - mcp_call / æµ‹è¯•çƒ­æ›¿æ¢ç­‰æ˜¾å¼ replace_allowed=True æ—¶åˆæ³•è¦†ç›?
    replace_allowed: bool = False
