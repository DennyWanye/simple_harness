orchestration_root = PosixPath('/private/var/folders/mp/b_1xsc9s50q1c2034tpd4nxm0000gn/T/pytest-of-taiwan/pytest-4951/test_create_runs_to_completed_0/userdata/data/agent-orchestrator')
principal = Principal(principal_id='local-user:test', display='本机用户', kind='human')

    @pytest.mark.asyncio
    async def test_create_runs_to_completed_and_is_idempotent(orchestration_root, principal):
        service = OrchestrationService(
            orchestration_root,
            OrchestrationSettings(),
            provider=notes_provider(),
            principal=principal,
            drive=False,
        )
        await service.start()
        try:
            first = service.create_mission(notes_request("k-1"))
            assert first["created"] is True
