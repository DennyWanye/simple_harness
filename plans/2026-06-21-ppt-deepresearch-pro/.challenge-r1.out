### WI-2 Â· è°ƒç ” â†?å¤§çº²æ‹Ÿåˆ¶ + ä¿®è®¢ï¼ˆF2ï¼?**æ–‡ä»¶** `backend/deskpet/tools/ppt_tools.py`ï¼ˆæ–°å¢žï¼‰
```python
async def _draft_outline_from_research(
    topic: str, report: "ResearchReport | None", *, pages: int, theme: str,
    image_mode: bool, llm_call, feedback: str = "",
) -> list[SlideOutline]:
    """åŸºäºŽè°ƒç ”æŠ¥å‘Šï¼ˆå¯ç©ºï¼‰æ‹?PPT å¤§çº²ã€‚image_mode=True åˆ™æ¯é¡µå¸¦ image_full+image_promptï¼ˆæƒŠè‰³æ¨¡å¼ï¼‰ã€?    feedback éžç©ºæ—?= ç”¨æˆ·ä¿®æ”¹æ„è§ï¼ŒæŒ‰å…¶é‡æ‹Ÿã€?""
    research_md = (report.report_md if report else "")[: _PPT_PRO_RESEARCH_CTX_CHARS]  # æˆªæ–­é˜²çˆ†çª—ï¼Œé»˜è®¤ 6000
    prompt = _build_outline_prompt(topic, research_md, pages=pages, image_mode=image_mode, feedback=feedback)
