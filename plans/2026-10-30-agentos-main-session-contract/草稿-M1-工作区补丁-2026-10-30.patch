@@ -0,0 +1,320 @@
+# SPDX-License-Identifier: Apache-2.0
+"""主会话统筹工作会话：命令幂等回执、父子关系、Goal。全部是会话账本里的持久事实。
+
+这里只管秩序：谁是谁的子会话、哪条命令已经受理过、Goal 现在是第几版、收口前结构事实
+齐不齐。要不要开工作会话、委派什么、结果好不好，都不在这里判。
+"""
+
+from __future__ import annotations
+
+import re
+import time
+from collections.abc import Callable, Mapping
+from typing import Any
+
+from .session_ledger import SessionError, digest
+
+CONFIG_VERSION = 3
+PROTOCOL_VERSION = 2
+MAX_DEPTH = 1
+
+GOAL_STATES = ("active", "waiting", "cancel_requested", "succeeded", "failed", "cancelled")
+TERMINAL_GOAL = frozenset({"succeeded", "failed", "cancelled"})
+GOAL_OUTCOMES = frozenset({"succeeded", "failed", "cancelled"})
+TERMINAL_TASK = frozenset({"COMPLETED", "FAILED", "CANCELLED", "REJECTED"})
+
+_KEY = re.compile(r"[A-Za-z0-9_-]{1,64}")
+
+
+def child_session_id(parent_id: str, child_key: str) -> str:
+    return f"{parent_id}_c_{child_key}"
+
+
+def _bounded_text(value: Any, name: str, *, limit: int = 12000, required: bool = True) -> str:
+    if value is None and not required:
+        return ""
+    if not isinstance(value, str) or (required and not value.strip()) or len(value) > limit:
+        raise SessionError("invalid_argument", f"{name} must be bounded text")
+    return value.strip()
+
+
+def _text_list(value: Any, name: str, *, minimum: int) -> list[str]:
+    if not isinstance(value, list) or len(value) < minimum or len(value) > 32:
+        raise SessionError("invalid_argument", f"{name} must list {minimum} to 32 items")
+    return [_bounded_text(item, name) for item in value]
+
+
+class Commands:
+    """写命令的幂等：同 ID 同参数返原回执；同 ID 异参数冲突；预校验失败不留痕。"""
+
+    def __init__(self, session: Any) -> None:
+        self.session, self.store = session, session._store
+
+    def run(
+        self,
+        command_id: Any,
+        kind: str,
+        body: Any,
+        apply: Callable[[], dict[str, Any]],
+    ) -> dict[str, Any]:
+        if not isinstance(command_id, str) or not command_id.strip() or len(command_id) > 256:
+            raise SessionError("invalid_argument", "command_id must be bounded nonempty text")
+        request_hash = digest([kind, body])
+        with self.store.transaction():
+            existing = self.store.get("commands", command_id)
+            if existing is not None:
+                if existing["request_hash"] != request_hash:
+                    raise SessionError(
+                        "idempotency_conflict", "command_id was used with different arguments"
+                    )
+                return existing["receipt"]
+            result = apply()
+            receipt = {
+                "command_id": command_id,
+                "request_hash": request_hash,
+                "status": result.pop("status", "completed"),
+                "session_id": self.session.session_id,
+                "event_seq": int(self.store.get("meta", "sequence")),
+                **result,
+            }
+            self.store.put(
+                "commands",
+                command_id,
+                {"kind": kind, "request_hash": request_hash, "receipt": receipt},
+            )
+            return receipt
+
+
+class Children:
+    """父子关系存在父账本；子账本只记它的父是谁。深度固定为 1。"""
+
+    def __init__(self, session: Any) -> None:
+        self.session, self.store = session, session._store
+
+    def rows(self) -> list[dict[str, Any]]:
+        return self.store.rows("children")
+
+    def find(self, child_key: str) -> dict[str, Any]:
+        row = self.store.get("children", str(child_key))
+        if row is None:
+            raise SessionError("not_found_or_forbidden", "no such child session")
+        return row
+
+    def register(self, child_key: Any, command_id: str, purpose: Any) -> dict[str, Any]:
+        session = self.session
+        if session.parent is not None:
+            raise SessionError(
+                "invalid_request", f"child sessions cannot create children (max depth {MAX_DEPTH})"
+            )
+        if not isinstance(child_key, str) or not _KEY.fullmatch(child_key):
+            raise SessionError("invalid_argument", "child_key must be a safe identifier")
+        purpose = _bounded_text(purpose, "purpose", limit=2000, required=False)
+        child_id = child_session_id(session.session_id, child_key)
+        if len(child_id) > 128:
+            raise SessionError("invalid_argument", "child session id would exceed 128 characters")
+
+        def apply() -> dict[str, Any]:
+            existing = self.store.get("children", child_key)
+            if existing is not None:
+                return {
+                    "child_session_id": existing["child_session_id"],
+                    "child_key": child_key,
+                    "created": False,
+                }
+            goal = session._goals.current()
+            row = {
+                "child_key": child_key,
+                "child_session_id": child_id,
+                "purpose": purpose,
+                "goal_ref": None if goal is None else session._goals.ref(goal),
+                "command_id": command_id,
+                "created_at": time.time(),
+            }
+            self.store.put("children", child_key, row)
+            self.store.event(
+                "child_created",
+                key=f"child:{child_key}",
+                child_key=child_key,
+                child_session_id=child_id,
+                payload={"purpose": purpose, "goal_ref": row["goal_ref"]},
+            )
+            return {"child_session_id": child_id, "child_key": child_key, "created": True}
+
+        return session._commands.run(
+            command_id, "create_child", {"child_key": child_key, "purpose": purpose}, apply
+        )
+
+
+class Goals:
+    """Goal 是宿主登记的有界目标。每个根会话同时只许一个未收口的 Goal。"""
+
+    def __init__(self, session: Any) -> None:
+        self.session, self.store = session, session._store
+
+    @staticmethod
+    def ref(goal: Mapping[str, Any]) -> dict[str, Any]:
+        return {"goal_id": goal["goal_id"], "goal_version": int(goal["goal_version"])}
+
+    def get(self, goal_id: str) -> dict[str, Any]:
+        row = self.store.get("goals", str(goal_id))
+        if row is None:
+            raise SessionError("not_found_or_forbidden", "no such goal")
+        return row
+
+    def current(self) -> dict[str, Any] | None:
+        for row in self.store.rows("goals"):
+            if row["status"] not in TERMINAL_GOAL:
+                return row
+        return None
+
+    def _normalize(self, spec: Any, command_id: str) -> dict[str, Any]:
+        if not isinstance(spec, Mapping):
+            raise SessionError("invalid_argument", "goal spec must be an object")
+        allowed = {
+            "goal_id",
+            "objective",
+            "completion_criteria",
+            "stop_conditions",
+            "budget",
+            "grant_ref",
+            "policy_revision",
+        }
+        if set(spec) - allowed:
+            raise SessionError("invalid_argument", "unknown goal spec fields")
+        budget = spec.get("budget") or {}
+        if not isinstance(budget, Mapping) or any(
+            isinstance(v, bool) or not isinstance(v, int) or v < 1 for v in budget.values()
+        ):
+            raise SessionError("invalid_argument", "budget values must be positive integers")
+        goal_id = spec.get("goal_id")
+        if goal_id is None:
+            goal_id = f"goal-{digest([self.session.session_id, command_id])[:32]}"
+        return {
+            "goal_id": _bounded_text(goal_id, "goal_id", limit=128),
+            "objective": _bounded_text(spec.get("objective"), "objective"),
+            "completion_criteria": _text_list(
+                spec.get("completion_criteria"), "completion_criteria", minimum=1
+            ),
+            "stop_conditions": _text_list(spec.get("stop_conditions", []), "stop_conditions", minimum=0),
+            "budget": dict(budget),
+            "grant_ref": _bounded_text(spec.get("grant_ref"), "grant_ref", limit=512, required=False),
+            "policy_revision": _bounded_text(
+                spec.get("policy_revision"), "policy_revision", limit=512, required=False
+            ),
+        }
+
+    def put(self, spec: Any, *, command_id: str, expected_version: Any) -> dict[str, Any]:
+        if type(expected_version) is not int or expected_version < 0:
+            raise SessionError("invalid_argument", "expected_version must be a nonnegative integer")
+        if self.session.parent is not None:
+            raise SessionError("invalid_request", "goals belong to the root session")
+        normalized = self._normalize(spec, command_id)
+
+        def apply() -> dict[str, Any]:
+            goal_id = normalized["goal_id"]
+            existing = self.store.get("goals", goal_id)
+            if existing is None:
+                if expected_version != 0:
+                    raise SessionError("stale_version", "goal does not exist", retryable=False)
+                active = self.current()
+                if active is not None:
+                    raise SessionError(
+                        "active_work", f"goal {active['goal_id']} is still open; finish it first"
+                    )
+                row = {**normalized, "goal_version": 1, "status": "active", "history": []}
+            else:
+                if existing["status"] in TERMINAL_GOAL:
+                    raise SessionError("stale_version", "finished goals are immutable")
+                if int(existing["goal_version"]) != expected_version:
+                    raise SessionError("stale_version", "goal version has moved on")
+                row = {
+                    **existing,
+                    **normalized,
+                    "goal_version": expected_version + 1,
+                    "history": [*existing.get("history", []), expected_version],
+                }
+            row["updated_at"] = time.time()
+            self.store.put("goals", goal_id, row)
+            self.store.event(
+                "goal_updated",
+                key=f"goal:{goal_id}:{row['goal_version']}",
+                goal_id=goal_id,
+                goal_version=row["goal_version"],
+                payload={"objective": row["objective"], "status": row["status"]},
+            )
+            return {**self.ref(row), "status": row["status"], "version": row["goal_version"]}
+
+        return self.session._commands.run(
+            command_id,
+            "put_goal",
+            {"spec": normalized, "expected_version": expected_version},
+            apply,
+        )
+
+    def blockers(self, goal_id: str) -> list[str]:
+        """收口前还差的结构事实。只看事实，不判结果好坏。"""
+
+        session = self.session
+        problems = []
+        for task in session.tasks():
+            ref = task.get("goal_ref") or {}
+            if ref.get("goal_id") == goal_id and task["status"] not in TERMINAL_TASK:
+                problems.append(f"task {task['delegation_id']} is {task['status']}")
+        for notice in session.inbox():
+            if notice.get("applied_turn_id") is None and not notice.get("excluded"):
+                problems.append(f"result {notice['event_id']} has not been applied to a turn")
+        return problems
+
+    def finish(
+        self,
+        goal_id: Any,
+        outcome: Any,
+        *,
+        command_id: str,
+        expected_version: Any,
+        basis: Any = "",
+    ) -> dict[str, Any]:
+        if outcome not in GOAL_OUTCOMES:
+            raise SessionError("invalid_argument", "outcome must be succeeded, failed or cancelled")
+        if type(expected_version) is not int or expected_version < 1:
+            raise SessionError("invalid_argument", "expected_version must be a positive integer")
+        basis = _bounded_text(basis, "basis", required=False)
+        if outcome == "succeeded" and not basis:
+            raise SessionError("invalid_argument", "succeeded needs a recorded basis")
+        goal_id = _bounded_text(goal_id, "goal_id", limit=128)
+
+        def apply() -> dict[str, Any]:
+            row = self.get(goal_id)
+            if row["status"] in TERMINAL_GOAL or int(row["goal_version"]) != expected_version:
+                raise SessionError("stale_version", "goal version has moved on")
+            blockers = self.blockers(goal_id)
+            if blockers:
+                raise SessionError("active_work", "; ".join(blockers)[:2000])
+            row = {**row, "status": outcome, "basis": basis, "finished_at": time.time()}
+            self.store.put("goals", goal_id, row)
+            self.store.event(
+                "goal_finished",
+                key=f"goal-finished:{goal_id}:{expected_version}",
+                goal_id=goal_id,
+                goal_version=expected_version,
+                payload={"status": outcome, "basis": basis},
+            )
+            return {**self.ref(row), "status": outcome, "version": row["goal_version"]}
+
+        return self.session._commands.run(
+            command_id,
+            "finish_goal",
+            {"goal_id": goal_id, "outcome": outcome, "expected_version": expected_version,
+             "basis": basis},
+            apply,
+        )
+
+
+__all__ = (
+    "CONFIG_VERSION",
+    "PROTOCOL_VERSION",
+    "Children",
+    "Commands",
+    "Goals",
+    "child_session_id",
+)
