  "trace_and_retention_oracle": {
    "required_lineage": [
      "evidence -> plan",
      "plan -> relation operation",
      "operation -> relation memory exact revision",
      "relation memory exact revision -> knowledge row",
      "knowledge row -> graph edge"
    ],
    "required_manifest_roots": [
      "evidence_root",
      "mutation_plan_root",
      "memory_state_root",
      "cognitive_relation_root",
      "graph_projection_root"
    ],
    "raw_evidence_oracle": "byte-identical before/after every reject, fault, replay, lifecycle transition, and reopen",
    "physical_delete_count": 0
  },
  "execution_contract": {
    "runner": "runners/run_semantic_relation_integrity_evidence.py",
    "candidate_lane": "source integration faults plus exact dual-wheel public state transitions",
    "artifact_policy": "ignored .local-test-evidence only",
    "adapter_argv": [
      "--fixture",
      "<integrity-fixture>",
      "--case-id",
      "<frozen-case-id>",
      "--phase",
      "setup|exercise",
      "--db-dir",
      "<fresh-request-only-dir-without-case-db>",
      "--execution-nonce",
      "<verifier-generated-hex64>",
      "--invocation-hash",
      "<verifier-computed-hex64>"
    ],
    "adapter_allowed_import_roots": [
      "simple_harness",
      "simple_harness_memory"
    ],
    "adapter_required_source_tokens": [
      "import simple_harness",
      "import simple_harness_memory",
      "MemoryMutationPlan",
      "SanitizedEvidenceEnvelope",
      "SuppressionRequest"
    ],
    "adapter_forbidden_source_tokens": [
      "from simple_harness.",
      "from simple_harness_memory.",
      "MemoryManager",
      "build_human_memory",
      "apply_memory_mutation_plan",
      "get_twin_graph_view",
