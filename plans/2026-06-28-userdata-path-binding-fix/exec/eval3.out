def _cache_breakpoint_order(
    messages: list[dict], *, has_tools: bool
) -> list[str]:
    """杩斿洖杩欐壒 messages 鐨?4-breakpoint 閫昏緫鏂偣搴忥紙绾嚱鏁帮紝缁欏崟娴嬶級銆?
    design.md D4 瑙勫畾鐨勭ǔ瀹氣啋鏄撳彉瑁呴厤椤哄簭锛?
        [0]    system (persona + 闈欐€佹寚浠?        鈫?breakpoint 1
        [1]    tools schema                       鈫?breakpoint 2
        [2]    memory / repo-map block            鈫?breakpoint 3
        [3..]  瀵硅瘽鍘嗗彶 + tool_results            鈫?鏄撳彉
        [last] 鏈€杩?user turn 涔嬪墠                鈫?breakpoint 4

    瀹為檯瑁呴厤鍦ㄤ笂娓革紙ContextAssembler / chat handler锛夛紱provider 鍙湪
    杈圭晫缁欏嚭濂戠害搴忥紝璁╁崟娴嬭兘鏂█"涓婃父娌℃妸鏄撳彉鍧楁彃杩涘墠缂€"銆?
    - `tools` 涓嶆槸涓€鏉?message锛堟槸 payload 椤跺眰瀛楁锛夛紝鐢?`has_tools`
      鍐冲畾鏄惁鍗犳柇鐐逛綅銆?    - `memory` 鍙湁鐪熸湁 memory/repo-map block锛坰ystem 娑堟伅閲屽惈
      ``<memory_block>`` 鎴栫 2 鏉?system锛夋墠鍗犱綅锛屽惁鍒欎笉纭锛?      閬垮厤娴垂 breakpoint銆?    """
    order: list[str] = []
    has_system = any(m.get("role") == "system" for m in (messages or []))
    if has_system:
        order.append("system")
    if has_tools:
        order.append("tools")
    # memory/repo-map 绾﹀畾锛氳涔堟樉寮?<memory_block> 鏍囪锛岃涔堟槸
    # 绗簩鏉?system 娑堟伅锛圕ontextAssembler 浜у嚭鐙珛 system block锛夈€?    sys_msgs = [m for m in (messages or []) if m.get("role") == "system"]
    has_memory = len(sys_msgs) >= 2 or any(
        isinstance(m.get("content"), str)
        and "<memory_block>" in m.get("content", "")
        for m in sys_msgs
    )
    if has_memory:
        order.append("memory")
    order.append("history")
    order.append("last-user-pre")
    return order


def _stabilize_prefix(messages: list[dict]) -> list[dict]:
    """杩斿洖 messages 鐨勫壇鏈紝鎶瑰钩浼氱牬鍧?prefix-cache 瀛楄妭鍝堝笇鐨勬姈鍔ㄣ€?
    绾緥锛堟妱 DeepSeek-TUI锛宒esign.md D4锛夛細**缁濅笉鏀瑰啓鍘嗗彶鍓嶇紑**銆?    涓婃父鍚屼竴閫昏緫杞湪涓嶅悓璇锋眰閲屽彲鑳斤細
      - tool-call-only assistant锛氭煇娆″甫 ``content: None``銆佹煇娆″畬鍏?        娌℃湁 ``content`` 瀛楁銆佹煇娆?``content: ""`` 鈥斺€?涓夌搴忓垪鍖栧瓧鑺?        涓嶅悓锛宲refix cache 鍏?miss銆傜粺涓€鎴愮ǔ瀹?``""``銆?      - ``reasoning_content``锛氭煇杞甫绌轰覆銆佹煇杞病杩欎釜 key 鈥斺€?"鏈?key
        浣嗙┖" 鍜?"鏃?key" 搴忓垪鍖栧瓧鑺備篃涓嶅悓銆傜┖/None 涓€寰嬪垹闄よ key銆?
    鍙姩 assistant 琛岀殑杩欎袱涓瓧娈碉紱system/user/tool 鍘熸牱閫忎紶銆備笉鍒?    娑堟伅銆佷笉鏀逛笅鏍囷紙tool_call/tool_result 閰嶅闈犱笅鏍囷紝鍔ㄤ笉寰楋級銆?    杈撳叆涓嶈鍘熷湴淇敼锛堣繑鍥炴繁鎷峰壇鏈噷闇€瑕佹敼鐨勯偅鍑犺锛夈€?    """
    out: list[dict] = []
    for m in messages or []:
        if m.get("role") != "assistant":
            out.append(m)
            continue
        fixed = dict(m)
        # tool-call-only / content 缂哄け鎴?None 鈫?绋冲畾 "" placeholder
        if fixed.get("content") is None:
            fixed["content"] = ""
        # reasoning_content 绌?None 鈫?鍒?key锛堜笉瑕?"绌?key" vs "鏃?key" 鎶栵級
        rc = fixed.get("reasoning_content")
        if rc is None or rc == "":
            fixed.pop("reasoning_content", None)
        out.append(fixed)
    return out


def _extract_cached_tokens(usage: dict | None) -> int | None:
    """闃插尽寮忓彇鍥炲寘閲岀殑 cached_tokens锛堝懡涓殑 prompt token 鏁帮級銆?
    浣嶇疆浼樺厛绾э細
      1. usage.prompt_tokens_details.cached_tokens  鈫?OpenAI / deepseek 鏍囧噯
      2. usage.cached_tokens                        鈫?閮ㄥ垎涓浆绔欏钩閾?
    浠讳綍缂哄け / 绫诲瀷涓嶅 鈫?杩斿洖 ``None``锛堣皟鐢ㄦ柟璁?``unknown``锛?    缁濅笉璁╄剰鏁版嵁鎶?LLM 璋冪敤鎼炲穿 鈥斺€?杩欐槸纭害鏉燂級銆?    """
    if not isinstance(usage, dict):
        return None
    details = usage.get("prompt_tokens_details")
    if isinstance(details, dict):
        v = details.get("cached_tokens")
        if isinstance(v, bool):
            return None
        if isinstance(v, int):
            return v
    v = usage.get("cached_tokens")
    if isinstance(v, bool):
        return None
    if isinstance(v, int):
        return v
    return None


def _log_cache_hit_rate(usage: dict | None, *, where: str) -> None:
    """钀戒竴鏉?prompt-cache 鍛戒腑鐜囨棩蹇楋紙1.3.4锛夈€?
    鍥炲寘甯?cached_tokens 鈫?璁?cached/prompt + 鍛戒腑鐜囩櫨鍒嗘瘮锛?    瀛楁缂哄け锛坱he relay 鐜扮姸甯歌锛夆啋 璁?``cached_tokens=unknown``锛岀粷涓嶅穿銆?    """
    try:
        cached = _extract_cached_tokens(usage)
        prompt = None
        if isinstance(usage, dict):
            pt = usage.get("prompt_tokens")
            if isinstance(pt, int) and not isinstance(pt, bool):
                prompt = pt
        if cached is None:
            logger.info(
                "p4s25_prompt_cache_hit",
                where=where,
                cached_tokens="unknown",
                prompt_tokens=prompt if prompt is not None else "unknown",
                hit_rate="unknown",
            )
            return
        rate = (
            round(cached / prompt, 4) if prompt and prompt > 0 else 0.0
        )
        logger.info(
            "p4s25_prompt_cache_hit",
            where=where,
            cached_tokens=cached,
            prompt_tokens=prompt if prompt is not None else "unknown",
            hit_rate=rate,
        )
    except Exception as exc:  # noqa: BLE001 鈥?鏃ュ織鍩嬬偣缁濅笉鑳藉奖鍝嶄富娴佺▼
        logger.debug("p4s25_prompt_cache_hit_log_failed err=%s", str(exc)[:120])


def _is_anthropic_endpoint(base_url: str) -> bool:
    """Heuristic: should we emit Anthropic-style cache_control marks?

    True only for endpoints that we have evidence handle the field.
    Most OpenAI-compat proxies (the relay, sealos, vllm, ollama) reject
    unknown message keys silently 鈥?observed empirically when the relay
    started returning empty content after we started emitting
    cache_control. Better to no-op than break working flows.
    """
    u = (base_url or "").lower()
    return "anthropic.com" in u or "claude" in u


def _stamp_cache_control(messages: list[dict]) -> list[dict]:
    """Return a copy of `messages` with cache_control on the last system msg.

    P4-S25: Anthropic prompt caching uses ``cache_control: {type:"ephemeral"}``
    on the message whose prefix should be cached. The frozen system stack
    (persona + skill_prelude + memory_block) lives at the front of every
    request; marking the last system message tells Anthropic "everything
    up to here is cacheable". OpenAI ignores the field; gpt-4o auto-caches
    based on prefix. Ollama / the relay strip unknown fields. Safe to always
    emit.
    """
    last_sys_idx = -1
    for i, m in enumerate(messages):
        if m.get("role") == "system":
            last_sys_idx = i
    if last_sys_idx < 0:
        return messages
    out: list[dict] = []
    for i, m in enumerate(messages):
        if i == last_sys_idx and isinstance(m.get("content"), str):
            stamped = dict(m)
            stamped["cache_control"] = {"type": "ephemeral"}
            out.append(stamped)
        else:
            out.append(m)
    return out

