{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.simpleharness.invalid/assurance/1.1/success-formula-v1.schema.json",
  "$ref": "#/$defs/formula",
  "$defs": {
    "formula": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "criterion"
          ],
          "properties": {
            "criterion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "items": {
                "$ref": "#/$defs/formula"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "any"
          ],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "items": {
                "$ref": "#/$defs/formula"
              }
            }
          }
        }
      ]
    }
  }
}
