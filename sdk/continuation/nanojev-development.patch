diff --git a/src/agent_orchestrator/decision/events.py b/src/agent_orchestrator/decision/events.py
new file mode 100644
index 0000000..0898318
--- /dev/null
+++ b/src/agent_orchestrator/decision/events.py
@@ -0,0 +1,563 @@
+# SPDX-FileCopyrightText: 2026 DennyWanye
+# SPDX-License-Identifier: Apache-2.0
+
+"""Additive, replayable decision events (plan §21–§26; workplan phase 4, slice 3).
+
+The plan asks for six event kinds on the existing event-sourcing system.  This
+module adds five of them — ``DecisionRequested``, ``DecisionProduced``,
+``ShadowDecisionProduced``, ``ShadowDecisionFailed`` and
+``DecisionOutcomeObserved`` — and nothing else.  ``DecisionEscalated`` is left
+out deliberately: the plan lists it but the first release has no escalation
+producer, and inventing an emitter would be new scheduling semantics rather than
+an additive event.
+
+Three design choices are load-bearing:
+
+* **The sink is the store's own event table.**  A decision event is one more
+  ``type`` string appended through :meth:`Store.append_event`.  No new table, no
+  migration, no change to ``EventKind`` (which stays closed — the orchestrator's
+  events are free-form ``type`` strings, and these are more of them), and no
+  change to any event H1 already writes.
+* **Replay is the store's idempotency, not a second mechanism.**  The
+  ``idempotency_key`` is derived from the event type plus the decision identity,
+  so re-appending the same fact returns the stored row instead of a second one.
+* **A conflicting identity fails closed.**  Same key, different payload is raised
+  as :class:`DecisionEventConflict` — never a silent overwrite, never a second
+  row.  The store returns the existing row without comparing, so the comparison
+  happens here, before the append.
+
+``decision_id`` is separate from H1's planning-decision id on purpose (plan §26).
+:meth:`DecisionEventJournal.is_accepting_decision_id` refuses the ``pd-`` ids
+that :func:`~agent_orchestrator.contracts.planning_decisions.compute_decision_id`
+mints, so a caller cannot accidentally file a planning decision under the
+NanoJev namespace or the reverse.
+
+Nothing here selects a task, touches the allocator, or calls a model.  The
+journal is an injected sink: a service with no journal behaves exactly as before.
+"""
+
+from __future__ import annotations
+
+import json
+import sqlite3
+from collections.abc import Mapping
+from dataclasses import dataclass
+from enum import StrEnum
+from typing import Any
+
+from ..contracts import ids
+from ..contracts.models import Event
+from ..storage.store import Store
+from .types import DecisionResult, DecisionType
+
+#: H1's planning-decision ids all start with this.  The NanoJev namespace must
+#: not collide with it (plan §26 / workplan phase 4 hard constraint).
+_PLANNING_DECISION_PREFIX = "pd-"
+
+
+class DecisionEventType(StrEnum):
+    """The wire names of the additive decision events (plan §21).
+
+    These are the literal ``Event.type`` strings.  They are fixed so a log
+    written today stays readable by a reader written later.
+    """
+
+    REQUESTED = "DecisionRequested"
+    PRODUCED = "DecisionProduced"
+    SHADOW_PRODUCED = "ShadowDecisionProduced"
+    SHADOW_FAILED = "ShadowDecisionFailed"
+    OUTCOME_OBSERVED = "DecisionOutcomeObserved"
+
+
+class DecisionProducer(StrEnum):
+    """Which path produced a ``DecisionProduced`` event."""
+
+    PRODUCTION = "production"
+    SHADOW = "shadow"
+
+
+class DecisionStatus(StrEnum):
+    """The outcome of one decision attempt."""
+
+    COMPLETED = "completed"
+    FAILED = "failed"
+    TIMED_OUT = "timed_out"
+
+
+class DecisionEventConflict(RuntimeError):
+    """The same event identity was appended twice with different content.
+
+    Raised instead of overwriting.  A replay of the *same* fact returns the
+    stored row; a replay of a *different* fact under the same identity is a bug
+    in the caller, and silently keeping the first would hide it (plan §35's
+    identity rule, applied to the decision log).
+    """
+
+
+class DecisionEventError(ValueError):
+    """A decision event carried a value the log must not accept."""
+
+
+def _row_to_event(row: sqlite3.Row) -> Event:
+    """Rehydrate one ``events`` row without reaching into the store's privates."""
+    return Event(
+        id=row["event_id"],
+        type=row["type"],
+        trace_id=row["trace_id"],
+        mission_id=row["mission_id"],
+        task_id=row["task_id"],
+        attempt_id=row["attempt_id"],
+        actor_type=row["actor_type"],
+        actor_id=row["actor_id"],
+        payload=json.loads(row["payload_json"]),
+        idempotency_key=row["idempotency_key"],
+        created_at=row["created_at"],
+        schema_version=row["schema_version"],
+        seq=row["seq"],
+    )
+
+
+def _require_text(value: Any, field: str) -> str:
+    if not isinstance(value, str):
+        raise TypeError(f"{field} must be a str, got {type(value).__name__}")
+    if not value.strip():
+        raise DecisionEventError(f"{field} must be a non-empty string")
+    return value
+
+
+@dataclass(frozen=True, slots=True)
+class DecisionRequested:
+    """Plan §22: a decision was requested.  Never carries the prompt."""
+
+    decision_id: str
+    decision_type: DecisionType
+    mission_id: str
+    task_id: str | None
+    candidates: tuple[str, ...]
+    context_hash: str
+    context_version: int
+
+    def __post_init__(self) -> None:
+        _require_text(self.decision_id, "decision_id")
+        if not isinstance(self.decision_type, DecisionType):
+            raise TypeError("decision_type must be a DecisionType")
+        _require_text(self.mission_id, "mission_id")
+        if self.task_id is not None:
+            _require_text(self.task_id, "task_id")
+        if not isinstance(self.candidates, tuple) or not self.candidates:
+            raise DecisionEventError("candidates must be a non-empty tuple of ids")
+        for candidate in self.candidates:
+            _require_text(candidate, "candidate id")
+        _require_text(self.context_hash, "context_hash")
+        if isinstance(self.context_version, bool) or not isinstance(self.context_version, int):
+            raise TypeError("context_version must be an int")
+        if self.context_version < 0:
+            raise DecisionEventError("context_version must be non-negative")
+
+    @property
+    def event_type(self) -> DecisionEventType:
+        return DecisionEventType.REQUESTED
+
+    @property
+    def identity(self) -> str:
+        """One request per ``decision_id`` (plan §26: the id is the thread)."""
+        return self.decision_id
+
+    def payload(self) -> dict[str, Any]:
+        return {
+            "decision_id": self.decision_id,
+            "decision_type": str(self.decision_type),
+            "mission_id": self.mission_id,
+            "task_id": self.task_id,
+            "candidates": list(self.candidates),
+            "context_hash": self.context_hash,
+            "context_version": self.context_version,
+        }
+
+
+def _result_payload(result: DecisionResult) -> dict[str, Any]:
+    """The result fields both produced events carry, with stable nulls."""
+    return {
+        "provider": result.provider,
+        "model_version": result.model_version,
+        "selected": result.selected,
+        "scores": {score.candidate_id: score.probability for score in result.scores},
+        "top1_probability": result.top1_probability,
+        "margin": result.margin,
+        "latency_ms": result.latency_ms,
+    }
+
+
+@dataclass(frozen=True, slots=True)
+class DecisionProduced:
+    """Plan §23: the production answer for a decision."""
+
+    decision_id: str
+    decision_type: DecisionType
+    mode: str
+    producer: DecisionProducer
+    result: DecisionResult
+    mission_id: str | None = None
+    task_id: str | None = None
+
+    def __post_init__(self) -> None:
+        _require_text(self.decision_id, "decision_id")
+        if not isinstance(self.decision_type, DecisionType):
+            raise TypeError("decision_type must be a DecisionType")
+        _require_text(self.mode, "mode")
+        if not isinstance(self.producer, DecisionProducer):
+            raise TypeError("producer must be a DecisionProducer")
+        if not isinstance(self.result, DecisionResult):
+            raise TypeError("result must be a DecisionResult")
+        if self.result.decision_id != self.decision_id:
+            raise DecisionEventError("result decision_id does not match the event")
+
+    @property
+    def event_type(self) -> DecisionEventType:
+        return DecisionEventType.PRODUCED
+
+    @property
+    def identity(self) -> str:
+        """One production answer per decision: replay must not add a second."""
+        return self.decision_id
+
+    def payload(self) -> dict[str, Any]:
+        return {
+            "decision_id": self.decision_id,
+            "decision_type": str(self.decision_type),
+            "mode": self.mode,
+            "producer": str(self.producer),
+            "status": str(DecisionStatus.COMPLETED),
+            **_result_payload(self.result),
+        }
+
+
+@dataclass(frozen=True, slots=True)
+class ShadowDecisionProduced:
+    """Plan §24: what the shadow provider chose, and whether it agreed."""
+
+    decision_id: str
+    decision_type: DecisionType
+    mode: str
+    result: DecisionResult
+    production_selected: str
+    mission_id: str | None = None
+    task_id: str | None = None
+
+    def __post_init__(self) -> None:
+        _require_text(self.decision_id, "decision_id")
+        if not isinstance(self.decision_type, DecisionType):
+            raise TypeError("decision_type must be a DecisionType")
+        _require_text(self.mode, "mode")
+        if not isinstance(self.result, DecisionResult):
+            raise TypeError("result must be a DecisionResult")
+        if self.result.decision_id != self.decision_id:
+            raise DecisionEventError("result decision_id does not match the event")
+        _require_text(self.production_selected, "production_selected")
+
+    @property
+    def event_type(self) -> DecisionEventType:
+        return DecisionEventType.SHADOW_PRODUCED
+
+    @property
+    def identity(self) -> str:
+        return self.decision_id
+
+    @property
+    def agreement(self) -> bool:
+        """Whether the shadow and production paths chose the same candidate."""
+        return self.result.selected == self.production_selected
+
+    def payload(self) -> dict[str, Any]:
+        return {
+            "decision_id": self.decision_id,
+            "decision_type": str(self.decision_type),
+            "mode": self.mode,
+            "producer": str(DecisionProducer.SHADOW),
+            "status": str(DecisionStatus.COMPLETED),
+            "production_selected": self.production_selected,
+            "agreement": self.agreement,
+            **_result_payload(self.result),
+        }
+
+
+@dataclass(frozen=True, slots=True)
+class ShadowDecisionFailed:
+    """Plan §19: a shadow failure is recorded, never raised into production."""
+
+    decision_id: str
+    decision_type: DecisionType
+    mode: str
+    error: str
+    status: DecisionStatus
+    latency_ms: float
+    mission_id: str | None = None
+    task_id: str | None = None
+    provider: str | None = None
+    model_version: str | None = None
+
+    def __post_init__(self) -> None:
+        _require_text(self.decision_id, "decision_id")
+        if not isinstance(self.decision_type, DecisionType):
+            raise TypeError("decision_type must be a DecisionType")
+        _require_text(self.mode, "mode")
+        _require_text(self.error, "error")
+        if not isinstance(self.status, DecisionStatus):
+            raise TypeError("status must be a DecisionStatus")
+        if self.provider is not None:
+            _require_text(self.provider, "provider")
+        if self.model_version is not None:
+            _require_text(self.model_version, "model_version")
+        if isinstance(self.latency_ms, bool) or not isinstance(self.latency_ms, (int, float)):
+            raise TypeError("latency_ms must be a number")
+        if self.latency_ms < 0:
+            raise DecisionEventError("latency_ms must be non-negative")
+
+    @property
+    def event_type(self) -> DecisionEventType:
+        return DecisionEventType.SHADOW_FAILED
+
+    @property
+    def identity(self) -> str:
+        return self.decision_id
+
+    def payload(self) -> dict[str, Any]:
+        return {
+            "decision_id": self.decision_id,
+            "decision_type": str(self.decision_type),
+            "mode": self.mode,
+            "producer": str(DecisionProducer.SHADOW),
+            "status": str(self.status),
+            "provider": self.provider,
+            "model_version": self.model_version,
+            "selected": None,
+            "error": self.error,
+            "latency_ms": float(self.latency_ms),
+        }
+
+
+@dataclass(frozen=True, slots=True)
+class DecisionOutcomeObserved:
+    """Plan §25: what actually happened, so agreement can be scored against it."""
+
+    decision_id: str
+    selected_task_id: str
+    task_success: bool
+    verifier_pass: bool
+    retry_count: int
+    execution_latency_ms: float
+    mission_id: str | None = None
+    task_id: str | None = None
+
+    def __post_init__(self) -> None:
+        _require_text(self.decision_id, "decision_id")
+        _require_text(self.selected_task_id, "selected_task_id")
+        for value, field in (
+            (self.task_success, "task_success"),
+            (self.verifier_pass, "verifier_pass"),
+        ):
+            if not isinstance(value, bool):
+                raise TypeError(f"{field} must be a bool")
+        if isinstance(self.retry_count, bool) or not isinstance(self.retry_count, int):
+            raise TypeError("retry_count must be an int")
+        if self.retry_count < 0:
+            raise DecisionEventError("retry_count must be non-negative")
+        if isinstance(self.execution_latency_ms, bool) or not isinstance(
+            self.execution_latency_ms, (int, float)
+        ):
+            raise TypeError("execution_latency_ms must be a number")
+        if self.execution_latency_ms < 0:
+            raise DecisionEventError("execution_latency_ms must be non-negative")
+
+    @property
+    def event_type(self) -> DecisionEventType:
+        return DecisionEventType.OUTCOME_OBSERVED
+
+    @property
+    def identity(self) -> str:
+        """One observed outcome per decision."""
+        return self.decision_id
+
+    def payload(self) -> dict[str, Any]:
+        return {
+            "decision_id": self.decision_id,
+            "selected_task_id": self.selected_task_id,
+            "task_success": self.task_success,
+            "verifier_pass": self.verifier_pass,
+            "retry_count": self.retry_count,
+            "execution_latency_ms": float(self.execution_latency_ms),
+        }
+
+
+#: Every event this module accepts, for callers that dispatch on type.
+DecisionEvent = (
+    DecisionRequested
+    | DecisionProduced
+    | ShadowDecisionProduced
+    | ShadowDecisionFailed
+    | DecisionOutcomeObserved
+)
+
+
+class DecisionEventJournal:
+    """An additive sink that files decision events in the existing event table.
+
+    The journal owns no storage, no connection and no schema: it composes a
+    :class:`~agent_orchestrator.storage.store.Store` and appends through it.  A
+    caller that wants decision events simply passes one in; a caller that does
+    not gets exactly today's behaviour.
+    """
+
+    def __init__(
+        self,
+        store: Store,
+        *,
+        mission_id: str | None = None,
+        task_id: str | None = None,
+    ) -> None:
+        if not isinstance(store, Store):
+            raise TypeError(f"store must be a Store, got {type(store).__name__}")
+        if mission_id is not None:
+            _require_text(mission_id, "mission_id")
+        self._store = store
+        self._mission_id = mission_id
+        self._task_id = task_id
+
+    @property
+    def store(self) -> Store:
+        return self._store
+
+    @staticmethod
+    def is_accepting_decision_id(decision_id: str) -> bool:
+        """Whether ``decision_id`` belongs to the NanoJev namespace (plan §26).
+
+        The ``pd-`` ids minted for H1 planning decisions are refused so the two
+        identities cannot be confusable in the log.
+        """
+        return isinstance(decision_id, str) and not decision_id.startswith(
+            _PLANNING_DECISION_PREFIX
+        )
+
+    @staticmethod
+    def _idempotency_key(event: DecisionEvent) -> str:
+        # Type + identity: replaying the same fact lands on the same key and the
+        # store returns the stored row (plan §26's one-thread-per-decision_id).
+        return f"{event.event_type.value}:{event.identity}"
+
+    def _event_id(self, mission_id: str, task_id: str | None, event: DecisionEvent) -> Event:
+        idempotency_key = self._idempotency_key(event)
+        return Event(
+            id=ids.event_id(idempotency_key),
+            type=event.event_type.value,
+            trace_id=ids.trace_id(mission_id),
+            mission_id=mission_id,
+            task_id=task_id,
+            attempt_id=None,
+            actor_type="system",
+            actor_id="decision-service",
+            payload=event.payload(),
+            idempotency_key=idempotency_key,
+            created_at=self._store.now,
+        )
+
+    def append(self, event: DecisionEvent) -> Event:
+        """Append ``event``, idempotently and fail-closed.
+
+        Returns:
+            The stored event — the existing row on a replay, the new one
+            otherwise.
+
+        Raises:
+            DecisionEventError: if ``event`` is not one of this module's events,
+                or carries a ``pd-`` planning-decision id.
+            DecisionEventConflict: if the same identity already holds a
+                different payload.  Nothing is written.
+        """
+        if not isinstance(
+            event,
+            (
+                DecisionRequested,
+                DecisionProduced,
+                ShadowDecisionProduced,
+                ShadowDecisionFailed,
+                DecisionOutcomeObserved,
+            ),
+        ):
+            raise DecisionEventError(
+                f"not a decision event: {type(event).__name__}"
+            )
+        if not self.is_accepting_decision_id(event.decision_id):
+            raise DecisionEventError(
+                f"decision_id {event.decision_id!r} belongs to the H1 planning-decision "
+                "namespace; NanoJev decision ids must be separate (plan §26)"
+            )
+
+        mission_id, task_id = self._routing(event)
+        candidate = self._event_id(mission_id, task_id, event)
+
+        existing = self._find(candidate.idempotency_key)
+        if existing is not None:
+            if self._payload_text(existing.payload) != self._payload_text(candidate.payload):
+                raise DecisionEventConflict(
+                    f"{candidate.type} for identity {event.identity!r} already exists "
+                    "with different content"
+                )
+            return existing
+        return self._store.append_event(candidate)
+
+    def _routing(self, event: DecisionEvent) -> tuple[str, str | None]:
+        """The event's Mission and Task.
+
+        ``DecisionRequested`` always carries its own Mission.  A follow-up event
+        names only the ``decision_id``, so its Mission is taken from the request
+        that opened the thread, and — when that request is not in this library —
+        from the journal's own mission.  The event is filed either way: the log
+        is a stream of facts, and refusing an outcome because its request landed
+        elsewhere would lose data rather than protect it.
+        """
+        if event.mission_id is not None:
+            return event.mission_id, event.task_id
+        row = self._store.connection.execute(
+            "SELECT mission_id FROM events WHERE type = ?"
+            " AND json_extract(payload_json, '$.decision_id') = ? LIMIT 1",
+            (DecisionEventType.REQUESTED.value, event.decision_id),
+        ).fetchone()
+        mission_id = row["mission_id"] if row is not None else self._mission_id
+        if mission_id is None:
+            raise DecisionEventError(
+                f"cannot route {event.event_type.value} for {event.decision_id!r}: "
+                "no DecisionRequested event and no mission_id on the journal"
+            )
+        return mission_id, event.task_id if event.task_id is not None else self._task_id
+
+    def _find(self, idempotency_key: str) -> Event | None:
+        """The stored event for ``idempotency_key``, or ``None``.
+
+        A read, never a write: the store's own append already de-duplicates on
+        this key, but it returns the existing row *without* checking the
+        payload, so the comparison has to happen here before the append.
+        """
+        row = self._store.connection.execute(
+            "SELECT * FROM events WHERE idempotency_key = ?", (idempotency_key,)
+        ).fetchone()
+        return _row_to_event(row) if row is not None else None
+
+    @staticmethod
+    def _payload_text(payload: Mapping[str, Any]) -> str:
+        return json.dumps(dict(payload), sort_keys=True, ensure_ascii=False)
+
+
+__all__ = (
+    "DecisionEvent",
+    "DecisionEventConflict",
+    "DecisionEventError",
+    "DecisionEventJournal",
+    "DecisionEventType",
+    "DecisionOutcomeObserved",
+    "DecisionProducer",
+    "DecisionProduced",
+    "DecisionRequested",
+    "DecisionStatus",
+    "ShadowDecisionFailed",
+    "ShadowDecisionProduced",
+)
diff --git a/src/agent_orchestrator/decision/gate.py b/src/agent_orchestrator/decision/gate.py
new file mode 100644
index 0000000..2e85220
--- /dev/null
+++ b/src/agent_orchestrator/decision/gate.py
@@ -0,0 +1,108 @@
+"""Fast-path gate and NanoJev eligibility (plan §4, §5, §39, §40, §52).
+
+Two rules live here, and both are deliberately small:
+
+* :func:`is_nanojev_decidable` answers *may the model be asked at all*.  Only
+  operational decisions qualify — the ones that decide how to execute the DAG
+  that already exists.  A structural decision changes the DAG, so it belongs to
+  slow-path / MainWork and must never produce a request (§4, §52).
+* :class:`FastPathGate` answers *is the answer good enough to use*.  The plan
+  fixes the first release's thresholds literally at ``top1 >= 0.80`` and
+  ``margin >= 0.20`` and asks explicitly for no more mathematics than that
+  (§39); a result the gate rejects falls back to the existing path (§40).
+
+Neither the gate nor the eligibility rule touches a model, a checkpoint, or an
+event log.  They are pure functions over a ``DecisionResult`` / ``DecisionType``
+so they can be unit-tested without any NanoJev runtime present.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from .types import DecisionResult, DecisionType
+
+#: Plan §39's thresholds, verbatim.
+DEFAULT_MIN_PROBABILITY = 0.80
+DEFAULT_MIN_MARGIN = 0.20
+
+#: Decision types NanoJev is allowed to answer in the first release (plan §5).
+#: A structural decision is *anything not listed here* — the DAG-changing set is
+#: open-ended in the plan and closed by refusal, not by enumeration.
+_NANOJEV_DECIDABLE = frozenset(
+    {
+        DecisionType.READY_TASK_PRIORITY,
+        DecisionType.RETRY_OR_ESCALATE,
+    }
+)
+
+
+class NanoJevEligibilityError(ValueError):
+    """A decision the NanoJev layer must not be asked about.
+
+    Raised instead of silently routing the request to the existing provider.
+    A caller that expected a model answer needs to know it is not getting one:
+    a quiet downgrade would look identical to "the model agreed".
+    """
+
+
+class DecisionOutcomeUnavailable(RuntimeError):
+    """Neither the model nor the fallback could produce a production result."""
+
+
+def is_nanojev_decidable(decision_type: DecisionType) -> bool:
+    """Whether ``decision_type`` is operational enough for NanoJev (plan §5).
+
+    Args:
+        decision_type: The kind of decision being requested.
+
+    Returns:
+        ``True`` for the two operational types the first release supports,
+        ``False`` for everything else (every structural decision).
+
+    Raises:
+        TypeError: if ``decision_type`` is not a ``DecisionType``.  An unknown
+            string is refused rather than defaulted, so a typo in a caller
+            cannot read as "structural" and quietly skip the model forever.
+    """
+    if not isinstance(decision_type, DecisionType):
+        raise TypeError(
+            "decision_type must be a DecisionType, got "
+            f"{type(decision_type).__name__}"
+        )
+    return decision_type in _NANOJEV_DECIDABLE
+
+
+@dataclass(frozen=True, slots=True)
+class FastPathGate:
+    """Accept a NanoJev result only above the plan's confidence thresholds.
+
+    The gate is intentionally the two comparisons from plan §39 and nothing
+    else — no calibration, no per-type tuning, no learned weights.  Promotion to
+    a real threshold policy is the Promotion Gate's job (plan §59), not this
+    one's.
+    """
+
+    min_probability: float = DEFAULT_MIN_PROBABILITY
+    min_margin: float = DEFAULT_MIN_MARGIN
+
+    def __post_init__(self) -> None:
+        for value, field in (
+            (self.min_probability, "min_probability"),
+            (self.min_margin, "min_margin"),
+        ):
+            if isinstance(value, bool) or not isinstance(value, (int, float)):
+                raise TypeError(f"{field} must be a number, got {type(value).__name__}")
+            if not 0.0 <= float(value) <= 1.0:
+                raise ValueError(f"{field} must be within [0, 1], got {value!r}")
+
+    def accept(self, result: DecisionResult) -> bool:
+        """Whether ``result`` is confident enough to use without slow-path."""
+        if not isinstance(result, DecisionResult):
+            raise TypeError(
+                f"result must be a DecisionResult, got {type(result).__name__}"
+            )
+        return (
+            result.top1_probability >= self.min_probability
+            and result.margin >= self.min_margin
+        )
diff --git a/src/agent_orchestrator/decision/host_integration.py b/src/agent_orchestrator/decision/host_integration.py
new file mode 100644
index 0000000..8716ff4
--- /dev/null
+++ b/src/agent_orchestrator/decision/host_integration.py
@@ -0,0 +1,467 @@
+"""The Host-facing seam for a Shadow-only ``READY_TASK_PRIORITY`` observation.
+
+Plan §57's PR-7 is "shadow 接入": a real production caller drives the decision
+layer, the existing path keeps answering, and NanoJev only watches.  The decision
+package itself is deliberately policy-free — it owns the contract, the providers,
+the non-blocking service and the event journal, and it reads no configuration.
+This module is the missing caller, and it is written to the parent's ruling:
+
+* **The Host owns the mode.**  This module reads no environment variable and no
+  config file.  A caller passes a typed :class:`DecisionPolicy`; ``EXISTING`` is
+  the default and the only way to change it is to pass a different policy.
+* **The allocator's grant set stays authoritative.**  The observation is over the
+  deterministic :func:`~agent_orchestrator.scheduling.allocator.frontier` order,
+  and the plan this module returns is the untouched ``allocate()`` result — the
+  suite asserts the observed and unobserved plans are equal, in every mode.
+* **No retry seam.**  ``RETRY_OR_ESCALATE`` is not wired here: ``RetryAction``
+  has six values, and mapping them onto the two-value contract is a ruling this
+  slice does not have.  Inventing one would be worse than leaving it out.
+* **The ids live in their own namespace.**  ``njr-`` (NanoJev run) is derived the
+  same deterministic way H1 derives ``pd-``, and never reuses ``pd-``; the event
+  journal already refuses that prefix.
+
+Everything here is additive.  A caller that passes no policy, no provider and no
+journal gets exactly the plan ``allocate()`` would have produced.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from collections.abc import Mapping, Sequence
+from typing import Any
+
+from ..contracts import Task
+from ..scheduling.allocator import AllocationPlan, allocate, frontier
+from .events import DecisionEventJournal
+from .gate import FastPathGate
+from .policy import DecisionMode, DecisionPolicy
+from .provider import DecisionProvider
+from .providers.existing import ExistingDecisionProvider
+from .service import DecisionObservation, DecisionService
+from .types import DecisionCandidate, DecisionRequest, DecisionType
+
+#: The one decision type this slice is allowed to observe (see the module docstring).
+READY_TASK_PRIORITY_TYPE = DecisionType.READY_TASK_PRIORITY
+
+#: The id namespace this module mints in.  It is deliberately *not* H1's ``pd-``.
+READY_TASK_DECISION_ID_PREFIX = "njr-"
+
+#: Bumped when the id material or the candidate encoding changes, so an id minted
+#: by an older convention can never collide with a newer one (the ``pd-`` trick).
+READY_TASK_ID_CONVENTION_VERSION = "njr-ready-task-priority-v1"
+
+#: The context schema version callers may pin on the request (plan §22's
+#: ``context_version``).  ``0`` means "unversioned", which is the honest default
+#: for a caller that has not versioned its own context yet.
+READY_TASK_CONTEXT_VERSION = 0
+
+
+def _identifier(value: Any, field: str) -> str:
+    if not isinstance(value, str):
+        raise TypeError(f"{field} must be a str, got {type(value).__name__}")
+    if not value.strip():
+        raise ValueError(f"{field} must be a non-empty string")
+    return value
+
+
+def _plain(value: Any) -> Any:
+    """Reduce a context to a JSON-stable shape so the id is over real content."""
+
+    if isinstance(value, Mapping):
+        ordered = sorted(value.items(), key=lambda kv: str(kv[0]))
+        return {str(key): _plain(item) for key, item in ordered}
+    if isinstance(value, (list, tuple)):
+        return [_plain(item) for item in value]
+    if isinstance(value, (set, frozenset)):
+        return sorted((_plain(item) for item in value), key=repr)
+    if isinstance(value, (str, int, float, bool)) or value is None:
+        return value
+    return repr(value)
+
+
+def compute_ready_task_decision_id(
+    *,
+    mission_id: str,
+    task_id: str | None,
+    ordinal: int,
+    candidate_ids: Sequence[str],
+    context: Mapping[str, Any],
+) -> str:
+    """Deterministically derive the ``njr-`` id for one frontier observation.
+
+    The same identity inputs always yield the same id, which is what makes a
+    replay land on the journal's idempotency key instead of a second event.  The
+    field separator is ``\\x1f`` — the same reason H1 uses it: without it,
+    ``("m", "ab")`` and ``("ma", "b")`` would hash the same material.
+    """
+
+    mission_id = _identifier(mission_id, "decision_id.mission_id")
+    if task_id is not None:
+        task_id = _identifier(task_id, "decision_id.task_id")
+    if isinstance(ordinal, bool) or not isinstance(ordinal, int):
+        raise TypeError("decision_id.ordinal must be an int")
+    if ordinal < 0:
+        raise ValueError("decision_id.ordinal must be non-negative")
+    ids = tuple(_identifier(item, "decision_id.candidate_ids[]") for item in candidate_ids)
+
+    material = "\x1f".join(
+        (
+            mission_id,
+            task_id or "",
+            str(ordinal),
+            json.dumps(list(ids), ensure_ascii=False),
+            json.dumps(_plain(context), sort_keys=True, ensure_ascii=False),
+            READY_TASK_ID_CONVENTION_VERSION,
+        )
+    )
+    digest = hashlib.sha256(material.encode("utf-8")).hexdigest()
+    return READY_TASK_DECISION_ID_PREFIX + digest[:24]
+
+
+def frontier_priority_candidates(tasks: Sequence[Task]) -> list[Task]:
+    """The deterministic ``frontier()`` ordering, as the observation sees it.
+
+    ``frontier()`` sorts by ``(-priority, ordinal)``.  ``allocate()`` sorts its
+    eligible set by the §29.3 score and only falls back to ``(-priority, ordinal)``
+    for a Task the scorer did not score, so the two orders are **different
+    functions**.  This slice observes the frontier order as the plan §57 scope
+    dictates and does not claim the two agree.
+    """
+
+    return frontier(tasks)
+
+
+def frontier_priority_candidate_set(tasks: Sequence[Task]) -> tuple[DecisionCandidate, ...]:
+    """The frontier order as an attributable candidate set.
+
+    Every candidate carries its own frontier ordinal and the numeric priority the
+    order came from, so a recorded label can be audited against the Tasks rather
+    than trusted as a string the decision layer made up.  A candidate id is the
+    Task id itself — the only identity a grant can be compared against.
+    """
+
+    ordered = frontier_priority_candidates(tasks)
+    return tuple(
+        DecisionCandidate(
+            id=task.id,
+            label=task.goal,
+            metadata={
+                "frontier_ordinal": ordinal,
+                "task_priority": float(task.priority),
+                "task_status": str(task.status),
+                "task_kind": str(task.kind),
+            },
+        )
+        for ordinal, task in enumerate(ordered)
+    )
+
+
+def build_ready_task_priority_request(
+    tasks: Sequence[Task],
+    *,
+    mission_id: str,
+    decision_id: str,
+    ordinal: int = 0,
+    context_version: int = READY_TASK_CONTEXT_VERSION,
+    context: Mapping[str, Any] | None = None,
+    journal: DecisionEventJournal | None = None,
+) -> DecisionRequest:
+    """Build the typed request for one frontier observation.
+
+    Raises:
+        ValueError: if the frontier has nothing to observe.  A request with an
+            empty candidate set is invalid by contract, and "no ready Task" is an
+            ordinary state, not a decision — the caller should skip the
+            observation rather than mint an observation about nothing.
+    """
+
+    candidates = frontier_priority_candidate_set(tasks)
+    if not candidates:
+        raise ValueError("the frontier is empty; there is no priority decision to observe")
+    payload: dict[str, Any] = {
+        "context_version": context_version,
+        "frontier_ordinal": ordinal,
+        "frontier_size": len(candidates),
+        "round": ordinal,
+    }
+    if context:
+        payload.update({str(key): value for key, value in context.items()})
+    return DecisionRequest(
+        decision_id=decision_id,
+        decision_type=READY_TASK_PRIORITY_TYPE,
+        mission_id=mission_id,
+        task_id=None,
+        candidates=candidates,
+        context=payload,
+    )
+
+
+def shadow_observation_enabled(policy: DecisionPolicy) -> bool:
+    """Whether this policy asks for an observation at all (plan §57).
+
+    The plan's hard constraint is that 0/1 candidates never call the model, and
+    the same reasoning applies to a policy that only wants the existing path:
+    observation is a property of the typed policy, never of the environment.
+    """
+
+    if not isinstance(policy, DecisionPolicy):
+        raise TypeError(f"policy must be a DecisionPolicy, got {type(policy).__name__}")
+    return policy.mode is DecisionMode.SHADOW
+
+
+def build_decision_service(
+    policy: DecisionPolicy,
+    *,
+    existing_provider: DecisionProvider | None = None,
+    shadow_provider: DecisionProvider | None = None,
+    shadow_timeout_seconds: float | None = None,
+    gate: FastPathGate | None = None,
+    journal: DecisionEventJournal | None = None,
+) -> DecisionService:
+    """Build the one service that owns shadow semantics.
+
+    The existing provider defaults to a selector that answers "the frontier's
+    first candidate".  That is not a second scheduling policy — it is the same
+    deterministic answer ``frontier()`` already gives, expressed in the decision
+    contract's vocabulary, so the seam never invents a ranking of its own.
+    """
+
+    if not isinstance(policy, DecisionPolicy):
+        raise TypeError(f"policy must be a DecisionPolicy, got {type(policy).__name__}")
+    if existing_provider is None:
+        existing_provider = ExistingDecisionProvider(
+            lambda request: request.candidates[0].id
+        )
+    return DecisionService(
+        existing_provider,
+        policy=policy,
+        shadow_provider=shadow_provider,
+        shadow_timeout_seconds=shadow_timeout_seconds,
+        gate=gate,
+        event_journal=journal,
+    )
+
+
+async def observe_frontier_priority(
+    tasks: Sequence[Task],
+    attempts: Sequence[Any],
+    *,
+    decision_id: str,
+    context: Mapping[str, Any] | None = None,
+    policy: DecisionPolicy,
+    existing_provider: DecisionProvider | None = None,
+    shadow_provider: DecisionProvider | None = None,
+    shadow_timeout_seconds: float | None = None,
+    gate: FastPathGate | None = None,
+    journal: DecisionEventJournal | None = None,
+    ordinal: int = 0,
+    context_version: int = READY_TASK_CONTEXT_VERSION,
+) -> tuple[Any, tuple[DecisionObservation, ...]]:
+    """Observe the frontier order once and return the production answer.
+
+    Returns ``(production_result, observations)``.  The production result comes
+    from the existing provider — the same deterministic answer ``frontier()``
+    gives — and the observations are whatever the shadow provider managed to
+    produce, failures included.  This function never lets a shadow problem
+    escape: a provider that raises, hangs or answers about another candidate set
+    is recorded and swallowed, which is the service's own contract.
+
+    Raises:
+        ValueError: if the frontier is empty, or if the policy asks for shadow
+            without a provider.  Both are configuration errors at the call site,
+            not conditions a production run should absorb.
+    """
+
+    mission_id = _mission_of(tasks)
+    service = build_decision_service(
+        policy,
+        existing_provider=existing_provider,
+        shadow_provider=shadow_provider,
+        shadow_timeout_seconds=shadow_timeout_seconds,
+        gate=gate,
+        journal=journal,
+    )
+    if not shadow_observation_enabled(policy) or len(frontier_priority_candidates(tasks)) < 2:
+        # Nothing to observe, or an answer that cannot differ: keep the existing
+        # path and do not spend a shadow call on it (plan §57's 0/1 rule).
+        candidates = frontier_priority_candidate_set(tasks)
+        if not candidates:
+            raise ValueError(
+                "the frontier is empty; there is no priority decision to observe"
+            )
+        request = DecisionRequest(
+            decision_id=decision_id,
+            decision_type=READY_TASK_PRIORITY_TYPE,
+            mission_id=mission_id,
+            task_id=None,
+            candidates=candidates,
+            context=_context_payload(context, ordinal, len(candidates), context_version),
+        )
+        result = await service.decide(request)
+        await service.close()
+        return result, service.observations
+
+    request = build_ready_task_priority_request(
+        tasks,
+        mission_id=mission_id,
+        decision_id=decision_id,
+        ordinal=ordinal,
+        context_version=context_version,
+        context=context,
+        journal=journal,
+    )
+    result = await service.decide(request)
+    observations = await service.close()
+    return result, observations
+
+
+def _context_payload(
+    context: Mapping[str, Any] | None,
+    ordinal: int,
+    frontier_size: int,
+    context_version: int,
+) -> dict[str, Any]:
+    payload: dict[str, Any] = {
+        "context_version": context_version,
+        "frontier_ordinal": ordinal,
+        "frontier_size": frontier_size,
+        "round": ordinal,
+    }
+    if context:
+        payload.update({str(key): value for key, value in context.items()})
+    return payload
+
+
+def _mission_of(tasks: Sequence[Task]) -> str:
+    for task in tasks:
+        mission_id = getattr(task, "mission_id", None)
+        if isinstance(mission_id, str) and mission_id.strip():
+            return mission_id
+    raise ValueError("no Task carries a mission_id; there is no Mission to file a decision under")
+
+
+async def ready_task_priority_decision(
+    tasks: Sequence[Task],
+    attempts: Sequence[Any],
+    *,
+    decision_id: str,
+    context: Mapping[str, Any] | None = None,
+    policy: DecisionPolicy,
+    existing_provider: DecisionProvider | None = None,
+    shadow_provider: DecisionProvider | None = None,
+    shadow_timeout_seconds: float | None = None,
+    gate: FastPathGate | None = None,
+    journal: DecisionEventJournal | None = None,
+    ordinal: int = 0,
+    context_version: int = READY_TASK_CONTEXT_VERSION,
+    **allocate_kwargs: Any,
+) -> tuple[AllocationPlan, tuple[DecisionObservation, ...]]:
+    """One allocator decision, optionally observed, with the plan untouched.
+
+    This is the Host's real entry: it computes the plan with the legacy
+    :func:`~agent_orchestrator.scheduling.allocator.allocate` — the same call,
+    the same weights, the same pressure gates — and then, and only then, offers
+    the frontier order to the decision layer for observation.  The plan is
+    returned exactly as ``allocate()`` produced it; the observation cannot add,
+    drop or reorder a grant, in any mode.
+
+    Returns ``(plan, observations)``.  ``observations`` is empty whenever the
+    policy is not ``SHADOW``, whenever a journal was not injected (nothing to
+    attribute an observation to), or whenever the frontier has fewer than two
+    candidates.
+    """
+
+    if not isinstance(policy, DecisionPolicy):
+        raise TypeError(f"policy must be a DecisionPolicy, got {type(policy).__name__}")
+    plan = allocate(tasks, attempts, **allocate_kwargs)
+    if journal is None:
+        # No sink means no attributable observation, so the model is not called.
+        # The plan is returned unchanged, which is the entire production contract.
+        return plan, ()
+    if not shadow_observation_enabled(policy):
+        return plan, ()
+    if len(frontier_priority_candidates(tasks)) < 2:
+        return plan, ()
+    mission_id = _mission_of(tasks)
+    request = build_ready_task_priority_request(
+        tasks,
+        mission_id=mission_id,
+        decision_id=decision_id,
+        ordinal=ordinal,
+        context_version=context_version,
+        context=context,
+        journal=journal,
+    )
+    service = build_decision_service(
+        policy,
+        existing_provider=existing_provider,
+        shadow_provider=shadow_provider,
+        shadow_timeout_seconds=shadow_timeout_seconds,
+        gate=gate,
+        journal=journal,
+    )
+    try:
+        await service.decide(request)
+        observations = await service.close()
+    except Exception as error:  # the plan is already computed and must still be returned
+        return plan, (
+            DecisionObservation(
+                decision_id=request.decision_id,
+                request_candidate_ids=tuple(candidate.id for candidate in request.candidates),
+                request_context={"error": f"{type(error).__name__}"},
+                existing_result=_unavailable_result(request),
+                shadow_result=None,
+                status=_failed_status(),
+                error=f"{type(error).__name__}: {error}",
+            ),
+        )
+    return plan, observations
+
+
+def _failed_status():  # noqa: ANN202 - a tiny indirection to avoid a second import block
+    from .service import ShadowObservationStatus
+
+    return ShadowObservationStatus.FAILED
+
+
+def _unavailable_result(request: DecisionRequest):  # noqa: ANN202
+    """A result placeholder for a request that never reached production.
+
+    It exists only so the observation record keeps its shape; the incident is the
+    recorded error, and the production answer is the plan the caller already has.
+    """
+
+    from .types import DecisionResult, DecisionScore
+
+    return DecisionResult(
+        decision_id=request.decision_id,
+        provider="existing",
+        selected=request.candidates[0].id,
+        scores=tuple(
+            DecisionScore(
+                candidate_id=candidate.id,
+                probability=1.0 if index == 0 else 0.0,
+            )
+            for index, candidate in enumerate(request.candidates)
+        ),
+        top1_probability=1.0,
+        margin=1.0,
+        latency_ms=0.0,
+    )
+
+
+__all__ = (
+    "READY_TASK_CONTEXT_VERSION",
+    "READY_TASK_DECISION_ID_PREFIX",
+    "READY_TASK_ID_CONVENTION_VERSION",
+    "READY_TASK_PRIORITY_TYPE",
+    "build_decision_service",
+    "build_ready_task_priority_request",
+    "compute_ready_task_decision_id",
+    "frontier_priority_candidate_set",
+    "frontier_priority_candidates",
+    "observe_frontier_priority",
+    "ready_task_priority_decision",
+    "shadow_observation_enabled",
+)
