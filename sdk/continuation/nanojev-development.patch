@@ -0,0 +1,845 @@
+# SPDX-FileCopyrightText: 2026 DennyWanye
+# SPDX-License-Identifier: Apache-2.0
+
+"""Packaged NanoJev candidate-path scorer (plan §29–§32).
+
+This module is the *implementation* half of the runtime split the plan asks for
+(§29): it owns tokenizer, checkpoint, device and forward passes, while
+``local_runtime`` owns lifecycle, admission and the async boundary, and
+``providers/nanojev.py`` owns the SDK contract.  A future MLX runtime replaces
+this module without the provider noticing.
+
+It is imported **only inside the inference worker child process**.  Importing it
+in the SDK process is not required and is not done: ``torch``/``transformers``
+are imported inside :class:`NanoJevDecisionScorer` so the SDK keeps importing
+cleanly without the ``nanojev`` extra installed.
+
+Prompt/target contract
+----------------------
+The prompt serialisation, candidate ordering, Boolean/Tensor construction and
+the softmax-over-first-``k``-logits decision rule are the contract the checkpoint
+was trained against.  They are reproduced here from the upstream reference
+implementation (``NanoJev`` / ``openjev`` ``scripts/predict_toy_decisions.py``,
+MIT, upstream commit ``71a513b``) rather than vendored: the reference script is a
+CUDA-only CLI experiment that emits a bespoke JSON report, computes nothing the
+SDK contract needs, and hard-codes its own device guard.  What is load-bearing
+for numerical identity — segment text, ``Candidate:`` framing, EOS terminator,
+the ``[0, z]`` Boolean logits, the attention set-head — is reimplemented
+faithfully and pinned by tests.  See ``docs/nanojev_integration.md`` for the
+full provenance and the not-vendored rationale; upstream is MIT-licensed, so
+vendoring was permitted, just not useful.
+
+Hard rules carried over from upstream, kept because they are exactly what plan
+§30–§34 asks of a runtime:
+
+* **no silent truncation** — a candidate path longer than ``max_length`` raises;
+* **no download** — every artifact is local, ``local_files_only=True`` and the
+  HF offline environment flags are set before ``transformers`` is imported;
+* **no fabricated probabilities** — non-finite logits raise, they are never
+  clamped or renormalised into a plausible-looking distribution.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import math
+import os
+from collections.abc import Mapping, Sequence
+from dataclasses import dataclass, field
+from pathlib import Path
+from typing import Any
+
+#: Checkpoint layout the scorer requires (upstream ``predict_toy_decisions.py``).
+REQUIRED_CHECKPOINT_FILES = ("config.json", "best.safetensors")
+REQUIRED_CHECKPOINT_DIRS = ("backbone_config", "tokenizer")
+
+#: Boolean questions are a single semantic path with logits ``[0, z]`` — upstream
+#: ``DecisionModel.forward``.  The candidate ids are fixed by the reference; the
+#: probability row still has two entries, one per Boolean outcome.
+BOOLEAN_CANDIDATE_IDS = ("false", "true")
+BOOLEAN_CANDIDATE_TEXT = "The proposition is true."
+
+#: ``set_head`` values the checkpoint's ``config.json`` may declare.  Anything
+#: else is refused instead of being coerced: the head changes the forward pass,
+#: so an unknown value means the weights and this code do not agree.
+SUPPORTED_SET_HEADS = frozenset({"none", "attention"})
+
+#: Path to the local tokenizer/backbone artifacts, relative to the checkpoint root.
+_RUN_CONFIG = "config.json"
+_WEIGHTS = "best.safetensors"
+_BACKBONE_CONFIG = "backbone_config"
+_TOKENIZER = "tokenizer"
+
+
+class NanoJevInferenceError(RuntimeError):
+    """The scorer cannot produce a trustworthy distribution.
+
+    Raised for a missing checkpoint artifact, an over-long candidate path, a
+    non-finite logit, or any other condition where returning *something* would
+    look like a model answer that the model did not give.
+    """
+
+
+class NanoJevDependencyError(NanoJevInferenceError):
+    """The optional ``nanojev`` extra (torch / transformers / safetensors) is absent.
+
+    A distinct type so the caller can tell "install the extra" apart from
+    "the checkpoint is wrong"; both fail the call, neither fails the import.
+    """
+
+
+@dataclass(frozen=True, slots=True)
+class CandidateQuestion:
+    """One decision question with its frozen, ordered candidate set.
+
+    ``candidate_ids`` order is part of the contract: probabilities are returned
+    in exactly this order, and neither the scorer nor the runtime re-sorts them.
+    """
+
+    question_id: str
+    instructions: str
+    candidate_ids: tuple[str, ...]
+    candidate_texts: tuple[str, ...]
+    boolean_criteria: Mapping[str, str] | None = None
+
+    def __post_init__(self) -> None:
+        if not isinstance(self.question_id, str) or not self.question_id.strip():
+            raise ValueError("question_id must be a non-empty string")
+        if not isinstance(self.instructions, str) or not self.instructions.strip():
+            raise ValueError("instructions must be a non-empty string")
+        if not isinstance(self.candidate_ids, tuple) or not self.candidate_ids:
+            raise ValueError("candidate_ids must be a non-empty tuple")
+        if not isinstance(self.candidate_texts, tuple):
+            raise TypeError("candidate_texts must be a tuple")
+        if self.boolean_criteria is not None:
+            if not isinstance(self.boolean_criteria, Mapping):
+                raise TypeError("boolean_criteria must be a Mapping when present")
+            if set(self.boolean_criteria) - {"false", "true"}:
+                raise ValueError("boolean_criteria may only contain false/true keys")
+            for value in self.boolean_criteria.values():
+                if not isinstance(value, str) or not value.strip():
+                    raise ValueError("boolean criterion text must be non-empty")
+        if question_kind_of(self.candidate_ids) == "boolean":
+            # A Boolean question scores one semantic path but reports two
+            # outcomes, so upstream's one-text/two-ids shape is the expected one.
+            if self.candidate_ids != BOOLEAN_CANDIDATE_IDS:
+                raise ValueError(
+                    "Boolean candidate ids must be exactly "
+                    f"{BOOLEAN_CANDIDATE_IDS!r}"
+                )
+            if self.candidate_texts != (BOOLEAN_CANDIDATE_TEXT,):
+                raise ValueError(
+                    f"Boolean candidate text must be exactly {BOOLEAN_CANDIDATE_TEXT!r}"
+                )
+            return
+        if len(self.candidate_ids) != len(self.candidate_texts):
+            raise ValueError("candidate_ids and candidate_texts must have equal length")
+        for value in (*self.candidate_ids, *self.candidate_texts):
+            if not isinstance(value, str) or not value.strip():
+                raise ValueError("candidate ids and texts must be non-empty strings")
+        if len(set(self.candidate_ids)) != len(self.candidate_ids):
+            raise ValueError("candidate_ids must be unique")
+
+
+@dataclass(frozen=True, slots=True)
+class ScoredQuestion:
+    """The scorer's answer for one question, in the request's candidate order."""
+
+    question_id: str
+    candidate_ids: tuple[str, ...]
+    probabilities: tuple[float, ...]
+    selected: str
+    #: Ordered ``score`` levels are the only type that reports an expectation;
+    #: it is ``None`` for choice/boolean so no consumer can read a mean off them.
+    expected_level: float | None = None
+
+
+@dataclass(frozen=True, slots=True)
+class ScoredState:
+    """All answers for one state, plus the candidate-order echo used to verify it."""
+
+    state_id: str
+    questions: tuple[ScoredQuestion, ...]
+
+
+@dataclass(frozen=True, slots=True)
+class InferenceReport:
+    """One forward-pass batch worth of results and the audit facts around it."""
+
+    states: tuple[ScoredState, ...]
+    device: str
+    precision: str
+    parameter_storage: str
+    set_head: str
+    max_length: int
+    model_id: str | None
+    model_revision: str | None
+    checkpoint_sha256: str
+    candidate_paths: int
+    forward_passes: int
+    architecture: str | None = None
+    extra: Mapping[str, Any] = field(default_factory=dict)
+
+
+@dataclass(frozen=True, slots=True)
+class PreparedQuestion:
+    """Tokenizer output for one question; carries the ids for exact echo-back."""
+
+    state_id: str
+    question: CandidateQuestion
+    leaf_tokens: tuple[tuple[int, ...], ...]
+
+
+def _reject_nonfinite(value: str) -> float:
+    raise NanoJevInferenceError(f"JSON must not contain non-finite numbers: {value}")
+
+
+def _unique_object(pairs: Sequence[tuple[str, Any]]) -> dict[str, Any]:
+    result: dict[str, Any] = {}
+    for key, value in pairs:
+        if key in result:
+            raise NanoJevInferenceError(f"duplicate JSON key: {key!r}")
+        result[key] = value
+    return result
+
+
+def read_local_json(path: Path) -> Any:
+    """Read a local JSON file, refusing duplicate keys and non-finite numbers."""
+    try:
+        text = path.read_text(encoding="utf-8")
+    except OSError as error:
+        raise NanoJevInferenceError(f"cannot read {path}: {error}") from error
+    try:
+        return json.loads(
+            text, object_pairs_hook=_unique_object, parse_constant=_reject_nonfinite
+        )
+    except json.JSONDecodeError as error:
+        raise NanoJevInferenceError(f"{path} is not valid JSON: {error}") from error
+
+
+def checkpoint_sha256(weights_path: Path) -> str:
+    """Streamed SHA-256 of the checkpoint weights.
+
+    The digest is the model identity recorded on every result (plan §31/§34: the
+    checkpoint is data outside the repo, so its identity has to travel with the
+    answer).  Hashing is streamed so a 2.4 GB file never lands in memory.
+    """
+    digest = hashlib.sha256()
+    with weights_path.open("rb") as handle:
+        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def resolve_checkpoint(checkpoint_dir: str | os.PathLike[str]) -> tuple[Path, dict[str, Path]]:
+    """Validate a checkpoint directory and return its artifact paths.
+
+    The directory is supplied by the caller — this module never guesses a
+    location and never creates one.  A missing artifact is an explicit error, not
+    an empty directory the loader would then try to fill over the network.
+    """
+    root = Path(checkpoint_dir).expanduser()
+    if not root.exists():
+        raise NanoJevInferenceError(f"checkpoint directory does not exist: {root}")
+    root = root.resolve(strict=True)
+    if not root.is_dir():
+        raise NanoJevInferenceError(f"checkpoint path is not a directory: {root}")
+    paths = {"run_config": root / _RUN_CONFIG, "weights": root / _WEIGHTS}
+    for name in REQUIRED_CHECKPOINT_DIRS:
+        paths[name] = root / name
+    for name in REQUIRED_CHECKPOINT_FILES[:-1]:
+        candidate = root / name
+        if not candidate.is_file():
+            raise NanoJevInferenceError(f"checkpoint is missing {name}: {root}")
+    for name in (*REQUIRED_CHECKPOINT_DIRS, _WEIGHTS):
+        candidate = root / name
+        if not candidate.exists():
+            raise NanoJevInferenceError(f"checkpoint is missing {name}: {root}")
+    if not paths["weights"].is_file():
+        raise NanoJevInferenceError(f"checkpoint weights are not a file: {paths['weights']}")
+    for name in REQUIRED_CHECKPOINT_DIRS:
+        if not paths[name].is_dir():
+            raise NanoJevInferenceError(f"checkpoint {name} is not a directory: {paths[name]}")
+    return root, paths
+
+
+def question_kind_of(candidate_ids: Sequence[str]) -> str:
+    """The question type implied by a frozen candidate set.
+
+    Derived rather than stored, so a caller cannot declare ``choice`` and then
+    supply Boolean candidates: the two must agree or construction fails.  The
+    ``score`` case is "candidate ids are the level ordinals", which is how the
+    reference implementation numbers ordered levels.
+    """
+    if tuple(candidate_ids) == BOOLEAN_CANDIDATE_IDS:
+        return "boolean"
+    if candidate_ids and all(
+        isinstance(candidate_id, str) and candidate_id.isdigit()
+        for candidate_id in candidate_ids
+    ):
+        return "score"
+    return "choice"
+
+
+def question_kind(question: CandidateQuestion) -> str:
+    """The question type token used in the prompt for ``question``."""
+    return question_kind_of(question.candidate_ids)
+
+
+def build_prompt_segments(state_text: str, question: CandidateQuestion) -> list[str]:
+    """The two prompt segments shared by every candidate path of one question.
+
+    Byte-for-byte the upstream framing: ``State:\\n{state}\\n`` then
+    ``Question type: {type}\\nQuestion:\\n{instructions}\\n`` with the Boolean
+    criteria lines appended to the second segment.
+    """
+    if not isinstance(state_text, str) or not state_text:
+        raise NanoJevInferenceError("state text must be a non-empty string")
+    segments = [
+        f"State:\n{state_text}\n",
+        f"Question type: {question_kind(question)}\nQuestion:\n{question.instructions}\n",
+    ]
+    if question.boolean_criteria:
+        for key, label in (("false", "False"), ("true", "True")):
+            text = question.boolean_criteria.get(key)
+            if text is not None:
+                segments[1] += f"{label} criterion: {text}\n"
+    return segments
+
+
+def candidate_text_for(question: CandidateQuestion, index: int) -> str:
+    """The text of one scored candidate path.
+
+    A Boolean question has one semantic path behind its two outcomes, and the
+    ``score`` type feeds the level description alone — never the ordinal index
+    and never the neighbouring level text, so the model cannot read its answer
+    off the prompt's position.
+    """
+    if question_kind(question) == "boolean":
+        return BOOLEAN_CANDIDATE_TEXT
+    return question.candidate_texts[index]
+
+
+def prepare_question(
+    tokenizer: Any,
+    state_id: str,
+    state_text: str,
+    question: CandidateQuestion,
+    max_length: int,
+) -> PreparedQuestion:
+    """Tokenize every candidate path, refusing rather than truncating.
+
+    Reproduces the upstream encode exactly (``add_special_tokens=False`` plus an
+    explicit EOS terminator).  ``max_length`` is enforced per path *before* any
+    forward pass, because a truncated path would silently score a different
+    question than the caller asked.
+    """
+    if type(max_length) is not int or max_length <= 0:
+        raise NanoJevInferenceError("max_length must be a positive integer")
+    eos = getattr(tokenizer, "eos_token_id", None)
+    if not isinstance(eos, int) or eos < 0:
+        raise NanoJevInferenceError("checkpoint tokenizer must declare a valid eos_token_id")
+    segments = build_prompt_segments(state_text, question)
+    prefix: list[int] = []
+    for segment in segments:
+        prefix.extend(tokenizer.encode(segment, add_special_tokens=False))
+    leaves: list[tuple[int, ...]] = []
+    for index, candidate_id in enumerate(question.candidate_ids):
+        text = candidate_text_for(question, index)
+        leaf = prefix + tokenizer.encode(
+            f"Candidate:\n{text}\nDecision:", add_special_tokens=False
+        )
+        leaf = [*leaf, eos]
+        if len(leaf) > max_length:
+            raise NanoJevInferenceError(
+                f"{state_id}:{question.question_id} candidate {candidate_id!r} path is "
+                f"{len(leaf)} tokens, above max_length={max_length}; input was not truncated"
+            )
+        leaves.append(tuple(leaf))
+    return PreparedQuestion(
+        state_id=state_id,
+        question=question,
+        leaf_tokens=tuple(leaves),
+    )
+
+
+def probabilities_from_logits(logits: Sequence[float], temperature: float) -> tuple[float, ...]:
+    """Softmax over one question's candidate logits.
+
+    Single-sourced here so the worker, the tests and any future in-process caller
+    cannot drift: ``logits`` are the raw head outputs for exactly ``k`` paths.
+    """
+    if not isinstance(temperature, (int, float)) or isinstance(temperature, bool):
+        raise NanoJevInferenceError("temperature must be a finite positive number")
+    if not math.isfinite(temperature) or temperature <= 0:
+        raise NanoJevInferenceError("temperature must be a finite positive number")
+    if not logits:
+        raise NanoJevInferenceError("cannot score an empty candidate set")
+    scaled = [float(value) / float(temperature) for value in logits]
+    if not all(math.isfinite(value) for value in scaled):
+        raise NanoJevInferenceError("model produced non-finite logits; no partial result returned")
+    largest = max(scaled)
+    exponentials = [math.exp(value - largest) for value in scaled]
+    total = math.fsum(exponentials)
+    if not math.isfinite(total) or total <= 0.0:
+        raise NanoJevInferenceError("model produced a degenerate distribution")
+    probabilities = tuple(value / total for value in exponentials)
+    if abs(math.fsum(probabilities) - 1.0) > 1e-9:
+        raise NanoJevInferenceError("model probabilities do not sum to 1")
+    return probabilities
+
+
+def select_from_probabilities(
+    candidate_ids: Sequence[str], probabilities: Sequence[float]
+) -> str:
+    """Argmax over the frozen candidate order, ties broken by that same order."""
+    if len(candidate_ids) != len(probabilities):
+        raise NanoJevInferenceError("candidate and probability counts disagree")
+    if not all(math.isfinite(value) and 0.0 <= value <= 1.0 for value in probabilities):
+        raise NanoJevInferenceError("model produced probabilities outside [0, 1]")
+    if abs(math.fsum(probabilities) - 1.0) > 1e-5:
+        raise NanoJevInferenceError("model probabilities do not sum to 1")
+    best = 0
+    for index in range(1, len(probabilities)):
+        if probabilities[index] > probabilities[best]:
+            best = index
+    return candidate_ids[best]
+
+
+class NanoJevDecisionScorer:
+    """A resident NanoJev scorer: one checkpoint load, many forwards.
+
+    Construction loads the checkpoint and keeps it on the device for the life of
+    the object (plan §31 — the load must not happen per decision, which on a
+    16 GB Mac is the difference between "usable" and "swap thrash").  Every
+    method here is synchronous and device-bound; the async boundary lives in
+    ``local_runtime``.
+    """
+
+    def __init__(
+        self,
+        checkpoint_dir: str | os.PathLike[str],
+        *,
+        device: str = "mps",
+        max_length: int | None = None,
+        batch_questions: int = 0,
+        temperature: float = 1.0,
+        allow_cpu_fallback: bool = True,
+    ) -> None:
+        if device not in {"mps", "cpu", "cuda"}:
+            raise NanoJevInferenceError(f"unsupported device: {device!r}")
+        if not isinstance(temperature, (int, float)) or isinstance(temperature, bool):
+            raise NanoJevInferenceError("temperature must be a finite positive number")
+        if not math.isfinite(temperature) or temperature <= 0:
+            raise NanoJevInferenceError("temperature must be a finite positive number")
+        if type(batch_questions) is not int or batch_questions < 0:
+            raise NanoJevInferenceError("batch_questions must be a non-negative integer")
+
+        # Set the offline flags before transformers is imported anywhere in this
+        # process.  Plan §34: the runtime is a local artifact reader; a network
+        # call at decision time would turn a model into an availability risk.
+        os.environ["HF_HUB_OFFLINE"] = "1"
+        os.environ["TRANSFORMERS_OFFLINE"] = "1"
+        os.environ["HF_HUB_DISABLE_TELEMETRY"] = "1"
+        os.environ.setdefault("HF_HUB_DISABLE_IMPLICIT_TOKEN", "1")
+
+        root, paths = resolve_checkpoint(checkpoint_dir)
+        run_config = read_local_json(paths["run_config"])
+        if not isinstance(run_config, Mapping):
+            raise NanoJevInferenceError("checkpoint config.json must be a JSON object")
+        set_head = run_config.get("set_head")
+        if set_head not in SUPPORTED_SET_HEADS:
+            raise NanoJevInferenceError(
+                f"checkpoint config.json declares an unsupported set_head: {set_head!r}"
+            )
+
+        try:
+            import torch
+            import torch.nn.functional as functional
+            from safetensors.torch import load_file
+            from transformers import AutoConfig, AutoModel, AutoTokenizer
+        except ImportError as error:  # pragma: no cover - exercised by the missing-extra test
+            raise NanoJevDependencyError(
+                "NanoJev inference requires the optional 'nanojev' extra "
+                '(torch, transformers, safetensors); install it with '
+                '`pip install "simple-harness-sdk[nanojev]"`'
+            ) from error
+
+        self._torch = torch
+        self._functional = functional
+        root_config = run_config
+        limit = root_config.get("max_length", 512) if max_length is None else max_length
+        if type(limit) is not int or limit <= 0:
+            raise NanoJevInferenceError("max_length must be a positive integer")
+
+        tokenizer = AutoTokenizer.from_pretrained(
+            str(paths["tokenizer"]), local_files_only=True, trust_remote_code=False
+        )
+        if tokenizer.pad_token_id is None:
+            tokenizer.pad_token = tokenizer.eos_token
+        backbone_config = AutoConfig.from_pretrained(
+            str(paths[_BACKBONE_CONFIG]), local_files_only=True, trust_remote_code=False
+        )
+        backbone_config.use_cache = False
+        context_limit = getattr(backbone_config, "max_position_embeddings", None)
+        if isinstance(context_limit, int) and limit > context_limit:
+            raise NanoJevInferenceError(
+                f"max_length={limit} exceeds the backbone's declared context window "
+                f"({context_limit})"
+            )
+
+        # ``from_config`` builds the architecture only; every parameter comes from
+        # ``best.safetensors``.  ``from_pretrained`` would be a network read.
+        backbone = AutoModel.from_config(
+            backbone_config, attn_implementation="sdpa", trust_remote_code=False
+        ).float()
+        model = DecisionModel(backbone, set_head)
+        weights = load_file(str(paths["weights"]), device="cpu")
+        model.load_state_dict(weights, strict=True)
+        del weights
+
+        self.root = root
+        self.run_config = root_config
+        self.tokenizer = tokenizer
+        self.max_length = limit
+        self.batch_questions = batch_questions
+        self.temperature = float(temperature)
+        self.model_id = root_config.get("model")
+        self.model_revision = root_config.get("resolved_model_revision") or root_config.get(
+            "revision"
+        )
+        self.set_head = set_head
+        self.architecture = getattr(backbone_config, "model_type", None)
+        self.checkpoint_sha256 = checkpoint_sha256(paths["weights"])
+        self.parameter_count = sum(p.numel() for p in model.parameters())
+        self.load_count = 1
+        self.inference_calls = 0
+        self._requested_device = device
+        self.device, self.device_fallback_reason = self._place(
+            model, device, allow_cpu_fallback=allow_cpu_fallback
+        )
+        model.to(device=self.device, dtype=torch.float32)
+        model.eval()
+        self.model = model
+
+    # -- device placement -------------------------------------------------
+
+    def _place(
+        self, model: Any, device: str, *, allow_cpu_fallback: bool
+    ) -> tuple[Any, str | None]:
+        """Resolve the compute device, falling back to CPU only when told to.
+
+        Plan §32 asks for MPS-first with a CPU fallback.  The fallback is never
+        silent: the reason is recorded and reported on every result, because
+        "ran on CPU" and "ran on the GPU" are different evidence and the test
+        plan forbids reporting one as the other.
+        """
+        torch = self._torch
+        requested = torch.device(device)
+        if requested.type == "mps":
+            if torch.backends.mps.is_available():
+                return requested, None
+            reason = "MPS was requested but this machine reports no usable MPS backend"
+            if not allow_cpu_fallback:
+                raise NanoJevInferenceError(reason)
+            return torch.device("cpu"), reason
+        if requested.type == "cuda":
+            if torch.cuda.is_available():
+                torch.cuda.set_device(requested)
+                torch.backends.cuda.matmul.allow_tf32 = False
+                return requested, None
+            reason = "CUDA was requested but no CUDA device is available"
+            if not allow_cpu_fallback:
+                raise NanoJevInferenceError(reason)
+            return torch.device("cpu"), reason
+        return requested, None
+
+    # -- inference --------------------------------------------------------
+
+    def score(
+        self,
+        states: Sequence[tuple[str, str, Sequence[CandidateQuestion]]],
+    ) -> InferenceReport:
+        """Score every question of every state in as few forwards as configured.
+
+        Args:
+            states: ``(state_id, state_text, questions)`` triples.  State and
+                question order is preserved in the report, and each question's
+                candidate order is echoed exactly, which is how the runtime
+                verifies the model answered the request it was given.
+
+        Returns:
+            An :class:`InferenceReport` whose probabilities are in request order.
+
+        Raises:
+            NanoJevInferenceError: on over-long input, non-finite logits, a
+                degraded distribution, or any missing artifact.  Never returns a
+                partial or renormalised result.
+        """
+        if not states:
+            raise NanoJevInferenceError("at least one state is required")
+        seen_states: set[str] = set()
+        prepared: list[PreparedQuestion] = []
+        for state_id, state_text, questions in states:
+            if not isinstance(state_id, str) or not state_id.strip():
+                raise NanoJevInferenceError("state id must be a non-empty string")
+            if state_id in seen_states:
+                raise NanoJevInferenceError(f"duplicate state id: {state_id!r}")
+            seen_states.add(state_id)
+            if not questions:
+                raise NanoJevInferenceError(f"state {state_id!r} carries no questions")
+            seen_questions: set[str] = set()
+            for question in questions:
+                if not isinstance(question, CandidateQuestion):
+                    raise NanoJevInferenceError("questions must be CandidateQuestion values")
+                if question.question_id in seen_questions:
+                    raise NanoJevInferenceError(
+                        f"duplicate question id in state {state_id!r}: "
+                        f"{question.question_id!r}"
+                    )
+                seen_questions.add(question.question_id)
+                prepared.append(
+                    prepare_question(
+                        self.tokenizer, state_id, state_text, question, self.max_length
+                    )
+                )
+
+        torch = self._torch
+        model = self.model
+        batches = self._batches(prepared)
+        self.inference_calls += 1
+        answers: dict[str, dict[str, ScoredQuestion]] = {
+            state_id: {} for state_id, _text, _questions in states
+        }
+        model.eval()
+        with torch.inference_mode():
+            for batch in batches:
+                logits = self._forward(batch)
+                for row, question_logits in zip(batch, logits):
+                    probabilities = probabilities_from_logits(
+                        question_logits, self.temperature
+                    )
+                    question = row.question
+                    identifiers = question.candidate_ids
+                    selected = select_from_probabilities(identifiers, probabilities)
+                    expected = None
+                    if question_kind(question) == "score":
+                        expected = math.fsum(
+                            index * value for index, value in enumerate(probabilities)
+                        )
+                    answers[row.state_id][question.question_id] = ScoredQuestion(
+                        question_id=question.question_id,
+                        candidate_ids=identifiers,
+                        probabilities=probabilities,
+                        selected=selected,
+                        expected_level=expected,
+                    )
+        return InferenceReport(
+            states=tuple(
+                ScoredState(
+                    state_id=state_id,
+                    questions=tuple(
+                        answers[state_id][question.question_id]
+                        for question in questions
+                    ),
+                )
+                for state_id, _text, questions in states
+            ),
+            device=str(self.device),
+            precision="fp32",
+            parameter_storage="float32",
+            set_head=self.set_head,
+            max_length=self.max_length,
+            model_id=self.model_id if isinstance(self.model_id, str) else None,
+            model_revision=(
+                self.model_revision if isinstance(self.model_revision, str) else None
+            ),
+            checkpoint_sha256=self.checkpoint_sha256,
+            candidate_paths=sum(len(row.leaf_tokens) for row in prepared),
+            forward_passes=len(batches),
+            architecture=self.architecture,
+            extra={
+                "requested_device": self._requested_device,
+                "device_fallback_reason": self.device_fallback_reason,
+                "parameter_count": self.parameter_count,
+                "persistent_model_load_count": self.load_count,
+                "inference_call_index": self.inference_calls,
+                "network_model_calls": 0,
+                "autoregressive_decode_steps": 0,
+                "prefix_sharing": False,
+                "batch_questions_limit": self.batch_questions or "all",
+                "temperature": self.temperature,
+            },
+        )
+
+    def _batches(
+        self, prepared: Sequence[PreparedQuestion]
+    ) -> list[tuple[PreparedQuestion, ...]]:
+        """Group questions into forward passes.
+
+        ``batch_questions=0`` means "all in one forward", matching the upstream
+        serving default; a positive value bounds the batch.  Grouping is by
+        whole question so a question's candidates are always scored together.
+        """
+        size = self.batch_questions or len(prepared)
+        return [
+            tuple(prepared[start : start + size])
+            for start in range(0, len(prepared), size)
+        ]
+
+    def _forward(self, batch: Sequence[PreparedQuestion]) -> list[list[float]]:
+        """One backbone forward over every candidate path of ``batch``.
+
+        This is the upstream ``DecisionModel.forward`` contract: paths are padded
+        to the batch maximum, the last *real* token of each path is the decision
+        position, and the set-head attends across a question's candidates only.
+        """
+        torch = self._torch
+        functional = self._functional
+        model = self.model
+        pad_token = self.tokenizer.pad_token_id
+
+        paths = [tokens for row in batch for tokens in row.leaf_tokens]
+        lengths = torch.tensor(
+            [len(tokens) for tokens in paths], device=self.device
+        )
+        width = int(lengths.max())
+        tokens = torch.full(
+            (len(paths), width), pad_token, dtype=torch.long, device=self.device
+        )
+        for index, ids in enumerate(paths):
+            tokens[index, : len(ids)] = torch.tensor(ids, device=self.device)
+        attention = (
+            torch.arange(width, device=self.device)[None, :] < lengths[:, None]
+        )
+        hidden = model.backbone(
+            input_ids=tokens, attention_mask=attention, use_cache=False
+        ).last_hidden_state
+        leaves = hidden[
+            torch.arange(len(paths), device=self.device), lengths - 1
+        ]
+        candidate_max = max(len(row.question.candidate_ids) for row in batch)
+        projected = leaves.new_zeros(
+            (len(batch), candidate_max, leaves.shape[-1])
+        )
+        valid = torch.zeros(
+            (len(batch), candidate_max), dtype=torch.bool, device=self.device
+        )
+        offset = 0
+        for index, row in enumerate(batch):
+            count = len(row.leaf_tokens)
+            projected[index, :count] = leaves[offset : offset + count]
+            valid[index, : len(row.question.candidate_ids)] = True
+            offset += count
+
+        normalised = model.norm(projected)
+        logits = model.scalar(normalised).squeeze(-1).float()
+        if model.set_head == "attention":
+            choice_rows = torch.tensor(
+                [index for index, row in enumerate(batch) if question_kind(row.question) == "choice"],
+                device=self.device,
+            )
+            if len(choice_rows):
+                log_k = (
+                    valid[choice_rows]
+                    .sum(-1)
+                    .float()
+                    .log()[:, None, None]
+                    .expand(-1, candidate_max, 1)
+                )
+                upper = model.set_project(
+                    torch.cat([projected[choice_rows], log_k.to(projected.dtype)], dim=-1)
+                )
+                mixed, _ = model.set_attention(
+                    upper, upper, upper, key_padding_mask=~valid[choice_rows], need_weights=False
+                )
+                delta = model.set_output(torch.tanh(upper + mixed)).squeeze(-1).float()
+                logits = logits.index_add(0, choice_rows, delta)
+
+        rows: list[list[float]] = []
+        for index, row in enumerate(batch):
+            count = len(row.question.candidate_ids)
+            if question_kind(row.question) == "boolean":
+                # Upstream: a Boolean question is one semantic path plus a scalar,
+                # represented as logits ``[0, z]`` — not a two-path comparison.
+                rows.append([0.0, float(logits[index, 0])])
+            else:
+                rows.append([float(value) for value in logits[index, :count]])
+        if not all(math.isfinite(value) for row in rows for value in row):
+            raise NanoJevInferenceError(
+                "model produced non-finite logits; no partial prediction returned"
+            )
+        return rows
+
+    def close(self) -> None:
+        """Drop the resident model so the device memory is released.
+
+        Called by the worker child on shutdown; the parent never calls this
+        directly, because in the worker topology the model does not live in the
+        parent process at all.
+        """
+        model = getattr(self, "model", None)
+        if model is not None:
+            del self.model
+        self.model = None  # type: ignore[assignment]
+        torch = self._torch
+        if torch is not None and self.device is not None and self.device.type == "mps":
+            try:
+                torch.mps.empty_cache()
+            except Exception:  # pragma: no cover - best effort, device-specific
+                pass
+
+
+def _define_decision_model() -> type[Any]:
+    """Build the ``DecisionModel`` class with the optional torch import inside.
+
+    Reimplemented from the upstream reference (MIT, commit ``71a513b``) rather
+    than vendored, for the reasons in this module's docstring.  The layer shapes,
+    the zero-initialised output projection and the ``tanh`` residual are the
+    trained architecture; changing any of them makes ``load_state_dict(strict=True)``
+    fail rather than quietly scoring with a different network.
+    """
+    import torch
+    from torch import nn
+
+    class DecisionModel(nn.Module):  # type: ignore[misc]
+        """Backbone plus the decision head the checkpoint was trained with."""
+
+        def __init__(self, backbone: Any, set_head: str) -> None:
+            super().__init__()
+            if set_head not in SUPPORTED_SET_HEADS:
+                raise NanoJevInferenceError(f"unsupported set_head: {set_head!r}")
+            self.backbone = backbone
+            hidden = backbone.config.hidden_size
+            self.norm = nn.LayerNorm(hidden)
+            self.scalar = nn.Linear(hidden, 1)
+            nn.init.normal_(self.scalar.weight, std=0.02)
+            nn.init.zeros_(self.scalar.bias)
+            self.set_head = set_head
+            if set_head == "attention":
+                self.set_project = nn.Linear(hidden + 1, 128)
+                self.set_attention = nn.MultiheadAttention(
+                    128, 4, dropout=0.0, batch_first=True
+                )
+                self.set_output = nn.Linear(128, 1)
+                nn.init.zeros_(self.set_output.weight)
+                nn.init.zeros_(self.set_output.bias)
+
+    return DecisionModel
+
+
+class _LazyDecisionModel:
+    """Indirection so ``DecisionModel`` is only built when torch is present."""
+
+    _cached: type[Any] | None = None
+
+    def __call__(self, backbone: Any, set_head: str) -> Any:
+        cls = _LazyDecisionModel._cached
+        if cls is None:
+            cls = _define_decision_model()
+            _LazyDecisionModel._cached = cls
+        return cls(backbone, set_head)
+
+
+DecisionModel = _LazyDecisionModel()
