+                storage_uri=str(path),
+                created_at=1000.0,
+            )
+            result = ResultEnvelope.from_json(
+                {
+                    "id": f"fixture-result-{index}",
+                    "task_id": task.id,
+                    "attempt_id": attempt.id,
+                    "mission_id": mission.id,
+                    "outcome": "candidate",
+                    "summary": "offline legacy fixture",
+                    "claims": [],
+                    "evidence": [],
+                    "artifacts": [artifact.id],
+                    "proposed_tasks": [],
+                    "used_knowledge": [],
+                    "risks": [],
+                    "cost": {},
+                }
+            )
+            recorded = service.record_result(
+                attempt.id, envelope=result, turn_id=turn, artifacts=[artifact], usage_refs=()
+            )
+            event_count = store.count_events(mission.id)
+            replay = service.record_result(
+                attempt.id, envelope=result, turn_id=turn, artifacts=[artifact], usage_refs=()
+            )
+            assert (
+                recorded.to_json() == replay.to_json()
+                and store.count_events(mission.id) == event_count
