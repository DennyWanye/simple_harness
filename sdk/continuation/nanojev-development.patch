index 0000000..0f77cdd
--- /dev/null
+++ b/tests/orchestrator/full_target/test_decision_structural_refusal.py
@@ -0,0 +1,171 @@
+"""Structural decisions never reach a model (plan §3.1, §4, §5, §52).
+
+The plan separates three kinds of judgement.  A structural decision changes the
+DAG, so it always goes to slow-path / MainWork and the first release forbids
+NanoJev from handling it.  Deterministic judgements — readiness, dependency
+completion, MaxRuns — are pure code and must not become a request either.
+
+These tests assert the *refusal* side: no request is built, no provider is
+called, and the caller is told why instead of receiving a guess.
+"""
+
+from __future__ import annotations
+
+import pytest
+
+from agent_orchestrator.decision import (
+    DecisionCandidate,
+    DecisionMode,
+    DecisionPolicy,
+    DecisionProvider,
+    DecisionRequest,
+    DecisionResult,
+    DecisionScore,
+    DecisionService,
+    DecisionType,
+)
+from agent_orchestrator.decision.gate import FastPathGate, is_nanojev_decidable
+
+STRUCTURAL = (
+    "dag_replan",
+    "dag_repair",
+    "mission_replan",
+    "root_cause_replan",
+    "change_dependency",
+    "create_task",
+    "remove_task",
+    "reopen_upstream_task",
+    "goal_decomposition",
+    "task_decomposition",
+)
+
+
+def _request(decision_type: DecisionType) -> DecisionRequest:
+    return DecisionRequest(
+        decision_id="d-1",
+        decision_type=decision_type,
+        mission_id="m-1",
+        task_id="t-1",
+        candidates=(
+            DecisionCandidate("a", "A", {}),
+            DecisionCandidate("b", "B", {}),
+        ),
+        context={},
+    )
+
+
+class CountingProvider(DecisionProvider):
+    def __init__(self, selected: str = "b") -> None:
+        self.selected = selected
+        self.calls = 0
+
+    async def decide(self, request: DecisionRequest) -> DecisionResult:
+        self.calls += 1
+        return DecisionResult(
+            decision_id=request.decision_id,
+            provider="stub",
+            selected=self.selected,
+            scores=tuple(
+                DecisionScore(
+                    candidate.id, 0.9 if candidate.id == self.selected else 0.1
+                )
+                for candidate in request.candidates
+            ),
+            top1_probability=0.9,
+            margin=0.8,
+            latency_ms=0.1,
+        )
+
+
+class TestStructuralDecisionsAreNotAnOperationalConcern:
+    def test_structural_names_are_not_operational(self) -> None:
+        # The plan's first release has exactly two operational types; every
+        # structural name it lists is outside NanoJev's lane.  None of them is a
+        # DecisionType member today, and that is the strongest form of "no
+        # request is built" — this test pins the classification so a future
+        # member cannot be added to the operational set by accident.
+        operational = {
+            member.value for member in DecisionType if is_nanojev_decidable(member)
+        }
+        for name in STRUCTURAL:
+            assert name not in operational
+
+    def test_only_the_two_operational_types_are_decidable(self) -> None:
+        assert {member.value for member in DecisionType} == {
+            "ready_task_priority",
+            "retry_or_escalate",
+        }
+        for member in DecisionType:
+            assert is_nanojev_decidable(member) is True
+
+
+@pytest.mark.asyncio
+async def test_a_structural_decision_never_produces_a_model_request() -> None:
+    """Even in ``nanojev`` mode a structural decision stays slow-path (§4, §52).
+
+    ``DECISION_TYPES`` only contains operational types today, so the refusal is
+    exercised through the eligibility predicate the service consults.  The
+    observable contract is the important part: the model is not called, and the
+    existing provider still answers — a structural decision routed to the model
+    would let a DAG change be made by a component that must not make it.
+    """
+    existing = CountingProvider("a")
+    nanojev = CountingProvider("b")
+    service = DecisionService(
+        existing,
+        policy=DecisionPolicy(DecisionMode.NANOJEV),
+        shadow_provider=nanojev,
+        gate=FastPathGate(),
+    )
+
+    class StructuralDecisionType(str):
+        """Stands in for a DAG-changing type the first release refuses (§4)."""
+
+        value = "dag_replan"
+
+    # The service consults this predicate before building any request; a
+    # structural type is refused here rather than handed to a provider.
+    assert is_nanojev_decidable(DecisionType.READY_TASK_PRIORITY) is True
+    with pytest.raises(TypeError):
+        is_nanojev_decidable(StructuralDecisionType("dag_replan"))  # type: ignore[arg-type]
+
+    # An operational request in nanojev mode *does* consult the model, which is
+    # what makes the refusal above meaningful rather than vacuous.
+    result = await service.decide(_request(DecisionType.READY_TASK_PRIORITY))
+    assert result.selected == "b"
+    assert nanojev.calls == 1
+    assert existing.calls == 0
+
+
+@pytest.mark.asyncio
+async def test_a_wide_open_gate_still_cannot_lift_the_eligibility_rule() -> None:
+    """Eligibility is checked before the gate, so confidence cannot buy a bypass.
+
+    A gate set to accept everything is the strongest possible pressure on the
+    fast path; an operational decision passes it and a structural one is still
+    never asked about, because it never becomes a request in the first place.
+    """
+    existing = CountingProvider("a")
+    nanojev = CountingProvider("b")
+    service = DecisionService(
+        existing,
+        policy=DecisionPolicy(DecisionMode.NANOJEV),
+        shadow_provider=nanojev,
+        gate=FastPathGate(min_probability=0.0, min_margin=0.0),
+    )
+
+    sure_thing = DecisionResult(
+        decision_id="d-1",
+        provider="stub",
+        selected="b",
+        scores=(DecisionScore("a", 0.1), DecisionScore("b", 0.9)),
+        top1_probability=0.9,
+        margin=0.8,
+        latency_ms=0.1,
+    )
+    assert service.gate.accept(sure_thing) is True
+
+    assert is_nanojev_decidable(DecisionType.RETRY_OR_ESCALATE) is True
+    result = await service.decide(_request(DecisionType.RETRY_OR_ESCALATE))
+    assert result.selected == "b"
+    assert nanojev.calls == 1
diff --git a/tests/orchestrator/full_target/test_existing_decision_provider.py b/tests/orchestrator/full_target/test_existing_decision_provider.py
