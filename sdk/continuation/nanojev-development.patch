+@pytest.mark.asyncio
+async def test_v2_observer_skips_when_allocator_score_has_no_task_row() -> None:
+    calls = []
+
+    async def capture(*args):
+        calls.append(args)
+
+    host = _observer_host(capture)
+    plan = AllocationPlanV2(scores={"m:missing": object()})
+    await host._observe_decision(
+        SimpleNamespace(id="m"),
+        (SimpleNamespace(id="m:present"),),
+        (),
+        plan,
+    )
+    assert calls == []
+    assert host.notes and "cannot assemble admission data losslessly" in host.notes[0]
