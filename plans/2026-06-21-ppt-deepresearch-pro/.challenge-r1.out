        use_template = True; _notify(notifier, sid, "âš ï¸ AI é…å›¾æš‚æ—¶è¿žä¸ä¸Šï¼Œå·²åˆ‡æ¢ç²¾ç¾Žæ¨¡æ¿ç”Ÿæˆã€?)
    if image_mode and not use_template:
