 1186: def resolve_config_path() -> Path:
 1187:     """Return the config.toml path the backend should load, with priority:
 1188: 
 1189:     1. ``DESKPET_CONFIG`` env (E2E / tests / power users).
 1190:     2. ``<user_data_dir>/config.toml`` 鈥?seeded on first run from the bundle.
 1191:     3. Bundle default (frozen exe dir or dev repo root).
 1192:     4. Whatever fallback we can find, even if missing 鈥?``load_config`` will
 1193:        silently return ``AppConfig()`` defaults in that case.
 1194:     """
 1195:     override = os.environ.get("DESKPET_CONFIG")
 1196:     if override:
 1197:         p = Path(override)
 1198:         if p.is_file():
 1199:             return p
 1200:         logger.warning("DESKPET_CONFIG=%s does not exist; falling through", override)
 1201: 
 1202:     # Try (or create) the user-data copy.
 1203:     seeded = seed_user_config_if_missing()
 1204:     if seeded is not None and seeded.is_file():
 1205:         try:
 1206:             _recover_orphaned_endpoints(seeded)
 1207:         except Exception as e:  # noqa: BLE001 - self-heal must not block startup
 1208:             logger.warning("endpoints_recover_unexpected: %s", e)
 1209:         return seeded
 1210: 
 1211:     # Fall through: bundle default.
 1212:     bundle = _bundle_default_config_path()
 1213:     if bundle is not None:
 1214:         return bundle
 1215: 
 1216:     # Last resort: a path that doesn't exist. load_config() returns
 1217:     # AppConfig() defaults when the path is missing, which is the
 1218:     # correct behaviour 鈥?we just won't read anything from disk.
 1219:     return _paths.user_data_dir() / "config.toml"
 1220: 

