+"""NanoJev-mode wiring in ``DecisionService`` (plan §39, §40, §42, §52).
+
+``DecisionMode.NANOJEV`` is the promotion target: NanoJev answers when it is
+confident and the existing path answers otherwise.  Two properties matter more
+than the happy path:
+
+* flipping the mode must never *silently* behave like ``EXISTING`` — before the
+  model boundary exists, the mode has to fail loudly instead of quietly
+  discarding every NanoJev vote;
+* a structural decision (anything outside the operational set) must never
+  produce a NanoJev request at all, whatever the mode says (§4, §52).
+
+These tests use fake providers only.  No checkpoint is loaded and no result is
+claimed to come from a real model.
+"""
+
+from __future__ import annotations
+
+import pytest
+
+from agent_orchestrator.decision import (
+    DecisionCandidate,
+    DecisionMode,
+    DecisionPolicy,
+    DecisionProvider,
+    DecisionRequest,
+    DecisionResult,
+    DecisionScore,
+    DecisionService,
+    DecisionType,
+)
+from agent_orchestrator.decision.gate import FastPathGate
+
+
+def _candidates() -> tuple[DecisionCandidate, ...]:
+    return (
+        DecisionCandidate("a", "A", {"rank": 1}),
+        DecisionCandidate("b", "B", {"rank": 2}),
+        DecisionCandidate("c", "C", {"rank": 3}),
+    )
+
+
+def _request(
+    decision_id: str = "d-1",
+    decision_type: DecisionType = DecisionType.READY_TASK_PRIORITY,
+) -> DecisionRequest:
+    return DecisionRequest(
+        decision_id=decision_id,
+        decision_type=decision_type,
+        mission_id="m-1",
+        task_id="t-1",
+        candidates=_candidates(),
+        context={"goal_summary": "pick one"},
+    )
+
+
+class StubProvider(DecisionProvider):
+    """A provider with a fixed answer; records how many times it was asked."""
+
+    def __init__(self, selected: str, *, probabilities: dict[str, float] | None = None) -> None:
+        self.selected = selected
+        self.probabilities = probabilities
+        self.calls = 0
+
+    async def decide(self, request: DecisionRequest) -> DecisionResult:
+        self.calls += 1
+        if self.probabilities is None:
+            scores = tuple(
+                DecisionScore(
+                    candidate.id,
+                    1.0 if candidate.id == self.selected else 0.0,
+                )
+                for candidate in request.candidates
+            )
+            top1 = 1.0
+            margin = 1.0 if len(request.candidates) == 1 else 1.0
+        else:
+            scores = tuple(
+                DecisionScore(candidate.id, self.probabilities[candidate.id])
+                for candidate in request.candidates
+            )
+            ordered = sorted(self.probabilities.values(), reverse=True)
+            top1 = ordered[0]
+            margin = ordered[0] - ordered[1] if len(ordered) > 1 else 1.0
+        return DecisionResult(
+            decision_id=request.decision_id,
+            provider="stub",
+            selected=self.selected,
+            scores=scores,
+            top1_probability=top1,
+            margin=margin,
+            latency_ms=0.1,
+        )
+
+
+@pytest.mark.asyncio
+async def test_nanojev_mode_uses_nanojev_when_gate_accepts() -> None:
+    existing = StubProvider("a")
+    nanojev = StubProvider("b", probabilities={"a": 0.05, "b": 0.91, "c": 0.04})
+    service = DecisionService(
+        existing,
+        policy=DecisionPolicy(DecisionMode.NANOJEV),
+        shadow_provider=nanojev,
+        gate=FastPathGate(),
+    )
+
+    result = await service.decide(_request())
+
+    assert result.selected == "b"
+    assert result.provider == "stub"
+    assert existing.calls == 0
+    assert nanojev.calls == 1
+
+
+@pytest.mark.asyncio
+async def test_nanojev_mode_falls_back_to_existing_when_gate_rejects() -> None:
+    existing = StubProvider("a")
+    nanojev = StubProvider("b", probabilities={"a": 0.51, "b": 0.48, "c": 0.01})
+    service = DecisionService(
+        existing,
+        policy=DecisionPolicy(DecisionMode.NANOJEV),
+        shadow_provider=nanojev,
+        gate=FastPathGate(),
+    )
+
+    result = await service.decide(_request())
+
+    assert result.selected == "a"
+    assert existing.calls == 1
+    assert nanojev.calls == 1
+
+
+@pytest.mark.asyncio
+async def test_nanojev_mode_falls_back_when_provider_fails() -> None:
+    existing = StubProvider("a")
+
+    class CrashingProvider(DecisionProvider):
+        def __init__(self) -> None:
+            self.calls = 0
+
+        async def decide(self, request: DecisionRequest) -> DecisionResult:
+            self.calls += 1
+            raise RuntimeError("no checkpoint")
+
+    nanojev = CrashingProvider()
+    service = DecisionService(
+        existing,
+        policy=DecisionPolicy(DecisionMode.NANOJEV),
+        shadow_provider=nanojev,
+        gate=FastPathGate(),
+    )
+
+    result = await service.decide(_request())
+
+    assert result.selected == "a"
+    assert existing.calls == 1
+    assert nanojev.calls == 1
+    assert service.observations == ()
+
+
+@pytest.mark.asyncio
+async def test_nanojev_mode_without_provider_fails_loudly() -> None:
+    # A silent downgrade to EXISTING would discard every NanoJev vote while the
+    # operator believes the model is live, so construction must refuse.
+    with pytest.raises(ValueError, match="nanojev"):
+        DecisionService(
+            StubProvider("a"),
+            policy=DecisionPolicy(DecisionMode.NANOJEV),
+        )
+
+
+@pytest.mark.asyncio
+async def test_nanojev_mode_single_candidate_never_calls_the_model() -> None:
+    existing = StubProvider("a")
+    nanojev = StubProvider("a")
+    service = DecisionService(
+        existing,
+        policy=DecisionPolicy(DecisionMode.NANOJEV),
+        shadow_provider=nanojev,
+        gate=FastPathGate(),
+    )
+    one = DecisionRequest(
+        decision_id="one",
+        decision_type=DecisionType.READY_TASK_PRIORITY,
+        mission_id="m-1",
+        task_id="t-1",
+        candidates=(DecisionCandidate("a", "A", {}),),
+        context={},
+    )
+
+    assert (await service.decide(one)).selected == "a"
+    assert nanojev.calls == 0
+    assert existing.calls == 1
+
+
+@pytest.mark.asyncio
+async def test_existing_mode_still_never_calls_the_nanojev_provider() -> None:
+    existing = StubProvider("a")
+    nanojev = StubProvider("b", probabilities={"a": 0.05, "b": 0.91, "c": 0.04})
+    service = DecisionService(
+        existing,
+        policy=DecisionPolicy(DecisionMode.EXISTING),
+        shadow_provider=nanojev,
+        gate=FastPathGate(),
+    )
+
+    assert (await service.decide(_request())).selected == "a"
+    assert nanojev.calls == 0
