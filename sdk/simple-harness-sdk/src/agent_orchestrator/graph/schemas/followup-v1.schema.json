{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:simpleharness:taskgraph:followup:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mission_id",
    "source_event_id",
    "kind",
    "subject_key",
    "source_revision",
    "cause_ref"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "mission_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "source_event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "kind": {
      "enum": [
        "REEVALUATE",
        "CONVERGE",
        "REQUEST_COMPOSITION"
      ]
    },
    "subject_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "source_revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "cause_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "revision",
        "content_hash"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
