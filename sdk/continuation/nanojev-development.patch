+        candidates=(
+            DecisionCandidate("a", "A", {}),
+            DecisionCandidate("b", "B", {}),
+        ),
+        context={"goal_summary": "choose"},
+    )
+
+
+class FakeRuntime(NanoJevRuntime):
+    def __init__(self, output: NanoJevOutput) -> None:
+        self.output = output
+        self.requests: list[NanoJevRequest] = []
+
+    async def start(self) -> None:
+        return None
+
+    async def evaluate(self, request: NanoJevRequest) -> NanoJevOutput:
+        self.requests.append(request)
+        return self.output
+
+    async def close(self) -> None:
+        return None
+
+
+@pytest.mark.asyncio
+async def test_provider_translates_request_and_result() -> None:
+    runtime = FakeRuntime(NanoJevOutput("b", {"a": 0.1, "b": 0.9}, "fake-v1"))
+    result = await NanoJevDecisionProvider(runtime).decide(make_request())
+
+    assert result.selected == "b"
+    assert result.provider == "nanojev"
+    assert result.model_version == "fake-v1"
+    assert runtime.requests[0].decision_id == "d-1"
+    assert [row["id"] for row in runtime.requests[0].candidates] == ["a", "b"]
+
+
+@pytest.mark.asyncio
+async def test_provider_rejects_unknown_candidate_and_bad_distribution() -> None:
+    unknown = FakeRuntime(NanoJevOutput("x", {"a": 0.1, "b": 0.9}))
+    with pytest.raises(ContractError):
+        await NanoJevDecisionProvider(unknown).decide(make_request())
+
+    bad_sum = FakeRuntime(NanoJevOutput("a", {"a": 0.2, "b": 0.2}))
+    with pytest.raises(ContractError, match="sum to 1"):
+        await NanoJevDecisionProvider(bad_sum).decide(make_request())
+
+
+@pytest.mark.asyncio
+async def test_provider_does_not_call_runtime_for_single_candidate() -> None:
+    runtime = FakeRuntime(NanoJevOutput("a", {"a": 1.0}))
+    request = make_request()
+    one = DecisionRequest(
+        decision_id=request.decision_id,
+        decision_type=request.decision_type,
+        mission_id=request.mission_id,
+        task_id=request.task_id,
+        candidates=(request.candidates[0],),
+        context=request.context,
+    )
+    with pytest.raises(ContractError, match="at least two"):
+        await NanoJevDecisionProvider(runtime).decide(one)
+    assert runtime.requests == []
