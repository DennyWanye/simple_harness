{
  "schema_version": "1.4.0",
  "release_unit": {
    "id": "2026-08-21-sdk-context-authority-cutover",
    "title": "SDK Context authority cutover",
    "acceptance_file": "plans/2026-08-21-sdk-context-authority-cutover/acceptance.md",
    "plan_file": "plans/2026-08-21-sdk-context-authority-cutover/plan.md"
  },
  "source_request": "建立 SDK Context 单一事实源、真实 Provider 用量账本与旧链路退役，并完成自动化和真实 UI 验证闭环。",
  "behavior_contract": [
    "fresh SDK Run 只准备一次，同一冻结快照驱动 RunStart、首个物理请求和 Inspector",
    "产品 Context 按策略完整进入真实请求且 fresh Run 排除 activity、artifact、summary 和其他 Session 数据",
    "每个 physical attempt 独立持久化真实身份与 nullable usage，不把缺失或失败伪造成零测量",
    "Provider、executor、Inspector 使用同一不可变 catalog generation、完整 schema 和 fingerprint",
    "Context UI 明确区分实际测量、估算、binding-only、legacy incomplete 与 unavailable",
    "多 Session、WAITING、取消、设置变化和完整重启保持 per-Run 隔离与恢复"
  ],
  "baseline": {
    "head": "e92883a5c52d406b30d4b4e212589fbe4fb44e13",
    "source": "git rev-parse HEAD before Phase 3 D oracle drafting"
  },
  "executor_engine": "current",
  "challenger_engine": "claude",
  "auditor_engine": "opus-4.8",
  "testcase_files": [
    "testcase/2026-08-21-sdk-context-authority-cutover/testcases.md",
    "testcase/2026-08-21-sdk-context-authority-cutover/core-value-smoke-inputs.md"
  ],
  "applicability": {
    "input_sensitive": {
      "value": true,
      "rationale": "真实 LLM 回答与工具选择会随 Persona、历史、附件和用户输入语义明显变化。",
      "decided_by": "phase-3-d-black-box-preparer"
    },
    "llm_payload_driven": {
      "value": true,
      "rationale": "Provider 文本、工具调用、usage、reasoning 与 schema 载荷直接驱动 Run、账本和 UI。",
      "decided_by": "phase-3-d-black-box-preparer"
    },
    "stateful_init": {
      "value": true,
      "rationale": "Provider 配置、Session 快照、usage、catalog lease 与 WAITING 均依赖持久化及冷启动恢复。",
      "decided_by": "phase-3-d-black-box-preparer"
    }
  },
