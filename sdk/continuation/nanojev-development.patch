@@ -0,0 +1,700 @@
+# SPDX-FileCopyrightText: 2026 DennyWanye
+# SPDX-License-Identifier: Apache-2.0
+
+"""PR-7: the Host-facing seam for a Shadow-only READY_TASK_PRIORITY observation.
+
+The NanoJev decision layer was built as a self-consistent island with no caller.
+This suite pins the caller the Host actually needs, and pins the three things the
+parent's ruling makes load-bearing:
+
+* ``EXISTING`` is the default, and only the typed policy can change it — there is
+  no environment variable and no config file in this module.
+* the observation is ``READY_TASK_PRIORITY`` over the deterministic ``frontier()``
+  order, and the allocator's grant set stays authoritative: the returned plan is
+  equal with and without the observation, in every mode.
+* the ids are deterministic and live in their own ``njr-`` namespace, never in
+  H1's ``pd-`` planning-decision namespace.
+
+``RETRY_OR_ESCALATE`` is deliberately absent: ``RetryAction`` has six values and
+the ruling does not authorise mapping them onto the two-value contract yet, so a
+retry seam would have to invent semantics.  The last test pins that absence, so a
+later slice cannot quietly add one under this module's name.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import inspect
+import json
+
+import pytest
+
+from agent_orchestrator.contracts import Attempt, AttemptStatus, Budget, Task, TaskStatus
+from agent_orchestrator.contracts.models import ContractError
+from agent_orchestrator.decision import (
+    DecisionMode,
+    DecisionPolicy,
+    DecisionService,
+    DecisionType,
+    ShadowObservationStatus,
+)
+from agent_orchestrator.decision import host_integration as seam
+from agent_orchestrator.decision.events import DecisionEventJournal
+from agent_orchestrator.decision.provider import DecisionProvider
+from agent_orchestrator.decision.types import DecisionResult, DecisionScore
+from agent_orchestrator.scheduling import allocator as legacy_allocator
+from agent_orchestrator.storage.store import Store
+
+MISSION = "m-pr7"
+
+
+# --------------------------------------------------------------------------------------
+# Builders
+# --------------------------------------------------------------------------------------
+
+
+def task_row(
+    task_id: str,
+    *,
+    status: TaskStatus = TaskStatus.READY,
+    priority: float = 1.0,
+    paused: bool = False,
+    deps: tuple[str, ...] = (),
+    ready_at: float | None = None,
+    kind: str = "work",
+) -> Task:
+    return Task(
+        id=task_id,
+        mission_id=MISSION,
+        parent_task_ids=(),
+        dependency_ids=deps,
+        goal=f"goal of {task_id}",
+        rationale="r",
+        success_criteria=("file:x",),
+        verification_policy=("format_check",),
+        allowed_tools=(),
+        budget=Budget(max_tokens=10_000, max_attempts=3),
+        priority=priority,
+        status=status,
+        version=1,
+        paused=paused,
+        ready_at=ready_at,
+        kind=kind,
+    )
+
+
+def attempt_row(task_id: str, ordinal: int, status: AttemptStatus) -> Attempt:
+    return Attempt(
+        id=f"{task_id}:attempt-{ordinal}",
+        task_id=task_id,
+        mission_id=MISSION,
+        role="worker",
+        model="x",
+        prompt_version="v",
+        context_version="c",
+        budget_reserved=Budget(max_tokens=1),
+        lease_owner=None,
+        lease_expires_at=None,
+        status=status,
+        retry_of=None,
+        created_at=1.0,
+        version=1,
+        ordinal=ordinal,
+        creation_key=f"k-{task_id}-{ordinal}",
+        input_id="i",
+        failure=None,
+    )
+
+
+def three_ready() -> list[Task]:
+    """Three READY Tasks with distinct priorities, plus one blocked and one held back.
+
+    ``task-3`` depends on ``task-1``, whose status is READY rather than COMPLETED,
+    so ``frontier()`` excludes it (``§8.1``).  That is the exclusion the
+    observation must inherit rather than re-derive: a Task that cannot be granted
+    must not become a candidate either.
+    """
+
+    return [
+        task_row("m-pr7:task-1", priority=1.0, ready_at=0.0),
+        task_row("m-pr7:task-2", priority=3.0, ready_at=0.0),
+        task_row("m-pr7:task-3", priority=2.0, ready_at=0.0, deps=("m-pr7:task-1",)),
+        task_row("m-pr7:task-4", priority=9.0, status=TaskStatus.BLOCKED),
+    ]
+
+
+class StubShadow(DecisionProvider):
+    """A shadow provider that answers whatever the test tells it to."""
+
+    def __init__(
+        self,
+        selected: str,
+        *,
+        error: Exception | None = None,
+        sticky: asyncio.Event | None = None,
+        tail: tuple[str, ...] = (),
+        drift: bool = False,
+    ) -> None:
+        self.selected = selected
+        self.error = error
+        self.sticky = sticky
+        self.tail = tail
+        self.drift = drift
+        self.calls = 0
+        self.requests: list[object] = []
+
+    async def decide(self, request):  # noqa: ANN001 - the contract's own request type
+        self.calls += 1
+        self.requests.append(request)
+        if self.sticky is not None:
+            await self.sticky.wait()
+        if self.error is not None:
+            raise self.error
+        chosen = self.selected
+        if self.drift and self.calls > 1:
+            chosen = self.selected
+        ids = [candidate.id for candidate in request.candidates] + list(self.tail)
+        if chosen not in ids:
+            raise AssertionError(f"stub asked to select an absent candidate {chosen!r}")
+        scores = tuple(
+            DecisionScore(candidate_id=item, probability=1.0 if item == chosen else 0.0)
+            for item in ids
+        )
+        return DecisionResult(
+            decision_id=request.decision_id,
+            provider="stub-shadow",
+            selected=chosen,
+            scores=scores,
+            top1_probability=1.0,
+            margin=1.0,
+            latency_ms=0.0,
+        )
+
+
+def real_journal(tmp_path):  # noqa: ANN001 - pytest's tmp_path
+    """A real journal over a real Store.
+
+    The seam takes the journal the service accepts — a genuine
+    ``DecisionEventJournal`` — so the focused suite uses one instead of a
+    duck-typed double.  That also lets the events themselves be asserted rather
+    than assumed.
+    """
+
+    return DecisionEventJournal(Store.open(tmp_path / "orchestrator.db"))
+
+
+@pytest.fixture
+def journal(tmp_path):
+    return real_journal(tmp_path)
+
+
+def journal_events(journal) -> list:  # noqa: ANN001 - a real journal
+    """Every event the journal stored, oldest first."""
+
+    rows = journal.store.connection.execute(
+        "SELECT type, payload_json FROM events ORDER BY seq"
+    ).fetchall()
+    return [(row["type"], json.loads(row["payload_json"])) for row in rows]
+
+
+def observe(
+    tasks,
+    shadow,
+    *,
+    mode: DecisionMode = DecisionMode.SHADOW,
+    timeout: float | None = 5.0,
+    journal,
+    attempts=(),
+    label: str = "njr-plan",
+    **allocate_kwargs,
+):
+    """Drive one allocator decision through the seam with an explicit journal.
+
+    The journal is a required argument rather than a defaulted one on purpose:
+    the seam's behaviour is *different* with and without a sink, so a test that
+    forgot to inject one would silently be testing the no-journal path.
+    """
+
+    plan, observations = asyncio.run(
+        seam.ready_task_priority_decision(
+            tasks,
+            attempts,
+            decision_id=label,
+            context={"round": 1},
+            policy=DecisionPolicy(mode=mode),
+            shadow_provider=shadow,
+            shadow_timeout_seconds=timeout,
+            journal=journal,
+            concurrency_limit=4,
+            **allocate_kwargs,
+        )
+    )
+    return plan, observations
+
+
