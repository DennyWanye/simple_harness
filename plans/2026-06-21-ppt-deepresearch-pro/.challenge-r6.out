### WI-1 Â· DeepResearch è°ƒç ”å°è£…ï¼ˆF1ï¼?**æ–‡ä»¶** `backend/deskpet/tools/ppt_tools.py`ï¼ˆæ–°å¢žå‡½æ•°ï¼Œé è¿‘æ–‡ä»¶å¤´å·¥å…·åŒºï¼?æ–°å¢žï¼?```python
async def _research_topic_for_ppt(topic: str, *, depth: str, timeout_s: float) -> "ResearchReport | None":
    """ä¸?PPT è°ƒç ”ä¸»é¢˜ï¼Œè¿”å›?ResearchReportï¼ˆreport_md/citations/coverageï¼‰ã€‚å¤±è´¥è¿”å›?Noneï¼ˆä¸é˜»æ–­ï¼Œé™çº§ä¸ºæ— è°ƒç ”ç›´æŽ¥æ‹Ÿçº²ï¼‰ã€?""
    from deskpet.tools.research_tools import deepresearch, _resolve_default_llm_call, _DEPTH_PRESETS
    try:
        llm = await _resolve_default_llm_call()
    except Exception as e:
        log.warning("ppt_pro research: no llm_call (%s) â†?skip research", e)
        return None
    sub_q, urls, passages, rounds = _DEPTH_PRESETS.get(depth, _DEPTH_PRESETS["standard"])
    try:
        return await asyncio.wait_for(
            deepresearch(
                topic, llm_call=llm,
                max_sub_questions=sub_q, max_urls_per_query=urls,
                max_total_passages=passages, max_rounds=rounds, mode=depth,
                user_request=f"ä¸ºåˆ¶ä½?PPT è°ƒç ”ä¸»é¢˜ï¼š{topic}",
            ),
            timeout=timeout_s,
        )
    except asyncio.TimeoutError:
        log.warning("ppt_pro research timeout â†?degrade to no-research outline")
        return None
    except Exception as e:
        # MINOR-3ï¼šä¸è¦?except Exception ä¸€æŠŠåžã€‚åŒºåˆ†ã€Œç½‘ç»?æœç´¢çž¬æ—¶å¤±è´¥ã€?é™çº§ None)
        # ä¸Žã€Œé…ç½?è®¤è¯é”™è¯¯ã€?åº”è®©ç”¨æˆ·çŸ¥é“,å¦åˆ™é™é»˜é€€åŒ–æˆå‡­ç©ºç¼?è¿èƒŒ F1)ã€?        if _is_config_or_auth_error(e):
            raise                       # ä¸ŠæŠ› â†?ç¼–æŽ’ task æŽ¨ã€Œè°ƒç ”æœåŠ¡æ²¡é…å¥½â€¦ã€ç»™ç”¨æˆ·
        log.warning("ppt_pro research failed: %s â†?degrade to no-research outline", e)
        return None
```
