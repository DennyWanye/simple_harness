+class OpenAICompatibleProvider(OpenAIAdapter):
+    """Compatibility export for OpenAI-compatible endpoints.
+
+    The legacy provider shape accepts positional ``base_url``, ``api_key``,
+    and ``model``. It reuses ``OpenAIAdapter`` so the empty-key guard lives
+    at the same request chokepoint.
+    """
+
+    def __init__(
+        self,
+        base_url: str,
+        api_key: str,
+        model: str,
+        temperature: float = 0.7,
+        timeout: float | None = None,
+        **kwargs: Any,
+    ) -> None:
+        super().__init__(
+            api_key=api_key,
+            default_model=model,
+            timeout=timeout if timeout is not None else 60.0,
+            base_url=base_url,
+            is_relay=bool(kwargs.get("is_relay", False)),
+        )
+        self.temperature = temperature
