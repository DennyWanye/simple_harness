@@ -0,0 +1,772 @@
+# SPDX-FileCopyrightText: 2026 DennyWanye
+# SPDX-License-Identifier: Apache-2.0
+
+"""NanoJev decision events: additive, replayable, and separate from H1 (plan §21–§26).
+
+Three properties are pinned here, and all three are about *not* corrupting what
+already exists:
+
+1. **Additive.**  A decision event is a new ``type`` string on the *existing*
+   event table (``Store.append_event``), with a stable JSON payload.  No schema,
+   no migration, no change to any H1 event, and the closed ``EventKind`` enum is
+   untouched.
+2. **Replay never duplicates.**  Re-appending the same ``(event type, identity)``
+   returns the stored row instead of a second one — the store's own
+   ``idempotency_key`` behaviour, not a new journal notion.
+3. **Conflicting identity fails closed.**  The same identity with different
+   content is a hard error; it is never a silent overwrite and never a second row.
+
+``decision_id`` is also pinned to a namespace distinct from H1's ``pd-``
+planning-decision ids (plan §26 / workplan phase 4 hard constraint).
+
+No model, checkpoint or runtime is involved.  ``DecisionService`` is wired with
+fakes and a real on-disk ``Store`` so the sink is exercised for real.
+"""
+
+from __future__ import annotations
+
+import json
+
+import pytest
+
+from agent_orchestrator.contracts import Budget, Mission, MissionStatus
+from agent_orchestrator.contracts.planning_decisions import compute_decision_id
+from agent_orchestrator.decision import (
+    DecisionCandidate,
+    DecisionEventConflict,
+    DecisionEventJournal,
+    DecisionEventType,
+    DecisionMode,
+    DecisionOutcomeObserved,
+    DecisionPolicy,
+    DecisionProduced,
+    DecisionProducer,
+    DecisionProvider,
+    DecisionRequest,
+    DecisionRequested,
+    DecisionResult,
+    DecisionScore,
+    DecisionService,
+    DecisionStatus,
+    DecisionType,
+    ShadowDecisionFailed,
+    ShadowDecisionProduced,
+)
+from agent_orchestrator.storage.store import Store
+
+MISSION = "m-nanojev-1"
+
+
+# --------------------------------------------------------------------------- fakes
+
+
+class _StaticProvider(DecisionProvider):
+    """A provider that answers with a fixed distribution."""
+
+    def __init__(
+        self,
+        *,
+        provider: str = "existing",
+        selected: str = "a",
+        probabilities: dict[str, float] | None = None,
+        model_version: str | None = None,
+        latency_ms: float = 1.0,
+    ) -> None:
+        self._provider = provider
+        self._selected = selected
+        self._probabilities = probabilities or {"a": 1.0}
+        self._model_version = model_version
+        self._latency_ms = latency_ms
+        self.calls = 0
+
+    async def decide(self, request: DecisionRequest) -> DecisionResult:
+        self.calls += 1
+        ordered = sorted(self._probabilities.values(), reverse=True)
+        return DecisionResult(
+            decision_id=request.decision_id,
+            provider=self._provider,
+            selected=self._selected,
+            scores=tuple(
+                DecisionScore(candidate_id, probability)
+                for candidate_id, probability in self._probabilities.items()
+            ),
+            top1_probability=ordered[0],
+            margin=1.0 if len(ordered) == 1 else ordered[0] - ordered[1],
+            latency_ms=self._latency_ms,
+            model_version=self._model_version,
+        )
+
+
+class _BoomProvider(DecisionProvider):
+    """A provider that fails the way a missing model or an OOM would."""
+
+    async def decide(self, request: DecisionRequest) -> DecisionResult:
+        raise RuntimeError("model checkpoint missing")
+
+
+def _candidates() -> tuple[DecisionCandidate, ...]:
+    return (
+        DecisionCandidate("a", "A", {"rank": 1}),
+        DecisionCandidate("b", "B", {"rank": 2}),
+    )
+
+
+def _request(decision_id: str = "nj-1") -> DecisionRequest:
+    return DecisionRequest(
+        decision_id=decision_id,
+        decision_type=DecisionType.READY_TASK_PRIORITY,
+        mission_id=MISSION,
+        task_id="t-1",
+        candidates=_candidates(),
+        context={"reason": "frontier"},
+    )
+
+
+def _mission(mission_id: str = MISSION) -> Mission:
+    return Mission(
+        id=mission_id,
+        goal="g",
+        success_criteria=("ok",),
+        stop_conditions=(),
+        allowed_tools=(),
+        risk_level="sandbox",
+        budget=Budget(max_tokens=1000, max_attempts=2),
+        tenant_id="t",
+        status=MissionStatus.CREATED,
+        created_at=1.0,
+        version=1,
+        idempotency_key=mission_id,
+    )
+
+
+@pytest.fixture
+def store(tmp_path) -> Store:
+    opened = Store.open(tmp_path / "orchestrator.db")
+    opened.insert_mission(_mission(), spec_hash="h")
+    return opened
+
+
+@pytest.fixture
+def journal(store: Store) -> DecisionEventJournal:
+    return DecisionEventJournal(store)
+
+
+def _events(store: Store, event_type: str | None = None) -> list:
+    return [event for event in store.list_events(MISSION) if event.type == event_type]
+
+
+def _payloads(store: Store, event_type: str) -> list[dict]:
+    return [json.loads(json.dumps(dict(event.payload))) for event in _events(store, event_type)]
+
+
+# ----------------------------------------------------------------- 1. event types
+
+
+def test_event_types_are_stable_strings() -> None:
+    """§21: the wire names are fixed, so a log written today stays readable."""
+    assert DecisionEventType.REQUESTED == "DecisionRequested"
+    assert DecisionEventType.PRODUCED == "DecisionProduced"
+    assert DecisionEventType.SHADOW_PRODUCED == "ShadowDecisionProduced"
+    assert DecisionEventType.SHADOW_FAILED == "ShadowDecisionFailed"
+    assert DecisionEventType.OUTCOME_OBSERVED == "DecisionOutcomeObserved"
+
+
+def test_event_type_set_is_exactly_the_declared_slice() -> None:
+    """Only the declared events may be emitted; nothing else is reachable."""
+    assert {member.value for member in DecisionEventType} == {
+        "DecisionRequested",
+        "DecisionProduced",
+        "ShadowDecisionProduced",
+        "ShadowDecisionFailed",
+        "DecisionOutcomeObserved",
+    }
+
+
+# ------------------------------------------------------------- 2. additive sink
+
+
+def test_requested_event_is_appended_to_existing_event_table(
+    store: Store, journal: DecisionEventJournal
+) -> None:
+    """Additive: a decision event is one more row in the table H1 already uses."""
+    journal.append(
+        DecisionRequested(
+            decision_id="nj-1",
+            decision_type=DecisionType.READY_TASK_PRIORITY,
+            mission_id=MISSION,
+            task_id="t-1",
+            candidates=("a", "b"),
+            context_hash="ctx-hash",
+            context_version=1,
+        )
+    )
+
+    stored = _events(store, "DecisionRequested")
+    assert len(stored) == 1
+    assert stored[0].mission_id == MISSION
+    assert stored[0].task_id == "t-1"
+
+
+def test_requested_payload_carries_the_plan_fields(
+    store: Store, journal: DecisionEventJournal
+) -> None:
+    """§22: identity, type, candidates, and a context hash — never the prompt."""
+    journal.append(
+        DecisionRequested(
+            decision_id="nj-1",
+            decision_type=DecisionType.READY_TASK_PRIORITY,
+            mission_id=MISSION,
+            task_id="t-1",
+            candidates=("a", "b"),
+            context_hash="ctx-hash",
+            context_version=2,
+        )
+    )
+
+    payload = _payloads(store, "DecisionRequested")[0]
+    assert payload["decision_id"] == "nj-1"
+    assert payload["decision_type"] == "ready_task_priority"
+    assert payload["mission_id"] == MISSION
+    assert payload["task_id"] == "t-1"
+    assert payload["candidates"] == ["a", "b"]
+    assert payload["context_hash"] == "ctx-hash"
+    assert payload["context_version"] == 2
+    assert "prompt" not in payload
+
+
+def test_decision_produced_payload_carries_scores_and_diagnostics(
+    store: Store, journal: DecisionEventJournal
+) -> None:
+    """§23: provider, selection, scores, top1, margin, latency."""
+    result = DecisionResult(
+        decision_id="nj-1",
+        provider="existing",
+        selected="a",
+        scores=(DecisionScore("a", 0.75), DecisionScore("b", 0.25)),
+        top1_probability=0.75,
+        margin=0.50,
+        latency_ms=3.5,
+        model_version=None,
+    )
+    journal.append(
+        DecisionProduced(
+            decision_id="nj-1",
+            decision_type=DecisionType.READY_TASK_PRIORITY,
+            mission_id=MISSION,
+            mode="existing",
+            producer=DecisionProducer.PRODUCTION,
+            result=result,
+        )
+    )
+
+    payload = _payloads(store, "DecisionProduced")[0]
+    assert payload["decision_id"] == "nj-1"
+    assert payload["provider"] == "existing"
+    assert payload["selected"] == "a"
+    assert payload["top1_probability"] == 0.75
+    assert payload["margin"] == 0.50
+    assert payload["latency_ms"] == 3.5
+    # the model version is a *stable* field: present and null, never absent
+    assert "model_version" in payload
+    assert payload["model_version"] is None
+    assert payload["scores"] == {"a": 0.75, "b": 0.25}
+
+
+def test_shadow_produced_payload_carries_agreement(
+    store: Store, journal: DecisionEventJournal
+) -> None:
+    """§24: the shadow event is what makes agreement_rate computable."""
+    result = DecisionResult(
+        decision_id="nj-1",
+        provider="nanojev",
+        selected="b",
+        scores=(DecisionScore("a", 0.30), DecisionScore("b", 0.70)),
+        top1_probability=0.70,
+        margin=0.40,
+        latency_ms=9.0,
+        model_version="nanojev-0.1",
+    )
+    journal.append(
+        ShadowDecisionProduced(
+            decision_id="nj-1",
+            decision_type=DecisionType.READY_TASK_PRIORITY,
+            mission_id=MISSION,
+            mode="shadow",
+            result=result,
+            production_selected="a",
+        )
+    )
+
+    payload = _payloads(store, "ShadowDecisionProduced")[0]
+    assert payload["decision_id"] == "nj-1"
+    assert payload["provider"] == "nanojev"
+    assert payload["selected"] == "b"
+    assert payload["production_selected"] == "a"
+    assert payload["agreement"] is False
+    assert payload["model_version"] == "nanojev-0.1"
+
+
+def test_shadow_agreement_is_true_when_selections_match(
+    store: Store, journal: DecisionEventJournal
+) -> None:
+    result = DecisionResult(
+        decision_id="nj-1",
+        provider="nanojev",
+        selected="a",
+        scores=(DecisionScore("a", 0.9), DecisionScore("b", 0.1)),
+        top1_probability=0.9,
+        margin=0.8,
+        latency_ms=4.0,
+    )
+    journal.append(
+        ShadowDecisionProduced(
+            decision_id="nj-1",
+            decision_type=DecisionType.READY_TASK_PRIORITY,
+            mission_id=MISSION,
+            mode="shadow",
+            result=result,
+            production_selected="a",
+        )
+    )
+
+    assert _payloads(store, "ShadowDecisionProduced")[0]["agreement"] is True
+
+
+def test_shadow_failed_payload_carries_error_without_a_result(
+    store: Store, journal: DecisionEventJournal
+) -> None:
+    """§19: a shadow failure is an observation with a reason, not a crash."""
+    journal.append(
+        ShadowDecisionFailed(
+            decision_id="nj-1",
+            decision_type=DecisionType.READY_TASK_PRIORITY,
+            mission_id=MISSION,
+            mode="shadow",
+            error="RuntimeError: model checkpoint missing",
+            status=DecisionStatus.FAILED,
+            latency_ms=12.0,
+        )
+    )
+
+    payload = _payloads(store, "ShadowDecisionFailed")[0]
+    assert payload["decision_id"] == "nj-1"
+    assert payload["status"] == "failed"
+    assert payload["error"] == "RuntimeError: model checkpoint missing"
+    assert payload["latency_ms"] == 12.0
+    assert payload["provider"] is None
+
+
+def test_outcome_observed_payload_carries_the_link_back(
+    store: Store, journal: DecisionEventJournal
+) -> None:
+    """§25: outcome is what separates "agreed" from "correct"."""
+    journal.append(
+        DecisionOutcomeObserved(
+            decision_id="nj-1",
+            mission_id=MISSION,
+            selected_task_id="t-1",
+            task_success=True,
+            verifier_pass=False,
+            retry_count=1,
+            execution_latency_ms=44.5,
+        )
+    )
+
+    payload = _payloads(store, "DecisionOutcomeObserved")[0]
+    assert payload["decision_id"] == "nj-1"
+    assert payload["selected_task_id"] == "t-1"
+    assert payload["task_success"] is True
+    assert payload["verifier_pass"] is False
+    assert payload["retry_count"] == 1
+    assert payload["execution_latency_ms"] == 44.5
+
+
+# ----------------------------------------------------------------- 3. replay
+
+
+def test_replaying_the_same_event_does_not_duplicate(
+    store: Store, journal: DecisionEventJournal
+) -> None:
+    """Replay returns the stored row; the log stays one row long."""
+    event = DecisionRequested(
+        decision_id="nj-1",
+        decision_type=DecisionType.READY_TASK_PRIORITY,
+        mission_id=MISSION,
+        task_id="t-1",
+        candidates=("a", "b"),
+        context_hash="ctx-hash",
+        context_version=1,
+    )
+
+    first = journal.append(event)
+    second = journal.append(event)
+
+    assert len(_events(store, "DecisionRequested")) == 1
+    assert first.seq == second.seq
+    assert first.id == second.id
+
+
+def test_replaying_the_same_event_twice_through_a_fresh_journal_is_still_idempotent(
+    store: Store,
+) -> None:
+    """Idempotency is the store's, not the journal instance's."""
+    event = DecisionProduced(
+        decision_id="nj-1",
+        decision_type=DecisionType.READY_TASK_PRIORITY,
+        mission_id=MISSION,
+        mode="existing",
+        producer=DecisionProducer.PRODUCTION,
+        result=DecisionResult(
+            decision_id="nj-1",
+            provider="existing",
+            selected="a",
+            scores=(DecisionScore("a", 1.0),),
+            top1_probability=1.0,
+            margin=1.0,
+            latency_ms=0.5,
+        ),
+    )
+
+    DecisionEventJournal(store).append(event)
+    DecisionEventJournal(store).append(event)
+
+    assert len(_events(store, "DecisionProduced")) == 1
+
+
+def test_replay_of_a_request_and_its_decision_keeps_both_rows_single(
+    store: Store, journal: DecisionEventJournal
+) -> None:
+    """The whole chain replayed twice is still one chain."""
+    requested = DecisionRequested(
+        decision_id="nj-1",
+        decision_type=DecisionType.READY_TASK_PRIORITY,
+        mission_id=MISSION,
+        task_id="t-1",
+        candidates=("a", "b"),
+        context_hash="ctx-hash",
+        context_version=1,
+    )
+    produced = DecisionProduced(
+        decision_id="nj-1",
+        decision_type=DecisionType.READY_TASK_PRIORITY,
+        mission_id=MISSION,
+        mode="existing",
+        producer=DecisionProducer.PRODUCTION,
+        result=DecisionResult(
+            decision_id="nj-1",
+            provider="existing",
+            selected="a",
+            scores=(DecisionScore("a", 1.0),),
+            top1_probability=1.0,
+            margin=1.0,
+            latency_ms=0.5,
+        ),
+    )
+
+    for _ in range(2):
+        journal.append(requested)
+        journal.append(produced)
+
+    assert len(_events(store, "DecisionRequested")) == 1
+    assert len(_events(store, "DecisionProduced")) == 1
+
+
+def test_different_decision_ids_are_separate_events(
+    store: Store, journal: DecisionEventJournal
+) -> None:
+    """Distinct identity is distinct, so a second decision is not swallowed."""
+    for decision_id in ("nj-1", "nj-2"):
+        journal.append(
+            DecisionRequested(
+                decision_id=decision_id,
+                decision_type=DecisionType.READY_TASK_PRIORITY,
+                mission_id=MISSION,
+                task_id="t-1",
+                candidates=("a", "b"),
+                context_hash="ctx-hash",
+                context_version=1,
+            )
+        )
+
+    assert len(_events(store, "DecisionRequested")) == 2
+
+
+# ------------------------------------------------------- 4. fail-closed conflict
+
+
+def test_same_identity_with_different_payload_is_fail_closed(
+    store: Store, journal: DecisionEventJournal
+) -> None:
+    """A second DecisionProduced for the same decision_id must not overwrite."""
+    journal.append(
+        DecisionProduced(
+            decision_id="nj-1",
+            decision_type=DecisionType.READY_TASK_PRIORITY,
+            mission_id=MISSION,
+            mode="existing",
+            producer=DecisionProducer.PRODUCTION,
+            result=DecisionResult(
+                decision_id="nj-1",
+                provider="existing",
+                selected="a",
+                scores=(DecisionScore("a", 1.0),),
+                top1_probability=1.0,
+                margin=1.0,
+                latency_ms=0.5,
+            ),
+        )
+    )
+
+    with pytest.raises(DecisionEventConflict):
+        journal.append(
+            DecisionProduced(
+                decision_id="nj-1",
+                decision_type=DecisionType.READY_TASK_PRIORITY,
+                mission_id=MISSION,
+                mode="existing",
+                producer=DecisionProducer.PRODUCTION,
+                result=DecisionResult(
+                    decision_id="nj-1",
+                    provider="existing",
+                    selected="b",
+                    scores=(DecisionScore("b", 1.0),),
+                    top1_probability=1.0,
+                    margin=1.0,
+                    latency_ms=0.6,
+                ),
+            )
+        )
+
+    # the refused call left the row exactly as it was
+    stored = _payloads(store, "DecisionProduced")
+    assert len(stored) == 1
+    assert stored[0]["selected"] == "a"
+
+
+def test_conflict_leaves_no_partial_row(store: Store, journal: DecisionEventJournal) -> None:
+    """Fail-closed means the count does not move, not just that it raised."""
+    journal.append(
+        DecisionRequested(
+            decision_id="nj-1",
+            decision_type=DecisionType.READY_TASK_PRIORITY,
+            mission_id=MISSION,
+            task_id="t-1",
+            candidates=("a", "b"),
+            context_hash="ctx-hash",
+            context_version=1,
+        )
+    )
+
+    with pytest.raises(DecisionEventConflict):
+        journal.append(
+            DecisionRequested(
+                decision_id="nj-1",
+                decision_type=DecisionType.READY_TASK_PRIORITY,
+                mission_id=MISSION,
+                task_id="t-1",
+                candidates=("a", "b", "c"),
+                context_hash="ctx-hash",
+                context_version=1,
+            )
+        )
+
+    assert len(_events(store, "DecisionRequested")) == 1
+
+
+# ------------------------------------------- 5. separation from H1 decision ids
+
+
+def test_nanojev_decision_id_cannot_be_an_h1_planning_decision_id() -> None:
+    """§26 / workplan: the two id namespaces must not be confusable."""
+    h1_id = compute_decision_id("req-1", 0, "a" * 64)
+    assert h1_id.startswith("pd-")
+    assert DecisionEventJournal.is_accepting_decision_id(h1_id) is False
+    assert DecisionEventJournal.is_accepting_decision_id("nj-1") is True
+
+
+def test_h1_decision_id_is_refused_by_the_nanojev_sink(
+    store: Store, journal: DecisionEventJournal
+) -> None:
+    """An H1 id in a NanoJev event is refused rather than silently stored."""
+    h1_id = compute_decision_id("req-1", 0, "a" * 64)
+
+    with pytest.raises(ValueError):
+        journal.append(
+            DecisionRequested(
+                decision_id=h1_id,
+                decision_type=DecisionType.READY_TASK_PRIORITY,
+                mission_id=MISSION,
+                task_id="t-1",
+                candidates=("a", "b"),
+                context_hash="ctx-hash",
+                context_version=1,
+            )
+        )
+
+    assert _events(store, "DecisionRequested") == []
+
+
+def test_nanojev_event_ordering_is_append_only_within_a_mission(
+    store: Store, journal: DecisionEventJournal
+) -> None:
+    """Events land in order and the store's own seq keeps them that way."""
+    requested = journal.append(
+        DecisionRequested(
+            decision_id="nj-1",
+            decision_type=DecisionType.READY_TASK_PRIORITY,
+            mission_id=MISSION,
+            task_id="t-1",
+            candidates=("a", "b"),
+            context_hash="ctx-hash",
+            context_version=1,
+        )
+    )
+    produced = journal.append(
+        DecisionProduced(
+            decision_id="nj-1",
+            decision_type=DecisionType.READY_TASK_PRIORITY,
+            mission_id=MISSION,
+            mode="existing",
+            producer=DecisionProducer.PRODUCTION,
+            result=DecisionResult(
+                decision_id="nj-1",
+                provider="existing",
+                selected="a",
+                scores=(DecisionScore("a", 1.0),),
+                top1_probability=1.0,
+                margin=1.0,
+                latency_ms=0.5,
+            ),
+        )
+    )
+
+    assert requested.seq is not None
+    assert produced.seq is not None
+    assert produced.seq > requested.seq
+
+
+# ------------------------------------------------ 6. service wiring (additive)
+
+
+@pytest.mark.asyncio
+async def test_existing_mode_appends_requested_and_produced(store: Store) -> None:
+    """The production chain emits the two events the plan names for it."""
+    journal = DecisionEventJournal(store)
+    service = DecisionService(
+        _StaticProvider(selected="a", probabilities={"a": 1.0, "b": 0.0}),
+        event_journal=journal,
+    )
+
+    result = await service.decide(_request())
+
+    assert result.selected == "a"
+    assert len(_events(store, "DecisionRequested")) == 1
+    assert len(_events(store, "DecisionProduced")) == 1
+
+
+@pytest.mark.asyncio
+async def test_service_without_a_journal_is_unchanged(store: Store) -> None:
+    """Additive: no journal means no events and the same production result."""
+    service = DecisionService(_StaticProvider(selected="a", probabilities={"a": 1.0, "b": 0.0}))
+
+    result = await service.decide(_request())
+
+    assert result.selected == "a"
+    assert store.count_events(MISSION, "DecisionRequested") == 0
+
+
+@pytest.mark.asyncio
+async def test_shadow_success_emits_shadow_produced_and_not_failed(store: Store) -> None:
+    """§19/§24: one shadow outcome, never both events."""
+    journal = DecisionEventJournal(store)
+    service = DecisionService(
+        _StaticProvider(selected="a", probabilities={"a": 1.0, "b": 0.0}),
+        policy=DecisionPolicy(mode=DecisionMode.SHADOW),
+        shadow_provider=_StaticProvider(
+            provider="nanojev",
+            selected="b",
+            probabilities={"a": 0.3, "b": 0.7},
+            model_version="nanojev-0.1",
+        ),
+        event_journal=journal,
+    )
+
+    result = await service.decide(_request())
+    await service.close()
+
+    assert result.selected == "a"  # production truth is unchanged
+    assert len(_events(store, "ShadowDecisionProduced")) == 1
+    assert _events(store, "ShadowDecisionFailed") == []
+    payload = _payloads(store, "ShadowDecisionProduced")[0]
+    assert payload["production_selected"] == "a"
+    assert payload["selected"] == "b"
+    assert payload["agreement"] is False
+
+
+@pytest.mark.asyncio
+async def test_shadow_failure_emits_failed_and_never_escapes(store: Store) -> None:
+    """§19: a model problem is an event, never a production failure."""
+
+    journal = DecisionEventJournal(store)
+    service = DecisionService(
+        _StaticProvider(selected="a", probabilities={"a": 1.0, "b": 0.0}),
+        policy=DecisionPolicy(mode=DecisionMode.SHADOW),
+        shadow_provider=_BoomProvider(),
+        event_journal=journal,
+    )
+
+    result = await service.decide(_request())
+    await service.close()
+
+    assert result.selected == "a"
+    failed = _payloads(store, "ShadowDecisionFailed")
+    assert len(failed) == 1
+    assert failed[0]["status"] == "failed"
+    assert "model checkpoint missing" in failed[0]["error"]
+    assert _events(store, "ShadowDecisionProduced") == []
+
+
+@pytest.mark.asyncio
+async def test_single_candidate_does_not_call_the_shadow_provider(store: Store) -> None:
+    """0/1 candidates stay deterministic — no model call, so no shadow event."""
+
+    journal = DecisionEventJournal(store)
+    shadow = _StaticProvider(provider="nanojev", selected="a")
+    service = DecisionService(
+        _StaticProvider(selected="a", probabilities={"a": 1.0}),
+        policy=DecisionPolicy(mode=DecisionMode.SHADOW),
+        shadow_provider=shadow,
+        event_journal=journal,
+    )
+
+    request = DecisionRequest(
+        decision_id="nj-single",
+        decision_type=DecisionType.READY_TASK_PRIORITY,
+        mission_id=MISSION,
+        task_id="t-1",
+        candidates=(DecisionCandidate("a", "A", {}),),
+        context={},
+    )
+    await service.decide(request)
+    await service.close()
+
+    assert shadow.calls == 0
+    assert _events(store, "ShadowDecisionProduced") == []
+
+
+@pytest.mark.asyncio
+async def test_replaying_the_same_request_through_the_service_emits_one_chain(
+    store: Store,
+) -> None:
+    """Replay at the service boundary is also idempotent."""
+    journal = DecisionEventJournal(store)
+    service = DecisionService(
+        _StaticProvider(selected="a", probabilities={"a": 1.0, "b": 0.0}),
+        event_journal=journal,
+    )
+
+    await service.decide(_request())
+    await service.decide(_request())
+
+    assert len(_events(store, "DecisionRequested")) == 1
+    assert len(_events(store, "DecisionProduced")) == 1
