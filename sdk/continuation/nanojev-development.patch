+def test_decision_id_is_stable_across_a_second_call_and_carries_field_separators():
+    """The separator is load-bearing: without it, two identities glue into one.
+
+    ``("m", "t")`` and ``("mt", None)`` must not hash the same material, and
+    neither may a context key glue onto the field before it.  A changed separator
+    is therefore a changed id, which is what keeps a replay from colliding with a
+    genuinely different observation.
+    """
+
+    glued = seam.compute_ready_task_decision_id(
+        mission_id="m", task_id="t", ordinal=0, candidate_ids=("a",), context={}
+    )
