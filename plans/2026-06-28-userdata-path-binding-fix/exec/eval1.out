    #[test]
    fn user_data_dir_falls_back_to_legacy_env() {
        // 鍙鏃?DESKPET_USER_DATA 鏃朵粛鍏煎(涓嶇牬鍧忚€佺敤鎴?銆?        let env = env_map(&[("DESKPET_USER_DATA", "E:/old/deskpet")]);
