   2: # SPDX-License-Identifier: BUSL-1.1
   3: 
   4: """Model / asset / user-data directory resolution.
   5: 
   6: P3-S1 birthed :func:`model_root` and :func:`resolve_model_dir`.
   7: P3-S6 + P3-S7 extend this module to cover the full "where does each kind
   8: of path live" question, because model storage and user data both moved
   9: out of the repo tree when we started shipping a frozen bundle.
  10: 
  11: P4-S22+ adds **portable mode**: when an ``<install_dir>/userdata/``
  12: folder exists alongside the frozen exe, ALL user-mutable state
  13: (config, SQLite, logs, models, skills, plugins) lives under it
  14: instead of `%AppData%`. This:
  15:   * keeps the C: drive clean (everything next to the install)
  16:   * survives MSI uninstall (Windows Installer only deletes files it
  17:     explicitly listed at install time; an empty userdata/ folder
  18:     sentinel created post-install is preserved)
  19:   * makes "move my install + data to another drive" a directory copy
  20: 
  21: Detection: the bundle ships an empty ``<install_dir>/userdata/.deskpet-portable``
  22: sentinel. If that sentinel exists, we're portable; if not, classic
  23: AppData layout.
  24: 
  25: Three orthogonal questions this module answers:
  26: 
  27: 1. **Where are model checkpoints?** (:func:`model_root` / :func:`resolve_model_dir`)
  28: 2. **Where does the user's mutable state live?** (:func:`user_data_dir`)
  29: 3. **Where do big, regenerable files live?** (:func:`user_cache_dir` /
  30:    :func:`user_models_dir`)
  31: 
  32: The ``DESKPET_*`` env vars exist so CI, E2E scripts, and dev workflows
  33: can pin paths explicitly without touching the filesystem defaults.
  34: """
  35: from __future__ import annotations
  36: 
  37: import logging
  38: import os
  39: import sys
  40: from pathlib import Path
  41: 
  42: import platformdirs
  43: 
  44: # Constants used by platformdirs. `appauthor=False` means "don't insert
  45: # an AppAuthor\AppName folder stack on Windows" 鈥?we own the top-level
  46: # name "deskpet" directly, giving clean paths like `AppData\Roaming\deskpet\`
  47: # instead of `AppData\Roaming\deskpet\deskpet\`.
  48: _APP_NAME = "deskpet"
  49: _APP_AUTHOR: str | bool = False
  50: logger = logging.getLogger(__name__)
  51: 
  52: def _install_dir() -> Path | None:
  53:     """Return the directory containing the frozen exe, or None in dev mode."""
  54:     if getattr(sys, "frozen", False):
  55:         return Path(sys.executable).resolve().parent
  56:     return None
  57: 
  58: 
  59: def _portable_userdata_dir() -> Path | None:
  60:     """Return ``<install_root>/userdata/`` when running from a frozen install.
  61: 
  62:     Layout we expect (Tauri MSI ships this)::
  63: 
  64:         <install_root>/                  (e.g. G:\\tools\\deskpet\\)
  65:             deskpet.exe                  (Tauri main exe)
  66:             backend/
  67:                 deskpet-backend.exe      鈫?sys.executable when frozen
  68:                 _internal/
  69:             userdata/
  70:                 config.toml
  71:                 data/state.db
  72:                 models/
  73:                 logs/
  74:                 skills/
  75: 
  76:     The backend exe's ``Path.parent`` is `<install>/backend/`; we walk
  77:     upward to find a sibling ``userdata/`` directory (or its parent
  78:     that *should* contain one). We don't gate on a sentinel file 鈥?    DeskPet has no legacy users to preserve `%AppData%` state for, so
  79:     "frozen 鈬?portable" is the simpler invariant.
  80: 
  81:     The MSI installer's component manifest does NOT list any files
  82:     under ``userdata/``, so MSI uninstall leaves the entire userdata
  83:     tree (state.db, config.toml, models/, skills/) untouched. That's
  84:     how "uninstall doesn't lose my chat history" works.
  85:     """
  86:     base = _install_dir()
  87:     if base is None:
  88:         return None
  89:     # Pick the "install root" deterministically based on the exe's
  90:     # parent dir name:
  91:     #   exe parent named "backend" 鈫?Tauri layout, root is 1 level up
  92:     #   anything else              鈫?standalone, exe parent IS the root
  93:     # Defensive: if the chosen root isn't writable (e.g. Program Files
  94:     # without admin), walk one more level up before giving up.
  95:     if base.name.lower() == "backend":
  96:         candidates_up = (1, 2, 0)
  97:     else:
  98:         candidates_up = (0, 1, 2)
  99:     for steps_up in candidates_up:
 100:         anchor = base
 101:         for _ in range(steps_up):
 102:             anchor = anchor.parent
 103:         candidate = anchor / "userdata"
 104:         try:
 105:             candidate.mkdir(parents=True, exist_ok=True)
 106:         except OSError:
 107:             continue
 108:         # Prove the dir is writable: probe-write then delete.
 109:         probe = candidate / ".deskpet-write-probe"
 110:         try:
 111:             probe.write_bytes(b"")
 112:             probe.unlink()
 113:         except OSError:
 114:             continue
 115:         return candidate
 116:     return None
 117: 
 118: 
 119: def is_portable_mode() -> bool:
 120:     """True when running from a frozen install with a writable userdata dir."""
 121:     return _portable_userdata_dir() is not None
 122: 
 123: 
 124: def _install_root_for_deepresearch() -> Path | None:
 125:     """Return writable ``<install_root>/DeepResearch`` for frozen installs."""
 126:     base = _install_dir()
 127:     if base is None:
 128:         return None
 129:     root = base.parent if base.name.lower() == "backend" else base
 130:     target = root / "DeepResearch"
 131:     try:
 132:         target.mkdir(parents=True, exist_ok=True)
 133:         probe = target / f".deskpet-dr-write-probe-{os.getpid()}"
 134:         probe.write_bytes(b"")
 135:         probe.unlink()
 136:     except OSError:
 137:         return None
 138:     return target
 139: 
 140: 
 141: def deepresearch_dir() -> Path:
 142:     """Runtime DeepResearch report directory.
 143: 
 144:     Resolution order:
 145:       1. ``DESKPET_DEEPRESEARCH_DIR`` env override.
 146:       2. Frozen install root ``<install_root>/DeepResearch`` when writable.
 147:       3. Dev repo root ``DeepResearch/``.
 148:       4. ``~/DeskPet/DeepResearch`` fallback.
 149: 
 150:     This path deliberately never falls back to :func:`user_data_dir` /
 151:     AppData, so research artifacts stay in a visible report directory.
 152:     """
 153:     override = os.environ.get("DESKPET_DEEPRESEARCH_DIR")
 154:     if override:
 155:         target = Path(override)
 156:         target.mkdir(parents=True, exist_ok=True)
 157:         return target
 158: 
 159:     frozen_target = _install_root_for_deepresearch()
 160:     if frozen_target is not None:
 161:         frozen_target.mkdir(parents=True, exist_ok=True)
 162:         return frozen_target
 163: 
 164:     if not getattr(sys, "frozen", False):
 165:         target = Path(__file__).resolve().parents[1] / "DeepResearch"
 166:         target.mkdir(parents=True, exist_ok=True)
 167:         return target
 168: 
 169:     target = Path.home() / "DeskPet" / "DeepResearch"
 170:     target.mkdir(parents=True, exist_ok=True)
 171:     logger.warning(
 172:         "DeepResearch install directory is not writable; falling back to %s",
 173:         target,
 174:     )
 175:     return target
 176: 
 177: 
 178: def user_data_dir() -> Path:
 179:     """Roaming user data directory (config, DBs, logs).
 180: 
 181:     Resolution order:
 182:       1. ``DESKPET_USER_DATA_DIR`` env override (tests, power users).
 183:       2. **Portable mode** 鈥?``<install_dir>/userdata/`` (if sentinel
 184:          present). All state lives next to the install, not under C:.
 185:       3. **Dev-from-source** 鈥?``DESKPET_DEV_MODE=1`` and not frozen 鈫?         repo-local ``backend/userdata/`` (same target as
 186:          ``scripts/dev-start.ps1``). Guardrail so ad-hoc dev launches that
 187:          forget to set ``DESKPET_USER_DATA_DIR`` still keep state on the
 188:          repo's disk instead of polluting ``%AppData%`` on C:.
 189:       4. Classic 鈥?Windows ``%AppData%\\deskpet\\``, macOS/Linux XDG.
 190:     """
 191:     override = os.environ.get("DESKPET_USER_DATA_DIR")
 192:     if override:
 193:         return Path(override)
 194:     portable = _portable_userdata_dir()
 195:     if portable is not None:
 196:         return portable
 197:     if os.environ.get("DESKPET_DEV_MODE") == "1" and not getattr(sys, "frozen", False):
 198:         # backend/userdata 鈥?paths.py lives in backend/, so .parent is it.
 199:         return Path(__file__).resolve().parent / "userdata"
 200:     return Path(platformdirs.user_data_dir(_APP_NAME, appauthor=_APP_AUTHOR, roaming=True))
 201: 
 202: 
