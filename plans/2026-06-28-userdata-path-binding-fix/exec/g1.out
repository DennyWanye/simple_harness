 272: def model_root() -> Path:
 273:     """Return the root directory containing all bundled model subfolders.
 274: 
 275:     Priority (first hit wins):
 276: 
 277:     1. ``DESKPET_MODEL_ROOT`` env 鈥?explicit override (CI/E2E/debug).
 278:     2. :func:`user_models_dir` if it exists on disk 鈥?production path
 279:        post-P3-S6. This is where the installer / setup script drops
 280:        real model weights.
 281:     3. ``sys._MEIPASS/models`` 鈥?PyInstaller bundle. Normally empty
 282:        after P3-S6 (too big to fit under P3-G2's 3.5 GB cap), but kept
 283:        as a fallback so tiny bundled checkpoints (or dev-only slim
 284:        bundles) still resolve without extra setup.
 285:     4. Dev fallback: ``backend/models/`` beside this file.
 286: 
 287:     Note: step 2 requires the directory to **exist** 鈥?if the user
 288:     hasn't run ``setup_user_data.ps1`` yet we fall through to the
 289:     bundle / dev path rather than returning a phantom empty dir.
 290:     Callers use :func:`resolve_model_dir` to join a subfolder; they
 291:     decide whether a missing subdir is fatal.
 292:     """
 293:     override = os.environ.get("DESKPET_MODEL_ROOT")
 294:     if override:
 295:         return Path(override)
 296:     # P3-S6: check the production (LocalAppData) path first, but only
 297:     # if it has been provisioned. This lets dev mode keep resolving to
 298:     # backend/models/ without forcing devs to populate LocalAppData.
 299:     user_dir = user_models_dir()
 300:     if user_dir.is_dir():
 301:         return user_dir
 302:     meipass = getattr(sys, "_MEIPASS", None)
 303:     if meipass:
 304:         return Path(meipass) / "models"
 305:     # Dev mode: backend/models/ beside this file.
 306:     return Path(__file__).resolve().parent / "models"
 307: 
 308: 
 309: def resolve_model_dir(subdir: str) -> Path:
 310:     """Return absolute path for a named model subfolder, with multi-source fallback.
 311: 
 312:     ``subdir`` examples: ``"faster-whisper-large-v3-turbo"``, ``"cosyvoice2"``,
 313:     ``"silero_vad"``, ``"bge-m3-int8"``.
 314: 
 315:     Priority (first **existing** directory wins so user-installed weights
 316:     override the bundle, and bundled weights override "nothing"):
 317: 
 318:     1. ``DESKPET_MODEL_ROOT/<subdir>`` 鈥?explicit env override (CI/E2E).
 319:     2. ``user_models_dir()/<subdir>`` 鈥?user-installed (let the user swap
 320:        in their own quantization or fine-tune by dropping it here).
 321:     3. ``sys._MEIPASS/models/<subdir>`` 鈥?frozen bundle's bundled weights
 322:        (P4-S20+ install bundle ships BGE-M3 + faster-whisper here).
 323:     4. ``backend/assets/<subdir>`` 鈥?dev-mode equivalent of #3 (this is
 324:        what PyInstaller reads from when freezing).
 325:     5. ``backend/models/<subdir>`` 鈥?legacy dev-mode location (kept for
 326:        back-compat with pre-P4-S20 dev setups).
 327: 
 328:     If none of the above exist, returns the path under
 329:     ``user_models_dir()/<subdir>`` so error messages point users at the
 330:     "right" place to drop missing weights. Callers must handle the
 331:     "directory still doesn't exist" case (e.g. faster-whisper falls back
 332:     to HuggingFace auto-download, BGE-M3 falls back to mock vectors).
 333:     """
 334:     override = os.environ.get("DESKPET_MODEL_ROOT")
 335:     if override:
 336:         return (Path(override) / subdir).resolve()
 337: 
 338:     backend_dir = Path(__file__).resolve().parent
 339:     candidates: list[Path] = [user_models_dir() / subdir]
 340:     meipass = getattr(sys, "_MEIPASS", None)
 341:     if meipass:
 342:         candidates.append(Path(meipass) / "models" / subdir)
 343:     candidates.append(backend_dir / "assets" / subdir)
 344:     candidates.append(backend_dir / "models" / subdir)
 345: 
 346:     for c in candidates:
 347:         if c.is_dir():
 348:             return c.resolve()
 349: 
 350:     # Nothing exists 鈫?return the user_models_dir path so missing-model
 351:     # errors point at the writable user-friendly location.
 352:     return (user_models_dir() / subdir).resolve()
 353: 
 354: 
 355: def ensure_user_dirs() -> None:
 356:     """Create the standard user directories if missing. Idempotent.
 357: 
 358:     Called once at backend startup (from ``main.py``) so downstream
 359:     code can assume ``user_data_dir() / "data"`` etc. exist without
 360:     each caller racing on ``mkdir(parents=True)``.
 361: 
 362:     Failures are swallowed with a warning rather than raised 鈥?the
 363:     backend should still come up on e.g. a read-only profile, using
 364:     whatever paths the user explicitly configured.
 365:     """
 366:     for d in (
 367:         user_data_dir(),
 368:         user_data_dir() / "data",
 369:         user_data_dir() / "workspace",  # P4-S22: MCP filesystem root
 370:         user_log_dir(),
 371:         user_cache_dir(),
 372:         user_models_dir(),
 373:     ):
 374:         try:
 375:             d.mkdir(parents=True, exist_ok=True)
 376:         except OSError:
 377:             # Non-fatal: user may have overridden to a read-only path.
 378:             # Downstream writes will surface the real error.
 379:             pass

