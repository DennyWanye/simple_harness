+@pytest.mark.asyncio
+async def test_timeout_refuses_and_releases_lease_after_worker_finishes(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    """A slow forward is abandoned by the caller, never by the device.
+
+    The runtime stops waiting, but the lease is only released once the shielded
+    worker is actually done: the physical forward is bounded, not orphaned.
+    """
+    started = threading.Event()
+    release = threading.Event()
+
+    def _gate(call: int) -> None:
+        if call == 1:
+            started.set()
+            release.wait(5.0)
+
+    scorer = _FakeScorer(on_score=_gate)
+    runtime = _runtime(monkeypatch, scorer, inference_timeout_seconds=0.05)
+    await runtime.start()
+
+    first = asyncio.create_task(runtime.evaluate(_request("a", "b")))
+    assert await asyncio.to_thread(started.wait, 5.0)
+
+    # The gate is opened *after* the caller's 0.05s patience has expired, so the
+    # timeout actually fires while the worker is still blocked.  The release is
+    # delayed rather than immediate because the runtime only hands the timeout
+    # error back once the shielded worker is done: opening the gate here would
+    # let the forward finish inside the patience window and `first` would return
+    # a result instead of raising.
+    await asyncio.sleep(0.1)  # beyond the caller's 0.05s patience
+    loop = asyncio.get_running_loop()
+    loop.call_later(0.1, release.set)
+    with pytest.raises(NanoJevInferenceError, match="patience"):
+        await first
+
+    second = asyncio.create_task(runtime.evaluate(_request("a", "b")))
+    result = await second
+
+    assert scorer.calls == 2
+    assert list(dict(result.probabilities)) == ["a", "b"]
+
+
+@pytest.mark.asyncio
+async def test_max_concurrency_bounds_physical_inference(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    release = threading.Event()
+    in_flight = 0
+    peak = 0
+    lock = threading.Lock()
+
+    def _gate(_call: int) -> None:
+        nonlocal in_flight, peak
+        with lock:
+            in_flight += 1
+            peak = max(peak, in_flight)
+        release.wait(5.0)
+        with lock:
+            in_flight -= 1
+
+    scorer = _FakeScorer(on_score=_gate)
+    runtime = _runtime(monkeypatch, scorer, max_concurrency=1)
+    await runtime.start()
+
+    tasks = [
+        asyncio.create_task(runtime.evaluate(_request("a", "b"))) for _ in range(3)
+    ]
+    await asyncio.sleep(0.1)
+    assert scorer.calls == 1
+
+    release.set()
+    outputs = await asyncio.gather(*tasks)
+
+    assert peak == 1
+    assert scorer.calls == 3
+    assert all(isinstance(output, NanoJevOutput) for output in outputs)
