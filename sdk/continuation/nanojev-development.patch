@@ -0,0 +1,117 @@
+"""Thin adapter over an existing (pre-NanoJev) selection callable.
+
+``ExistingDecisionProvider`` lets the NanoJev decision layer observe whichever
+selection the current system already makes, without itself containing any model
+dependency or scoring behaviour. Production behaviour stays owned by the
+injected ``selector``; this class only:
+
+* invokes the selector (sync or async) with the request,
+* measures how long that took,
+* validates that the selector chose one of the request's candidates, and
+* wraps the choice in a well-formed ``DecisionResult`` (selected = 1.0, every
+  other candidate = 0.0, in request order).
+
+The one-hot scores are a deterministic encoding of the existing selector's
+categorical outcome, not a claim that the selector supplied calibrated model
+probabilities. ``top1_probability`` and ``margin`` are therefore both 1.0 by
+construction; consumers comparing model confidence must treat this provider's
+values as a baseline sentinel.
+
+Because it never calls a model, it is safe to run in shadow mode alongside the
+live path.
+"""
+
+from __future__ import annotations
+
+import inspect
+import time
+from collections.abc import Awaitable, Callable
+
+from ...contracts.models import ContractError
+from ..provider import DecisionProvider
+from ..types import DecisionRequest, DecisionResult, DecisionScore
+
+SelectorResult = str | Awaitable[str]
+Selector = Callable[[DecisionRequest], SelectorResult]
+
+DEFAULT_PROVIDER_NAME = "existing"
+
+
+class ExistingDecisionProvider(DecisionProvider):
+    """Wrap an injected existing selector as a ``DecisionProvider``.
+
+    Args:
+        selector: A callable taking the ``DecisionRequest`` and returning the
+            id of the candidate the existing system would pick. It may be a
+            plain function or an awaitable-returning (coroutine) callable.
+        name: The provider name recorded on results. Defaults to
+            ``"existing"``; must be a non-empty string.
+    """
+
+    def __init__(self, selector: Selector, name: str = DEFAULT_PROVIDER_NAME) -> None:
+        if not callable(selector):
+            raise TypeError("selector must be callable")
+        if not isinstance(name, str):
+            raise TypeError(f"name must be a str, got {type(name).__name__}")
+        if not name.strip():
+            raise ValueError("name must be a non-empty string")
+        self._selector = selector
+        self._name = name
+
+    @property
+    def name(self) -> str:
+        """The provider name recorded on results."""
+        return self._name
+
+    async def decide(self, request: DecisionRequest) -> DecisionResult:
+        """Return the existing selector's choice for ``request``.
+
+        Raises:
+            TypeError: if ``request`` is not a ``DecisionRequest``.
+            ContractError: if the selector returns a non-string/empty id, or an
+                id that is not among ``request.candidates``.
+        """
+        if not isinstance(request, DecisionRequest):
+            raise TypeError(
+                f"request must be a DecisionRequest, got {type(request).__name__}"
+            )
+
+        started = time.perf_counter()
+        selected = self._selector(request)
+        if inspect.isawaitable(selected):
+            selected = await selected
+        latency_ms = (time.perf_counter() - started) * 1000.0
+
+        if not isinstance(selected, str):
+            raise ContractError(
+                "existing selector must return a candidate id as a str, got "
+                f"{type(selected).__name__}"
+            )
+        if not selected.strip():
+            raise ContractError("existing selector returned an empty candidate id")
+
+        candidate_ids = [candidate.id for candidate in request.candidates]
+        if selected not in candidate_ids:
+            raise ContractError(
+                f"existing selector returned {selected!r}, which is not among the "
+                f"request candidates {candidate_ids!r}"
+            )
+
+        scores = tuple(
+            DecisionScore(
+                candidate_id=candidate.id,
+                probability=1.0 if candidate.id == selected else 0.0,
+            )
+            for candidate in request.candidates
+        )
+
+        return DecisionResult(
+            decision_id=request.decision_id,
+            provider=self._name,
+            selected=selected,
+            scores=scores,
+            top1_probability=1.0,
+            margin=1.0,
+            latency_ms=latency_ms,
+            model_version=None,
+        )
