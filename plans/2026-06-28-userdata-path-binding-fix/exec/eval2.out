   44: def _merge_code_params(payload: dict, code_params: dict | None) -> dict:
   45:     """code-session-model-params: splice the per-session request fragment.
   46: 
   47:     Top-level keys (e.g. ``reasoning_effort``) are set directly; an
   48:     ``extra_body`` dict is shallow-merged. Total/pure: empty/None 鈫?    payload unchanged. Never overrides ``model``/``messages``.
   49:     """
   50:     if not code_params:
   51:         return payload
   52:     for k, v in code_params.items():
   53:         if k in ("model", "messages"):
   54:             continue
   55:         if k == "extra_body" and isinstance(v, dict):
   56:             eb = dict(payload.get("extra_body") or {})
   57:             eb.update(v)
   58:             payload["extra_body"] = eb
   59:         else:
   60:             payload[k] = v
   61:     return payload
