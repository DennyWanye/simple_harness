+"""Rollout policy for the NanoJev decision layer.
+
+The policy decides how a decision result is used at runtime: keep the existing
+behaviour, run NanoJev in shadow mode for observation only, or let NanoJev
+drive the actual selection.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from enum import StrEnum
+
+
+class DecisionMode(StrEnum):
+    """How the NanoJev decision layer participates in a run."""
+
+    EXISTING = "existing"
+    SHADOW = "shadow"
+    NANOJEV = "nanojev"
+
+
+@dataclass(frozen=True, slots=True)
+class DecisionPolicy:
+    """An immutable policy selecting the decision mode for a run."""
+
+    mode: DecisionMode = DecisionMode.EXISTING
+
+    def __post_init__(self) -> None:
+        if not isinstance(self.mode, DecisionMode):
+            raise TypeError(
+                f"mode must be a DecisionMode, got {type(self.mode).__name__}"
+            )
