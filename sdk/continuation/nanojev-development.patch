+++ b/scripts/nanojev_sdk_acceptance.py
@@ -0,0 +1,873 @@
+#!/usr/bin/env python3
+"""Reusable acceptance runner for the NanoJev SDK decision integration.
+
+This script is *evidence collection*, not a unit test.  It walks the frozen R02
+fixture set through the real SDK decision stack — the ``NanoJevRuntime``
+boundary, ``NanoJevDecisionProvider``, ``ExistingDecisionProvider`` and the real
+``DecisionService`` shadow path — and writes raw, per-call output to
+``.local-test-evidence/<date>/sdk-nanojev-integration/real/``.
+
+Design constraints (deliberate):
+
+* **No model is loaded at import time.**  Nothing here touches torch, mlx or a
+  checkpoint until a runtime instance is actually handed in by the caller.
+* **No API is guessed.**  The runner never constructs ``LocalNanoJevRuntime``
+  itself.  The caller passes a *runtime factory* or an already-constructed
+  runtime; until ``decision/local_runtime.py`` lands and is readable this script
+  refuses to invent its signature and prints the required invocation instead.
+* **No caching / no bypass.**  Acceptance must cross runtime -> provider ->
+  service, so the cache predictor is never called directly here.
+* **Raw output stays out of git** — everything is written under
+  ``.local-test-evidence/``, which is gitignored.
+
+Usage (once ``LocalNanoJevRuntime`` exists and its signature is known)::
+
+    python scripts/nanojev_sdk_acceptance.py --runtime-module \\
+        agent_orchestrator.decision.local_runtime --runtime-class LocalNanoJevRuntime \\
+        --runtime-kwargs '{"checkpoint_dir": "/path/to/checkpoint", "device": "mps"}'
+
+Without ``--runtime-module`` the script runs the *fixture freeze check* only:
+it validates all 18 frozen cases against the SDK contract types, digests them,
+and reports what is still blocking the live run.  That mode needs no model.
+"""
+
+from __future__ import annotations
+
+import argparse
+import asyncio
+import hashlib
+import importlib
+import json
+import platform
+import statistics
+import sys
+import time
+from collections.abc import Callable, Mapping
+from datetime import date
+from pathlib import Path
+from typing import Any
+
+REPO_ROOT = Path(__file__).resolve().parents[1]
+FIXTURE_DIR = REPO_ROOT / "tests" / "orchestrator" / "nanojev_real"
+EVIDENCE_DIR = (
+    REPO_ROOT / ".local-test-evidence" / date.today().isoformat()
+    / "sdk-nanojev-integration" / "real"
+)
+
+ADAPTER_ERRORS = (ValueError, TypeError)
+
+# Group names as frozen in the fixture JSON.
+GROUP_CLEAR = "clear_preferred"
+GROUP_CONTEXT = "paired_context_change"
+GROUP_AMBIGUOUS = "ambiguous_legal_set"
+
+
+# --------------------------------------------------------------------------- #
+# Fixture loading and freezing
+# --------------------------------------------------------------------------- #
+
+
+class FixtureError(RuntimeError):
+    """A frozen fixture does not satisfy the R02 contract."""
+
+
+def load_fixtures(fixture_dir: Path = FIXTURE_DIR) -> list[dict[str, Any]]:
+    """Load every frozen R02 fixture in stable filename order."""
+    paths = sorted(fixture_dir.glob("r02_*.json"))
+    if not paths:
+        raise FixtureError(f"no r02_*.json fixtures found under {fixture_dir}")
+    fixtures: list[dict[str, Any]] = []
+    for path in paths:
+        with path.open("r", encoding="utf-8") as handle:
+            payload = json.load(handle)
+        payload["__path__"] = str(path.relative_to(REPO_ROOT))
+        payload["__sha256__"] = hashlib.sha256(path.read_bytes()).hexdigest()
+        fixtures.append(payload)
+    return fixtures
+
+
+def fixture_digest(fixtures: list[dict[str, Any]]) -> str:
+    """One digest over the whole frozen set, stable across machines."""
+    material = "\n".join(
+        f"{item['fixture_id']}:{item['__sha256__']}" for item in fixtures
+    )
+    return hashlib.sha256(material.encode("utf-8")).hexdigest()
+
+
+def validate_fixture_shape(fixture: dict[str, Any]) -> list[str]:
+    """Check one fixture against the R02 contract *before* any model call.
+
+    Returns a list of human-readable problems; empty means well-formed.  This is
+    intentionally pure data validation — it never imports the model layer.
+    """
+    problems: list[str] = []
+    fid = fixture.get("fixture_id", "<missing id>")
+
+    candidates = fixture.get("candidates")
+    if not isinstance(candidates, list) or len(candidates) < 2:
+        problems.append(f"{fid}: needs at least two legal candidates")
+        candidates = candidates if isinstance(candidates, list) else []
+
+    candidate_ids: list[str] = []
+    for candidate in candidates:
+        cid = candidate.get("id") if isinstance(candidate, dict) else None
+        if not isinstance(cid, str) or not cid.strip():
+            problems.append(f"{fid}: candidate without a stable non-empty id")
+            continue
+        candidate_ids.append(cid)
+        label = candidate.get("label", "")
+        # Labels must stay short enough for a 512-token model budget.
+        if len(label) > 120:
+            problems.append(f"{fid}: label too long for a 512-token budget: {cid}")
+    if len(set(candidate_ids)) != len(candidate_ids):
+        problems.append(f"{fid}: duplicate candidate ids")
+
+    if fixture.get("decision_type") not in {"ready_task_priority", "retry_or_escalate"}:
+        problems.append(f"{fid}: decision_type outside the two legal R02 types")
+
+    expected = fixture.get("expected_selected")
+    accepted = fixture.get("accepted_set")
+    if not isinstance(accepted, list) or not accepted:
+        problems.append(f"{fid}: accepted_set must be a non-empty list")
+        accepted = []
+    unknown = [item for item in accepted if item not in candidate_ids]
+    if unknown:
+        problems.append(f"{fid}: accepted_set references unknown candidates {unknown}")
+    if expected is not None:
+        if expected not in candidate_ids:
+            problems.append(f"{fid}: expected_selected is not a candidate")
+        if expected not in accepted:
+            problems.append(f"{fid}: expected_selected missing from accepted_set")
+        if len(accepted) != 1:
+            problems.append(f"{fid}: a definite answer must accept exactly one candidate")
+    else:
+        # Ambiguous cases must not smuggle in a single forced answer.
+        if len(accepted) < 2:
+            problems.append(f"{fid}: ambiguous fixture must accept at least two candidates")
+
+    context = fixture.get("context")
+    if not isinstance(context, dict) or not context:
+        problems.append(f"{fid}: context must be a non-empty mapping")
+
+    existing = fixture.get("existing_selector")
+    if existing not in candidate_ids:
+        problems.append(f"{fid}: existing_selector is not a candidate")
+
+    group = fixture.get("group")
+    if expected is None and group != GROUP_AMBIGUOUS:
+        problems.append(f"{fid}: only ambiguous fixtures may omit expected_selected")
+    if expected is not None and group == GROUP_AMBIGUOUS:
+        problems.append(f"{fid}: ambiguous fixture must not pin expected_selected")
+
+    return problems
+
+
+def validate_fixture_set(fixtures: list[dict[str, Any]]) -> list[str]:
+    """Check the 4/4/4 group composition and the R02 pairing rules."""
+    problems: list[str] = []
+    for fixture in fixtures:
+        problems.extend(validate_fixture_shape(fixture))
+
+    by_group: dict[str, list[dict[str, Any]]] = {}
+    for fixture in fixtures:
+        by_group.setdefault(str(fixture.get("group")), []).append(fixture)
+
+    for group, expected_count in (
+        (GROUP_CLEAR, 4),
+        (GROUP_CONTEXT, 4),
+        (GROUP_AMBIGUOUS, 4),
+    ):
+        actual = len(by_group.get(group, []))
+        if actual != expected_count:
+            problems.append(f"group {group}: expected {expected_count} fixtures, got {actual}")
+
+    ids = [fixture["fixture_id"] for fixture in fixtures]
+    if len(set(ids)) != len(ids):
+        problems.append("fixture ids are not unique")
+
+    # Every context-change case must name a clear case it pairs with.
+    clear_by_id = {item["fixture_id"]: item for item in by_group.get(GROUP_CLEAR, [])}
+    for fixture in by_group.get(GROUP_CONTEXT, []):
+        partner = fixture.get("pairs_with")
+        if partner not in clear_by_id:
+            problems.append(f"{fixture['fixture_id']}: pairs_with does not name a clear case")
+            continue
+        if not str(fixture.get("changed_fact", "")).strip():
+            problems.append(f"{fixture['fixture_id']}: paired case must record the changed fact")
+
+    return problems
+
+
+def order_sensitivity_cases(fixtures: list[dict[str, Any]]) -> list[dict[str, Any]]:
+    """The 6 clear cases re-tested with the candidate order reversed.
+
+    R02 step 3 asks for six definite-answer cases to be replayed with only the
+    candidate permutation changed, compared by stable id rather than position.
+    """
+    clear = [item for item in fixtures if item.get("group") == GROUP_CLEAR]
+    return [item for item in clear if item.get("expected_selected") is not None][:6]
+
+
+# --------------------------------------------------------------------------- #
+# SDK adapters — built from the real contract types, never re-implemented
+# --------------------------------------------------------------------------- #
+
+
+#: The two `ready_task_priority` context keys that describe the situation, in the
+#: order they read as prose.  `notes` is appended last because it qualifies the
+#: goal rather than naming it.
+_PRIORITY_STATE_KEYS = ("goal_summary", "blocking_gap", "notes")
+
+#: The retry/escalate context keys that describe the situation.  `normalized_error`
+#: leads because it is the fact the decision is about; the remaining keys are the
+#: observable conditions the retry-or-escalate rule turns on.
+_RETRY_STATE_KEYS = (
+    "normalized_error",
+    "attempts_so_far",
+    "max_attempts",
+    "input_changed",
+    "side_effects_possible",
+    "last_attempt_outcome_confirmed",
+    "notes",
+)
+
+#: The question the model is asked, per decision type.  These are *not* fixture
+#: data: the frozen fixtures pin the answer, not the prompt, and the fixture
+#: context is a situation rather than a question.
+_INSTRUCTIONS_BY_TYPE = {
+    "ready_task_priority": (
+        "Choose the single candidate that should be worked on next."
+    ),
+    "retry_or_escalate": (
+        "Choose whether to retry the same task or escalate it to the planner."
+    ),
+}
+
+
+def derive_state_text(decision_type: str, context: Mapping[str, Any]) -> str:
+    """Render a fixture context into the model's ``State:`` segment.
+
+    The frozen R02 context is a *situation* description — ``goal_summary`` /
+    ``blocking_gap`` / ``notes`` for priority, the retry conditions for
+    retry-or-escalate — and it is deliberately not split into the runtime's
+    ``state``/``instructions`` prompt keys.  This adapter is the one place that
+    knows those semantics, so the derivation lives here rather than being guessed
+    by the runtime.
+
+    Only keys actually present are rendered, in a fixed order, so the segment is
+    deterministic and no fact is invented or dropped.  Values are rendered with
+    ``json.dumps`` for non-strings so a boolean or an integer keeps its type.
+    """
+    keys = (
+        _RETRY_STATE_KEYS
+        if decision_type == "retry_or_escalate"
+        else _PRIORITY_STATE_KEYS
+    )
+    lines: list[str] = []
+    for key in keys:
+        if key not in context:
+            continue
+        value = context[key]
+        rendered = value if isinstance(value, str) else json.dumps(value)
+        lines.append(f"{key}: {rendered}")
+    return "\n".join(lines)
+
+
+def build_runtime_context(fixture: dict[str, Any]) -> dict[str, Any]:
+    """The decision context handed to the runtime: fixture facts plus the prompt split.
+
+    The fixture's own keys are preserved verbatim under a ``fixture_context``
+    entry *and* stay at the top level, so the runtime-visible context still
+    carries every fact the fixture froze; ``state``/``instructions`` are added
+    alongside them as the model's two prompt segments.
+    """
+    context = dict(fixture["context"])
+    decision_type = str(fixture["decision_type"])
+    instructions = _INSTRUCTIONS_BY_TYPE.get(decision_type)
+    if instructions is None:
+        raise FixtureError(
+            f"{fixture.get('fixture_id')}: no instructions for decision type "
+            f"{decision_type!r}; refusing to invent a question"
+        )
+    return {
+        **context,
+        "fixture_context": context,
+        "state": derive_state_text(decision_type, context),
+        "instructions": instructions,
+    }
+
+
+def build_sdk_request(fixture: dict[str, Any], *, reverse: bool = False) -> Any:
+    """Turn one fixture into a real ``DecisionRequest``.
+
+    ``reverse`` rewrites only the candidate order, keeping ids and labels
+    untouched, so an order-sensitive failure is attributable to position.
+
+    The request's ``context`` is the fixture's situation rendered into the shape
+    the runtime's admission requires (see :func:`build_runtime_context`); the
+    fixture's own keys are not dropped, so the semantics are preserved rather
+    than flattened away to satisfy the boundary.
+    """
+    from agent_orchestrator.decision import (
+        DecisionCandidate,
+        DecisionRequest,
+        DecisionType,
+    )
+
+    candidates = list(fixture["candidates"])
+    if reverse:
+        candidates = list(reversed(candidates))
+    return DecisionRequest(
+        decision_id=str(fixture["fixture_id"]),
+        decision_type=DecisionType(str(fixture["decision_type"])),
+        mission_id=str(fixture["mission_id"]),
+        task_id=fixture.get("task_id"),
+        candidates=tuple(
+            DecisionCandidate(
+                id=str(item["id"]),
+                label=str(item["label"]),
+                metadata=dict(item.get("metadata") or {}),
+            )
+            for item in candidates
+        ),
+        context=build_runtime_context(fixture),
+    )
+
+
+def build_existing_provider(fixture: dict[str, Any]) -> Any:
+    """The frozen Existing selector: a fixed, repeatable production answer."""
+    from agent_orchestrator.decision.providers import ExistingDecisionProvider
+
+    frozen_choice = str(fixture["existing_selector"])
+    return ExistingDecisionProvider(lambda _request, choice=frozen_choice: choice)
+
+
+def build_nanojev_provider(runtime: Any) -> Any:
+    """Wrap a live runtime in the real SDK provider (runtime -> provider)."""
+    from agent_orchestrator.decision import NanoJevDecisionProvider
+
+    return NanoJevDecisionProvider(runtime)
+
+
+def result_to_dict(result: Any) -> dict[str, Any]:
+    """Flatten a ``DecisionResult`` into JSON-friendly evidence."""
+    return {
+        "decision_id": result.decision_id,
+        "provider": result.provider,
+        "selected": result.selected,
+        "model_version": result.model_version,
+        "top1_probability": result.top1_probability,
+        "margin": result.margin,
+        "latency_ms": result.latency_ms,
+        "scores": {
+            score.candidate_id: score.probability for score in result.scores
+        },
+    }
+
+
+def validate_distribution(result: Any, candidate_ids: tuple[str, ...]) -> list[str]:
+    """Finite-probability / id-coverage checks applied to a live result.
+
+    The SDK types already enforce this at construction; re-checking here keeps
+    the *evidence* self-describing when a check fails inside the service.
+    """
+    problems: list[str] = []
+    scored = {score.candidate_id for score in result.scores}
+    if scored != set(candidate_ids):
+        problems.append(f"score ids {sorted(scored)} != request ids {sorted(candidate_ids)}")
+    total = 0.0
+    for score in result.scores:
+        value = score.probability
+        if value != value or value in (float("inf"), float("-inf")):
+            problems.append(f"non-finite probability for {score.candidate_id}")
+        elif not 0.0 <= value <= 1.0:
+            problems.append(f"probability out of range for {score.candidate_id}")
+        total += value
+    if abs(total - 1.0) > 1e-5:
+        problems.append(f"probabilities sum to {total!r}, not 1 (tol 1e-5)")
+    return problems
+
+
+# --------------------------------------------------------------------------- #
+# Execution
+# --------------------------------------------------------------------------- #
+
+
+async def run_fixture_once(
+    fixture: dict[str, Any],
+    *,
+    runtime: Any,
+    mode: str,
+    reverse: bool = False,
+) -> dict[str, Any]:
+    """Send one fixture through the real provider / service path once."""
+    from agent_orchestrator.decision import (
+        DecisionMode,
+        DecisionPolicy,
+        DecisionService,
+        ShadowObservationStatus,
+    )
+
+    request = build_sdk_request(fixture, reverse=reverse)
+    candidate_ids = tuple(candidate.id for candidate in request.candidates)
+    existing_provider = build_existing_provider(fixture)
+    nanojev_provider = build_nanojev_provider(runtime)
+
+    record: dict[str, Any] = {
+        "fixture_id": fixture["fixture_id"],
+        "group": fixture["group"],
+        "decision_type": fixture["decision_type"],
+        "mode": mode,
+        "reversed_candidate_order": reverse,
+        "candidate_order": list(candidate_ids),
+        "expected_selected": fixture.get("expected_selected"),
+        "accepted_set": list(fixture["accepted_set"]),
+        "existing_selector": fixture["existing_selector"],
+        "agreement_with_existing": fixture["agreement_with_existing"],
+        "reason": fixture["reason"],
+    }
+
+    provider_error: str | None = None
+    started = time.perf_counter()
+    try:
+        result = await nanojev_provider.decide(request)
+    except ADAPTER_ERRORS as exc:
+        provider_error = f"{type(exc).__name__}: {exc}"
+        result = None
+    elapsed_ms = (time.perf_counter() - started) * 1000.0
+
+    record["provider_latency_ms"] = elapsed_ms
+    if result is None:
+        record["valid"] = False
+        record["error"] = provider_error
+        record["selected"] = None
+        record["candidate_match"] = False
+    else:
+        problems = validate_distribution(result, candidate_ids)
+        record["valid"] = not problems
+        record["error"] = None if not problems else "; ".join(problems)
+        record["result"] = result_to_dict(result)
+        record["selected"] = result.selected
+        record["expected_match"] = (
+            None
+            if fixture.get("expected_selected") is None
+            else result.selected == fixture["expected_selected"]
+        )
+        record["in_accepted_set"] = result.selected in fixture["accepted_set"]
+        record["candidate_match"] = result.selected == fixture["existing_selector"]
+
+    # Shadow mode: run through the real service to prove the production answer
+    # is untouched by whatever the model predicted.
+    if mode == "shadow" and result is not None:
+        policy = DecisionPolicy(mode=DecisionMode.SHADOW)
+        service = DecisionService(
+            existing_provider,
+            policy=policy,
+            shadow_provider=nanojev_provider,
+            shadow_timeout_seconds=30.0,
+        )
+        production = await service.decide(request)
+        observations = await service.close()
+        record["shadow_production"] = result_to_dict(production)
+        record["shadow_production_unchanged"] = (
+            production.selected == fixture["existing_selector"]
+        )
+        record["shadow_observations"] = [
+            {
+                "decision_id": observation.decision_id,
+                "status": str(observation.status),
+                "existing_selected": observation.existing_result.selected,
+                "shadow_selected": (
+                    None if observation.shadow_result is None
+                    else observation.shadow_result.selected
+                ),
+                "error": observation.error,
+                "candidate_ids": list(observation.request_candidate_ids),
+            }
+            for observation in observations
+        ]
+        record["shadow_errors_retained"] = any(
+            item["status"] != str(ShadowObservationStatus.COMPLETED)
+            and item["error"]
+            for item in record["shadow_observations"]
+        )
+
+    return record
+
+
+async def run_suite(
+    fixtures: list[dict[str, Any]],
+    *,
+    runtime: Any,
+    mode: str,
+) -> dict[str, Any]:
+    """R02: 12 frozen fixtures once each, then the 6 clear cases reversed."""
+    records: list[dict[str, Any]] = []
+    for fixture in fixtures:
+        records.append(await run_fixture_once(fixture, runtime=runtime, mode=mode))
+
+    order_records: list[dict[str, Any]] = []
+    for fixture in order_sensitivity_cases(fixtures):
+        order_records.append(
+            await run_fixture_once(fixture, runtime=runtime, mode=mode, reverse=True)
+        )
+
+    return {
+        "fixture_digest": fixture_digest(fixtures),
+        "fixture_hashes": {
+            item["fixture_id"]: item["__sha256__"] for item in fixtures
+        },
+        "records": records,
+        "order_sensitivity_records": order_records,
+        "summary": summarize_r02(records),
+        "order_sensitivity": summarize_order_sensitivity(records, order_records),
+    }
+
+
+def summarize_r02(records: list[dict[str, Any]]) -> dict[str, Any]:
+    """Report validity, definite-answer hits and distribution health.
+
+    Validity and answer quality are reported separately, and accuracy is never
+    conflated with agreement against the Existing selector.
+    """
+    total = len(records)
+    valid = [item for item in records if item.get("valid")]
+    definite = [item for item in valid if item.get("expected_selected") is not None]
+    ambiguous = [item for item in valid if item.get("expected_selected") is None]
+
+    per_type: dict[str, dict[str, int]] = {}
+    for item in definite:
+        bucket = per_type.setdefault(item["decision_type"], {"hits": 0, "cases": 0})
+        bucket["cases"] += 1
+        if item.get("expected_match"):
+            bucket["hits"] += 1
+
+    top1: list[float] = []
+    margins: list[float] = []
+    for item in valid:
+        payload = item.get("result") or {}
+        if isinstance(payload.get("top1_probability"), float):
+            top1.append(payload["top1_probability"])
+        if isinstance(payload.get("margin"), float):
+            margins.append(payload["margin"])
+
+    return {
+        "cases_total": total,
+        "valid_returns": len(valid),
+        "adapter_errors": total - len(valid),
+        "errors": [
+            {"fixture_id": item["fixture_id"], "error": item["error"]}
+            for item in records
+            if not item.get("valid")
+        ],
+        "definite_cases": len(definite),
+        "definite_hits": sum(1 for item in definite if item.get("expected_match")),
+        "accuracy_per_type": per_type,
+        "ambiguous_cases": len(ambiguous),
+        "ambiguous_in_accepted_set": sum(
+            1 for item in ambiguous if item.get("in_accepted_set")
+        ),
+        "agreement_with_existing": sum(
+            1 for item in valid if item.get("candidate_match")
+        ),
+        "mean_top1_probability": statistics.fmean(top1) if top1 else None,
+        "mean_margin": statistics.fmean(margins) if margins else None,
+        "note": (
+            "agreement_with_existing and definite_hits measure different things; "
+            "a hit is not evidence of production readiness"
+        ),
+    }
+
+
+def summarize_order_sensitivity(
+    base_records: list[dict[str, Any]], reversed_records: list[dict[str, Any]]
+) -> dict[str, Any]:
+    """Did reversing the candidate list change the stable-id answer?"""
+    base = {item["fixture_id"]: item for item in base_records}
+    changes: list[dict[str, Any]] = []
+    for item in reversed_records:
+        original = base.get(item["fixture_id"])
+        if original is None:
+            continue
+        if original.get("selected") != item.get("selected"):
+            changes.append(
+                {
+                    "fixture_id": item["fixture_id"],
+                    "original_selected": original.get("selected"),
+                    "reversed_selected": item.get("selected"),
+                    "expected_selected": item.get("expected_selected"),
+                }
+            )
+    return {
+        "cases": len(reversed_records),
+        "stable_answers": len(reversed_records) - len(changes),
+        "changed_answers": changes,
+    }
+
+
+async def measure_latency(
+    fixtures: list[dict[str, Any]], *, runtime: Any, warmups: int = 5, samples: int = 20
+) -> dict[str, Any]:
+    """Small cold/warm latency measurement.
+
+    The load itself is the caller's job (``runtime.start()``); this measures the
+    adapter's warm end-to-end path only, so load cost is never mixed in.
+    """
+    probe = fixtures[0]
+    request = build_sdk_request(probe)
+    provider = build_nanojev_provider(runtime)
+
+    for _ in range(warmups):
+        try:
+            await provider.decide(request)
+        except ADAPTER_ERRORS:
+            pass
+
+    latencies: list[float] = []
+    errors = 0
+    for _ in range(samples):
+        started = time.perf_counter()
+        try:
+            await provider.decide(request)
+            latencies.append((time.perf_counter() - started) * 1000.0)
+        except ADAPTER_ERRORS:
+            errors += 1
+
+    return {
+        "warmup_calls": warmups,
+        "sample_calls": samples,
+        "successful_samples": len(latencies),
+        "errors": errors,
+        "p50_ms": statistics.median(latencies) if latencies else None,
+        "p95_ms": (
+            sorted(latencies)[max(0, int(len(latencies) * 0.95) - 1)]
+            if latencies
+            else None
+        ),
+        "note": "few samples; p99 not reported, and these are not product SLAs",
+    }
+
+
+# --------------------------------------------------------------------------- #
+# Runtime discovery and reporting
+# --------------------------------------------------------------------------- #
+
+
+def resolve_runtime(
+    runtime_module: str | None,
+    runtime_class: str | None,
+    runtime_kwargs: dict[str, Any],
+    service_factory: str | None,
+) -> Callable[[], Any]:
+    """Build a factory returning a live runtime, without guessing its API.
+
+    The runner deliberately does not hard-code ``LocalNanoJevRuntime``: the
+    class and its constructor live in ``decision/local_runtime.py``, which is
+    owned by another agent.  Until that module exists and is readable, the
+    caller must name it explicitly (or pass a service factory).
+    """
+    if runtime_module is None or runtime_class is None:
+        raise SystemExit(describe_required_invocation())
+
+    module = importlib.import_module(runtime_module)
+    try:
+        runtime_type = getattr(module, runtime_class)
+    except AttributeError as exc:
+        raise SystemExit(
+            f"{runtime_module!r} has no attribute {runtime_class!r}. "
+            "The local runtime is not available yet; do not guess its API.\n\n"
+            + describe_required_invocation()
+        ) from exc
+
+    def factory() -> Any:
+        instance = runtime_type(**runtime_kwargs)
+        if service_factory:
+            # A factory-shaped override the host may supply for wiring tests.
+            hook = getattr(instance, service_factory, None)
+            if callable(hook):
+                instance = hook()
+        return instance
+
+    return factory
+
+
+def describe_required_invocation() -> str:
+    """Print exactly what a live run needs, without inventing a signature."""
+    return (
+        "NanoJev live acceptance is not run yet.\n"
+        "Reason: decision/local_runtime.py (LocalNanoJevRuntime) is owned by a\n"
+        "separate agent and was not readable at freeze time. This runner does not\n"
+        "guess its API, so it stopped after freezing and validating fixtures.\n"
+        "\n"
+        "Required invocation once the runtime exists:\n"
+        "  python scripts/nanojev_sdk_acceptance.py \\\n"
+        "      --runtime-module agent_orchestrator.decision.local_runtime \\\n"
+        "      --runtime-class LocalNanoJevRuntime \\\n"
+        "      --runtime-kwargs '{\"checkpoint_dir\": \"<checkpoint>\", \"device\": \"mps\"}' \\\n"
+        "      --mode shadow\n"
+        "\n"
+        "The runtime must implement the SDK ABC NanoJevRuntime\n"
+        "  (start / evaluate(NanoJevRequest) -> NanoJevOutput / close)\n"
+        "declared in src/agent_orchestrator/decision/runtime.py, and will be\n"
+        "wrapped by the real NanoJevDecisionProvider and the real DecisionService\n"
+        "shadow path. Do not call a cache predictor directly: acceptance has to\n"
+        "cross runtime -> provider -> service."
+    )
+
+
+def host_environment() -> dict[str, Any]:
+    """The one-off lightweight machine record from plan section 6."""
+    return {
+        "machine": platform.machine(),
+        "platform": platform.platform(),
+        "platform_version": platform.mac_ver()[0] or None,
+        "python_version": sys.version.split()[0],
+        "python_executable": sys.executable,
+    }
+
+
+def write_evidence(payload: dict[str, Any], name: str) -> Path:
+    """Write raw evidence under .local-test-evidence (never committed)."""
+    EVIDENCE_DIR.mkdir(parents=True, exist_ok=True)
+    path = EVIDENCE_DIR / name
+    with path.open("w", encoding="utf-8") as handle:
+        json.dump(payload, handle, indent=2, ensure_ascii=False, default=repr)
+        handle.write("\n")
+    return path
+
+
+def print_freeze_report(fixtures: list[dict[str, Any]]) -> None:
+    """Echo the frozen hashes so the run is reproducible from stdout alone."""
+    print("R02 frozen fixtures (12 + 6 order-sensitivity replays)")
+    print(f"  fixture directory : {FIXTURE_DIR.relative_to(REPO_ROOT)}")
+    for fixture in fixtures:
+        print(
+            f"  {fixture['__sha256__']}  {fixture['fixture_id']}"
+            f"  [{fixture['group']}]"
+        )
+    print(f"  combined SHA256   : {fixture_digest(fixtures)}")
+    print(f"  evidence directory: {EVIDENCE_DIR}")
+
+
+async def main_async(args: argparse.Namespace) -> int:
+    fixtures = load_fixtures()
+    problems = validate_fixture_set(fixtures)
+    print_freeze_report(fixtures)
+
+    if problems:
+        print("\nFIXTURE CONTRACT PROBLEMS:", file=sys.stderr)
+        for problem in problems:
+            print(f"  - {problem}", file=sys.stderr)
+        return 2
+    print("\nfixture contract: OK (4 clear / 4 paired-context / 4 ambiguous legal-set)")
+
+    if args.runtime_module is None:
+        print()
+        print(describe_required_invocation())
+        frozen = {
+            "fixtures": [
+                {
+                    "fixture_id": item["fixture_id"],
+                    "group": item["group"],
+                    "sha256": item["__sha256__"],
+                }
+                for item in fixtures
+            ],
+            "fixture_digest": fixture_digest(fixtures),
+            "status": "FROZEN_PENDING_RUNTIME",
+            "blocked_on": "agent_orchestrator.decision.local_runtime.LocalNanoJevRuntime",
+        }
+        path = write_evidence(frozen, "r02_fixture_freeze.json")
+        print(f"freeze record written: {path.relative_to(REPO_ROOT)}")
+        return 0
+
+    factory = resolve_runtime(
+        args.runtime_module, args.runtime_class, args.runtime_kwargs, args.service_factory
+    )
+    runtime = factory()
+    env = host_environment()
+
+    load_started = time.perf_counter()
+    await runtime.start()
+    load_ms = (time.perf_counter() - load_started) * 1000.0
+
+    try:
+        suite = await run_suite(fixtures, runtime=runtime, mode=args.mode)
+        latency = await measure_latency(fixtures, runtime=runtime)
+    finally:
+        await runtime.close()
+
+    payload = {
+        "environment": env,
+        "mode": args.mode,
+        "model_load_ms": load_ms,
+        "runtime_module": args.runtime_module,
+        "runtime_class": args.runtime_class,
+        "runtime_kwargs": args.runtime_kwargs,
+        "suite": suite,
+        "latency": latency,
+        "caveat": (
+            "Sample size is 12+6. This does not establish production readiness "
+            "and must not be read as a Primary promotion result."
+        ),
+    }
+    suite_path = write_evidence(payload, "r02_suite.json")
+
+    print(f"\nmodel load ms : {load_ms:.1f}")
+    print(
+        f"valid returns : {suite['summary']['valid_returns']}"
+        f"/{suite['summary']['cases_total']}"
+    )
+    print(
+        f"definite hits : {suite['summary']['definite_hits']}"
+        f"/{suite['summary']['definite_cases']}"
+    )
+    print(
+        f"order stable  : {suite['order_sensitivity']['stable_answers']}"
+        f"/{suite['order_sensitivity']['cases']}"
+    )
+    print(f"warm p50 ms   : {latency['p50_ms']}")
+    print(f"evidence      : {suite_path.relative_to(REPO_ROOT)}")
+    return 0
+
+
+def build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    parser.add_argument(
+        "--runtime-module",
+        default=None,
+        help="importable module holding the local NanoJev runtime (omit to freeze only)",
+    )
+    parser.add_argument("--runtime-class", default=None, help="runtime class name")
+    parser.add_argument(
+        "--runtime-kwargs",
+        default="{}",
+        help="JSON object of keyword arguments for the runtime constructor",
+    )
+    parser.add_argument(
+        "--service-factory",
+        default=None,
+        help="optional attribute to call for custom service wiring",
+    )
+    parser.add_argument(
+        "--mode",
+        default="shadow",
+        choices=["shadow", "nanojev", "existing"],
+        help="DecisionMode used for the live run",
+    )
+    return parser
+
+
+def main(argv: list[str] | None = None) -> int:
+    args = build_parser().parse_args(argv)
+    try:
+        args.runtime_kwargs = json.loads(args.runtime_kwargs)
+    except json.JSONDecodeError as exc:
+        raise SystemExit(f"--runtime-kwargs must be JSON: {exc}") from exc
+    if not isinstance(args.runtime_kwargs, dict):
+        raise SystemExit("--runtime-kwargs must decode to a JSON object")
+    return asyncio.run(main_async(args))
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
