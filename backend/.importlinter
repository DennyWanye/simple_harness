# 后端分层契约（代码质量整治阶段 4.3）。运行：cd backend && lint-imports
# 从上到下，上层可以引用下层，下层不许引用上层。
# "|" 隔开的同层模块彼此独立；":" 隔开的同层模块允许互相引用（现有互相引用，拆分留给阶段 6）。
# 只在类型检查时生效的导入不算。
# 单文件模块（main、p4_ipc、provider_test_connection、config、context、paths）import-linter 不收，
# 由 scripts/code_quality/backend_layers.py 检查：它们与这里的层次一致。

[importlinter]
root_packages =
    host
    router
    billing
    deskpet
    agent
    llm
    providers
    memory
    tools
    observability
exclude_type_checking_imports = True

[importlinter:contract:backend-layers]
name = 后端分层：host → 上层适配 → deskpet 与旧 agent → 模型与提供方 → 日志与监控
type = layers
layers =
    host
    router : billing
    deskpet : agent
    llm : providers : memory : tools
    observability
# 分层例外已清空，不许再加。
