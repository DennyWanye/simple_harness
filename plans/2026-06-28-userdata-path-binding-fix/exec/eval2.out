   64: class OpenAICompatibleProvider:
   65:     """LLM provider speaking OpenAI's /v1/chat/completions SSE protocol.
   66: 
   67:     Works against any compatible endpoint:
   68:       - Local Ollama on /v1 (api_key "ollama", ignored server-side).
   69:       - DashScope compatible-mode /v1 (real bearer token).
   70:       - Any other OpenAI-compatible gateway.
   71: 
   72:     Implements the `LLMProvider` Protocol in providers/base.py.
   73:     """
   74: 
   75:     def __init__(
   76:         self,
   77:         base_url: str,
   78:         api_key: str,
   79:         model: str,
   80:         temperature: float = 0.7,
   81:         timeout: float | None = None,
   82:         sanitize_inline_cot_dsml: bool = True,
   83:         code_params: dict | None = None,
   84:         is_relay: bool = False,
   85:     ) -> None:
   86:         self.base_url = base_url.rstrip("/")
   87:         self.api_key = api_key
   88:         self.model = model
   89:         self.temperature = temperature
   90:         self._is_relay = is_relay
   91:         # code-session-model-params: per-code-session request fragment
   92:         # (e.g. {"reasoning_effort":"high","extra_body":{...}}) produced
   93:         # by llm.code_params; merged into the chat payload. None/{} = no
   94:         # change (provider defaults / non-code sessions).
   95:         self.code_params = code_params or {}
   96:         # 2026-05-17 deepseek-inline-cot-dsml-sanitize Strangler-Fig flag.
   97:         # Default on; caller (provider registry) passes the config value.
   98:         # False = byte-for-byte legacy passthrough (demo rollback).
   99:         self.sanitize_inline_cot_dsml = sanitize_inline_cot_dsml
  100:         # P4-S25 / P5-S2: timeout is a tuple-style budget instead of a single
  101:         # number:
  102:         #   * connect = 10s 鈥?TCP + TLS handshake. Bumped 5鈫?0s on 2026-05-11
  103:         #                     after seeing real ConnectTimeout failures while
  104:         #                     the relay itself reported no errors (their server
  105:         #                     never saw the request 鈥?handshake failed our
  106:         #                     side). Windows DNS cache invalidation + TLS
  107:         #                     slow-start on cold connections legitimately
  108:         #                     takes 6-8s. 10s gives headroom without making
  109:         #                     real outages drag.
  110:         #   * read    = 60s 鈥?between bytes / for a full single response.
  111:         #                     Initial 20s based on user-reported 14.4s p-max
  112:         #                     was too tight: 2026-05-09 logs showed frequent
  113:         #                     `attempt=1 of=3 ReadTimeout` retries that ate
  114:         #                     the whole budget on a string of slow turns.
  115:         #                     60s covers thinking-mode bursts + the relay
  116:         #                     idle-spikes; the proxy's own 100-120s idle cut
  117:         #                     remains the outer bound.
  118:         #   * write   = 5s  鈥?POST body is small; anything past this is dead.
  119:         #   * pool    = 5s  鈥?connection-pool acquisition.
  120:         # Caller can still pass a scalar/Timeout; we honour that verbatim.
  121:         # P5-S2 F1 (2026-05-12) 鈥?bumped read 60鈫?20 and write 5鈫?0 per
  122:         # the relay's integration guide (docs/涓浆绔欏缓璁?md). the relay's PR #27
  123:         # ships a 15s SSE keep-alive comment that resets read timers on
  124:         # every hop, so a 120s read budget is generous + safe and covers
  125:         # individual reasoning tokens that can be 5KB+ on slow chunks.
  126:         # connect stays at 10s 鈥?Windows DNS slow-start legitimately
  127:         # takes 6-8s, the relay's suggested 5s would false-fail occasionally.
  128:         if timeout is None:
  129:             self.timeout: float | httpx.Timeout = httpx.Timeout(
  130:                 connect=10.0, read=120.0, write=10.0, pool=5.0,
  131:             )
  132:         else:
  133:             self.timeout = timeout
  134:         # P2-1-S8: last completed stream's usage block from the OpenAI SSE
  135:         # protocol (populated only when the server emits one 鈥?OpenAI/DashScope
  136:         # always do when stream_options.include_usage=True; Ollama today does
  137:         # NOT emit usage in its SSE stream, so this stays None after Ollama
  138:         # calls and billing records nothing. main.py handles that case.
  139:         self.last_usage: dict | None = None
  140:         # Test-only injection: unit tests assign an httpx.MockTransport here.
  141:         # Production code MUST leave this None; otherwise every request goes
  142:         # through the mock and never reaches the real endpoint.
  143:         self._test_transport: httpx.BaseTransport | None = None
