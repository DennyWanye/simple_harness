 232: def user_models_dir() -> Path:
 233:     """Models directory.
 234: 
 235:     Portable: ``<install_dir>/userdata/models``.
 236:     Classic:  ``%LocalAppData%\\deskpet\\models\\`` (Windows).
 237: 
 238:     Override via ``DESKPET_MODEL_ROOT`` (same env var :func:`model_root`
 239:     uses, so a single setting covers both lookup paths).
 240:     """
 241:     override = os.environ.get("DESKPET_MODEL_ROOT")
 242:     if override:
 243:         return Path(override)
 244:     portable = _portable_userdata_dir()
 245:     if portable is not None:
 246:         return portable / "models"
 247:     # Sits under LocalAppData\deskpet\ (alongside Cache\, Logs\ if we ever
 248:     # want them) via platformdirs' non-roaming user_data_dir.
 249:     local_base = Path(platformdirs.user_data_dir(_APP_NAME, appauthor=_APP_AUTHOR, roaming=False))
