fn portable_userdata_dir() -> Option<PathBuf> {
    // æµ‹è¯•ä¸‹ä¸æŽ¢æµ‹çœŸå®ž current_exe(é¿å… test runner æ—ç¢°å·§çš„ userdata å¹²æ‰°
