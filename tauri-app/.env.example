# Tauri frontend env template — copy to .env.local for overrides.

# ============================================================
# Pet rendering backend selector (S1 — Live2D rewrite 2026-05-28)
# ============================================================
#   live2d (default) — legacy pixi-live2d-display + cubismcore path.
#                      Renders Hiyori, the current visual baseline.
#   null             — placeholder backend (Canvas2D fallback character
#                      + stub CoreModel). Used during the rewrite to
#                      validate pet-anim AnimationOverlay only touches
#                      CoreModelLike — anything that breaks under this
#                      flag is a leaky abstraction we want to flush out
#                      before S3 swaps in the WebGL2 mesh renderer.
# Future:
#   deskpet-mesh     — self-rendered WebGL2 (S3). Not yet wired up.
#
# Change requires `tauri dev` restart (resolved once at component mount).
VITE_PET_ENGINE=live2d
