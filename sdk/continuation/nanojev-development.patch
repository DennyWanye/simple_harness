@@ -0,0 +1,99 @@
+from __future__ import annotations
+
+import asyncio
+
+import pytest
+
+from agent_orchestrator.contracts.models import ContractError
+from agent_orchestrator.decision import DecisionCandidate, DecisionRequest, DecisionType
+from agent_orchestrator.decision.providers import ExistingDecisionProvider
+
+
+def _request(*ids: str) -> DecisionRequest:
+    return DecisionRequest(
+        decision_id="decision-1",
+        decision_type=DecisionType.READY_TASK_PRIORITY,
+        mission_id="mission-1",
+        task_id="task-1",
+        candidates=tuple(DecisionCandidate(id=cid, label=cid, metadata={}) for cid in ids),
+        context={},
+    )
+
+
+@pytest.mark.asyncio
+async def test_wraps_sync_selector_and_preserves_candidate_order() -> None:
+    request = _request("a", "b", "c")
+    provider = ExistingDecisionProvider(lambda current: current.candidates[1].id)
+
+    result = await provider.decide(request)
+
+    assert result.decision_id == request.decision_id
+    assert result.provider == "existing"
+    assert result.selected == "b"
+    assert [(score.candidate_id, score.probability) for score in result.scores] == [
+        ("a", 0.0),
+        ("b", 1.0),
+        ("c", 0.0),
+    ]
+    assert result.top1_probability == 1.0
+    assert result.margin == 1.0
+    assert result.model_version is None
+    assert result.latency_ms >= 0.0
+
+
+@pytest.mark.asyncio
+async def test_wraps_async_selector_without_model_dependency() -> None:
+    called = False
+
+    async def select(request: DecisionRequest) -> str:
+        nonlocal called
+        called = True
+        await asyncio.sleep(0)
+        return request.candidates[0].id
+
+    result = await ExistingDecisionProvider(select, name="legacy-allocator").decide(
+        _request("a", "b")
+    )
+
+    assert called
+    assert result.provider == "legacy-allocator"
+    assert result.selected == "a"
+
+
+@pytest.mark.asyncio
+async def test_single_candidate_is_valid_and_selector_runs_once() -> None:
+    calls = 0
+
+    def select(request: DecisionRequest) -> str:
+        nonlocal calls
+        calls += 1
+        return request.candidates[0].id
+
+    result = await ExistingDecisionProvider(select).decide(_request("only"))
+
+    assert calls == 1
+    assert result.selected == "only"
+    assert result.scores[0].probability == 1.0
+    assert result.margin == 1.0
+
+
+@pytest.mark.asyncio
+async def test_rejects_unknown_or_empty_selector_result() -> None:
+    for value in ("missing", "", 1):
+        with pytest.raises(ContractError, match="selector"):
+            await ExistingDecisionProvider(lambda _request, value=value: value).decide(
+                _request("a", "b")
+            )
+
+
+@pytest.mark.asyncio
+async def test_rejects_non_request() -> None:
+    with pytest.raises(TypeError, match="DecisionRequest"):
+        await ExistingDecisionProvider(lambda _request: "a").decide(object())  # type: ignore[arg-type]
+
+
+def test_rejects_invalid_constructor_arguments() -> None:
+    with pytest.raises(TypeError, match="callable"):
+        ExistingDecisionProvider(None)  # type: ignore[arg-type]
+    with pytest.raises(ValueError, match="non-empty"):
+        ExistingDecisionProvider(lambda _request: "a", name=" ")
