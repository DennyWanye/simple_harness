{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.simpleharness.invalid/assurance/1.1/criterion-policy-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mission_id",
    "requirements_ref",
    "scope_hash",
    "criteria",
    "approval_receipt_ref",
    "adapter_version"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "mission_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "requirements_ref": {
      "$ref": "common.schema.json#/$defs/pin"
    },
    "scope_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion_id",
          "mode",
          "any_check_sets"
        ],
        "properties": {
          "criterion_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "mode": {
            "enum": [
              "SEMANTIC",
              "CHECKED"
            ]
          },
          "any_check_sets": {
            "type": "array",
            "minItems": 0,
            "maxItems": 16,
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "items": {
                "allOf": [
                  {
                    "$ref": "common.schema.json#/$defs/ref"
                  },
                  {
                    "properties": {
                      "kind": {
                        "enum": [
                          "check_spec"
                        ]
                      }
                    }
                  }
                ]
              },
              "uniqueItems": true
            },
            "uniqueItems": true
          }
        }
      },
      "uniqueItems": true
    },
    "approval_receipt_ref": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/ref"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "commit_receipt"
              ]
            }
          }
        }
      ]
    },
    "adapter_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    }
  }
}
