+#!/usr/bin/env python3
+"""Static partial-registry diagnostic. Never imports the runner or grants readiness.
+
+This adapter reads declarations, not arbitrary Python runtime semantics. Unsupported
+expressions require review. The existing strict readiness binder remains separate.
+"""
+from __future__ import annotations
+import argparse
+import ast
+import json
+from pathlib import Path, PurePosixPath
+from capture_sources import digest
+from collection_identity import expand_selector, executed_fingerprint, relative_test_path
+from h1h_manifest import literal, verified_snapshot, write_new
+
+SYMBOLS = {'IMPLEMENTED_NODEIDS', 'MATCHED', 'PARTIAL', 'SUPPORTING_NODEIDS'}
+
+
+def selector_path(value: str) -> str:
+    if not isinstance(value, str) or not value or '\\' in value or '\x00' in value:
+        raise ValueError('invalid selector')
+    rel = value.split('::', 1)[0]
+    path = PurePosixPath(rel)
+    if path.is_absolute() or '..' in path.parts or ':' in rel or not rel.endswith('.py') or str(path) != rel:
+        raise ValueError('selector must have canonical relative Python path')
+    if '::' in value and any(not part for part in value.split('::')[1:]):
+        raise ValueError('empty selector component')
+    return rel
+
+
+def read_declarations(raw: str, expected: set[str]) -> list[dict]:
+    tree = ast.parse(raw)
+    definitions = {}
+    allowed_targets = set()
+    for statement in tree.body:
+        if isinstance(statement, ast.Assign) and len(statement.targets) == 1:
+            target, value = statement.targets[0], statement.value
+        elif isinstance(statement, ast.AnnAssign):
+            target, value = statement.target, statement.value
+        else:
+            continue
+        if isinstance(target, ast.Name) and target.id in SYMBOLS:
+            if target.id in definitions or value is None:
+                raise ValueError('missing value or reassigned registry')
+            definitions[target.id] = value
+            allowed_targets.add(id(target))
+    if set(definitions) != SYMBOLS:
+        raise ValueError('required declarations missing')
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Name) and node.id in SYMBOLS and isinstance(node.ctx, (ast.Store, ast.Del)) and id(node) not in allowed_targets:
+            raise ValueError('reassigned registry')
+        if isinstance(node, (ast.Subscript, ast.Attribute)) and isinstance(node.ctx, (ast.Store, ast.Del)):
+            if any(isinstance(n, ast.Name) and n.id in SYMBOLS for n in ast.walk(node.value)):
+                raise ValueError('registry mutation')
+        if isinstance(node, ast.Call) and isinstance(node.func, ast.Attribute):
+            if isinstance(node.func.value, ast.Name) and node.func.value.id in SYMBOLS and node.func.attr not in {'get', 'items', 'keys', 'values'}:
+                raise ValueError('unsupported registry method')
+    values = {}
+    for name, expression in definitions.items():
+        if name in {'MATCHED', 'PARTIAL'}:
+            if not (isinstance(expression, ast.Call) and isinstance(expression.func, ast.Name)
+                    and expression.func.id == 'frozenset' and len(expression.args) == 1 and not expression.keywords):
+                raise ValueError('expected literal frozenset declaration')
+            expression = expression.args[0]
+        # No name aliases, imports, eval, comprehensions or function calls.
+        values[name] = literal(expression, {})
+    primary, support = values['IMPLEMENTED_NODEIDS'], values['SUPPORTING_NODEIDS']
+    if not isinstance(primary, dict) or set(primary) != expected:
+        raise ValueError('case set differs from specification')
+    if not isinstance(support, dict) or not set(support) <= expected:
+        raise ValueError('unknown supporting case')
+    groups = []
+    for name in ('MATCHED', 'PARTIAL'):
+        group = values[name]
+        if not isinstance(group, list) or any(not isinstance(x, str) for x in group) or len(group) != len(set(group)) or not set(group) <= expected:
+            raise ValueError('invalid coverage group')
+        groups.append(set(group))
+    matched, partial = groups
+    if matched & partial:
+        raise ValueError('overlapping coverage groups')
+    rows = []
+    for case_id, target in sorted(primary.items()):
+        if target is not None:
+            selector_path(target)
+        additions = support.get(case_id, [])
+        if not isinstance(additions, list) or any(not isinstance(s, str) for s in additions) or len(additions) != len(set(additions)):
+            raise ValueError('invalid supporting selectors')
+        for value in additions:
+            selector_path(value)
+        rows.append({'id': case_id, 'selector': target, 'supporting_selectors': additions,
+                     'declared_coverage': 'MATCH' if case_id in matched else 'PARTIAL' if case_id in partial else 'MISMATCH'})
+    return rows
+
+
+def bind(rows: list[dict], collection: dict, source: dict, root: Path) -> dict:
+    fp = source['repositories']['candidate']['fingerprint']
+    variant = executed_fingerprint(source)
+    if collection.get('candidate_fingerprint') != fp or collection.get('executed_source_fingerprint') != variant:
+        raise ValueError('source fingerprint mismatch')
+    if (collection.get('schema_version') != 2 or collection.get('kind') != 'PYTEST_COLLECTION_ONLY'
+            or collection.get('collection_exitstatus') != 0 or collection.get('collection_errors') != []
+            or collection.get('deselected') != [] or collection.get('sdk_tests_executed') is not False):
+        raise ValueError('receipt is not complete successful collection only')
+    if collection.get('rootdir_physical') != str(root.resolve()):
+        raise ValueError('collection physical root mismatch')
+    nodeids, items = collection.get('nodeids'), collection.get('items')
+    if not isinstance(nodeids, list) or any(not isinstance(n, str) for n in nodeids) or len(nodeids) != len(set(nodeids)):
+        raise ValueError('invalid or duplicate nodeids')
+    if not isinstance(items, list) or any(not isinstance(i, dict) for i in items):
+        raise ValueError('invalid metadata')
+    ids = [i.get('nodeid') for i in items]
+    if any(not isinstance(n, str) for n in ids) or len(ids) != len(set(ids)) or set(ids) != set(nodeids):
+        raise ValueError('metadata does not cover collection exactly')
+    captured = {f['path']: f['sha256'] for f in source['snapshot']['files']}
+    for item in items:
+        rel = selector_path(item['nodeid'])
+        if rel != item.get('source_path') or rel not in captured or item.get('source_sha256') != captured[rel]:
+            raise ValueError('collected source mismatch')
+        base = item.get('base_nodeid')
+        if not isinstance(base, str) or relative_test_path(base) != rel or type(item.get('parametrized')) is not bool:
+            raise ValueError('invalid Function metadata')
+        if item['parametrized']:
+            if item.get('identity_source') != 'PYTEST_FUNCTION_ORIGINALNAME' or not isinstance(item.get('parameter_id'), str):
+                raise ValueError('unproven parameter identity')
+            if item['nodeid'] != base + '[' + item['parameter_id'] + ']':
+                raise ValueError('parameter identity mismatch')
+        elif base != item['nodeid'] or item.get('parameter_id') is not None:
+            raise ValueError('nonparameter identity mismatch')
+    results = []
+    for row in rows:
+        expansions, missing, actual = [], [], []
+        targets = ([('primary', row['selector'])] if row['selector'] is not None else [])
+        targets += [('supporting', value) for value in row['supporting_selectors']]
+        for role, selector in targets:
+            rel = selector_path(selector)
+            if rel not in captured:
+                raise ValueError('selector source was not captured')
+            if '::' in selector:
+                nodes, mode = expand_selector(selector, collection)
+            else:
+                nodes = sorted(i['nodeid'] for i in items if i['source_path'] == selector)
+                mode = 'EXACT_COLLECTED_FILE'
+            if not nodes:
+                missing.append(selector)
+            expansions.append({'role': role, 'selector': selector, 'mode': mode, 'nodeids': nodes})
+            actual.extend(nodes)
+        results.append({**row, 'selector_expansions': expansions, 'actual_nodeids': sorted(set(actual)),
+                        'missing_selectors': missing, 'execution_status': 'NOT_RUN', 'assertion_coverage_review': 'PENDING',
+                        'collection_status': 'NOT_COVERED_NO_TARGET' if row['selector'] is None else 'BLOCKED_MISSING_SELECTOR' if missing else 'COLLECTED_NOT_RUN'})
+    return {'kind': 'DIAGNOSTIC_PARTIAL_H1H_COLLECTION_NOT_GATE', 'candidate_fingerprint': fp,
+            'executed_source_fingerprint': variant, 'cases': results, 'case_count': len(results),
+            'collected_item_count': len(nodeids), 'execution_status': 'NOT_RUN', 'sdk_pass_cases': 0,
+            'h1_h_ready': False, 'production_enablement_allowed': False}
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    for key in ('source-map', 'spec', 'collection', 'out'):
+        parser.add_argument('--' + key, type=Path, required=True)
+    parser.add_argument('--runner-relative', default='tests/orchestrator/full_target/h1h_stage_runner.py')
+    args = parser.parse_args()
+    source, root = verified_snapshot(args.source_map)
+    spec = json.loads(args.spec.read_text())
+    expected = {c['id'] for c in spec['cases']}
+    if len(expected) != 36 or len(spec['cases']) != 36:
+        raise ValueError('exact 36 case specification required')
+    rel = selector_path(args.runner_relative)
+    if '::' in args.runner_relative:
+        raise ValueError('runner must be a file')
+    path = (root / rel).resolve(strict=True)
+    captured = {f['path']: f['sha256'] for f in source['snapshot']['files']}
+    raw = path.read_bytes()
+    if not path.is_relative_to(root) or captured.get(rel) != digest(raw):
+        raise ValueError('runner is not the captured source')
+    rows = read_declarations(raw.decode(), expected)
+    result = bind(rows, json.loads(args.collection.read_text()), source, root)
+    result.update({'runner_relative_path': rel, 'registry_sha256': digest(raw)})
+    verified_snapshot(args.source_map)
+    write_new(args.out, result, args.source_map.parent)
+    print(json.dumps({key: result[key] for key in ('kind', 'case_count', 'collected_item_count', 'sdk_pass_cases', 'h1_h_ready')}))
+
+
+if __name__ == '__main__':
+    main()
