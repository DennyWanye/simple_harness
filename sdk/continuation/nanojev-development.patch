+    async def _observe_decision(
+        self,
+        mission: Mission,
+        tasks: Sequence[Task],
+        attempts: Sequence[Attempt],
+        plan: AllocationPlan | AllocationPlanV2,
+    ) -> None:
+        """Offer an already-computed allocation to an optional Host observer.
+
+        The observer is deliberately after ``allocate()``/``allocate_v2()`` and receives
+        no authority over the returned plan.  For v2, only the Task rows represented by
+        ``AllocationPlanV2.scores`` are passed: that set is the allocator's admitted,
+        pressure-filtered frontier and avoids exposing compounds/refusals as candidates.
+        If the plan references a Task that was not present in the caller snapshot, the
+        data cannot be assembled without inventing a default; record a blocker and skip
+        observation.  A missing observer, provider failure or malformed callback is
+        isolated to the observation path so scheduling behavior remains unchanged.
+        """
+
+        observer = self._decision_observer
+        if observer is None:
+            return
+        observed_tasks: Sequence[Task] = tasks
+        if isinstance(plan, AllocationPlanV2):
+            eligible_ids = {str(task_id) for task_id in plan.scores}
+            if not eligible_ids:
+                return
+            by_id = {task.id: task for task in tasks}
+            missing = sorted(eligible_ids.difference(by_id))
+            if missing:
+                self._note(
+                    "decision shadow observer skipped for v2: "
+                    "allocator score references missing Task rows "
+                    f"{missing!r} (cannot assemble admission data losslessly)"
+                )
+                return
+            observed_tasks = tuple(task for task in tasks if task.id in eligible_ids)
+            if len(observed_tasks) != len(eligible_ids):
+                self._note(
+                    "decision shadow observer skipped for v2: "
+                    "allocator score/task identity is not one-to-one "
+                    "(cannot assemble admission data losslessly)"
+                )
+                return
+        try:
+            result = observer(mission, observed_tasks, attempts, plan)
+            if asyncio.iscoroutine(result) or isinstance(result, Awaitable):
+                # The production allocation must not wait for a shadow provider.  Keep a
+                # strong reference until completion so the task can finish and journal its
+                # observation, while routing any late exception through the same note path.
+                task = asyncio.ensure_future(result)
+                self._decision_observer_tasks.add(task)
+                task.add_done_callback(self._finish_decision_observer)
+        except Exception as error:  # noqa: BLE001 - Shadow must never stop allocation
+            self._note(
+                f"decision shadow observer failed for mission {mission.id}: "
+                f"{type(error).__name__}: {error}"
+            )
+
+    def _finish_decision_observer(self, task: asyncio.Future[Any]) -> None:
+        self._decision_observer_tasks.discard(task)
+        if task.cancelled():
+            return
+        try:
+            task.result()
+        except Exception as error:  # noqa: BLE001 - Shadow remains fail-open
+            self._note(
+                f"decision shadow observer failed asynchronously: "
+                f"{type(error).__name__}: {error}"
+            )
