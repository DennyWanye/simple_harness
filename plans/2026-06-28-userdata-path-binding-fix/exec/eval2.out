   60: /// Portable-mode userdata dir: when running from a frozen install, data
   61: /// lives in `<install>/userdata/` next to the exe (mirrors Python
   62: /// `backend/paths.py::_portable_userdata_dir`). Returns None in dev mode
   63: /// (current_exe isn't in the install layout) or when userdata/ is not writable.
   64: ///
   65: /// Layout: `<install>/deskpet.exe` + `<install>/userdata/`; the backend
   66: /// exe sits at `<install>/backend/deskpet-backend.exe`, so we also check
   67: /// one level up when the exe's parent is named "backend".
   68: fn portable_userdata_dir_from_exe(exe: &Path) -> Option<PathBuf> {
   69:     let parent = exe.parent()?;
   70:     let root = if parent
