def test_openai_compatible_empty_or_placeholder_cloud_raises(api_key: str):
    """闈炴湰鍦?endpoint + 绌?鍗犱綅绗?key 鈫?_client() 鎶?LLMProviderError锛?    error_class=empty_api_key锛堜笉鏋勯€?client銆佷笉鍙戣姹傘€佷笉鎷肩┖ Bearer锛夈€?""
