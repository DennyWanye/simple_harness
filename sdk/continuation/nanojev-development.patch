+# SPDX-FileCopyrightText: 2026 DennyWanye
+# SPDX-License-Identifier: Apache-2.0
+
+"""Lifecycle wrapper that turns the packaged scorer into a resident runtime.
+
+This module is the *lifecycle* half of the runtime split: :mod:`local_runtime`
+owns start/evaluate/close, admission of a runtime request into a single frozen
+question, the thread boundary that keeps a device-bound forward pass off the
+event loop, and the bounded patience around physical inference.  It owns no
+checkpoint code, no tokenizer, and no tensor maths — :mod:`nanojev_inference`
+does, and a future MLX runtime can replace it without the provider noticing.
+
+Two hard properties are the whole point of the file:
+
+* **The torch import is deferred.**  Constructing this runtime, and importing
+  this module, must never import ``torch``/``transformers``.  The SDK stays
+  importable on a machine that never installed the ``nanojev`` extra; only
+  :meth:`LocalNanoJevRuntime.start` inside the worker child pays that cost.
+* **Patience is bounded without abandoning work.**  A forward pass is shielded
+  because a thread cannot be cancelled.  On timeout the runtime stops waiting
+  but still awaits the worker's own cleanup before releasing the inference
+  lease, so physical inference never overlaps itself and a late result can never
+  be handed back as if it were on time.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import math
+import os
+from collections.abc import Mapping, Sequence
+from concurrent.futures import Executor
+from pathlib import Path
+from typing import Any
+
+from .nanojev_inference import (
+    BOOLEAN_CANDIDATE_IDS,
+    BOOLEAN_CANDIDATE_TEXT,
+    CandidateQuestion,
+    InferenceReport,
+    NanoJevDecisionScorer,
+    NanoJevDependencyError,
+    NanoJevInferenceError,
+    question_kind_of,
+)
+from .runtime import NanoJevOutput, NanoJevRequest, NanoJevRuntime
+from .types import DecisionType
+
+#: Token used by :attr:`NanoJevOutput.model_version` when the checkpoint's
+#: ``config.json`` does not name a model.  Exported as a constant so the runtime
+#: does not have to invent an opacity at the call site.
+DEFAULT_MODEL_VERSION = "nanojev-local"
+
+#: Context keys the runtime reads.  ``state``/``instructions`` are required —
+#: they are the two prompt segments the checkpoint was trained against
+#: (``State:\n{state}\n`` / ``Question type: ...\nQuestion:\n{instructions}\n``)
+#: and the runtime cannot guess which free-form context keys play those roles.
+#: ``criteria`` and ``candidates`` are alternative descriptions of the same
+#: frozen candidate set; when neither is present the request's own
+#: ``candidates[].label`` values are used instead.
+_STATE_KEYS = ("state", "state_text")
+_INSTRUCTION_KEYS = ("instructions", "instruction")
+_CRITERION_KEYS = ("criteria", "boolean_criteria")
+_CANDIDATE_TEXT_KEYS = ("candidates", "candidate_descriptions", "candidate_texts")
+_CANDIDATE_ID_KEYS = ("candidate_ids", "candidate_labels", "candidate_texts")
+
+#: ``criteria`` may be a Boolean mapping (``{"true": ..., "false": ...}``) or a
+#: per-candidate description mapping; both name keys the runtime already knows.
+_FALSE_TRUE_KEYS = frozenset({"false", "true"})
+
+
+class LocalNanoJevRuntime(NanoJevRuntime):
+    """A resident local NanoJev runtime: one scorer load, many decisions.
+
+    The constructor validates arguments eagerly — a bad device or a
+    non-positive timeout is a programming error and must fail before any
+    decision is attempted — but does **not** load a checkpoint, and does **not**
+    import torch.  Device residency is established by :meth:`start`, which the
+    caller runs inside the inference worker child.
+
+    Args:
+        checkpoint_dir: Checkpoint root containing ``config.json``,
+            ``best.safetensors``, ``backbone_config/`` and ``tokenizer/``.
+        implementation_dir: Reserved for an alternative implementation root.
+            Recognised and validated; currently unused, so the scorer is always
+            loaded from the packaged :mod:`nanojev_inference`.
+        device: Requested compute device (``"mps"``, ``"cpu"`` or ``"cuda"``).
+            The scorer performs the real placement and reports any fallback.
+        allow_cpu_fallback: Whether a request for an unavailable accelerator may
+            silently (but audibly, via the scorer's diagnostics) degrade to CPU.
+        max_length: Token budget for one candidate path.  Bounded rather than
+            truncated: an over-long path raises in the scorer.
+        inference_timeout_seconds: Patience for one logical decision.  Must be a
+            finite positive number.
+        max_concurrency: How many physical forwards may be in flight at once.
+            This is the admission bound, not a batching hint.
+    """
+
+    def __init__(
+        self,
+        checkpoint_dir: str | os.PathLike[str],
+        *,
+        implementation_dir: str | os.PathLike[str] | None = None,
+        device: str = "mps",
+        allow_cpu_fallback: bool = True,
+        max_length: int = 512,
+        inference_timeout_seconds: float = 120.0,
+        max_concurrency: int = 1,
+        executor: Executor | None = None,
+    ) -> None:
+        self._checkpoint_dir = self._as_path(checkpoint_dir, "checkpoint_dir", required=True)
+        self._implementation_dir = self._as_path(
+            implementation_dir, "implementation_dir", required=False
+        )
+        if not isinstance(device, str) or not device.strip():
+            raise ValueError("device must be a non-empty string")
+        if not isinstance(allow_cpu_fallback, bool):
+            raise TypeError("allow_cpu_fallback must be a bool")
+        if type(max_length) is not int or max_length <= 0:
+            raise ValueError("max_length must be a positive integer")
+        if isinstance(inference_timeout_seconds, bool) or not isinstance(
+            inference_timeout_seconds, (int, float)
+        ):
+            raise TypeError("inference_timeout_seconds must be a number")
+        timeout = float(inference_timeout_seconds)
+        if not math.isfinite(timeout) or timeout <= 0.0:
+            raise ValueError(
+                "inference_timeout_seconds must be a finite positive number"
+            )
+        if type(max_concurrency) is not int or max_concurrency <= 0:
+            raise ValueError("max_concurrency must be a positive integer")
+        if executor is not None and not isinstance(executor, Executor):
+            raise TypeError("executor must be a concurrent.futures.Executor")
+
+        self.device = device
+        self.allow_cpu_fallback = allow_cpu_fallback
+        self.max_length = max_length
+        self.inference_timeout_seconds = timeout
+        self.max_concurrency = max_concurrency
+
+        self._executor = executor
+        self._semaphore = asyncio.Semaphore(max_concurrency)
+        self._scorer: NanoJevDecisionScorer | None = None
+        self._pending: set[asyncio.Task[Any]] = set()
+        self._closed = False
+
+    # -- properties -------------------------------------------------------
+
+    @property
+    def checkpoint_dir(self) -> Path:
+        """Checkpoint root this runtime would load (absolute, unresolved links)."""
+        return self._checkpoint_dir
+
+    @property
+    def implementation_dir(self) -> Path | None:
+        """Implementation root if one was supplied; ``None`` for the packaged one."""
+        return self._implementation_dir
+
+    @property
+    def started(self) -> bool:
+        """Whether a scorer is resident and this runtime has not been closed."""
+        return self._scorer is not None
+
+    @property
+    def closed(self) -> bool:
+        return self._closed
+
+    # -- lifecycle --------------------------------------------------------
+
+    async def start(self) -> None:
+        """Load the resident scorer once, off the event loop.
+
+        Idempotent: a second call while started is a no-op.  The import of
+        :mod:`nanojev_inference`'s torch-backed scorer happens *here*, and the
+        constructor (checkpoint read, weights, device placement) runs in the
+        executor so a 2.4 GB load never blocks the caller's loop.
+        """
+        self._raise_if_closed("start")
+        if self._scorer is not None:
+            return
+        loop = asyncio.get_running_loop()
+        self._scorer = await loop.run_in_executor(self._executor, self._load_scorer)
+
+    async def close(self) -> None:
+        """Wait out in-flight work, then release the resident model.
+
+        Pending decisions are awaited because releasing device memory under a
+        live forward pass would corrupt that pass's result.  Close is therefore
+        patient, not abrupt; it is idempotent and safe to call without a start.
+        """
+        self._closed = True
+        if self._pending:
+            await asyncio.gather(*tuple(self._pending), return_exceptions=True)
+        scorer, self._scorer = self._scorer, None
+        if scorer is None:
+            return
+        closer = getattr(scorer, "close", None)
+        if callable(closer):
+            loop = asyncio.get_running_loop()
+            await loop.run_in_executor(self._executor, closer)
+
+    async def evaluate(self, request: NanoJevRequest) -> NanoJevOutput:
+        """Answer one decision request with the resident scorer.
+
+        The request is admitted first (see :meth:`_question_for`), then scored as
+        a single question in a single state, so the report's question order and
+        candidate order are the request's own.  The physical forward pass is
+        bounded by the runtime's semaphore and its timeout.
+
+        Raises:
+            RuntimeError: if the runtime was not started, or was closed.
+            NanoJevInferenceError: if the request cannot be expressed as a
+                scored question, if inference timed out, or if the scorer's
+                answer fails the output contract.
+        """
+        self._raise_if_closed("evaluate")
+        if not isinstance(request, NanoJevRequest):
+            raise TypeError("request must be a NanoJevRequest")
+        scorer = self._scorer
+        if scorer is None:
+            raise RuntimeError("NanoJev runtime is not started; call start() first")
+        question = self._question_for(request)
+        report = await self._score(
+            scorer, ((request.decision_id, self._state_text(request.context), (question,)),)
+        )
+        scored = self._first_scored_question(report, request.decision_id)
+        return self._to_output(scored, report, request)
+
+    # -- admission --------------------------------------------------------
+
+    def _question_for(self, request: NanoJevRequest) -> CandidateQuestion:
+        """Translate a runtime request into one frozen candidate question.
+
+        Refusals are explicit and happen before any device work: an unknown
+        decision type, a candidate list that is not the canonical Boolean pair,
+        a missing/empty state, or missing instructions.
+        """
+        decision_type = DecisionType(request.decision_type)
+        context = request.context
+        identifiers = tuple(self._candidate_id(item) for item in request.candidates)
+        if len(set(identifiers)) != len(identifiers):
+            raise NanoJevInferenceError("runtime request repeats a candidate id")
+
+        # Admission checks state/instructions before anything device-bound runs.
+        self._first_text(context, _STATE_KEYS, "state", required=True)
+        instructions = self._first_text(
+            context, _INSTRUCTION_KEYS, "instructions", required=True
+        )
+
+        # A partial Boolean candidate set is judged here rather than inferred by
+        # ``question_kind_of``: a lone ``"true"``/``"false"`` is not a Boolean
+        # pair, so the derived kind would be "choice" and the half-asked question
+        # would be handed to the scorer as a generic two-text question.  The
+        # exact pair is required, and required before any device work.
+        partial_boolean = set(identifiers) & set(BOOLEAN_CANDIDATE_IDS)
+        if partial_boolean and identifiers != BOOLEAN_CANDIDATE_IDS:
+            raise NanoJevInferenceError(
+                "Boolean runtime requests must use exactly the candidate ids "
+                f"{BOOLEAN_CANDIDATE_IDS!r}; a partial Boolean question cannot be "
+                "scored, because the model answers it as one semantic path"
+            )
+
+        kind = question_kind_of(identifiers)
+        if kind == "boolean":
+            return self._boolean_question(request, identifiers, instructions)
+        texts = self._candidate_texts(context, request.candidates, identifiers)
+        if texts is None:
+            raise NanoJevInferenceError(
+                "runtime request candidates must be described: give each candidate "
+                "a non-empty 'label', or provide "
+                f"context[{_CANDIDATE_TEXT_KEYS[0]!r}] or a context[{_CRITERION_KEYS[0]!r}] "
+                "mapping keyed by candidate id"
+            )
+        return CandidateQuestion(
+            question_id=decision_type.value,
+            instructions=instructions,
+            candidate_ids=identifiers,
+            candidate_texts=texts,
+        )
+
+    def _boolean_question(
+        self, request: NanoJevRequest, identifiers: tuple[str, ...], instructions: str
+    ) -> CandidateQuestion:
+        """Build the canonical Boolean question, refusing a half-Boolean request."""
+        if identifiers != BOOLEAN_CANDIDATE_IDS:
+            raise NanoJevInferenceError(
+                "Boolean runtime requests must use exactly the candidate ids "
+                f"{BOOLEAN_CANDIDATE_IDS!r}; a partial Boolean question cannot be "
+                "scored, because the model answers it as one semantic path"
+            )
+        criteria = self._boolean_criteria(request.context)
+        return CandidateQuestion(
+            question_id=DecisionType(request.decision_type).value,
+            instructions=instructions,
+            candidate_ids=identifiers,
+            candidate_texts=(BOOLEAN_CANDIDATE_TEXT,),
+            boolean_criteria=criteria,
+        )
+
+    def _boolean_criteria(self, context: Mapping[str, Any]) -> Mapping[str, str] | None:
+        """Boolean proposition text, if the context supplies it.
+
+        ``criteria``/``boolean_criteria`` is accepted in both of the shapes the
+        layer already uses: a ``{"false": ..., "true": ...}`` mapping, or the
+        candidate-description mapping the non-Boolean path also reads.  Nothing
+        is invented for absent keys — the prompt simply omits the line.
+        """
+        raw = self._criterion_mapping(context)
+        if raw is None:
+            return None
+        criteria: dict[str, str] = {}
+        for key in ("false", "true"):
+            value = raw.get(key)
+            if isinstance(value, str) and value.strip():
+                criteria[key] = value
+        return criteria or None
+
+    def _candidate_texts(
+        self,
+        context: Mapping[str, Any],
+        candidates: Sequence[Any],
+        identifiers: tuple[str, ...],
+    ) -> tuple[str, ...] | None:
+        """Candidate descriptions in candidate order.
+
+        Three sources are tried, in order of decreasing specificity: a
+        ``criteria`` mapping keyed by candidate id, a ``candidates`` sequence in
+        the context, and finally the request's **own** ``candidates[].label``.
+
+        The request's labels are a legitimate source rather than invention: they
+        are the candidate descriptions the caller already declared on the
+        :class:`~.runtime.NanoJevRequest`, and the provider forwards exactly the
+        ``id``/``label``/``metadata`` it was given.  A context that describes its
+        candidates always wins, so a caller that wants a different phrasing keeps
+        full control; a caller that supplies only labels (the common case) is no
+        longer refused for leaving the context silent about its candidates.
+
+        A source that describes *some* candidates is not accepted: a half
+        described candidate set would be scored as if the undescribed candidates
+        were equal.
+        """
+        mapping = self._criterion_mapping(context)
+        if mapping is not None:
+            texts: list[str] = []
+            for identifier in identifiers:
+                value = mapping.get(identifier)
+                if not isinstance(value, str) or not value.strip():
+                    return None
+                texts.append(value)
+            return tuple(texts)
+        for key in _CANDIDATE_TEXT_KEYS:
+            value = context.get(key)
+            if value is None:
+                continue
+            sequence = self._as_sequence(value)
+            if sequence is None:
+                continue
+            if len(sequence) != len(identifiers):
+                return None
+            texts = []
+            for item in sequence:
+                if isinstance(item, str) and item.strip():
+                    texts.append(item)
+                    continue
+                label = self._candidate_label(item)
+                if label is None:
+                    return None
+                texts.append(label)
+            return tuple(texts)
+        return self._candidate_texts_from_candidates(candidates, identifiers)
+
+    def _candidate_texts_from_candidates(
+        self, candidates: Sequence[Any], identifiers: tuple[str, ...]
+    ) -> tuple[str, ...] | None:
+        """The request's own declared labels, in candidate order.
+
+        Checked positionally against ``identifiers`` so a reordered or mismatched
+        candidate list cannot silently pair a label with the wrong id; the
+        ``id`` and ``label`` must come from the same entry.
+        """
+        if len(candidates) != len(identifiers):
+            return None
+        texts: list[str] = []
+        for identifier, candidate in zip(identifiers, candidates):
+            if self._candidate_id(candidate) != identifier:
+                return None
+            label = self._candidate_label(candidate)
+            if label is None:
+                return None
+            texts.append(label)
+        return tuple(texts)
+        return None
+
+    def _criterion_mapping(self, context: Mapping[str, Any]) -> Mapping[str, Any] | None:
+        """The first criterion mapping present in the context, if any.
+
+        A ``{"false": ..., "true": ...}`` mapping is *not* a candidate
+        description for a non-Boolean question, so it is skipped there.
+        """
+        for key in _CRITERION_KEYS:
+            value = context.get(key)
+            if isinstance(value, Mapping):
+                if set(value) <= _FALSE_TRUE_KEYS:
+                    return value
+                return value
+        return None
+
+    # -- scoring ----------------------------------------------------------
+
+    async def _score(
+        self,
+        scorer: NanoJevDecisionScorer,
+        states: Sequence[tuple[str, str, Sequence[CandidateQuestion]]],
+    ) -> InferenceReport:
+        """Run one physical inference under the runtime's bounds.
+
+        The forward pass is shielded and moved to the executor: shielding means a
+        timeout stops *waiting* without cancelling the thread, and the lease is
+        only released once the worker is actually done, so no second forward can
+        overlap it and a late result is never mistaken for a timely one.
+        """
+        async with self._semaphore:
+            self._raise_if_closed("evaluate")
+            worker = asyncio.ensure_future(
+                asyncio.get_running_loop().run_in_executor(
+                    self._executor, lambda: scorer.score(states)
+                )
+            )
+            self._pending.add(worker)
+            try:
+                report = await asyncio.wait_for(
+                    asyncio.shield(worker), self.inference_timeout_seconds
+                )
+            except TimeoutError as error:
+                raise NanoJevInferenceError(
+                    "NanoJev inference exceeded its "
+                    f"{self.inference_timeout_seconds:g}s patience for a single decision"
+                ) from error
+            finally:
+                if not worker.done():
+                    # Bounded: only the *outcome* is abandoned, and the worker's
+                    # own completion (or failure) is absorbed so no exception is
+                    # reported as unretrieved and the semaphore is not released
+                    # underneath a live forward pass.
+                    worker.add_done_callback(_absorb_worker_outcome)
+                    try:
+                        await asyncio.shield(worker)
+                    except asyncio.CancelledError:
+                        raise
+                    except BaseException:  # noqa: BLE001 - absorbed, see docstring
+                        pass
+                self._pending.discard(worker)
+        if not isinstance(report, InferenceReport):
+            raise NanoJevInferenceError("NanoJev scorer returned a malformed report")
+        return report
+
+    @staticmethod
+    def _first_scored_question(report: InferenceReport, state_id: str) -> Any:
+        """The request's own question from the report, identified by state id.
+
+        Taken from the single state the runtime submitted, so the report cannot
+        smuggle in an answer to a question nobody asked.
+        """
+        for state in report.states:
+            if state.state_id != state_id:
+                continue
+            if not state.questions:
+                break
+            return state.questions[0]
+        raise NanoJevInferenceError(
+            f"NanoJev report carries no scored question for {state_id!r}"
+        )
+
+    # -- output -----------------------------------------------------------
+
+    def _to_output(
+        self,
+        scored: Any,
+        report: InferenceReport,
+        request: NanoJevRequest,
+    ) -> NanoJevOutput:
+        """Map the scored question onto the runtime contract, validating it.
+
+        The candidate id/order echo is checked against the request before the
+        probabilities are trusted, and the probabilities themselves must be
+        finite and normalised.  A distribution failing either check is refused
+        rather than repaired.
+        """
+        identifiers = tuple(self._candidate_id(item) for item in request.candidates)
+        if tuple(scored.candidate_ids) != identifiers:
+            raise NanoJevInferenceError(
+                "NanoJev scorer answered a different candidate set than the request: "
+                f"expected {identifiers!r}, got {tuple(scored.candidate_ids)!r}"
+            )
+        probabilities = tuple(float(value) for value in scored.probabilities)
+        if len(probabilities) != len(identifiers):
+            raise NanoJevInferenceError(
+                "NanoJev scorer returned a different number of probabilities than candidates"
+            )
+        for value in probabilities:
+            if not math.isfinite(value):
+                raise NanoJevInferenceError(
+                    "NanoJev scorer returned a non-finite probability"
+                )
+            if not 0.0 <= value <= 1.0:
+                raise NanoJevInferenceError(
+                    f"NanoJev scorer returned a probability outside [0, 1]: {value!r}"
+                )
+        total = math.fsum(probabilities)
+        if abs(total - 1.0) > 1e-5:
+            raise NanoJevInferenceError(
+                f"NanoJev scorer probabilities must sum to 1, got {total!r}"
+            )
+        if scored.selected not in identifiers:
+            raise NanoJevInferenceError(
+                f"NanoJev scorer selected an unknown candidate: {scored.selected!r}"
+            )
+        return NanoJevOutput(
+            selected=scored.selected,
+            probabilities={
+                identifier: probability
+                for identifier, probability in zip(identifiers, probabilities)
+            },
+            model_version=self._model_version(report),
+        )
+
+    @staticmethod
+    def _model_version(report: Any) -> str:
+        """The model identity recorded on every result (plan §31/§34).
+
+        Taken from the report the scorer produced, not from the scorer object:
+        the runtime's own output must describe the inference that actually
+        happened.
+        """
+        model_id = getattr(report, "model_id", None)
+        if isinstance(model_id, str) and model_id.strip():
+            return model_id
+        return DEFAULT_MODEL_VERSION
+
+    # -- helpers ----------------------------------------------------------
+
+    @staticmethod
+    def _as_path(
+        value: str | os.PathLike[str] | None, field: str, *, required: bool
+    ) -> Path | None:
+        if value is None:
+            if required:
+                raise ValueError(f"{field} is required")
+            return None
+        if not isinstance(value, (str, os.PathLike)):
+            raise TypeError(f"{field} must be a str or os.PathLike")
+        path = Path(value)
+        if isinstance(value, str) and not value.strip():
+            raise ValueError(f"{field} must be a non-empty path")
+        return path.absolute()
+
+    @staticmethod
+    def _as_sequence(value: Any) -> Sequence[Any] | None:
+        if isinstance(value, (str, bytes, bytearray, Mapping)):
+            return None
+        if isinstance(value, Sequence):
+            return value
+        return None
+
+    @staticmethod
+    def _candidate_id(candidate: Any) -> str:
+        if isinstance(candidate, str) and candidate.strip():
+            return candidate
+        if not isinstance(candidate, Mapping):
+            raise NanoJevInferenceError("runtime request candidates must be mappings")
+        identifier = candidate.get("id")
+        if not isinstance(identifier, str) or not identifier.strip():
+            raise NanoJevInferenceError(
+                "runtime request candidate must carry a non-empty string 'id'"
+            )
+        return identifier
+
+    @staticmethod
+    def _candidate_label(candidate: Any) -> str | None:
+        if not isinstance(candidate, Mapping):
+            return None
+        for key in ("label", "text", "description"):
+            value = candidate.get(key)
+            if isinstance(value, str) and value.strip():
+                return value
+        return None
+
+    @staticmethod
+    def _first_text(
+        context: Mapping[str, Any], keys: Sequence[str], field: str, *, required: bool
+    ) -> str:
+        for key in keys:
+            value = context.get(key)
+            if isinstance(value, str) and value.strip():
+                return value
+        if required:
+            raise NanoJevInferenceError(
+                f"runtime request context must contain a non-empty {field!r} string "
+                f"(one of {tuple(keys)!r})"
+            )
+        return ""
+
+    @staticmethod
+    def _state_text(context: Mapping[str, Any]) -> str:
+        return LocalNanoJevRuntime._first_text(
+            context, _STATE_KEYS, "state", required=True
+        )
+
+    def _raise_if_closed(self, action: str) -> None:
+        if self._closed:
+            raise RuntimeError(f"NanoJev runtime is closed; cannot {action}")
+
+    def _load_scorer(self) -> NanoJevDecisionScorer:
+        """Import and construct the packaged scorer — executor-side, blocking.
+
+        Imported by name inside this method so ``import local_runtime`` stays
+        free of torch even though the module-level import above would otherwise
+        pull the definition in; the module itself defers its torch import to
+        construction, so this is a name lookup, not a second copy of the rule.
+        """
+        if self._implementation_dir is not None:
+            root = self._implementation_dir
+            if not root.exists():
+                raise NanoJevInferenceError(
+                    f"implementation_dir does not exist: {root}"
+                )
+        return NanoJevDecisionScorer(
+            self._checkpoint_dir,
+            device=self.device,
+            max_length=self.max_length,
+            allow_cpu_fallback=self.allow_cpu_fallback,
+        )
+
+
+def _absorb_worker_outcome(worker: asyncio.Future[Any]) -> None:
+    """Consume a shielded worker's result so its outcome is never 'unretrieved'."""
+    if worker.cancelled():  # pragma: no cover - the runtime never cancels it
+        return
+    worker.exception()
+
+
+#: Re-exported so callers can catch the runtime's failure modes from one place.
+RUNTIME_ERRORS: tuple[type[BaseException], ...] = (
+    NanoJevInferenceError,
+    NanoJevDependencyError,
+)
+
+__all__ = [
+    "DEFAULT_MODEL_VERSION",
+    "LocalNanoJevRuntime",
+    "RUNTIME_ERRORS",
+]
