+def test_missing_fields_duplicate_changes_and_mutable_aliases_are_rejected_or_detached():
+    raw = diff_documents(document(), document(plan_revision=PlanRevision(2))).to_json()
+    for field in raw:
+        missing = {key: value for key, value in raw.items() if key != field}
+        with pytest.raises(ContractError, match="missing or unknown"):
+            TaskGraphDiffV1.from_json(missing)
+    change = StructuralChange(
+        kind="occurrence", identity="o-a", before_hash=None, after_hash="a" * 64
+    )
+    raw["changes"] = [change.to_json(), change.to_json()]
+    with pytest.raises(ContractError, match="duplicate change"):
+        TaskGraphDiffV1.from_json(raw)
+    mutable = [change]
+    result = TaskGraphDiffV1(
+        mission_id="m",
+        from_revision=0,
+        to_revision=2**53 - 1,
+        from_manifest_hash="b" * 64,
+        to_manifest_hash="c" * 64,
+        changes=mutable,
+        complete=True,
+    )
+    mutable.clear()
+    assert result.changes == (change,)
+    with pytest.raises(FrozenInstanceError):
+        result.complete = False
+
