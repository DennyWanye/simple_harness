    "_abandon_run_authority",
    "_release_runtime_lease",
    "_drop_local_authority"
   ]
  },
  {
   "module": "spawn",
   "class": "WorkflowSpawnControlMixin",
   "doc": "Workflow spawn control: accepting spawns and registering recovered and started children.",
   "methods": [
    "_accept_workflow_spawn_control",
