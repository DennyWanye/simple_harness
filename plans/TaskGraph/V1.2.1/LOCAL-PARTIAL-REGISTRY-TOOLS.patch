+import copy
+import json
+from pathlib import Path
+import sys
+import tempfile
+import unittest
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'tools'))
+from h1h_partial_registry import read_declarations, bind, selector_path
+
+EXPECTED = {'A01', 'A02', 'A03'}
+RAW = '''
+IMPLEMENTED_NODEIDS = {'A01': 'tests/a.py', 'A02': None, 'A03': 'tests/b.py::test_b'}
+MATCHED = frozenset({'A01'})
+PARTIAL = frozenset({'A03'})
+SUPPORTING_NODEIDS = {'A02': ('tests/a.py',), 'A03': ('tests/a.py::test_a',)}
+'''
+ROOT = Path('/frozen')
+SOURCE = {'repositories': {'candidate': {'fingerprint': 'fp'}}, 'snapshot': {'files': [
+    {'path': 'tests/a.py', 'sha256': 'ha'}, {'path': 'tests/b.py', 'sha256': 'hb'},
+    {'path': 'tests/a.py_extra.py', 'sha256': 'hx'}]}}
+
+
+def receipt():
+    items = []
+    for path, name, parameter, digest in [('tests/a.py', 'test_a', None, 'ha'),
+                                         ('tests/b.py', 'test_b', 'x[y]', 'hb'),
+                                         ('tests/b.py', 'test_b', 'z', 'hb'),
+                                         ('tests/a.py_extra.py', 'test_x', None, 'hx')]:
+        base = path + '::' + name
+        items.append({'nodeid': base + '[' + parameter + ']' if parameter is not None else base,
+                      'base_nodeid': base, 'source_path': path, 'source_sha256': digest,
+                      'parametrized': parameter is not None, 'parameter_id': parameter,
+                      'identity_source': 'PYTEST_FUNCTION_ORIGINALNAME'})
+    return {'schema_version': 2, 'kind': 'PYTEST_COLLECTION_ONLY', 'candidate_fingerprint': 'fp',
+            'executed_source_fingerprint': 'fp', 'rootdir_physical': str(ROOT.resolve()),
+            'nodeids': [i['nodeid'] for i in items], 'items': items, 'deselected': [],
+            'collection_errors': [], 'collection_exitstatus': 0, 'sdk_tests_executed': False}
+
+
+class PartialRegistryTests(unittest.TestCase):
+    def test_nullable_supporting_and_coverage_remain_separate(self):
+        result = bind(read_declarations(RAW, EXPECTED), receipt(), SOURCE, ROOT)
+        a, null, partial = result['cases']
+        self.assertEqual(a['actual_nodeids'], ['tests/a.py::test_a'])
+        self.assertEqual(null['collection_status'], 'NOT_COVERED_NO_TARGET')
+        self.assertTrue(null['actual_nodeids'])
+        self.assertEqual(partial['declared_coverage'], 'PARTIAL')
+        self.assertEqual(partial['selector_expansions'][0]['nodeids'], ['tests/b.py::test_b[x[y]]', 'tests/b.py::test_b[z]'])
+        self.assertEqual(partial['selector_expansions'][1]['role'], 'supporting')
+        self.assertEqual(result['sdk_pass_cases'], 0)
+        self.assertFalse(result['h1_h_ready'])
+        self.assertTrue(all(r['execution_status'] == 'NOT_RUN' for r in result['cases']))
+
+    def test_exact_parameter_selection(self):
+        rows = read_declarations(RAW.replace('tests/b.py::test_b', 'tests/b.py::test_b[x[y]]'), EXPECTED)
+        result = bind(rows, receipt(), SOURCE, ROOT)
+        self.assertEqual(result['cases'][2]['selector_expansions'][0]['nodeids'], ['tests/b.py::test_b[x[y]]'])
+
+    def test_missing_selector_blocks(self):
+        rows = read_declarations(RAW.replace('tests/b.py::test_b', 'tests/b.py::test_missing'), EXPECTED)
+        self.assertEqual(bind(rows, receipt(), SOURCE, ROOT)['cases'][2]['collection_status'], 'BLOCKED_MISSING_SELECTOR')
+
+    def test_bad_declarations(self):
+        bad = [RAW.replace("'A02': None, ", ''), RAW.replace("'A02': None", "'A99': None"),
+               RAW.replace("'A02': None", "'A02': None, 'A02': None"),
+               RAW.replace("frozenset({'A03'})", "frozenset({'A01'})"),
+               RAW.replace("frozenset({'A03'})", "frozenset({'ZZZ'})"),
+               RAW.replace("'A02': ('tests/a.py',)", "'ZZZ': ('tests/a.py',)"),
+               RAW + '\nIMPLEMENTED_NODEIDS = {}', RAW + '\nIMPLEMENTED_NODEIDS.update({})',
+               RAW + "\nIMPLEMENTED_NODEIDS['A01'] = None",
+               RAW + '\nif True:\n    PARTIAL = frozenset({})',
+               RAW.replace("'A02': None", "'A02': factory()"),
+               RAW.replace("frozenset({'A03'})", "other({'A03'})"),
+               RAW.replace("'A02': None", "'A02': ['tests/a.py']")]
+        for raw in bad:
+            with self.subTest(raw=raw), self.assertRaises(ValueError):
+                read_declarations(raw, EXPECTED)
+
+    def test_dynamic_expression_never_runs(self):
+        with tempfile.TemporaryDirectory() as d:
+            marker = Path(d) / 'executed'
+            payload = f"__import__('pathlib').Path({str(marker)!r}).touch()"
+            with self.assertRaises(ValueError):
+                read_declarations(RAW.replace("'A02': None", "'A02': " + payload), EXPECTED)
+            self.assertFalse(marker.exists())
+
+    def test_invalid_paths(self):
+        for value in ('/tests/a.py', '../a.py', 'tests/../a.py', 'C:/a.py', 'tests\\a.py', './tests/a.py', 'tests//a.py', 'tests/a.py::', '', None):
+            with self.subTest(value=value), self.assertRaises(ValueError):
+                selector_path(value)
+
+    def test_collection_state_and_fingerprints_fail_closed(self):
+        updates = [('candidate_fingerprint', 'other'), ('executed_source_fingerprint', 'other'),
+                   ('rootdir_physical', '/other'), ('collection_exitstatus', 1),
+                   ('collection_errors', ['error']), ('deselected', ['test']), ('sdk_tests_executed', True),
+                   ('schema_version', 1), ('kind', 'TEST_RESULT')]
+        for key, value in updates:
+            for remove in (False, True):
+                c = receipt()
+                if remove:
+                    c.pop(key)
+                else:
+                    c[key] = value
+                with self.subTest(key=key, remove=remove), self.assertRaises(ValueError):
+                    bind(read_declarations(RAW, EXPECTED), c, SOURCE, ROOT)
+
+    def test_metadata_failures(self):
+        for mutation in ('missing', 'duplicate', 'duplicate_node', 'hash', 'path', 'base', 'parameter', 'proof', 'unknown_file'):
+            c = receipt()
+            if mutation == 'missing': c['items'].pop()
+            elif mutation == 'duplicate': c['items'].append(c['items'][0])
+            elif mutation == 'duplicate_node': c['nodeids'].append(c['nodeids'][0])
+            elif mutation == 'hash': c['items'][0]['source_sha256'] = 'wrong'
+            elif mutation == 'path': c['items'][0]['source_path'] = 'tests/b.py'
+            elif mutation == 'base': c['items'][0]['base_nodeid'] = 'tests/a.py::other'
+            elif mutation == 'parameter': c['items'][1]['parameter_id'] = 'wrong'
+            elif mutation == 'proof': c['items'][1]['identity_source'] = 'GUESSED'
+            elif mutation == 'unknown_file':
+                c['nodeids'][0] = c['items'][0]['nodeid'] = 'tests/unknown.py::test_a'
+                c['items'][0]['source_path'] = 'tests/unknown.py'
+            with self.subTest(mutation=mutation), self.assertRaises(ValueError):
+                bind(read_declarations(RAW, EXPECTED), c, SOURCE, ROOT)
+
+    def test_derived_source_cannot_impersonate_base(self):
+        source = copy.deepcopy(SOURCE)
+        source['snapshot']['source_variant_fingerprint'] = 'derived'
+        with self.assertRaises(ValueError):
+            bind(read_declarations(RAW, EXPECTED), receipt(), source, ROOT)
+        c = receipt(); c['executed_source_fingerprint'] = 'derived'
+        self.assertEqual(bind(read_declarations(RAW, EXPECTED), c, source, ROOT)['executed_source_fingerprint'], 'derived')
+
+
+if __name__ == '__main__':
+    unittest.main()
