+        return (
+            "localhost" in base_url
+            or "127.0.0.1" in base_url
+            or "0.0.0.0" in base_url
+        )
+
+    def _ensure_api_key_usable(self) -> None:
+        if (self._api_key or "").strip().lower() in _PLACEHOLDER_KEYS:
