    if use_template:
        slides = _degrade_to_template(slides)   # å·²æ¸…ç©?image_prompt â†?ä¸‹é¢ ppt_create ä¸ä¼šäºŒæ¬¡ç”Ÿå›¾
        return ppt_create(slides, theme=theme, title=title, author=author,
                          output_path=output_path, template=_default_category_template(),
                          skip_image_gen=True)              # åŒä¿é™?    # æƒŠè‰³è·¯å¾„ï¼šå›¾å·²ç”Ÿå¥?image_path å¡«å¥½)ï¼Œè·³è¿?ppt_create å†…éƒ¨äºŒæ¬¡ç”Ÿå›¾
    return ppt_create(slides, theme=theme, title=title, author=author,
                      output_path=output_path, skip_image_gen=True)
