+        mission_id="mt", task_id=None, ordinal=0, candidate_ids=("a",), context={}
+    )
+    assert glued != split
+
+    with_context = seam.compute_ready_task_decision_id(
+        mission_id="m", task_id=None, ordinal=0, candidate_ids=("a",), context={"1": 2}
+    )
+    without_context = seam.compute_ready_task_decision_id(
+        mission_id="m", task_id=None, ordinal=0, candidate_ids=("a",), context={}
+    )
