+            ledger = BudgetLedger(store)
+            with store.transaction():
+                assert (
+                    ledger.import_usage(
+                        subject_id=attempt.id,
+                        mission_id=mission.id,
+                        facts=[UsageFact(f"fixture-usage-{index}", 120, 30, None)],
+                    )
+                    == 1
+                )
+                if index == 1:
+                    settled = ledger.settle(subject_id=attempt.id)
+                    assert settled["settled_tokens"] == 150 and settled["unpriced"] == 1
+            receipts.append(
+                {
+                    "mission_id": mission.id,
+                    "task_id": task.id,
+                    "attempt_id": attempt.id,
+                    "intent_id": intent.intent_id,
+                    "result_id": result.id,
