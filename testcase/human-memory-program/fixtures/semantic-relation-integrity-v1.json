      "status",
      "edge_count",
      "payload_sha256"
    ],
    "case_db_filename": "memory.sqlite",
    "case_wire_filename": "invalid-wire.json",
    "principal_context": {
      "deployment_id": "deployment-relation-1",
      "household_id": "household-relation-1",
      "actor_id": "principal-relation-1",
      "session_id": "session-relation-1"
    },
    "verifier_owned_inspector": {
      "sqlite_tables": [
        "evidence_envelopes",
        "evidence_items",
        "cognitive_memory_heads",
        "cognitive_memory_revisions",
        "cognitive_relations",
        "memory_mutation_receipts",
        "memory_mutation_rejection_audits",
        "memory_mutation_apply_results"
      ],
      "graph_api": "installed simple_harness_memory.build_human_memory_v7 plus MemoryManager.get_twin_graph_view",
      "harness_parser": "installed simple_harness.parse_memory_mutation_plan",
      "rule": "adapter only performs setup/exercise; verifier snapshots and reads the real database, calls the installed graph API/parser itself, recomputes roots/cardinality/receipt/graph hashes, applies frozen corruptions itself, and writes the final artifact",
      "request_process_isolation": "the pinned adapter runs in a separate process with only a fresh request directory and emits bounded command JSON; it never receives the case database path and cannot supply calls, outcomes, roots, receipts, fault events or PASS",
      "apply_call_executor": "after the adapter process exits, a verifier-owned second process parses the bounded commands, opens the exact-wheel public MemoryManager, injects the frozen fault point, executes each real public apply/suppress/ingest call and returns the call trace; adapter and trace collector never share interpreter globals",
      "fault_injection_points": {
        "before-relation-memory-insert": "mutation.before_relation_memory_insert",
        "after-memory-before-edge": "mutation.after_relation_memory_before_knowledge_row",
        "after-edge-before-commit": "mutation.after_knowledge_row_before_commit",
        "commit-before-ack": "mutation.after_commit"
      },
      "replay_rule": "exact replay requires a real exercise apply call returning the byte-identical public result captured from setup; commit-before-ack requires one verifier-injected post-commit exception followed by one real replay call with the stored receipt"
    },
    "pass_rule": "the verifier creates a clean venv, installs both exact wheels, independently probes installed module origins, generates an unpredictable nonce and invocation hash, obtains request-only command JSON from a separate adapter process, executes those commands in a verifier-owned exact-wheel process, and uses only that call trace plus its SQLite/package-root inspector to create and evaluate every artifact; external evidence indexes, adapter-produced artifacts, producer-reported call counts/outcomes, shared interpreter state, and producer-reported PASS are not inputs"
  }
