+"""Lifecycle tests for the local NanoJev runtime boundary.
+
+Everything here runs against a fake scorer: the real one loads a 2.4 GB
+checkpoint on an MPS device, which is not a unit test.  The fake keeps the
+properties the runtime actually depends on — a synchronous, blocking ``score``
+that echoes the request's candidate order — so the tests can assert the
+lifecycle, the thread boundary, the mapping and the refusals without a model.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import sys
+import threading
+import time
+from collections.abc import Mapping, Sequence
+from typing import Any
+
+import pytest
+
+from agent_orchestrator.decision.local_runtime import (
+    DEFAULT_MODEL_VERSION,
+    LocalNanoJevRuntime,
+)
+from agent_orchestrator.decision.nanojev_inference import (
+    BOOLEAN_CANDIDATE_IDS,
+    CandidateQuestion,
+    InferenceReport,
+    NanoJevInferenceError,
+    ScoredQuestion,
+    ScoredState,
+)
+from agent_orchestrator.decision.runtime import NanoJevOutput, NanoJevRequest
+from agent_orchestrator.decision.types import DecisionType
+
+# --------------------------------------------------------------------------
+# fakes
+# --------------------------------------------------------------------------
+
+
+class _FakeScorer:
+    """Minimal stand-in for ``NanoJevDecisionScorer``.
+
+    Records the questions it was handed and answers with a chosen distribution
+    built from the request's own candidate ids, so order mismatches are visible.
+    """
+
+    def __init__(
+        self,
+        probabilities: Sequence[float] | None = None,
+        *,
+        delay: float = 0.0,
+        model_id: str | None = "checkpoint-model",
+        broken_candidates: bool = False,
+        on_score: Any = None,
+    ) -> None:
+        self.questions: list[CandidateQuestion] = []
+        self.states: list[tuple[str, str]] = []
+        self.calls = 0
+        self.closed = 0
+        self.thread_names: list[str] = []
+        self._probabilities = probabilities
+        self._delay = delay
+        self._model_id = model_id
+        self._broken_candidates = broken_candidates
+        self._on_score = on_score
+
+    def score(
+        self, states: Sequence[tuple[str, str, Sequence[CandidateQuestion]]]
+    ) -> InferenceReport:
+        self.calls += 1
+        self.thread_names.append(threading.current_thread().name)
+        if self._on_score is not None:
+            self._on_score(self.calls)
+        if self._delay:
+            time.sleep(self._delay)
+        rows = []
+        for state_id, state_text, questions in states:
+            self.states.append((state_id, state_text))
+            scored = []
+            for question in questions:
+                self.questions.append(question)
+                identifiers = tuple(question.candidate_ids)
+                probabilities = (
+                    tuple(self._probabilities)
+                    if self._probabilities is not None
+                    else tuple(1.0 / len(identifiers) for _ in identifiers)
+                )
+                if self._broken_candidates:
+                    identifiers = tuple(reversed(identifiers))
+                scored.append(
+                    ScoredQuestion(
+                        question_id=question.question_id,
+                        candidate_ids=identifiers,
+                        probabilities=probabilities,
+                        selected=identifiers[
+                            probabilities.index(max(probabilities))
+                        ],
+                    )
+                )
+            rows.append(ScoredState(state_id=state_id, questions=tuple(scored)))
+        return InferenceReport(
+            states=tuple(rows),
+            device="cpu",
+            precision="fp32",
+            parameter_storage="float32",
+            set_head="none",
+            max_length=512,
+            model_id=self._model_id,
+            model_revision="rev-1",
+            checkpoint_sha256="0" * 64,
+            candidate_paths=1,
+            forward_passes=1,
+        )
+
+    def close(self) -> None:
+        self.closed += 1
+
+
+def _context(state: str = "a ready task", **extra: Any) -> dict[str, Any]:
+    context: dict[str, Any] = {"state": state, "instructions": "Pick the next task."}
+    context.update(extra)
+    return context
+
+
+def _request(
+    *ids: str,
+    decision_type: DecisionType = DecisionType.READY_TASK_PRIORITY,
+    context: Mapping[str, Any] | None = None,
+) -> NanoJevRequest:
+    if context is None:
+        context = _context(candidates=tuple(f"do {cid}" for cid in ids))
+    return NanoJevRequest(
+        decision_id="decision-1",
+        decision_type=decision_type,
+        candidates=tuple(
+            {"id": cid, "label": f"Task {cid}", "metadata": {}} for cid in ids
+        ),
+        context=context,
+    )
+
+
