+                                "key": "A",
+                                "goal": "write artifact",
+                                "rationale": "legacy preservation fixture",
+                                "success_criteria": ["artifact persists"],
+                                "verification_policy": ["rule_check"],
+                                "budget": {"max_tokens": 10000, "max_attempts": 3},
+                                "outputs": ["report.txt"],
+                            }
+                        ]
+                    }
+                ),
+                base_version=planning.version,
+                source={},
+            )
+            task = tasks[0]
+            attempt, intent = service.create_attempt(
+                task.id,
+                role="worker",
+                model="offline-fixture-no-call",
+                prompt_version="fixture-v1",
+                context_version="fixture-v1",
+                reservation=Reservation(tokens=1000, cost_micros=0),
+                intent_config={"agent_config": {}, "message": {}},
+                input_hash="fixture-input",
+            )
+            turn = f"fixture-turn-{index}"
+            service.claim_intent(intent.intent_id, owner="fixture-owner", lease_seconds=60)
+            service.record_agent_created(
+                intent.intent_id, agent_id=f"fixture-agent-{index}", expected_turn_id=turn
+            )
+            service.record_submitted(intent.intent_id, receipt={"turn_id": turn})
+            content = f"legacy artifact {index}\n".encode()
+            path = artifact_dir / f"report-{index}.txt"
+            path.write_bytes(content)
+            sha = hashlib.sha256(content).hexdigest()
+            files[str(path)] = sha
+            artifact = Artifact(
+                id=f"fixture-artifact-{index}",
+                mission_id=mission.id,
+                task_id=task.id,
+                attempt_id=attempt.id,
+                type="text",
+                path="report.txt",
+                version=1,
+                content_hash=sha,
+                size_bytes=len(content),
