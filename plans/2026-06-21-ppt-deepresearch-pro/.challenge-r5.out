async def _handle_ppt_pro(**kwargs):
    sid = kwargs.get("_session_id", "default")          # registry æ³¨å…¥è¿?argsï¼ˆåŒ ppt_create @3769ï¼?    outline_propose = _PPT_PRO_CTX.get("outline_propose")  # WI-3 FP-5 é£Žæ ¼å¤§çº²å?propose
