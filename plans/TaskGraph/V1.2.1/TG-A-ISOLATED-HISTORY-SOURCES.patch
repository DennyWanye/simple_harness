+from __future__ import annotations
+
+import shutil
+import sqlite3
+from dataclasses import replace
+from pathlib import Path
+
+import pytest
+from _htn_migration_fixture import build_fixture
+
+from agent_orchestrator.contracts import htn
+from agent_orchestrator.contracts.models import ContractError
+from agent_orchestrator.contracts.semantic_base import TypedRef, TypedRefKind
+from agent_orchestrator.graph.network_codec import encode
+from agent_orchestrator.graph.revision_pins import build_revision_pins
+from agent_orchestrator.graph.task_network import TaskNetworkSnapshot
+from agent_orchestrator.storage.htn_store import HtnStore
+from agent_orchestrator.storage.store import Store
+from agent_orchestrator.storage.taskgraph_history_sources import validate_revision_sources
+
+_ROOT = Path(__file__).resolve().parents[4]
+
+
+def _network(data):
+    fields = dict(data)
+    for name, codec in {
+        "occurrences": htn.OccurrenceSpec,
+        "task_bindings": htn.TaskSemanticBindingV1,
+        "method_instances": htn.MethodInstanceDraft,
+        "order_constraints": htn.OrderConstraint,
+        "data_requirements": htn.DataRequirement,
+        "typed_edges": htn.TypedEdge,
+        "obligation_coverage": htn.ObligationCoverage,
+    }.items():
+        fields[name] = tuple(codec.from_json(item) for item in fields[name])
+    for name in ("adopted_instance_ids", "root_occurrence_ids", "required_obligations"):
+        fields[name] = tuple(fields[name])
+    return TaskNetworkSnapshot(**fields)
+
+
+@pytest.fixture(scope="module")
+def persisted(tmp_path_factory):
+    area = tmp_path_factory.mktemp("htn-sources")
+    database = area / "source.sqlite"
+    fixture = build_fixture(_ROOT, database)
+    store = Store.open(database)
+    documents = []
+    for command in fixture["commands"]:
+        row = store.connection.execute(
+            "SELECT revision_id,revision,content_hash FROM requirements_revisions "
+            "WHERE mission_id=?",
+            (command["mission_id"],),
+        ).fetchone()
+        candidate = _network(command["network"])
+        # Compilation decorates the root binding with adopted_method_instance_id;
+        # the original immutable row retains its exact bytes. Bind a historical
+        # document to those precise revisions, while keeping explicit adoption.
+        source_network = replace(
+            candidate,
+            task_bindings=tuple(
+                HtnStore(store).get_task_semantics(
+                    str(binding.task_id), int(binding.contract_revision)
+                )
+                for binding in candidate.task_bindings
+            ),
+        )
+        documents.append(
+            encode(
+                source_network,
+                TypedRef(
+                    kind=TypedRefKind.REQUIREMENTS,
+                    id=row[0],
+                    revision=row[1],
+                    content_hash=row[2],
+                ),
+            )
+        )
+    store.close()
+    return database, fixture, documents
+
+
+@pytest.fixture
+def sample(persisted, tmp_path):
+    source, fixture, documents = persisted
+    database = tmp_path / "copy.sqlite"
+    shutil.copyfile(source, database)
+    store = Store.open(database)
+    yield store, fixture, documents
+    store.close()
+
+
+def test_real_commit_sources_are_read_exactly_despite_newer_binding_and_retirement(sample):
+    store, fixture, documents = sample
+    queries = []
+    store.connection.set_trace_callback(queries.append)
+    changes = store.connection.total_changes
+    for command, document in zip(fixture["commands"], documents, strict=True):
+        validate_revision_sources(store, document)
+        for pin in build_revision_pins(document).member_pins:
+            stored_hash = store.connection.execute(
+                "SELECT content_hash FROM task_semantics WHERE task_id=? AND binding_revision=?",
+                (pin.task_id, pin.binding_revision),
+            ).fetchone()[0]
+            assert pin.binding_hash == stored_hash
+        old = command["historical_difference"]
+        assert HtnStore(store).latest_task_semantics(old["task_id"]).contract_revision == 2
+        assert (
+            HtnStore(store).method_instance_state(command["mission_id"], old["instance_id"])
+            == "RETIRED"
+        )
+    store.connection.set_trace_callback(None)
+    assert store.connection.total_changes == changes
+    assert queries.count("BEGIN") == queries.count("COMMIT") == 2
+    assert not any(
+        query.lstrip().upper().startswith(("INSERT", "UPDATE", "DELETE", "REPLACE"))
+        for query in queries
+    )
+    assert "ORDER BY binding_revision DESC" not in "\n".join(queries[: queries.index("COMMIT")])
+
+
+@pytest.mark.parametrize(
+    "mutation",
+    [
+        "missing_member",
+        "extra_order",
+        "missing_binding",
+        "wrong_binding_hash",
+        "missing_child",
+        "wrong_requirements_hash",
+    ],
+)
+def test_incomplete_or_inconsistent_original_source_rows_fail_closed(sample, mutation):
+    store, _, documents = sample
+    document = documents[0]
+    connection = store.connection
+    # Deliberate corruption stays in this disposable database, never in a producer.
+    connection.execute("PRAGMA foreign_keys=OFF")
+    if mutation == "missing_member":
+        connection.execute(
+            "DELETE FROM plan_memberships WHERE mission_id=? AND occurrence_id=?",
+            (document.mission_id, document.root_occurrence_ids[0]),
+        )
+    elif mutation == "extra_order":
+        network = _network_from_document(document)
+        ids = [item.occurrence_id for item in network.occurrences]
+        existing = {(item.before, item.after) for item in network.order_constraints}
+        before, after = next(
+            (left, right)
+            for left in ids
+            for right in ids
+            if left != right and (left, right) not in existing
+        )
+        HtnStore(store).insert_order_constraint(
+            document.mission_id, document.revision, htn.OrderConstraint(before=before, after=after)
+        )
+    elif mutation in {"missing_binding", "wrong_binding_hash"}:
+        binding = _network_from_document(document).task_bindings[0]
+        if mutation == "missing_binding":
+            connection.execute(
+                "DELETE FROM task_semantics WHERE task_id=? AND binding_revision=?",
