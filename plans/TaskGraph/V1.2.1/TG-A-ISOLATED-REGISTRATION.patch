+# SPDX-FileCopyrightText: 2026 DennyWanye
+# SPDX-License-Identifier: Apache-2.0
+
+"""TG-A registered-source migration checks. No runtime descriptor injection.
+
+TG_BASE_SNAPSHOT selects the exact pre-extension SDK for legacy fixture creation.
+The active SDK must be the isolated registered-source derivative, never the Host.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import shutil
+import signal
+import sqlite3
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+
+from agent_orchestrator.storage import schema
+from agent_orchestrator.storage.store import SchemaIncompatible, Store
+
+ROOT = Path(__file__).resolve().parents[4]
+
+
+def canonical(value):
+    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False)
+
+
+def q(name):
+    return '"' + name.replace('"', '""') + '"'
+
+
+def state(path):
+    with sqlite3.connect(path.as_uri() + "?mode=ro", uri=True) as c:
+        objects = [
+            list(r)
+            for r in c.execute(
+                "SELECT type,name,tbl_name,sql FROM sqlite_master "
+                "WHERE name NOT LIKE 'sqlite_%' ORDER BY type,name"
+            )
+        ]
+        rows = {}
+        for kind, name, _, _ in objects:
+            if kind == "table":
+                rows[name] = sorted(
+                    canonical([{"blob": v.hex()} if isinstance(v, bytes) else v for v in r])
+                    for r in c.execute("SELECT * FROM " + q(name))
+                )
+        return {"objects": objects, "rows": rows}
+
+
+def health(path):
+    with sqlite3.connect(path) as c:
+        assert not list(c.execute("PRAGMA foreign_key_check"))
+        assert c.execute("PRAGMA integrity_check").fetchone() == ("ok",)
+
+
+def open_close(path):
+    s = Store.open(path)
+    s.close()
+
+
+def descriptors(path):
+    with sqlite3.connect(path) as c:
+        return list(
+            c.execute("SELECT version,name,checksum FROM orch_schema_migrations ORDER BY version")
+        )
+
+
+@pytest.fixture(scope="module")
+def legacy(tmp_path_factory):
+    area = tmp_path_factory.mktemp("registered-tg-legacy")
+    base = Path(os.environ["TG_BASE_SNAPSHOT"]).resolve(strict=True)
+    assert base != ROOT
+    script = """import json,sys
+from pathlib import Path
+from agent_orchestrator.storage.store import Store
+from agent_orchestrator.storage import schema
+from _migration_fixture import build_fixture
+assert Path(sys.modules[Store.__module__].__file__).resolve().is_relative_to(Path(sys.argv[1]))
+out=Path(sys.argv[2])
+receipt=build_fixture(Store,out/'legacy.sqlite3',out/'artifacts')
+receipt['descriptors']=[[m.version,m.name,m.checksum] for m in schema.MIGRATIONS]
+(out/'producer.json').write_text(json.dumps(receipt,indent=2))
+"""
+    env = {
+        **os.environ,
+        "PYTHONDONTWRITEBYTECODE": "1",
+        "PYTHONPATH": os.pathsep.join([str(base / "src"), str(Path(__file__).parent)]),
+    }
+    run = subprocess.run(
+        [sys.executable, "-c", script, str(base), str(area)],
+        env=env,
+        cwd=area,
+        capture_output=True,
+        text=True,
+        timeout=30,
+    )
+    assert run.returncode == 0, run.stderr
+    receipt = json.loads((area / "producer.json").read_text())
+    path = area / "legacy.sqlite3"
+    before = state(path)
+    assert all(
+        len(before["rows"][n]) == 2
+        for n in ("missions", "tasks", "attempts", "results", "artifacts")
+    )
+    health(path)
+    return path, receipt
+
+
+def assert_target_matches(db, expected, before):
+    actual = state(db)
+    assert actual["objects"] == expected["objects"]
+    for name, rows in expected["rows"].items():
+        if name != "orch_schema_migrations":
+            assert actual["rows"][name] == rows
+    assert descriptors(db) == [(m.version, m.name, m.checksum) for m in schema.MIGRATIONS]
+    old = before["rows"]["orch_schema_migrations"]
+    new = actual["rows"]["orch_schema_migrations"]
+    assert len(new) == len(old) + 1 and all(row in new for row in old)
+
+
+def test_registered_descriptor_is_exact_append_only(legacy):
+    db, receipt = legacy
+    assert Path(sys.modules[Store.__module__].__file__).resolve().is_relative_to(ROOT)
+    assert Path(schema.__file__).resolve().is_relative_to(ROOT)
+    actual = [[m.version, m.name, m.checksum] for m in schema.MIGRATIONS]
+    assert actual[:-1] == receipt["descriptors"]
+    assert actual[-1][0] == max(row[0] for row in receipt["descriptors"]) + 1
+    assert actual[-1][1] == "orchestrator-taskgraph-execution-v2"
+    ddl = Path(os.environ["TG_REVIEWED_DDL"]).read_bytes()
+    assert schema.MIGRATIONS[-1].ddl.encode() == ddl
+    assert schema.MIGRATIONS[-1].checksum == hashlib.sha256(ddl).hexdigest()
+    assert descriptors(db) == [tuple(r) for r in receipt["descriptors"]]
+
+
+def test_registered_fresh_upgrade_preserve_every_legacy_row(tmp_path, legacy):
+    original, receipt = legacy
+    before = state(original)
+    db = tmp_path / "upgrade.sqlite3"
+    shutil.copyfile(original, db)
+    fresh = tmp_path / "fresh.sqlite3"
+    open_close(db)
+    open_close(fresh)
+    after = state(db)
+    assert after["objects"] == state(fresh)["objects"]
+    for name, rows in before["rows"].items():
+        if name != "orch_schema_migrations":
+            assert after["rows"][name] == rows
+    assert descriptors(db) == [(m.version, m.name, m.checksum) for m in schema.MIGRATIONS]
+    old_names = {r[1] for r in before["objects"]}
+    added = [r for r in after["objects"] if r[1] not in old_names]
+    assert sum(r[0] == "table" for r in added) == 9
+    assert sum(r[0] == "trigger" for r in added) == 25
+    assert after["rows"]["taskgraph_policy_bindings"] == []
+    open_close(db)
+    assert state(db) == after
+    health(db)
+    health(fresh)
+    for path, sha in receipt["artifact_files"].items():
+        assert hashlib.sha256(Path(path).read_bytes()).hexdigest() == sha
+    assert state(original) == before
+
+
+def test_registered_constraints_and_checksum_refuse_without_mutation(tmp_path, legacy):
+    original, _ = legacy
+    db = tmp_path / "checks.sqlite3"
+    shutil.copyfile(original, db)
+    with sqlite3.connect(db) as c:
+        c.execute("UPDATE orch_schema_migrations SET checksum=? WHERE version=1", ("f" * 64,))
+    before = state(db)
+    with pytest.raises(SchemaIncompatible):
+        open_close(db)
+    assert state(db) == before
+    fresh = tmp_path / "fresh.sqlite3"
+    open_close(fresh)
+    with sqlite3.connect(fresh) as c:
+        c.execute("PRAGMA foreign_keys=ON")
+        with pytest.raises(sqlite3.IntegrityError):
+            c.execute(
+                "INSERT INTO taskgraph_policy_bindings VALUES(?,?,?,?,?,?,?)",
+                ("missing", "taskgraph-exec-v2", "a" * 64, "{}", "probe", "b" * 64, 0.0),
+            )
+        c.rollback()
+    health(fresh)
+
+
+CRASH_SCRIPT = """import json,os,signal,sqlite3,sys
+from pathlib import Path
+from agent_orchestrator.storage.store import Store
+path,mode,marker=Path(sys.argv[1]),sys.argv[2],Path(sys.argv[3])
+original=sqlite3.connect
+
+def kill(facts):
+    with marker.open('x') as f:
+        json.dump(facts,f);f.flush();os.fsync(f.fileno())
+    os.kill(os.getpid(),signal.SIGKILL)
+
+def connect(*args,**kwargs):
+    c=original(*args,**kwargs)
+    if args and Path(str(args[0])).resolve()==path:
+        def trace(sql):
+            if mode=='mid_ddl' and 'CREATE TABLE taskgraph_revision_records' in sql:
+                exists=c.execute(
+                    "SELECT name FROM sqlite_master WHERE name='taskgraph_policy_bindings'"
+                ).fetchone()
+                kill({'in_transaction':c.in_transaction,'prior_table':bool(exists)})
+            if mode=='pre_commit' and sql.strip().upper()=='COMMIT':
+                count=c.execute(
+                    "SELECT count(*) FROM sqlite_master "
+                    "WHERE type='table' AND name LIKE 'taskgraph_%'"
+                ).fetchone()[0]
+                if count==9:kill({'in_transaction':c.in_transaction,'tg_tables':count})
+        c.set_trace_callback(trace)
+    return c
+sqlite3.connect=connect
+s=Store.open(path)
+if mode=='post_commit':kill({'in_transaction':s._connection.in_transaction})
+s.close()
+raise AssertionError('crash point not reached')
+"""
+
+
+@pytest.mark.parametrize("mode", ["mid_ddl", "pre_commit", "post_commit"])
+def test_registered_real_process_crash_and_recovery(tmp_path, legacy, mode):
+    original, receipt = legacy
+    before = state(original)
+    good = tmp_path / "good.sqlite3"
+    shutil.copyfile(original, good)
+    open_close(good)
+    expected = state(good)
+    assert (
+        sum(
+            r[0] == "trigger" and r[1] not in {x[1] for x in before["objects"]}
+            for r in expected["objects"]
+        )
+        == 25
+    )
+    db = tmp_path / "crash.sqlite3"
+    shutil.copyfile(original, db)
+    marker = tmp_path / "cut.json"
+    env = {**os.environ, "PYTHONDONTWRITEBYTECODE": "1", "PYTHONPATH": str(ROOT / "src")}
+    run = subprocess.run(
+        [sys.executable, "-c", CRASH_SCRIPT, str(db), mode, str(marker)],
+        env=env,
+        cwd=tmp_path,
+        capture_output=True,
+        text=True,
+        timeout=30,
+    )
+    assert run.returncode == -signal.SIGKILL, run.stderr
+    observed = json.loads(marker.read_text())
+    if mode == "post_commit":
+        assert observed["in_transaction"] is False
+        assert_target_matches(db, expected, before)  # Before any recovery open.
+    else:
+        assert observed["in_transaction"] is True
+        assert (
+            observed.get("prior_table") is True if mode == "mid_ddl" else observed["tg_tables"] == 9
+        )
+        assert state(db) == before
+    open_close(db)
+    assert_target_matches(db, expected, before)
+    recovered = state(db)
+    open_close(db)
+    assert state(db) == recovered
+    health(db)
+    assert state(original) == before
+
+
+def test_missing_committed_trigger_is_detected(tmp_path, legacy):
+    original, _ = legacy
+    db = tmp_path / "missing.sqlite3"
+    shutil.copyfile(original, db)
+    open_close(db)
+    good = state(db)
+    before = state(original)
+    with sqlite3.connect(db) as c:
+        c.execute("DROP TRIGGER tg_revision_source_guard")
+    with pytest.raises(AssertionError):
+        assert_target_matches(db, good, before)
+    # The runner trusts applied descriptor identity; test oracle must inspect full schema.
+    open_close(db)
+    with pytest.raises(AssertionError):
+        assert_target_matches(db, good, before)
