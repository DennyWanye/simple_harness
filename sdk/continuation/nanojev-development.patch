@@ -0,0 +1,173 @@
+"""Fast-path gate and NanoJev-eligibility boundaries (plan §4, §5, §39, §40, §52).
+
+These tests pin the two rules that keep NanoJev inside its lane:
+
+* only *operational* decisions (READY_TASK_PRIORITY, RETRY_OR_ESCALATE) may be
+  handed to NanoJev — a structural decision changes the DAG and must never
+  reach the model, so no request is even built for it (§4, §52);
+* a NanoJev result is only used when it is confident enough, by the plan's
+  deliberately simple threshold, otherwise the existing/slow path answers
+  (§39, §40).
+
+Nothing here claims a real checkpoint: the gate is pure arithmetic over a
+``DecisionResult`` and the eligibility rule is a set membership test.
+"""
+
+from __future__ import annotations
+
+import pytest
+
+from agent_orchestrator.decision import (
+    DecisionResult,
+    DecisionScore,
+    DecisionType,
+)
+from agent_orchestrator.decision.gate import (
+    DEFAULT_MIN_MARGIN,
+    DEFAULT_MIN_PROBABILITY,
+    FastPathGate,
+    is_nanojev_decidable,
+)
+
+
+def _result(
+    *,
+    scores: tuple[DecisionScore, ...],
+    top1_probability: float,
+    margin: float,
+    selected: str = "a",
+) -> DecisionResult:
+    return DecisionResult(
+        decision_id="d-1",
+        provider="nanojev",
+        selected=selected,
+        scores=scores,
+        top1_probability=top1_probability,
+        margin=margin,
+        latency_ms=1.0,
+        model_version="fake-v1",
+    )
+
+
+class TestDefaultThresholds:
+    def test_thresholds_match_the_plan(self) -> None:
+        # Plan §39 gives the numbers literally: 0.80 top1 and 0.20 margin.
+        assert DEFAULT_MIN_PROBABILITY == 0.80
+        assert DEFAULT_MIN_MARGIN == 0.20
+
+    def test_gate_defaults_use_plan_thresholds(self) -> None:
+        gate = FastPathGate()
+        assert gate.min_probability == DEFAULT_MIN_PROBABILITY
+        assert gate.min_margin == DEFAULT_MIN_MARGIN
+
+
+class TestFastPathGateAcceptance:
+    def test_accepts_confident_result(self) -> None:
+        # Plan §50: 0.91 / 0.05 / 0.04 is a high-confidence NanoJev answer.
+        result = _result(
+            scores=(
+                DecisionScore("a", 0.91),
+                DecisionScore("b", 0.05),
+                DecisionScore("c", 0.04),
+            ),
+            top1_probability=0.91,
+            margin=0.86,
+        )
+        assert FastPathGate().accept(result) is True
+
+    def test_rejects_low_probability_and_thin_margin(self) -> None:
+        # Plan §51: 0.51 / 0.48 / 0.01 is low confidence -> slow path.
+        result = _result(
+            scores=(
+                DecisionScore("a", 0.51),
+                DecisionScore("b", 0.48),
+                DecisionScore("c", 0.01),
+            ),
+            top1_probability=0.51,
+            margin=0.03,
+        )
+        assert FastPathGate().accept(result) is False
+
+    def test_rejects_high_probability_but_thin_margin(self) -> None:
+        # Both conditions must hold; a good top1 alone is not enough.
+        thin = _result(
+            scores=(
+                DecisionScore("a", 0.85),
+                DecisionScore("b", 0.75),
+                DecisionScore("c", 0.0),
+            ),
+            top1_probability=0.85,
+            margin=0.10,
+        )
+        assert FastPathGate().accept(thin) is False
+
+    def test_thresholds_are_inclusive(self) -> None:
+        # Exactly at the plan's numbers counts as confident (>=, not >).
+        exact = _result(
+            scores=(
+                DecisionScore("a", 0.80),
+                DecisionScore("b", 0.60),
+                DecisionScore("c", 0.0),
+            ),
+            top1_probability=0.80,
+            margin=0.20,
+        )
+        assert FastPathGate().accept(exact) is True
+
+    def test_custom_thresholds_are_honoured(self) -> None:
+        gate = FastPathGate(min_probability=0.95, min_margin=0.5)
+        result = _result(
+            scores=(DecisionScore("a", 0.91), DecisionScore("b", 0.09)),
+            top1_probability=0.91,
+            margin=0.82,
+        )
+        assert gate.accept(result) is False
+
+    def test_single_candidate_is_deterministic_and_never_needs_the_model(self) -> None:
+        # margin is 1.0 by contract for one candidate; no model call is implied.
+        result = _result(
+            scores=(DecisionScore("a", 1.0),),
+            top1_probability=1.0,
+            margin=1.0,
+        )
+        assert FastPathGate().accept(result) is True
+
+    def test_rejects_non_decision_result(self) -> None:
+        with pytest.raises(TypeError):
+            FastPathGate().accept("not-a-result")  # type: ignore[arg-type]
+
+    def test_rejects_out_of_range_thresholds(self) -> None:
+        for kwargs in (
+            {"min_probability": -0.1},
+            {"min_probability": 1.1},
+            {"min_margin": -0.1},
+            {"min_margin": 1.1},
+        ):
+            with pytest.raises(ValueError):
+                FastPathGate(**kwargs)  # type: ignore[arg-type]
+
+    def test_gate_is_frozen(self) -> None:
+        gate = FastPathGate()
+        with pytest.raises(Exception):
+            gate.min_probability = 0.5  # type: ignore[misc]
+
+
+class TestNanoJevEligibility:
+    def test_operational_decisions_are_decidable(self) -> None:
+        # Plan §5: the first release supports exactly these two.
+        assert is_nanojev_decidable(DecisionType.READY_TASK_PRIORITY) is True
+        assert is_nanojev_decidable(DecisionType.RETRY_OR_ESCALATE) is True
+
+    def test_every_declared_decision_type_is_classified(self) -> None:
+        # A new DecisionType must be classified deliberately, never by default:
+        # anything not in the operational set is structural and stays slow-path.
+        operational = {
+            DecisionType.READY_TASK_PRIORITY,
+            DecisionType.RETRY_OR_ESCALATE,
+        }
+        for decision_type in DecisionType:
+            assert is_nanojev_decidable(decision_type) is (decision_type in operational)
+
+    def test_rejects_unknown_value(self) -> None:
+        with pytest.raises(TypeError):
+            is_nanojev_decidable("dag_replan")  # type: ignore[arg-type]
