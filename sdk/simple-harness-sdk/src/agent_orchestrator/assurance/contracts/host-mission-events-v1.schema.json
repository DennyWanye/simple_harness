{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.simpleharness.invalid/host/host-mission-events-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "mission_id",
    "events",
    "has_more",
    "through_seq"
  ],
  "properties": {
    "mission_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      },
      "maxItems": 200
    },
    "has_more": {
      "type": "boolean"
    },
    "through_seq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seq",
        "type",
        "created_at",
        "task_id",
        "attempt_id",
        "actor_type"
      ],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "created_at": {
          "type": "number",
          "minimum": 0
        },
        "task_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 512
        },
        "attempt_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 512
        },
        "actor_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "summary": {
          "type": "string",
          "minLength": 0,
          "maxLength": 300
        }
      }
    }
  }
}
