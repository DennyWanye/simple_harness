def _user_template_roots() -> list[Path]:
    """é¢å¤–æ¨¡æ¿æ ¹ç›®å½?é€’å½’æœç´¢),æ¥è‡ª env ``DESKPET_PPT_TEMPLATE_ROOTS``
    (``;`` åˆ†éš”)ã€‚åº“ä¸»æ ¹ç”?ppt_template_picker.template_library_root() æä¾›ã€?
    ä»Žä¸æŠ›å¼‚å¸¸ã€?
    """
    roots: list[Path] = []
    try:
        env = (os.environ.get("DESKPET_PPT_TEMPLATE_ROOTS", "") or "").strip()
        if env:
            roots += [Path(p.strip()) for p in env.split(";") if p.strip()]
    except Exception:  # noqa: BLE001
        pass
    return [r for r in roots if r.is_dir()]


