{
 "package": "kernel_domains",
 "records": "support",
 "records_doc": "Module-level definitions of the runtime kernel: driver contracts, ports, the run client and the runtime builder.",
 "stubs_in_core": false,
 "groups": [
  {
   "module": "core",
   "class": "RuntimeCore",
   "core": true,
   "doc": "Runtime construction, lifecycle state and the accessors every part uses.",
   "methods": [
    "__init__",
    "_now",
    "_require_started",
    "state",
    "production_authorities",
    "observability",
    "_emit_transition"
   ]
  },
  {
   "module": "base_agent",
