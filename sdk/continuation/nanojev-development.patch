+def test_the_recorded_event_thread_is_the_deterministic_id(journal):
+    """The id the Host mints is the id the journal files the thread under.
+
+    In ``SHADOW`` mode with more than one candidate the service is deliberately
+    non-blocking: it returns the existing answer and observes asynchronously, so
+    the thread it records is ``DecisionRequested`` + ``ShadowDecisionProduced``.
+    A ``DecisionProduced`` event is *not* written on that path — the service only
+    writes it when the production answer is final at the time it returns (plan
+    §22/§24).  This suite pins what actually happens rather than what the names
+    suggest, because a caller that assumed otherwise would be wrong about the log.
+    """
+
+    tasks = three_ready()
+    expected_ids = tuple(task.id for task in legacy_allocator.frontier(tasks))
+    label = seam.compute_ready_task_decision_id(
+        mission_id=MISSION,
+        task_id=None,
+        ordinal=0,
+        candidate_ids=expected_ids,
+        context=seam._context_payload({"round": 1}, 0, len(expected_ids), 0),
+    )
+    observe(tasks, StubShadow("m-pr7:task-1"), journal=journal, label=label)
+    events = journal_events(journal)
+    assert [name for name, _ in events] == [
+        "DecisionRequested",
+        "ShadowDecisionProduced",
+    ]
+    for _, payload in events:
+        assert payload["decision_id"] == label
+        assert not payload["decision_id"].startswith("pd-")
+    requested = events[0][1]
+    assert requested["mission_id"] == MISSION
+    assert requested["candidates"] == list(expected_ids)
+    assert requested["decision_type"] == "ready_task_priority"
+    shadow_event = events[1][1]
+    assert shadow_event["mode"] == "shadow"
+    # The production selector answers "the frontier's first candidate", and the
+    # stub shadow picks the *second* one, so the thread records a real
+    # disagreement — which is the whole point of collecting observations.
+    assert shadow_event["production_selected"] == expected_ids[0]
+    assert shadow_event["selected"] == "m-pr7:task-1"
+    assert shadow_event["agreement"] is False
+
