+
+        monkeypatch.setattr(Path, "write_bytes", fail_if_probe_retried)
+        second = paths._portable_userdata_dir()
+
+        assert second is first
+        assert second == install_root / "userdata"
+    finally:
+        paths.reset_path_cache()
+
+
