    def test_sdk_await_subagents_uses_typed_port_and_never_loads_old_harness() -> None:
        import asyncio
    
        from simple_harness import CallId, RequestId, RunId, thaw_json
        from simple_harness.tools import (
            CancellationToken,
            ToolCall,
            ToolContext,
            ToolOutcome,
        )
    
