# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ P5-S2 Phase 7: in-loop self-check â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
#
# Every ``_SELFCHECK_EVERY`` iterations, BEFORE the LLM call, we inject
# a system message. The message ESCALATES based on iteration count:
#
#   tier 1 (iter=10): gentle reflection â€?"consider committing to a finish"
#   tier 2 (iter=20): firm â€?"you MUST justify each remaining tool call"
#   tier 3 (iter=30+): forced â€?"your NEXT response MUST be stop_reason=end_turn"
#
# Empirical: tier 1 alone wasn't enough â€?the LLM sees "considered" and
# keeps going. Forced tier at 30 reliably breaks "infinite content
# generation" patterns where each iteration writes another section,
# fix, refactor, etc.
#
# P6 Phase 6: the legacy soft tool-budget injection (``_TOOL_BUDGET_HARD_MSG``
# + the >= _TOOL_BUDGET_HARD branch) was removed â€?the TerminationGate
# now enforces tool_budget_hard with a HARD break that emits
# ErrorEvent(error_tool_budget). Only the iteration-based selfcheck
# tiers remain as soft nudges.

_SELFCHECK_EVERY = 10  # base interval â€?tier 1 fires here
_SELFCHECK_TIER2_AT = 20  # iter >= this â†?escalate
_SELFCHECK_TIER3_AT = 30  # iter >= this â†?forced stop
