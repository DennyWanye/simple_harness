# â”€â”€â”€ ArtifactAction â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

ActionId = Literal["open", "show_in_folder", "copy_path", "save_as", "preview"]


@dataclass
class ArtifactAction:
    """å‰ç«¯æŒ?kind é»˜è®¤ + å·¥å…·å¯æ˜¾å¼è¦†ç›–ã€?""
    id: ActionId
    label: str = ""

    def to_dict(self) -> dict[str, Any]:
        return {"id": self.id, "label": self.label or ""}


def _default_actions_for(kind: str) -> list[ArtifactAction]:
    """æŒ?kind ç»™é»˜è®?actionsï¼ˆD2 capability negotiation çš?fallbackï¼‰ã€?""
    if kind == "file":
        return [
            ArtifactAction(id="open", label="æ‰“å¼€"),
            ArtifactAction(id="show_in_folder", label="åœ¨æ–‡ä»¶å¤¹ä¸­æ˜¾ç¤?),
            ArtifactAction(id="copy_path", label="å¤åˆ¶è·¯å¾„"),
            ArtifactAction(id="save_as", label="å¦å­˜ä¸?),
        ]
    if kind == "url":
        return [ArtifactAction(id="open", label="åœ¨æµè§ˆå™¨ä¸­æ‰“å¼€"),
                ArtifactAction(id="copy_path", label="å¤åˆ¶é“¾æŽ¥")]
    if kind == "text":
        return [ArtifactAction(id="preview", label="é¢„è§ˆ"),
                ArtifactAction(id="copy_path", label="å¤åˆ¶å†…å®¹")]
    if kind == "image":
        return [ArtifactAction(id="open", label="æ‰“å¼€"),
                ArtifactAction(id="show_in_folder", label="åœ¨æ–‡ä»¶å¤¹ä¸­æ˜¾ç¤?),
                ArtifactAction(id="save_as", label="å¦å­˜ä¸?)]
    if kind == "table":
        return [ArtifactAction(id="preview", label="é¢„è§ˆ")]
    return []


# â”€â”€â”€ ToolArtifact â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

Kind = Literal["file", "url", "text", "image", "table"]


@dataclass
class ToolArtifact:
    """å·¥å…·äº§ç‰©ç»Ÿä¸€ä¿¡å° â€?è¯¦è§ PRD Â§3 D1ã€?
    å­—æ®µé¡ºåºå¿…é¡»ç¨³å®šï¼ˆç”¨äºŽå­—èŠ‚çº§ golden file å¯¹è´¦ï¼ŒTG-12 T12-1ï¼‰ã€?    """
    kind: Kind
    path: Optional[str] = None
    url: Optional[str] = None
    mime: Optional[str] = None
    title: str = ""
    preview: Optional[str] = None
    size_bytes: Optional[int] = None
    sha256: Optional[str] = None
    created_at: str = ""
    actions: list[ArtifactAction] = field(default_factory=list)

    def __post_init__(self) -> None:
        # kind çº¦æŸï¼ˆPRD Â§3.1 IDL allOfï¼?        if self.kind == "file" and not self.path:
            raise ValueError(f"kind='file' requires path; got path={self.path!r}")
        if self.kind == "url" and not self.url:
            raise ValueError(f"kind='url' requires url; got url={self.url!r}")
        # preview è‡ªåŠ¨æˆªæ–­ï¼ˆT2-4ï¼?        if self.preview is not None and len(self.preview) > PREVIEW_MAX_CHARS:
            cut_at = PREVIEW_MAX_CHARS - len("â€?truncated)")
            self.preview = self.preview[:cut_at] + "â€?truncated)"
        # é»˜è®¤ title â€?basename(path) / url / "untitled"
        if not self.title:
            if self.path:
                self.title = os.path.basename(self.path) or "untitled"
            elif self.url:
                self.title = self.url
            else:
                self.title = "untitled"
        # é»˜è®¤ created_at = nowï¼ˆUTC, ISO-8601 with Zï¼?        if not self.created_at:
            self.created_at = datetime.now(timezone.utc).strftime(
                "%Y-%m-%dT%H:%M:%SZ"
            )
        # é»˜è®¤ mimeï¼ˆä»… fileï¼?        if self.kind in ("file", "image") and self.path and not self.mime:
            ext = Path(self.path).suffix.lower()
            self.mime = _EXT_TO_MIME.get(ext)
        # é»˜è®¤ actionsï¼ˆæŒ‰ kindï¼?        if not self.actions:
            self.actions = _default_actions_for(self.kind)

    def to_dict(self) -> dict[str, Any]:
        """å­—æ®µé¡ºåºç¨³å®šçš?dict è¡¨ç¤ºã€?
        None å­—æ®µ**ä¿ç•™ä¸?null**ï¼ˆä¸çœç•¥ï¼‰ï¼Œå‰ç«¯ type signature ç¨³å®šï¼?        actions åºåˆ—åŒ–ä¸º [{id, label}, ...]ã€?        """
        d = asdict(self)
        d["actions"] = [a if isinstance(a, dict) else a.to_dict()
                        if hasattr(a, "to_dict") else dict(a)
                        for a in self.actions]
        # asdict å·²å±•å¼€ ArtifactAction ä¸?dictï¼Œä½† .to_dict() è·¯å¾„æ›´ç¨³ï¼?        # è¿™é‡Œå…œåº•ç¡®ä¿ list[dict]ã€?        return d


# â”€â”€â”€ sha256 å¼‚æ­¥ â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

def _sha256_file_sync(path: Path) -> str:
    """åŒæ­¥ç®?sha256ï¼ˆçº¿ç¨‹æ± é‡Œè°ƒï¼‰ã€‚è¯» 1MB chunk é˜?OOMã€?""
    h = hashlib.sha256()
    with open(path, "rb") as f:
        while True:
            chunk = f.read(1024 * 1024)
            if not chunk:
                break
            h.update(chunk)
    return h.hexdigest()


async def sha256_file_async(
    path: Path,
    timeout_s: float = SHA256_DEFAULT_TIMEOUT_S,
) -> Optional[str]:
    """å¼‚æ­¥ç®?sha256ï¼Œå¤§æ–‡ä»¶èµ°çº¿ç¨‹æ± é¿å…é˜»å¡žä¸»å¾ªçŽ¯ï¼ˆPRD D5ï¼‰ã€?
    Returns:
        hex digest å­—ç¬¦ä¸²ï¼›è¶…æ—¶ â†?``None``ï¼ˆè°ƒç”¨æ–¹æ®æ­¤æ ?``sha256_pending``ï¼‰ã€?    """
    if not path.exists() or not path.is_file():
        return None
    try:
        size = path.stat().st_size
    except OSError:
        return None

    loop = asyncio.get_running_loop()
    fut: asyncio.Future[str]
    if size <= SHA256_EXECUTOR_THRESHOLD_BYTES:
        # å°æ–‡ä»¶ç›´æŽ¥åŒæ­¥ç®—ï¼? 10MBï¼Œ~30ms é‡çº§ï¼?        # ä»åŒ…ä¸€å±?executor è®?await è¯­ä¹‰ç»Ÿä¸€ + ä¸é˜»å¡?event loop tick
        fut = loop.run_in_executor(None, _sha256_file_sync, path)
