+def test_all_changes_are_reported_with_exact_original_object_hashes():
+    before = document(typed_edges=(support_edge("e-old", "o-a", "support-old"),))
+    old_network = snapshot()
+    changed_occurrences = tuple(
+        replace(item, requiredness=Requiredness.OPTIONAL_AUTHORIZED)
+        if str(item.occurrence_id) == "o-a"
+        else item
+        for item in old_network.occurrences
+    )
+    after = document(
+        plan_revision=PlanRevision(2),
+        occurrences=changed_occurrences,
+        typed_edges=(support_edge("e-new", "o-d", "support-new"),),
+    )
+    result = diff_documents(before, after)
+    old = {(item.kind, item.identity): item.sha256 for item in before.objects}
+    new = {(item.kind, item.identity): item.sha256 for item in after.objects}
+    assert len(result.changes) == 3
+    assert {(item.kind, item.identity) for item in result.changes} == {
+        ("occurrence", "o-a"),
+        *((item.kind, item.identity) for item in before.objects if item.kind == "typed_edge"),
+        *((item.kind, item.identity) for item in after.objects if item.kind == "typed_edge"),
+    }
+    for item in result.changes:
+        assert item.before_hash == old.get((item.kind, item.identity))
+        assert item.after_hash == new.get((item.kind, item.identity))
+    assert (
+        result.from_manifest_hash
+        == hashlib.sha256(canonical_json(before.to_json()).encode()).hexdigest()
+    )
+    assert (
+        result.to_manifest_hash
