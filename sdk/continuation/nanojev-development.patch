new file mode 100644
index 0000000..eb7842e
--- /dev/null
+++ b/src/agent_orchestrator/decision/providers/nanojev.py
@@ -0,0 +1,70 @@
+"""Adapter from the resident NanoJev runtime to the decision contract."""
+
+from __future__ import annotations
+
+import time
+
+from ...contracts.models import ContractError
+from ..provider import DecisionProvider
+from ..runtime import NanoJevOutput, NanoJevRequest, NanoJevRuntime
+from ..types import DecisionRequest, DecisionResult, DecisionScore
+
+
+class NanoJevDecisionProvider(DecisionProvider):
+    def __init__(self, runtime: NanoJevRuntime, *, name: str = "nanojev") -> None:
+        if not isinstance(runtime, NanoJevRuntime):
+            raise TypeError("runtime must be a NanoJevRuntime")
+        if not isinstance(name, str) or not name.strip():
+            raise ValueError("name must be a non-empty string")
+        self._runtime = runtime
+        self._name = name
+
+    @property
+    def name(self) -> str:
+        return self._name
+
+    async def decide(self, request: DecisionRequest) -> DecisionResult:
+        if not isinstance(request, DecisionRequest):
+            raise TypeError("request must be a DecisionRequest")
+        if len(request.candidates) <= 1:
+            raise ContractError("NanoJev provider requires at least two candidates")
+        nano_request = NanoJevRequest(
+            decision_id=request.decision_id,
+            decision_type=request.decision_type,
+            candidates=tuple(
+                {"id": candidate.id, "label": candidate.label, "metadata": candidate.metadata}
+                for candidate in request.candidates
+            ),
+            context=request.context,
+        )
+        started = time.perf_counter()
+        raw = await self._runtime.evaluate(nano_request)
+        latency_ms = (time.perf_counter() - started) * 1000.0
+        if not isinstance(raw, NanoJevOutput):
+            raise ContractError("NanoJev runtime returned an invalid output")
+        candidate_ids = tuple(candidate.id for candidate in request.candidates)
+        if raw.selected not in candidate_ids:
+            raise ContractError("NanoJev selected an unknown candidate")
+        if set(raw.probabilities) != set(candidate_ids):
+            raise ContractError("NanoJev probabilities do not match candidates")
+        try:
+            scores = tuple(
+                DecisionScore(candidate_id, float(raw.probabilities[candidate_id]))
+                for candidate_id in candidate_ids
+            )
+        except (TypeError, ValueError, KeyError) as error:
+            raise ContractError("NanoJev probabilities are invalid") from error
+        total = sum(score.probability for score in scores)
+        if abs(total - 1.0) > 1e-5:
+            raise ContractError("NanoJev probabilities must sum to 1")
+        ordered = sorted((score.probability for score in scores), reverse=True)
+        return DecisionResult(
+            decision_id=request.decision_id,
+            provider=self._name,
+            selected=raw.selected,
+            scores=scores,
+            top1_probability=ordered[0],
+            margin=ordered[0] - ordered[1] if len(ordered) > 1 else 1.0,
+            latency_ms=latency_ms,
+            model_version=raw.model_version,
+        )
