{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.simpleharness.invalid/assurance/1.1/review-reply-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "verdict",
    "assessments",
    "findings"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "verdict": {
      "enum": [
        "ACCEPT",
        "REWORK",
        "INCONCLUSIVE",
        "REJECTED"
      ]
    },
    "assessments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion_id",
          "verdict",
          "evidence_ids",
          "reason",
          "limitations"
        ],
        "properties": {
          "criterion_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "verdict": {
            "enum": [
              "PASS",
              "FAIL",
              "UNKNOWN"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "minItems": 0,
            "maxItems": 64,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "uniqueItems": true
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "limitations": {
            "type": "array",
            "minItems": 0,
            "maxItems": 16,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "uniqueItems": true
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "minItems": 0,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion_id",
          "severity",
          "reason"
        ],
        "properties": {
          "criterion_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "severity": {
            "enum": [
              "BLOCKER",
              "WARNING",
              "INFO"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        }
      }
    }
  },
  "$defs": {
    "formula": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "criterion"
          ],
          "properties": {
            "criterion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "items": {
                "$ref": "#/$defs/formula"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "any"
          ],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "maxItems": 256,
              "items": {
                "$ref": "#/$defs/formula"
              }
            }
          }
        }
      ]
    }
  }
}
