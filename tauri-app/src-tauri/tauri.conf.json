{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "SimpleHarness",
  "version": "0.6.0-beta.9",
  "identifier": "com.dennywanye.simpleharness",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Simple Harness",
        "width": 1000,
        "height": 700,
        "minWidth": 800,
        "minHeight": 560,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "resizable": true,
        "maximizable": true,
        "skipTaskbar": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "wix": {
        "version": "0.6.0.3"
      }
    },
    "resources": {
      "../../resources/diagnostic-redaction.json": "resources/diagnostic-redaction.json"
    }
  },
  "plugins": {
    "updater": {
      "active": false,
      "endpoints": [
        "https://defaultbucket-1300194691.cos.ap-guangzhou.myqcloud.com/deskpet/latest.json",
        "https://github.com/DennyWanye/deskpet/releases/latest/download/latest.json"
      ],
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVFM0I2QTIxREZENEFDM0YKUldRL3JOVGZJV283WGg1YlFWZG9Lbkxldk8yc3VNUXhzMG10QlgzRmpEODk1S2JFdWd6RjVMdW8K"
    }
  }
}
