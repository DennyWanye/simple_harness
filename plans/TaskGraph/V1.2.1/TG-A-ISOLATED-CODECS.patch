+from __future__ import annotations
+
+import copy
+import hashlib
+import json
+import os
+from pathlib import Path
+
+import jsonschema
+import pytest
+
+from agent_orchestrator.contracts.models import ContractError
+from agent_orchestrator.graph.execution_contracts import GraphSourceRead, PreviewBindingV1
+
+CHANNELS = (
+    "request",
+    "authorization",
+    "network",
+    "methods",
+    "evidence",
+    "capabilities",
+    "operations",
+    "running_work",
+    "acceptances",
+    "demand",
+    "budget",
+    "inputs",
+)
+HASH = "a" * 64
+
+
+def _payload() -> dict:
+    return {
+        "schema_version": 1,
+        "decision_id": "decision-1",
+        "request_id": "request-1",
+        "mission_id": "mission-1",
+        "base_revision": 0,
+        "decision_hash": HASH,
+        "network_hash": "b" * 64,
+        "candidate_hash": "c" * 64,
+        "delta_hash": "d" * 64,
+        "read_set_hash": "e" * 64,
+        "validator_id": "validator-1",
+        "validator_version": "v1",
+        "source_reads": [
+            {"channel": channel, "identity": f"{channel}-1", "digest": HASH, "coverage": "COMPLETE"}
+            for channel in CHANNELS
+        ],
+        "pending_compound_ids": ["compound-2", "compound-1"],
+        "required_convergence_ids": ["convergence-2", "convergence-1"],
+    }
+
+
+def test_positive_payload_matches_frozen_schema() -> None:
+    payload = _payload()
+    binding = PreviewBindingV1.from_json(payload)
+    assert binding.to_json()["source_reads"][0]["channel"] == "acceptances"
+    assert binding.to_json()["pending_compound_ids"] == ["compound-1", "compound-2"]
+    schema_path = Path(
+        "/Users/denny/projects/simple_harness/.local-test-evidence/2026-09-21/taskgraph/parallel-221113/source-capture/inputs/simpleharness-taskgraph-code-plan-kit/schemas/preview-binding-v1.schema.json"
+    )
+    assert (
+        hashlib.sha256(schema_path.read_bytes()).hexdigest()
+        == os.environ["TG_REVIEWED_PREVIEW_SCHEMA_SHA256"]
+    )
+    jsonschema.Draft202012Validator(json.loads(schema_path.read_text())).validate(binding.to_json())
+
+
+@pytest.mark.parametrize("channel", CHANNELS)
+def test_each_missing_channel_is_rejected(channel: str) -> None:
+    payload = _payload()
+    payload["source_reads"] = [
+        item for item in payload["source_reads"] if item["channel"] != channel
+    ]
+    with pytest.raises(ContractError):
+        PreviewBindingV1.from_json(payload)
+
+
+@pytest.mark.parametrize("channel", CHANNELS)
+def test_each_channel_replaced_by_unknown_is_rejected(channel: str) -> None:
+    payload = _payload()
+    next(item for item in payload["source_reads"] if item["channel"] == channel)["channel"] = (
+        "unknown"
+    )
+    with pytest.raises(ContractError):
+        PreviewBindingV1.from_json(payload)
+
+
+@pytest.mark.parametrize("channel", CHANNELS)
+def test_each_duplicate_channel_is_rejected(channel: str) -> None:
+    payload = _payload()
+    item = copy.deepcopy(
+        next(item for item in payload["source_reads"] if item["channel"] == channel)
+    )
+    payload["source_reads"].append(item)
+    with pytest.raises(ContractError):
+        PreviewBindingV1.from_json(payload)
+
+
+def test_incomplete_coverage_is_rejected() -> None:
+    payload = _payload()
+    payload["source_reads"][0]["coverage"] = "INCOMPLETE"
+    with pytest.raises(ContractError):
+        PreviewBindingV1.from_json(payload)
+
+
+def test_unknown_fields_are_rejected_at_both_levels() -> None:
+    payload = _payload()
+    payload["extra"] = True
+    with pytest.raises(ContractError):
+        PreviewBindingV1.from_json(payload)
+    payload = _payload()
+    payload["source_reads"][0]["extra"] = True
+    with pytest.raises(ContractError):
+        PreviewBindingV1.from_json(payload)
+
+
+@pytest.mark.parametrize(
+    "field,value",
+    [
+        ("decision_hash", "A" * 64),
+        ("network_hash", "z" * 64),
+        ("candidate_hash", "a" * 63),
+        ("base_revision", True),
+        ("base_revision", -1),
+        ("base_revision", 9_007_199_254_740_992),
+        ("schema_version", True),
+        ("schema_version", 2),
+    ],
+)
+def test_numeric_bool_version_and_hash_bounds_are_rejected(field: str, value: object) -> None:
+    payload = _payload()
+    payload[field] = value
+    with pytest.raises(ContractError):
+        PreviewBindingV1.from_json(payload)
+
+
+def test_duplicate_ids_are_rejected_and_valid_ids_are_sorted() -> None:
+    payload = _payload()
+    payload["pending_compound_ids"] = ["same", "same"]
+    with pytest.raises(ContractError):
+        PreviewBindingV1.from_json(payload)
+    payload = _payload()
+    binding = PreviewBindingV1.from_json(payload)
+    assert binding.required_convergence_ids == ("convergence-1", "convergence-2")
+
+
+def test_constructor_detaches_mutable_nested_input() -> None:
+    reads = [
+        {"channel": channel, "identity": channel, "digest": HASH, "coverage": "COMPLETE"}
+        for channel in CHANNELS
+    ]
+    pending = ["pending"]
+    binding = PreviewBindingV1.from_json(
+        {**_payload(), "source_reads": reads, "pending_compound_ids": pending}
+    )
+    reads[0]["identity"] = "mutated"
+    pending.append("later")
+    request_read = next(item for item in binding.source_reads if item.channel == "request")
+    assert request_read.identity == "request"
+    assert binding.pending_compound_ids == ("pending",)
+
+
+def test_roundtrip_and_canonical_hash_are_stable() -> None:
+    first = PreviewBindingV1.from_json(_payload())
+    second = PreviewBindingV1.from_json(json.loads(first.canonical_json()))
+    assert first.to_json() == second.to_json()
+    assert first.canonical_hash() == second.canonical_hash()
+    assert first.canonical_hash() == hashlib.sha256(first.canonical_json().encode()).hexdigest()
+
+
+@pytest.mark.parametrize(
+    "field", ["decision_id", "request_id", "mission_id", "validator_id", "validator_version"]
+)
+def test_text_bounds_are_enforced(field: str) -> None:
+    payload = _payload()
+    payload[field] = "x" * 512
+    assert getattr(PreviewBindingV1.from_json(payload), field) == "x" * 512
+    payload[field] = "x" * 513
+    with pytest.raises(ContractError):
+        PreviewBindingV1.from_json(payload)
+    payload[field] = "\ud800"
+    with pytest.raises(ContractError):
+        PreviewBindingV1.from_json(payload)
+
+
+@pytest.mark.parametrize("field", ["pending_compound_ids", "required_convergence_ids"])
+def test_set_bounds_are_enforced(field: str) -> None:
+    payload = _payload()
+    payload[field] = [f"x-{i}" for i in range(4096)]
+    assert len(getattr(PreviewBindingV1.from_json(payload), field)) == 4096
+    payload[field] = [f"x-{i}" for i in range(4097)]
+    with pytest.raises(ContractError):
+        PreviewBindingV1.from_json(payload)
+
+
+def test_non_string_mapping_keys_are_rejected() -> None:
+    payload = _payload()
+    payload[1] = "bad"
+    with pytest.raises(ContractError):
+        PreviewBindingV1.from_json(payload)
+    payload = _payload()
+    payload["source_reads"][0][1] = "bad"
+    with pytest.raises(ContractError):
+        PreviewBindingV1.from_json(payload)
+
+
+def test_constructor_rejects_same_invalid_shapes_as_from_json() -> None:
+    with pytest.raises(ContractError):
+        PreviewBindingV1(
+            source_reads=1,
+            **{key: value for key, value in _payload().items() if key != "source_reads"},
+        )
+    with pytest.raises(ContractError):
+        PreviewBindingV1.from_json({**_payload(), "source_reads": 1})
+
+
+def test_graph_source_read_constructor_and_from_json_share_validation() -> None:
+    with pytest.raises(ContractError):
+        GraphSourceRead(channel="request", identity="x", digest=HASH, coverage="INCOMPLETE")
+    with pytest.raises(ContractError):
+        GraphSourceRead.from_json(
+            {
+                "channel": "request",
+                "identity": "x",
+                "digest": HASH,
+                "coverage": "COMPLETE",
+                "extra": 1,
+            }
+        )
+
+
+@pytest.mark.parametrize("field", tuple(_payload()))
+def test_missing_preview_field_is_rejected(field: str) -> None:
+    payload = _payload()
+    del payload[field]
+    with pytest.raises(ContractError, match="all fields are required"):
+        PreviewBindingV1.from_json(payload)
+
+
+def test_complete_coverage_requires_explicit_constructor_input() -> None:
+    with pytest.raises(TypeError, match="coverage"):
+        GraphSourceRead(channel="request", identity="x", digest=HASH)
+
+
+def test_input_permutation_has_same_canonical_hash() -> None:
+    first = _payload()
+    second = copy.deepcopy(first)
+    second["source_reads"].reverse()
+    second["pending_compound_ids"].reverse()
+    second["required_convergence_ids"].reverse()
+    assert (
+        PreviewBindingV1.from_json(first).canonical_json()
+        == PreviewBindingV1.from_json(second).canonical_json()
+    )
