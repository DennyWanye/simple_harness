        r.kind ? `ï¼ˆkind=${r.kind}ï¼‰` : ""
      }`;
    case "error":
      return `å‘½ä»¤å‡ºé”™: ${r.message || "unknown"}${r.hint ? `\næç¤º: ${r.hint}` : ""}`;
    default:
      // å…œåº•ï¼šæœªçŸ?type ä¹Ÿè¦å±•ç¤ºï¼Œç¦æ­¢é™é»˜ä¸¢ã€?
