        if tc.args_parse_error:
            args_raw = tc.args_raw or ""
            preview = args_raw[:300]
            if len(args_raw) > 300:
                preview = preview + "鈥?
            logger.warning(
                "p5s2_dispatch_short_circuit_malformed_args "
