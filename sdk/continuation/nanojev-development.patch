@@ -0,0 +1,202 @@
+from __future__ import annotations
+
+import asyncio
+
+import pytest
+
+from agent_orchestrator.contracts.models import ContractError
+from agent_orchestrator.decision import (
+    DecisionCandidate,
+    DecisionMode,
+    DecisionPolicy,
+    DecisionRequest,
+    DecisionResult,
+    DecisionService,
+    DecisionType,
+    ShadowObservationStatus,
+)
+from agent_orchestrator.decision.provider import DecisionProvider
+from agent_orchestrator.decision.types import DecisionScore
+
+
+def request(
+    decision_id: str = "d-1", *, context: dict[str, object] | None = None
+) -> DecisionRequest:
+    return DecisionRequest(
+        decision_id=decision_id,
+        decision_type=DecisionType.READY_TASK_PRIORITY,
+        mission_id="m-1",
+        task_id="t-1",
+        candidates=(
+            DecisionCandidate("a", "A", {"rank": 1}),
+            DecisionCandidate("b", "B", {"rank": 2}),
+        ),
+        context=context or {"target": {"value": "original"}},
+    )
+
+
+class StubProvider(DecisionProvider):
+    def __init__(
+        self,
+        selected: str,
+        *,
+        gate: asyncio.Event | None = None,
+        error: Exception | None = None,
+    ) -> None:
+        self.selected = selected
+        self.gate = gate
+        self.error = error
+        self.calls = 0
+
+    async def decide(self, request: DecisionRequest) -> DecisionResult:
+        self.calls += 1
+        if self.gate is not None:
+            await self.gate.wait()
+        if self.error is not None:
+            raise self.error
+        return DecisionResult(
+            decision_id=request.decision_id,
+            provider="stub",
+            selected=self.selected,
+            scores=tuple(
+                DecisionScore(
+                    candidate.id,
+                    1.0
+                    if len(request.candidates) == 1
+                    else (0.9 if candidate.id == self.selected else 0.1),
+                )
+                for candidate in request.candidates
+            ),
+            top1_probability=1.0 if len(request.candidates) == 1 else 0.9,
+            margin=1.0 if len(request.candidates) == 1 else 0.8,
+            latency_ms=0.1,
+        )
+
+
+class MalformedProvider(DecisionProvider):
+    async def decide(self, request: DecisionRequest) -> DecisionResult:
+        return DecisionResult(
+            decision_id=request.decision_id,
+            provider="malformed",
+            selected="a",
+            scores=tuple(
+                DecisionScore(candidate.id, 0.4) for candidate in request.candidates
+            ),
+            top1_probability=0.4,
+            margin=0.0,
+            latency_ms=0.1,
+        )
+
+
+@pytest.mark.asyncio
+async def test_shadow_returns_existing_before_shadow_and_records_late_result() -> None:
+    gate = asyncio.Event()
+    existing = StubProvider("a")
+    shadow = StubProvider("b", gate=gate)
+    service = DecisionService(
+        existing,
+        policy=DecisionPolicy(DecisionMode.SHADOW),
+        shadow_provider=shadow,
+    )
+
+    result = await service.decide(request())
+    assert result.selected == "a"
+    assert service.observations == ()
+    await asyncio.sleep(0)
+    assert shadow.calls == 1
+
+    gate.set()
+    observations = await service.drain()
+    assert len(observations) == 1
+    assert observations[0].status is ShadowObservationStatus.COMPLETED
+    assert observations[0].shadow_result is not None
+    assert observations[0].shadow_result.selected == "b"
+
+
+@pytest.mark.asyncio
+async def test_shadow_failure_is_observed_without_failing_existing() -> None:
+    service = DecisionService(
+        StubProvider("a"),
+        policy=DecisionPolicy(DecisionMode.SHADOW),
+        shadow_provider=StubProvider("b", error=ContractError("bad output")),
+    )
+
+    assert (await service.decide(request())).selected == "a"
+    observations = await service.drain()
+    assert observations[0].status is ShadowObservationStatus.FAILED
+    assert "ContractError" in (observations[0].error or "")
+
+
+@pytest.mark.asyncio
+async def test_shadow_observations_keep_request_identity_and_detached_context() -> None:
+    existing = StubProvider("a")
+    shadow = StubProvider("b")
+    service = DecisionService(
+        existing,
+        policy=DecisionPolicy(DecisionMode.SHADOW),
+        shadow_provider=shadow,
+    )
+    original_context = {"target": {"value": "before"}}
+    await service.decide(request("x", context=original_context))
+    original_context["target"]["value"] = "after"
+    await service.decide(request("y", context={"target": {"value": "y"}}))
+    observations = await service.drain()
+
+    assert [item.decision_id for item in observations] == ["x", "y"]
+    assert observations[0].request_context["target"]["value"] == "before"
+    assert observations[1].request_context["target"]["value"] == "y"
+    with pytest.raises(TypeError):
+        observations[0].request_context["new"] = "forbidden"
+
+
+@pytest.mark.asyncio
+async def test_single_candidate_does_not_call_shadow_provider() -> None:
+    existing = StubProvider("a")
+    shadow = StubProvider("a")
+    service = DecisionService(
+        existing,
+        policy=DecisionPolicy(DecisionMode.SHADOW),
+        shadow_provider=shadow,
+    )
+    one = DecisionRequest(
+        decision_id="one",
+        decision_type=DecisionType.READY_TASK_PRIORITY,
+        mission_id="m-1",
+        task_id="t-1",
+        candidates=(DecisionCandidate("a", "A", {}),),
+        context={},
+    )
+
+    assert (await service.decide(one)).selected == "a"
+    assert shadow.calls == 0
+    assert await service.drain() == ()
+
+
+@pytest.mark.asyncio
+async def test_invalid_shadow_distribution_is_observed_as_failure() -> None:
+    service = DecisionService(
+        StubProvider("a"),
+        policy=DecisionPolicy(DecisionMode.SHADOW),
+        shadow_provider=MalformedProvider(),
+    )
+
+    assert (await service.decide(request())).selected == "a"
+    observations = await service.drain()
+    assert observations[0].status is ShadowObservationStatus.FAILED
+    assert "sum to 1" in (observations[0].error or "")
+
+
+@pytest.mark.asyncio
+async def test_shadow_timeout_does_not_replace_existing_result() -> None:
+    gate = asyncio.Event()
+    service = DecisionService(
+        StubProvider("a"),
+        policy=DecisionPolicy(DecisionMode.SHADOW),
+        shadow_provider=StubProvider("b", gate=gate),
+        shadow_timeout_seconds=0.001,
+    )
+
+    assert (await service.decide(request())).selected == "a"
+    observations = await service.drain()
+    assert observations[0].status is ShadowObservationStatus.TIMED_OUT
+    assert observations[0].existing_result.selected == "a"
