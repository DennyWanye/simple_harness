# Public dataclasses
# ---------------------------------------------------------------------


@dataclass
class SlideOutline:
    """One slide spec. LLM produces a list of these as JSON."""

    layout: str = "bullet"
    title: str = ""
    subtitle: str = ""
    bullets: list[str] = field(default_factory=list)
    # two_column
    left: list[str] = field(default_factory=list)
    right: list[str] = field(default_factory=list)
    left_title: str = ""
    right_title: str = ""
    # image
    image_path: Optional[str] = None
    # 鏁撮〉鐢熷浘锛氭湁鍒?ppt_create 鑷姩鐢熷浘濉?image_path
    image_prompt: Optional[str] = None
    # 鏁撮〉鐢熷浘鐗堝紡鍙樹綋(鐗堝紡澶氭牱鍖?: cover/split_left/split_right/top/card/
    # quote銆傜┖ = 鐢?_assign_image_layouts 鎸夊唴瀹硅嚜鍔ㄥ垎閰?鐩搁偦涓嶉噸澶?銆?
    image_variant: str = ""
    # 瑙嗚璇勫闂幆鐨?shrink_text 鍔ㄤ綔: 娓叉煋瀛楀彿 脳 姝ょ郴鏁?榛樿 1.0)銆?
    font_scale: float = 1.0
    caption: str = ""
    # quote
    quote: str = ""
    cite: str = ""
    # toc 鈥?uses bullets[]
    # chart: {"type": "bar"|"line"|"pie", "categories": [...],
    #         "series": [{"name": "...", "values": [...]}, ...]}
    chart: Optional[dict] = None
    # generic
    notes: str = ""  # speaker notes

    def normalize(self) -> "SlideOutline":
        """Coerce raw LLM output into the strict schema."""
        layout = (self.layout or "bullet").strip().lower()
