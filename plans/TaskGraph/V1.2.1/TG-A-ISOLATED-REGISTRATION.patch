+        provenance = {}
+        for cls in (CommitService, TaskGraphProposal):
+            path = Path(sys.modules[cls.__module__].__file__).resolve()
+            provenance[cls.__module__] = {
+                "path": str(path),
+                "sha256": hashlib.sha256(path.read_bytes()).hexdigest(),
+            }
+        return {
+            "chains": receipts,
+            "artifact_files": files,
+            "model_calls": 0,
+            "real_executor_used": False,
+            "producer_sources": provenance,
+        }
+    finally:
+        store.close()
