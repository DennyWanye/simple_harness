     user doesn't have one yet. Also: P4-S21 #12 — if user_data_dir/config.toml
     exists but uses the legacy ``[llm.local]/[llm.cloud]`` schema, back it up
@@ -1009,12 +1011,131 @@
             "seeded user config.toml from bundle: %s -> %s", source, user_target,
         )
         return user_target
-    except OSError as e:
