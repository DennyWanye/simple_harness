+    # observer must not see an unscored compound/refusal row from the input snapshot.
+    plan = AllocationPlanV2(
+        grants=((SimpleNamespace(task_id="m:task-a"), 1),),
+        scores={"m:task-a": object(), "m:task-b": object()},
+    )
+
+    await host._observe_decision(
+        SimpleNamespace(id="m"),
+        (task_a, task_b, SimpleNamespace(id="m:compound")),
+        (),
+        plan,
+    )
+    for _ in range(20):
+        if not host._decision_observer_tasks:
+            break
+        await asyncio.sleep(0)
+
+    assert len(observed) == 1
+    assert tuple(task.id for task in observed[0][1]) == ("m:task-a", "m:task-b")
+    assert observed[0][3] is plan
