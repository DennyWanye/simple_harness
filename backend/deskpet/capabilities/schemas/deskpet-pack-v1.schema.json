{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deskpet.local/schemas/deskpet-pack-v1.schema.json",
  "title": "DeskPet Capability Pack Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "source",
    "compatibility",
    "entries",
    "permissions",
    "effects",
    "dependencies",
    "files",
    "uninstall"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "$ref": "#/$defs/logicalId" },
    "name": { "type": "string", "minLength": 1 },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "uri", "revision"],
      "properties": {
        "type": { "enum": ["builtin", "local", "configured", "git"] },
        "uri": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deskpet", "os", "architectures", "python"],
      "properties": {
        "deskpet": { "type": "string", "minLength": 1 },
        "os": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "architectures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "python": { "type": "string", "minLength": 1 }
      }
    },
    "entries": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "skills": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "properties": { "path": { "$ref": "#/$defs/relativePath" } }
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "provider_name",
              "runtime",
              "execution_profile",
              "input_views",
              "entry",
              "schema",
              "healthcheck"
            ],
            "properties": {
              "id": { "$ref": "#/$defs/logicalId" },
              "provider_name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "runtime": { "enum": ["deskpet-json-tool-v1", "mcp"] },
              "execution_profile": {
                "enum": ["brokered-effect-v1", "native-adapter"]
              },
              "input_views": {
                "type": "array",
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "entry": { "$ref": "#/$defs/relativePath" },
              "schema": { "$ref": "#/$defs/relativePath" },
              "healthcheck": { "type": "string", "minLength": 1 }
            }
          }
        },
        "mcp_servers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "config_ref"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "config_ref": { "$ref": "#/$defs/relativePath" }
            }
          }
        }
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "effects": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "read_only",
          "idempotent_read",
          "deterministic_reusable",
          "staged_file",
          "opaque_manual"
        ]
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "commands"],
      "properties": {
        "python": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["requirement"],
                "properties": {
                  "requirement": { "type": "string", "minLength": 1 }
                }
              }
            ]
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "version"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "files": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "$ref": "#/$defs/relativePath" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "uninstall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stop_servers", "remove_environment_when_unreferenced"],
      "properties": {
        "stop_servers": { "type": "boolean" },
        "remove_environment_when_unreferenced": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "logicalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9_-]{0,62}[A-Za-z0-9])?$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?![A-Za-z]:)[^\\\\]+$"
    }
  }
}
