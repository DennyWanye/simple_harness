+
+    separated = seam.compute_ready_task_decision_id(
+        mission_id="m", task_id=None, ordinal=0, candidate_ids=("ab",), context={}
+    )
+    other = seam.compute_ready_task_decision_id(
+        mission_id="ma", task_id=None, ordinal=0, candidate_ids=("b",), context={}
+    )
